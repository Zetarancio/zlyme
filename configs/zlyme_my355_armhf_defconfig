# Separate ARM EABI hard-float sysroot for PortMaster. This is not the
# Flip image. BR2_cortex_a55 depends on AArch64 in Buildroot 2026.08, so
# the 32-bit tune is cortex-a53: ARMv8-A AArch32, NEON, and FP-ARMv8,
# which the RK3566 runs. Do not point this file at output/.
# external.mk gives this glibc slibdir and libdir /usr/lib/zlyme-armhf
# and leaves the loader at /lib/ld-linux-armhf.so.3.
# package/system/zlyme-armhf-runtime/stage-runtime.sh copies that
# layout into a root. It is not selected in the product image.
BR2_arm=y
BR2_cortex_a53=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_ARM_INSTRUCTIONS_ARM=y

BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_7_1=y

BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
BR2_TARGET_ROOTFS_TAR=y
BR2_PACKAGE_ZLYME_ARMHF_PROBE=y
