BR2_aarch64=y
BR2_cortex_a55=y
BR2_ZLYME_DEVICE_MY355=y

# Cortex-A55 with CRC/crypto/fp/simd/rcpc. Userspace -O3 (BR2_OPTIMIZE_3);
# pin known-bad packages back to -O2 in their .mk. Kernel stays -O2.
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char -mcpu=cortex-a55+crc+crypto+fp+simd+rcpc"
BR2_OPTIMIZE_3=y

BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Kernel headers must match the kernel we build. 6.19 is Buildroot's
# newest series flag and covers 7.0.2. Without it glibc silently becomes uClibc.
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_19=y

# ccache. Path comes from the environment (build.sh).
BR2_CCACHE=y

# Kernel/u-boot patches, in order. Later dirs build on earlier ones.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_ZLYME_PATH)/board/my355/linux/patches/10-mainline $(BR2_EXTERNAL_ZLYME_PATH)/board/my355/linux/patches/20-rk3566 $(BR2_EXTERNAL_ZLYME_PATH)/board/my355/linux/patches/30-default $(BR2_EXTERNAL_ZLYME_PATH)/board/my355/linux/patches/40-kernel-7.0 $(BR2_EXTERNAL_ZLYME_PATH)/board/my355/uboot/patches"

BR2_TARGET_GENERIC_HOSTNAME="zlyme"
BR2_TARGET_GENERIC_ISSUE="Zlyme"

# Empty root password on serial. Bring-up only.
BR2_TARGET_ENABLE_ROOT_LOGIN=y
BR2_TARGET_GENERIC_ROOT_PASSWD=""

# busybox init (S## scripts). No systemd. eudev for OTG, disks, BT HID.
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_EUDEV=y
# HWDB is USB pretty-names; skip the extra udevd startup cost.
# BR2_PACKAGE_EUDEV_ENABLE_HWDB is not set

# Serial getty on ttyS2. Baud is already 1500000; "keep" leaves it alone.
BR2_TARGET_GENERIC_GETTY_PORT="ttyS2"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_KEEP=y
BR2_TARGET_GENERIC_GETTY_TERM="linux"

# squashfs root stays read-only. /var is tmpfs (see fstab).
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set

BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ZLYME_PATH)/board/my355/fsoverlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ZLYME_PATH)/board/my355/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_ZLYME_PATH)/board/my355/post-image.sh"

# Kernel 7.0.2. Hash is in board/my355/linux/patches/10-mainline/linux/linux.hash.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.0.2"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_ZLYME_PATH)/board/my355/linux/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ZLYME_PATH)/board/my355/linux/my355.fragment"
BR2_LINUX_KERNEL_IMAGE=y
BR2_PACKAGE_ZLYME_INITRAMFS=y

# DTS tree (keeps rockchip/ so rk3566.dtsi resolves). dtb line is in external.mk.
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_ZLYME_PATH)/board/my355/linux/dts"

# mainline u-boot, Quartz64-A defconfig. Patches: no RK8XX power-on, SD boot order.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2026.01"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="quartz64-a-rk3566"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
BR2_TARGET_UBOOT_USE_BINMAN=y
BR2_TARGET_UBOOT_NEEDS_ROCKCHIP_RKBIN=y

# idbloader + FIT, not the unified blob (genimage cannot span partitions).
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot.itb"
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="idbloader.img"

# TPL + BL31 must be a matching pair (else "loader&trust unmatch!!!").
# On a normal card boot Miyoo's NAND preloader already did DDR/SPL; only
# BL31 from this pair runs. TPL matters for a bootrom-only card (idbloader).
BR2_PACKAGE_ROCKCHIP_RKBIN=y
BR2_PACKAGE_ROCKCHIP_RKBIN_TPL_FILENAME="bin/rk35/rk3566_ddr_1056MHz_v1.23.bin"
BR2_PACKAGE_ROCKCHIP_RKBIN_BL31_FILENAME="bin/rk35/rk3568_bl31_v1.44.elf"

BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
BR2_TARGET_ROOTFS_SQUASHFS_EXTREME_COMP=y
BR2_TARGET_ROOTFS_SQUASHFS_BS_1024K=y
# BR2_TARGET_ROOTFS_TAR is not set

# Image assembly.
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# Connectivity. Real kmod: busybox modprobe ignores blacklist and softdep,
# and this combo chip resets if WiFi and BT load in the wrong order.
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y

# RTL8733BU: WiFi driver, power GPIO, BT firmware.
BR2_PACKAGE_RTL8733BU=y
BR2_PACKAGE_RTL8733BU_POWER=y
BR2_PACKAGE_RTL8723FU_FIRMWARE=y

# regulatory.db for cfg80211 (no CRDA).
BR2_PACKAGE_WIRELESS_REGDB=y

# wpa_supplicant (WPA3/SAE). No NetworkManager.
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y

# iw, for bring-up.
BR2_PACKAGE_IW=y

# SSH (SFTP). Host key on tmpfs; S27sshd starts before NextUI.
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_OPENSSH=y

# BlueZ: pairing, HID/HOG. Audio plugin comes with ALSA below. dbus is required.
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_MONITOR=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HOG=y

# exFAT tools. First boot formats the grown partition (Knulli S02resize).
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_GPTFDISK_SGDISK=y

# GPU: Mesa Panfrost, KMSDRM + GBM + EGL, no X11/Wayland.
# MESA3D_LLVM is required by Buildroot's panfrost option (else it is dropped).
# LLVM is not used in the GL client; see external.mk.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y

# kmscube: KMSDRM + GBM + GLES smoke test.
BR2_PACKAGE_KMSCUBE=y

# Vulkan loader + headers. ICD is mali_icd.json (libmali blob) when
# gpu=libmali. Buildroot 2026.02 mesa3d has no PanVK Kconfig option, so
# the panfrost stack stays GLES. Emulators pick vulkan vs gl themselves.
BR2_PACKAGE_VULKAN_HEADERS=y
BR2_PACKAGE_VULKAN_LOADER=y

# Audio: ALSA only. HDMI is card 0, rk817_ext is card 1.
BR2_PACKAGE_ALSA_LIB=y

# alsactl (S20alsa restores mixer state). The rest is bring-up.
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# bluealsa (SBC). A2DP PCM is the `bt` sink in asound.conf.
BR2_PACKAGE_BLUEZ_ALSA=y
BR2_PACKAGE_ZLYME_JACKD=y

# zlyme_defconfig = zlyme_minimal plus emulators. Keep the shared lines in step.
# SDL2: KMSDRM + GLES only.

BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_OPENGLES=y
BR2_PACKAGE_SDL2_KMSDRM=y
# AetherSX2 (ROCKNIX binary) needs libaio. PortMaster games often need cairo.
BR2_PACKAGE_LIBAIO=y
BR2_PACKAGE_CAIRO=y
BR2_PACKAGE_CAIRO_PNG=y
# Qt6Core needs the 16-bit PCRE2. pcre2 was already built 8-bit-only
# before AetherSX2 landed; keep this in the defconfig so a cold build
# does not drop it.
BR2_PACKAGE_PCRE2=y
BR2_PACKAGE_PCRE2_16=y

BR2_PACKAGE_RETROARCH=y
BR2_PACKAGE_LIBRETRO_GAMBATTE=y
BR2_PACKAGE_LIBRETRO_GENESISPLUSGX=y

# Flip gamepad. The retired ROCKNIX module is not built.
BR2_PACKAGE_MIYOO_FLIP_GAMEPAD=y

# NextUI (my355). Not in the minimal image.

BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_FREETYPE=y
# RetroArch 1.22 libchdr needs liblzma at runtime. curl was linked
# against libzstd (squashfs is zstd too) but the .so was not on target.
BR2_PACKAGE_XZ=y
BR2_PACKAGE_ZSTD=y
# PortMaster themes are JPEG. sdl2_image only enables jpg when this is y
# at configure time; a later scummvm select does not rebuild it.
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_SDL2_TTF=y
BR2_PACKAGE_NEXTUI=y
# Packaged only. Not started at boot. Phase 4B owns the first run.
BR2_PACKAGE_INPUTPLUMBER=y
BR2_PACKAGE_LIBIIO=y
# BR2_PACKAGE_LIBIIO_XML_BACKEND is not set
# BR2_PACKAGE_LIBIIO_NETWORK_BACKEND is not set
# BR2_PACKAGE_LIBIIO_USB_BACKEND is not set
# BR2_PACKAGE_LIBIIO_SERIAL_BACKEND is not set
# BR2_PACKAGE_LIBIIO_IIOD is not set
BR2_PACKAGE_MINUI_LIST=y
BR2_PACKAGE_MINUI_PRESENTER=y
BR2_PACKAGE_ZLYME_KEYLIDMON=y

# Libretro cores.
BR2_PACKAGE_LIBRETRO_GPSP=y
BR2_PACKAGE_LIBRETRO_BEETLE_SUPAFAUST=y
BR2_PACKAGE_LIBRETRO_PCSX=y
BR2_PACKAGE_LIBRETRO_PICODRIVE=y
BR2_PACKAGE_LIBRETRO_NESTOPIA=y
BR2_PACKAGE_LIBRETRO_STELLA=y
