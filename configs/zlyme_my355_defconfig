BR2_PACKAGE_LIBRETRO_BEETLE_PCE_FAST=y
BR2_PACKAGE_LIBRETRO_BEETLE_SUPERGRAFX=y
BR2_PACKAGE_LIBRETRO_POKEMINI=y
BR2_PACKAGE_LIBRETRO_O2EM=y
BR2_PACKAGE_LIBRETRO_VECX=y
BR2_PACKAGE_LIBRETRO_BLUEMSX=y
BR2_PACKAGE_LIBRETRO_GEARCOLECO=y
BR2_PACKAGE_LIBRETRO_FREEINTV=y
BR2_PACKAGE_LIBRETRO_FBNEO=y
BR2_PACKAGE_LIBRETRO_MAME2003_PLUS=y
BR2_PACKAGE_LIBRETRO_NEOCD=y
BR2_PACKAGE_LIBRETRO_OPERA=y
BR2_PACKAGE_LIBRETRO_DOSBOX_PURE=y
BR2_PACKAGE_LIBRETRO_TIC80=y
BR2_PACKAGE_LIBRETRO_FAKE08=y
BR2_PACKAGE_LIBRETRO_MUPEN64PLUS_NEXT=y
BR2_PACKAGE_LIBRETRO_YABASANSHIRO=y
BR2_PACKAGE_LIBRETRO_EASYRPG=y
BR2_PACKAGE_LIBXMP=y
BR2_PACKAGE_WILDMIDI=y
BR2_PACKAGE_LIBRETRO_MKXP_Z=y
BR2_PACKAGE_LIBZIP=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_PPSSPP=y
BR2_PACKAGE_FLYCAST=y
BR2_PACKAGE_MALI_KBASE=y
BR2_PACKAGE_GPUDRIVER=y
BR2_PACKAGE_LIBMALI=y
BR2_PACKAGE_SAMBA4=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_SQLITE=y
BR2_PACKAGE_PYTHON3_PYEXPAT=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_SYNCTHING=y
BR2_PACKAGE_BOX64=y
# PortMaster launch scripts are #!/bin/bash ([[ ]], process subst).
BR2_PACKAGE_BASH=y
BR2_PACKAGE_PORTMASTER=y
BR2_PACKAGE_SCUMMVM=y
BR2_PACKAGE_HYPSEUS_SINGE=y
BR2_PACKAGE_AMIBERRY=y
BR2_PACKAGE_OPENBOR=y
