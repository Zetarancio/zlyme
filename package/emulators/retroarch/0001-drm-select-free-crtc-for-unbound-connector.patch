+static bool drm_bind_unbound_encoder(int fd)
+{
+   int i, c;
+
+   if (!g_drm_connector || g_drm_connector->encoder_id != 0 || !g_drm_resources)
+      return false;
+
+   /* 1.22.2 never sets these. ACTIVE and the primary plane are absent
+    * until it does, so a failed property read marked every CRTC occupied
+    * and an unbound HDMI connector could not take its own disabled CRTC.
+    */
+   drmSetClientCap(fd, DRM_CLIENT_CAP_UNIVERSAL_PLANES, 1);
+   drmSetClientCap(fd, DRM_CLIENT_CAP_ATOMIC, 1);
+
+   for (i = 0; i < g_drm_connector->count_encoders; i++)
+   {
+      drmModeEncoder *enc = drmModeGetEncoder(fd,
+            g_drm_connector->encoders[i]);
+      int chosen = -1;
+
+      if (!enc)
+         continue;
+      for (c = 0; c < g_drm_resources->count_crtcs; c++)
+      {
+         if ((enc->possible_crtcs & (1u << c)) == 0)
+            continue;
+         if (drm_crtc_is_scanning(fd, g_drm_resources->crtcs[c]))
+            continue;
+         chosen = c;
+         break;
+      }
+      if (chosen >= 0)
+      {
+         enc->crtc_id = g_drm_resources->crtcs[chosen];
+         g_drm_encoder = enc;
+         RARCH_LOG("[DRM] Unbound connector %u using encoder %u crtc %u.\n",
+               g_drm_connector->connector_id, enc->encoder_id, enc->crtc_id);
+         return true;
+      }
+      drmModeFreeEncoder(enc);
+   }
+   RARCH_WARN("[DRM] No free CRTC for unbound connector %u.\n",
+         g_drm_connector->connector_id);
+   return false;
+}
