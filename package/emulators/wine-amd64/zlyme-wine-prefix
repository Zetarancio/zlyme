#!/bin/sh
# Persistent Wine prefix files live on exFAT. dosdevices is a 1 MiB
# tmpfs because c: and z: have to be symlinks, and exFAT does not keep
# them. prepare prints the prefix directory. cleanup releases only that
# tmpfs and the wineserver for this prefix.

set -eu

STATE=/run/zlyme-wine
TMPFS_SIZE=1024k
WINE_PE=/usr/lib/wine-amd64/lib/wine
# Bump when the shipped PE trees change. A matching stamp skips the copy.
PE_SEED="wine-11.6-amd64-wow64"

log() {
	echo "zlyme-wine-prefix: $*" >&2
}

platform() {
	plat=my355
	if [ -r /usr/share/zlyme/device.conf ]; then
		# shellcheck disable=SC1091
		. /usr/share/zlyme/device.conf
		plat=${ZLYME_NEXTUI_PLATFORM:-my355}
	fi
	printf '%s' "$plat"
}

prefix_dir() {
	printf '%s\n' "/storage/.config/nextui/$(platform)/wine-prefix"
}

dosdevices_dir() {
	printf '%s\n' "$(prefix_dir)/dosdevices"
}

mounted_at() {
	awk -v p="$1" '$2 == p { found = 1 } END { exit found ? 0 : 1 }' /proc/mounts
}

mount_field() {
	awk -v p="$2" -v col="$1" '$2 == p { print $col; found = 1; exit } END { exit found ? 0 : 1 }' /proc/mounts
}

# The mountpoint must be this prefix's dosdevices, and both the source
# and the fstype must be tmpfs. Anything else stays mounted.
owned_tmpfs() {
	dos=$1
	src=$(mount_field 1 "$dos" 2>/dev/null || true)
	fst=$(mount_field 3 "$dos" 2>/dev/null || true)
	[ "$src" = "tmpfs" ] && [ "$fst" = "tmpfs" ]
}

link_devices() {
	dos=$1
	ln -sfn ../drive_c "$dos/c:"
	ln -sfn / "$dos/z:"
}

# exFAT cannot store the symlinks wineboot uses for builtin DLLs, and
# its copy is partial: syswow64 can lack user32.dll and the rest of the
# 32-bit import closure. A 32-bit GUI then dies with c0000135. Copy any
# missing PE builtin into system32 and syswow64. Existing files stay.
seed_dir() {
	src=$1
	dst=$2
	[ -d "$src" ] || return 0
	mkdir -p "$dst"
	list=$(mktemp)
	ls "$src" >"$list" || {
		rm -f "$list"
		return 1
	}
	while IFS= read -r base; do
		[ -n "$base" ] || continue
		[ -f "$src/$base" ] || continue
		[ -e "$dst/$base" ] && continue
		cp -f "$src/$base" "$dst/$base" || {
			rm -f "$list"
			return 1
		}
	done <"$list"
	rm -f "$list"
}

seed_builtins() {
	prefix=$1
	stamp="$prefix/.zlyme-pe-seed"
	if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$PE_SEED" ]; then
		return 0
	fi
	seed_dir "$WINE_PE/x86_64-windows" "$prefix/drive_c/windows/system32" || return 1
	seed_dir "$WINE_PE/i386-windows" "$prefix/drive_c/windows/syswow64" || return 1
	seed_winsxs "$prefix" || return 1
	printf '%s\n' "$PE_SEED" >"$stamp"
}

# wineboot writes the x86 common-controls manifest, then symlinks
# comctl32.dll into winsxs. exFAT drops the symlink, so the directory
# never appears and a 32-bit GUI fails with c0000135. Copy the builtin
# next to any x86 manifest that does not already have its file, and
# create the common-controls assembly before the first wineboot.
seed_winsxs() {
	prefix=$1
	winsxs="$prefix/drive_c/windows/winsxs"
	src="$WINE_PE/i386-windows"
	asm="x86_microsoft.windows.common-controls_6595b64144ccf1df_6.0.2600.2982_none_deadbeef"
	if [ -f "$src/comctl32.dll" ]; then
		mkdir -p "$winsxs/$asm"
		if [ ! -f "$winsxs/$asm/comctl32.dll" ]; then
			cp -f "$src/comctl32.dll" "$winsxs/$asm/comctl32.dll" || return 1
		fi
	fi
	man="$winsxs/manifests"
	[ -d "$man" ] || return 0
	for manifest in "$man"/x86_*.manifest; do
		[ -f "$manifest" ] || continue
		name=$(basename "$manifest" .manifest)
		dest="$winsxs/$name"
		mkdir -p "$dest"
		list=$(mktemp)
		sed -n 's/.*<file name="\([^"]*\)".*/\1/p' "$manifest" >"$list"
		while IFS= read -r dll; do
			[ -n "$dll" ] || continue
			[ -f "$dest/$dll" ] && continue
			[ -f "$src/$dll" ] || continue
			cp -f "$src/$dll" "$dest/$dll" || {
				rm -f "$list"
				return 1
			}
		done <"$list"
		rm -f "$list"
	done
}

holders() {
	dos=$1
	prefix=$2
	log "dosdevices is busy:"
	for d in /proc/[0-9]*; do
		pid=${d#/proc/}
		case "$pid" in
			*[!0-9]*) continue ;;
		esac
		cwd=$(readlink "$d/cwd" 2>/dev/null || true)
		exe=$(readlink "$d/exe" 2>/dev/null || true)
		root=$(readlink "$d/root" 2>/dev/null || true)
		case "$cwd:$exe:$root" in
			*"$dos"*|*"$prefix"*)
				cmd=$(tr '\0' ' ' < "$d/cmdline" 2>/dev/null || true)
				log "pid $pid $cmd"
				;;
		esac
	done
}

quiesce() {
	dos=$1
	prefix=$2
	i=0
	if [ -x /usr/bin/wineserver ]; then
		WINEPREFIX=$prefix /usr/bin/wineserver -k >/dev/null 2>&1 || true
	fi
	while mounted_at "$dos"; do
		if umount "$dos" 2>/dev/null; then
			return 0
		fi
		i=$((i + 1))
		if [ "$i" -ge 20 ]; then
			return 1
		fi
		sleep 0.1
	done
	return 0
}

prepare_cmd() {
	prefix=$(prefix_dir)
	dos=$(dosdevices_dir)
	# c: is a symlink to drive_c. Create the directory first. A dangling
	# symlink makes wineboot fail with ERROR_PATH_NOT_FOUND on C:\windows.
	mkdir -p "$prefix/drive_c" "$dos" "$STATE"
	seed_builtins "$prefix" || return 1
	printf '%s\n' "$prefix" > "$STATE/prefix"
	if mounted_at "$dos"; then
		if ! owned_tmpfs "$dos"; then
			log "$dos is not this prefix tmpfs"
			return 1
		fi
	elif ! mount -t tmpfs -o "size=${TMPFS_SIZE},mode=0755,nosuid,nodev" tmpfs "$dos"; then
		log "could not mount $dos"
		return 1
	fi
	link_devices "$dos"
	printf '%s\n' "$prefix"
}

cleanup_cmd() {
	prefix=$(prefix_dir)
	dos=$(dosdevices_dir)
	if [ -x /usr/bin/wineserver ]; then
		WINEPREFIX=$prefix /usr/bin/wineserver -k >/dev/null 2>&1 || true
	fi
	if mounted_at "$dos"; then
		if ! owned_tmpfs "$dos"; then
			log "refusing to unmount $dos"
			return 1
		fi
		if ! quiesce "$dos" "$prefix"; then
			holders "$dos" "$prefix"
			return 1
		fi
	fi
	rm -rf "$STATE"
	return 0
}

case "${1:-}" in
	prepare) prepare_cmd ;;
	cleanup) cleanup_cmd ;;
	*)
		log "usage: zlyme-wine-prefix prepare|cleanup"
		exit 2
		;;
esac
