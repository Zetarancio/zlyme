#!/bin/sh
# Persistent Wine prefix files live on exFAT. dosdevices is a 1 MiB
# tmpfs because c: and z: have to be symlinks, and exFAT does not keep
# them. prepare prints the prefix directory. cleanup releases only that
# tmpfs and the wineserver for this prefix.

set -eu

STATE=/run/zlyme-wine
TMPFS_SIZE=1024k

log() {
	echo "zlyme-wine-prefix: $*" >&2
}

platform() {
	plat=my355
	if [ -r /usr/share/zlyme/device.conf ]; then
		# shellcheck disable=SC1091
		. /usr/share/zlyme/device.conf
		plat=${ZLYME_NEXTUI_PLATFORM:-my355}
	fi
	printf '%s' "$plat"
}

prefix_dir() {
	printf '%s\n' "/storage/.config/nextui/$(platform)/wine-prefix"
}

dosdevices_dir() {
	printf '%s\n' "$(prefix_dir)/dosdevices"
}

mounted_at() {
	awk -v p="$1" '$2 == p { found = 1 } END { exit found ? 0 : 1 }' /proc/mounts
}

mount_field() {
	awk -v p="$2" -v col="$1" '$2 == p { print $col; found = 1; exit } END { exit found ? 0 : 1 }' /proc/mounts
}

# The mountpoint must be this prefix's dosdevices, and both the source
# and the fstype must be tmpfs. Anything else stays mounted.
owned_tmpfs() {
	dos=$1
	src=$(mount_field 1 "$dos" 2>/dev/null || true)
	fst=$(mount_field 3 "$dos" 2>/dev/null || true)
	[ "$src" = "tmpfs" ] && [ "$fst" = "tmpfs" ]
}

link_devices() {
	dos=$1
	ln -sfn ../drive_c "$dos/c:"
	ln -sfn / "$dos/z:"
}

holders() {
	dos=$1
	prefix=$2
	log "dosdevices is busy:"
	for d in /proc/[0-9]*; do
		pid=${d#/proc/}
		case "$pid" in
			*[!0-9]*) continue ;;
		esac
		cwd=$(readlink "$d/cwd" 2>/dev/null || true)
		exe=$(readlink "$d/exe" 2>/dev/null || true)
		root=$(readlink "$d/root" 2>/dev/null || true)
		case "$cwd:$exe:$root" in
			*"$dos"*|*"$prefix"*)
				cmd=$(tr '\0' ' ' < "$d/cmdline" 2>/dev/null || true)
				log "pid $pid $cmd"
				;;
		esac
	done
}

quiesce() {
	dos=$1
	prefix=$2
	i=0
	if [ -x /usr/bin/wineserver ]; then
		WINEPREFIX=$prefix /usr/bin/wineserver -k >/dev/null 2>&1 || true
	fi
	while mounted_at "$dos"; do
		if umount "$dos" 2>/dev/null; then
			return 0
		fi
		i=$((i + 1))
		if [ "$i" -ge 20 ]; then
			return 1
		fi
		sleep 0.1
	done
	return 0
}

prepare_cmd() {
	prefix=$(prefix_dir)
	dos=$(dosdevices_dir)
	mkdir -p "$prefix" "$dos" "$STATE"
	printf '%s\n' "$prefix" > "$STATE/prefix"
	if mounted_at "$dos"; then
		if ! owned_tmpfs "$dos"; then
			log "$dos is not this prefix tmpfs"
			return 1
		fi
	elif ! mount -t tmpfs -o "size=${TMPFS_SIZE},mode=0755,nosuid,nodev" tmpfs "$dos"; then
		log "could not mount $dos"
		return 1
	fi
	link_devices "$dos"
	printf '%s\n' "$prefix"
}

cleanup_cmd() {
	prefix=$(prefix_dir)
	dos=$(dosdevices_dir)
	if [ -x /usr/bin/wineserver ]; then
		WINEPREFIX=$prefix /usr/bin/wineserver -k >/dev/null 2>&1 || true
	fi
	if mounted_at "$dos"; then
		if ! owned_tmpfs "$dos"; then
			log "refusing to unmount $dos"
			return 1
		fi
		if ! quiesce "$dos" "$prefix"; then
			holders "$dos" "$prefix"
			return 1
		fi
	fi
	rm -rf "$STATE"
	return 0
}

case "${1:-}" in
	prepare) prepare_cmd ;;
	cleanup) cleanup_cmd ;;
	*)
		log "usage: zlyme-wine-prefix prepare|cleanup"
		exit 2
		;;
esac
