+/* dirExists copies into MAX_LABEL_LEN-1 bytes and does not add a NUL
+ * when that copy fills the buffer. Keep the relative default unless the
+ * override fits and has no control bytes. */
+static void apply_dir_override(char *dest, const char *envname)
+{
+	const char *val;
+	size_t i, n;
+
+	val = getenv(envname);
+	if(val == NULL || val[0] == '\0')
+	{
+		return;
+	}
+	n = strlen(val);
+	if(n >= (size_t)(MAX_LABEL_LEN - 1))
+	{
+		return;
+	}
+	for(i = 0; i < n; i++)
+	{
+		if((unsigned char)val[i] < 32)
+		{
+			return;
+		}
+	}
+	memcpy(dest, val, n + 1);
+}
+
