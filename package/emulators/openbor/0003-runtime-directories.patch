+#ifdef SDL
+/* logsDir stays "Logs" when OPENBOR_LOGS_DIR is unset. A path that does
+ * not fit this buffer keeps the relative Logs/ default. */
+static char *bor_log_path(int engine)
+{
+	static char path[MAX_LABEL_LEN];
+	const char *leaf = engine ? "OpenBorLog.txt" : "ScriptLog.txt";
+	int n = snprintf(path, sizeof(path), "%s/%s", logsDir, leaf);
+
+	if(n < 0 || (size_t)n >= sizeof(path))
+	{
+		snprintf(path, sizeof(path), "./Logs/%s", leaf);
+	}
+	return path;
+}
+
+static void copy_sdl_root_path(char *buf, char *name)
+{
+	if(strcmp(name, "Saves") == 0)
+	{
+		strcpy(buf, savesDir);
+		strcat(buf, "/");
+		return;
+	}
+	strcpy(buf, "./");
+	strcat(buf, name);
+	strcat(buf, "/");
+}
+
+static void copy_sdl_paks_path(char *buf, char *name)
+{
+	strcpy(buf, paksDir);
+	strcat(buf, "/");
+	strcat(buf, name);
