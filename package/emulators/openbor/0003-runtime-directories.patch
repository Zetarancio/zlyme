+#ifdef SDL
+/* An override that does not fit is an empty path. fopen then fails.
+ * Do not substitute ./Logs, which would be a different file. */
+static char *bor_log_path(int engine)
+{
+	static char path[MAX_FILENAME_LEN];
+	const char *leaf = engine ? "OpenBorLog.txt" : "ScriptLog.txt";
+	int n = snprintf(path, sizeof(path), "%s/%s", logsDir, leaf);
+
+	if(n < 0 || (size_t)n >= sizeof(path))
+	{
+		path[0] = '\0';
+	}
+	return path;
+}
+
+/* Format into destlen. A result that does not fit is empty, not truncated. */
+static void sdl_format_path(char *buf, size_t buflen, const char *fmt, const char *a, const char *b)
+{
+	int n;
+
+	if(buflen == 0)
+	{
+		return;
+	}
+	if(b == NULL)
+	{
+		n = snprintf(buf, buflen, fmt, a);
+	}
+	else
+	{
+		n = snprintf(buf, buflen, fmt, a, b);
+	}
+	if(n < 0 || (size_t)n >= buflen)
+	{
+		buf[0] = '\0';
+	}
+}
+
+static void copy_sdl_root_path(char *buf, size_t buflen, char *name)
+{
+	if(strcmp(name, "Saves") == 0)
+	{
+		sdl_format_path(buf, buflen, "%s/", savesDir, NULL);
+		return;
+	}
+	sdl_format_path(buf, buflen, "./%s/", name, NULL);
+}
+
+static void copy_sdl_paks_path(char *buf, size_t buflen, char *name)
+{
+	sdl_format_path(buf, buflen, "%s/%s", paksDir, name);
+}
