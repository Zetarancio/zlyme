config BR2_PACKAGE_MOONLIGHT
	bool "moonlight"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_PACKAGE_HAS_LIBGLES
	depends on BR2_PACKAGE_HAS_UDEV
	select BR2_PACKAGE_OPUS
	select BR2_PACKAGE_LIBEVDEV
	select BR2_PACKAGE_DBUS
	select BR2_PACKAGE_AVAHI
	select BR2_PACKAGE_AVAHI_DAEMON
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_ENET
	select BR2_PACKAGE_FFMPEG
	select BR2_PACKAGE_SDL2
	help
	  moonlight-embedded GameStream client. SDL2 + GLES,
	  no X11/CEC.

	  https://github.com/moonlight-stream/moonlight-embedded

comment "moonlight needs GLES, C++ and udev"
	depends on !BR2_PACKAGE_HAS_LIBGLES || !BR2_INSTALL_LIBSTDCPP || !BR2_PACKAGE_HAS_UDEV
