config BR2_PACKAGE_GZDOOM
	bool "gzdoom"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_HOST_GZDOOM
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_OPENAL
	select BR2_PACKAGE_ZMUSIC
	select BR2_PACKAGE_LIBVPX
	select BR2_PACKAGE_WEBP
	select BR2_PACKAGE_WEBP_DEMUX
	select BR2_PACKAGE_WEBP_MUX
	select BR2_PACKAGE_JPEG
	select BR2_PACKAGE_BZIP2
	select BR2_PACKAGE_ZLIB
	help
	  GZDoom GLES2 source port. No Vulkan/X11/Wayland.

	  https://zdoom.org

config BR2_PACKAGE_HOST_GZDOOM
	bool

comment "gzdoom needs GLES and C++"
	depends on !BR2_PACKAGE_HAS_LIBGLES || !BR2_INSTALL_LIBSTDCPP
