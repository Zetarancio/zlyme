#!/bin/sh
# Explicit graphical Box86 entry point. Existing port-provided native
# libraries remain ahead of Zlyme's isolated ARMHF GL4ES.
set -eu

gl4es=/usr/lib/zlyme-armhf/gl4es
[ -f "$gl4es/libGL.so.1" ] || {
	echo "zlyme-box86-gl4es-run: ARMHF GL4ES is unavailable" >&2
	exit 127
}
if [ -n "${ZLYME_BOX86_NATIVE_LIBRARY_PATH:-}" ]; then
	ZLYME_BOX86_NATIVE_LIBRARY_PATH=$ZLYME_BOX86_NATIVE_LIBRARY_PATH:$gl4es
else
	ZLYME_BOX86_NATIVE_LIBRARY_PATH=$gl4es
fi
export ZLYME_BOX86_NATIVE_LIBRARY_PATH
: "${LIBGL_ES:=2}"
: "${LIBGL_GL:=21}"
: "${LIBGL_FB:=4}"
export LIBGL_ES LIBGL_GL LIBGL_FB

exec /usr/bin/zlyme-box86-run "$@"
