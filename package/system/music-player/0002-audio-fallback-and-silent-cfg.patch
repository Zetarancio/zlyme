diff -ruN a/src/config_readonly_shim.h b/src/config_readonly_shim.h
--- a/src/config_readonly_shim.h	2026-09-13 20:18:01.000000000 +0200
+++ b/src/config_readonly_shim.h	2026-10-01 22:07:57.626834026 +0200
@@ -33,10 +33,12 @@
 
 static inline FILE *mp_config_readonly_fopen(const char *path, const char *mode)
 {
-	/* Block write ("w"/"w+"/"wb"...) and append ("a"...) opens; allow reads
-	 * (and any unexpected mode) through. config.c only ever opens "r" and "w". */
+	/* Discard writes. Returning NULL makes CFG_sync print
+	 * "[CFG] Unable to open settings file" on every call. /dev/null
+	 * accepts the write and leaves NextUI's minuisettings.txt alone.
+	 * config.c only ever opens "r" and "w". */
 	if (mode && (mode[0] == 'w' || mode[0] == 'a'))
-		return NULL;
+		return fopen("/dev/null", mode);
 	return fopen(path, mode); /* macro not yet defined here -> the real fopen */
 }
 
