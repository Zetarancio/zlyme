config BR2_PACKAGE_BOX64
	bool "box64"
	depends on BR2_aarch64
	depends on BR2_INSTALL_LIBSTDCPP
	select BR2_PACKAGE_SDL2
	help
	  box64 v0.4.4 so PortMaster x86_64 ports can run. No X11;
	  ARM dynarec only.

	  https://github.com/ptitSeb/box64

comment "box64 needs aarch64 and C++"
	depends on !BR2_aarch64 || !BR2_INSTALL_LIBSTDCPP
