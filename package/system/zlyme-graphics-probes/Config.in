config BR2_PACKAGE_ZLYME_GRAPHICS_PROBES
	bool "zlyme graphics validation probes"
	depends on BR2_aarch64
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_SDL3
	select BR2_PACKAGE_GL4ES
	help
	  Small non-startup diagnostics for SDL3 KMSDRM/input and the
	  explicitly selected AArch64 GL4ES compatibility path. They
	  are launched only through temporary normal NextUI fixtures.
