#!/bin/sh
#
# Controller policy after InputPlumber. rc.late starts this in the
# same subshell as S31, after the first frame. The daemon waits for
# the bus name, then enables management. It does not delay the list.

DAEMON="${ZLYME_INPUT_BIN:-/usr/sbin/zlyme-input}"
PIDFILE="${ZLYME_INPUT_PIDFILE:-/run/zlyme-input.pid}"
LOG="${ZLYME_INPUT_LOG:-/tmp/zlyme-input.log}"

export PATH=/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}

running() {
	[ -f "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start() {
	if running; then
		echo "Starting zlyme-input: already running"
		return 0
	fi
	rm -f "$PIDFILE"
	printf 'Starting zlyme-input: '
	mkdir -p /run
	if start-stop-daemon -S -q -b -m -p "$PIDFILE" --exec "$DAEMON" -- run \
		>>"$LOG" 2>&1
	then
		echo "OK"
	else
		echo "FAIL"
		return 1
	fi
}

stop() {
	printf 'Stopping zlyme-input: '
	if running; then
		start-stop-daemon -K -q -p "$PIDFILE" --exec "$DAEMON"
		i=0
		while running && [ "$i" -lt 20 ]; do
			sleep 0.1
			i=$((i + 1))
		done
	fi
	rm -f "$PIDFILE"
	echo "OK"
}

status() {
	if running; then
		echo "zlyme-input is running"
		return 0
	fi
	echo "zlyme-input is stopped"
	return 1
}

restart() {
	stop
	start
}

case "$1" in
	start|stop|status|restart)
		"$1"
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
