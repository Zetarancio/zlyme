+        if isFileEntry(kind):
+          if hiddenGamePath(dirPath, path):
+            continue
+          let ext = splitFile(path).ext.toLowerAscii()
+          if ext notin EXCLUDED_EXTS:
+            return true
+        elif isDirEntry(kind):
+          if scan(path, depth + 1):
+            return true
+    except OSError:
+      discard
+    false
+  scan(dirPath, 0)
 
