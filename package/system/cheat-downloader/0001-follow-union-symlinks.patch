+proc dirIdentity(path: string): string =
+  ## Target inode. A symlink and its directory are the same node, so a
+  ## cycle through the union cannot be walked forever.
+  try:
+    let info = getFileInfo(path, followSymlink = true)
+    result = $info.id.device & ":" & $info.id.file
+  except OSError:
+    result = ""
+
+proc hiddenGamePath(root, path: string): bool =
+  if path.len < root.len:
+    return true
+  let rel = path[root.len .. ^1]
+  "/." in rel or rel.startsWith(".") or rel.startsWith("/.")
+
