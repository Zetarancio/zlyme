config BR2_PACKAGE_CHEAT_DOWNLOADER
	bool "cheat-downloader"
	depends on BR2_aarch64
	select BR2_PACKAGE_MINUI_LIST
	select BR2_PACKAGE_MINUI_PRESENTER
	select BR2_PACKAGE_SQLITE
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBCURL_CURL
	select BR2_PACKAGE_CA_CERTIFICATES
	help
	  Cheat Downloader v1.6.0. The Libretro database is user data
	  under /storage/.config/cheat-downloader. Installed .cht files
	  stay on the Cheats content path. Runtime needs libsqlite3,
	  the curl binary, and the system CA bundle.

	  https://github.com/nborodikhin/nextui-cheat-downloader-alt
