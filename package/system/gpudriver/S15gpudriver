#!/bin/sh
# After S15bootpart (gpu flag on /storage) and S12bootfs (/boot).
# One of libmali / panfrost; they cannot share the GPU.

start() {
	[ -x /usr/sbin/gpudriver ] || return 0
	printf "GPU stack: "
	gpudriver
}

case "$1" in
	start) start ;;
	stop) ;;
	*) echo "usage: $0 {start|stop}"; exit 1 ;;
esac
