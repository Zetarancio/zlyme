#!/bin/sh
# Explicit AArch64 GL4ES selector. Existing per-port paths stay first.
set -eu

[ "$#" -ge 1 ] || {
	echo "usage: zlyme-gl4es-run <program> [args...]" >&2
	exit 2
}
gl4es=${ZLYME_GL4ES_DIR:-/usr/lib/portmaster/gl4es/aarch64}
[ -f "$gl4es/libGL.so.1" ] || {
	echo "zlyme-gl4es-run: isolated GL4ES is unavailable" >&2
	exit 127
}

# Preserve directories a port or its runtime prepended, then put GL4ES
# before Zlyme's shared compatibility and system directories. Appending
# GL4ES after /usr/lib would silently select the system libGL instead.
port_paths=
system_paths=
old_ifs=$IFS
IFS=:
for dir in ${LD_LIBRARY_PATH:-}; do
	[ -n "$dir" ] || continue
	[ "$dir" = "$gl4es" ] && continue
	case "$dir" in
		/usr/lib|/usr/lib/compat|/usr/share/nextui/lib|/storage/.config/zlyme/lib)
			system_paths=${system_paths:+$system_paths:}$dir
			;;
		*)
			port_paths=${port_paths:+$port_paths:}$dir
			;;
	esac
done
IFS=$old_ifs
LD_LIBRARY_PATH=${port_paths:+$port_paths:}$gl4es${system_paths:+:$system_paths}
export LD_LIBRARY_PATH
# This NOX11 build does not compile the mode-3 branch, so the
# selector does not invent a framebuffer mode. A port that already
# exported LIBGL_FB keeps that value.
: "${LIBGL_ES:=2}"
: "${LIBGL_GL:=21}"
if [ -n "${LIBGL_FB:-}" ]; then
	export LIBGL_FB
fi
export LIBGL_ES LIBGL_GL
# Prefer KMSDRM when the caller did not already choose a driver.
: "${SDL_VIDEODRIVER:=kmsdrm}"
export SDL_VIDEODRIVER

exec "$@"
