config BR2_PACKAGE_GL4ES
	bool "gl4es (isolated PortMaster runtime)"
	depends on BR2_aarch64
	depends on BR2_PACKAGE_MESA3D_OPENGL_EGL
	depends on BR2_PACKAGE_MESA3D_OPENGL_ES
	help
	  OpenGL 2.1 compatibility over GLES 2, installed only under
	  /usr/lib/portmaster/gl4es/aarch64. The build follows the
	  ROCKNIX NOX11 and NOEGL profile. Ports must select it
	  explicitly; it does not replace system GL, EGL, or GLES.

	  https://github.com/ptitSeb/gl4es

comment "gl4es needs AArch64 Mesa EGL and GLES"
	depends on !BR2_aarch64 || !BR2_PACKAGE_MESA3D_OPENGL_EGL || \
		!BR2_PACKAGE_MESA3D_OPENGL_ES
