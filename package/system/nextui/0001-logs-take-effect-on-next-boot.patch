+static void logs_apply_notice()
+{
+	std::string out;
+	std::string err;
+	int rc = zlyme_tool_exec("/usr/sbin/zlyme-ctl",
+		{"apply-logs"}, nullptr, &out, &err);
+	if (rc == 0)
+		return;
+	std::string msg = out + err;
+	while (!msg.empty() && (msg.back() == '\n' || msg.back() == '\r'))
+		msg.pop_back();
+	if (msg.empty())
+		msg = "Early boot log was not updated.";
+	MenuList::showOverlay(msg, OverlayDismissMode::DismissOnA);
+}
