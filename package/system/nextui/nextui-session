#!/bin/sh
#
# Start NextUI against Zlyme. Stock launch.sh exports /mnt/SDCARD,
# starts miyoo_inputd and writes Playback Path. None of that exists
# here. Cores are /usr/lib/libretro. nextui.elf exits when it wants a
# pak: the command is in /tmp/next.
#
# Directories come from NextUI's platform.h (SDCARD_PATH /storage).
# This script only sets the environment NextUI still reads at runtime.

export PLATFORM=my355
export DEVICE=my355
export SDCARD_PATH=/storage
export BIOS_PATH=/storage/Bios
export SAVES_PATH=/storage/Saves
export CHEATS_PATH=/storage/Cheats
export SYSTEM_PATH=/storage/.system/$PLATFORM
export CORES_PATH=/usr/lib/libretro
export USERDATA_PATH=/storage/.config/nextui/$PLATFORM
export SHARED_USERDATA_PATH=/storage/.config/nextui/shared
export LOGS_PATH=$USERDATA_PATH/logs
export HOOKS_PATH=$USERDATA_PATH/.hooks
export SDL_VIDEODRIVER=kmsdrm
export SDL_GAMECONTROLLERCONFIG_FILE=/usr/lib/gamecontrollerdb.txt
if [ -r "$SDL_GAMECONTROLLERCONFIG_FILE" ]; then
	# Newline-separated. The Flip pad is BUS_HOST (1900…), not USB (0300…).
	# SDL_GAMECONTROLLERCONFIG is extra mappings; include every GUID.
	export SDL_GAMECONTROLLERCONFIG="$(grep -v '^#' "$SDL_GAMECONTROLLERCONFIG_FILE" | grep 'retrogame_joypad')"
fi
export HOME=$USERDATA_PATH
export XDG_CONFIG_HOME=/storage/.config
export PATH=$SYSTEM_PATH/bin:/usr/bin:/usr/sbin:/bin:/sbin
# Squashfs first. An exFAT dir at the front of LD_LIBRARY_PATH makes
# every NEEDED .so miss before /usr/lib.
export LD_LIBRARY_PATH=/usr/lib:$SYSTEM_PATH/lib
export IS_NEXT=yes
[ -r /etc/zlyme-gpu-env.sh ] && . /etc/zlyme-gpu-env.sh

boot_mark() {
	line="$(cut -d' ' -f1 /proc/uptime 2>/dev/null) $*"
	echo "$line" >> /tmp/boot-timing
	echo "$line" >> /storage/.config/zlyme/boot-timing 2>/dev/null || true
}
mkdir -p /storage/.config/zlyme
boot_mark session-start

# Stock MinUI tools still open /mnt/SDCARD. Keep one path for scrapers.
mkdir -p /mnt
[ -e /mnt/SDCARD ] || ln -sfn /storage /mnt/SDCARD

mkdir -p "$LOGS_PATH" "$HOOKS_PATH" "$SHARED_USERDATA_PATH/.minui" \
	/storage/.roms_base /storage/Roms

seed=/usr/share/nextui
img_ver=""
[ -r "$seed/version.txt" ] && img_ver=$(cat "$seed/version.txt")

# Dummy cart so Pico-8 is visible before the user adds .p8 files.
# Name contains "splore" so start_pico8.sh uses -splore (ROCKNIX / minui-pico-8-pak).
pico_rom="/storage/.roms_base/Pico-8 (PICO)"
pico_art="$seed/paks/Emus/PICO.pak/splore/Splore.p8.png"
pico_mark="$SHARED_USERDATA_PATH/Pico-8-native/splore-installed"
if [ -f "$pico_art" ] && [ ! -f "$pico_mark" ]; then
	mkdir -p "$SHARED_USERDATA_PATH/Pico-8-native" "$pico_rom/.media"
	cp -f "$pico_art" "$pico_rom/Splore.p8"
	cp -f "$pico_art" "$pico_rom/.media/Splore.png"
	: >"$pico_mark"
fi

# Older images mkdir'd every Pretty name. hasRoms then opens each empty
# folder through mergerfs. rmdir is a no-op if a ROM is already there.
prune_stamp=/storage/.roms_base/.zlyme-empty-pruned
if [ ! -f "$prune_stamp" ] && [ -r "$seed/rom-dirs.txt" ]; then
	while IFS= read -r d; do
		[ -n "$d" ] || continue
		rmdir "/storage/.roms_base/$d/.media" 2>/dev/null || true
		rmdir "/storage/.roms_base/$d" 2>/dev/null || true
	done < "$seed/rom-dirs.txt"
	: >"$prune_stamp"
fi

# Same bind zlyme35 used (fast, shown the list). S17 unmounts it and
# mergerfs-es SD2; do not mergerfs here (that blocked the first frame).
if ! mountpoint -q /storage/Roms 2>/dev/null; then
	mount --bind /storage/.roms_base /storage/Roms 2>/dev/null || true
fi
boot_mark session-roms

# PortMaster: /roms/ports is baked into the squashfs. If the card only
# has lowercase ports, point the symlink there (needs a writable /roms).
ports_dir="/storage/Roms/Ports (PORTS)"
if [ ! -d "$ports_dir" ] && [ -d /storage/Roms/ports ]; then
	ln -sfn /storage/Roms/ports /roms/ports 2>/dev/null || true
fi

# Refresh stock assets when the image version changes. Copying paks
# onto exFAT blocked the first frame (Artwork Scraper.pak is large).
# Bind the squashfs copies instead; that also hides stale card launch.sh.
card_ver=""
[ -r /storage/.system/version.txt ] && card_ver=$(cat /storage/.system/version.txt)
refresh=1
[ -n "$img_ver" ] && [ "$img_ver" = "$card_ver" ] && refresh=0

bind_dir() {
	src=$1
	dest=$2
	[ -d "$src" ] || return 0
	mkdir -p "$dest"
	mountpoint -q "$dest" && return 0
	mount --bind "$src" "$dest" 2>/dev/null
}

mkdir -p /storage/.system/res
if [ -d "$seed/res" ]; then
	bind_dir "$seed/res" /storage/.system/res || {
		[ "$refresh" = 1 ] && cp -a "$seed/res/." /storage/.system/res/
	}
fi

# Bind emu paks before nextui.elf (hasEmu). Tools and one-time
# migrations are after the first exec so they do not sit on the list.
if [ -d "$seed/paks" ]; then
	mkdir -p "$SYSTEM_PATH/paks"
	if [ -d "$seed/paks/Emus" ]; then
		bind_dir "$seed/paks/Emus" "$SYSTEM_PATH/paks/Emus"
	fi
	if [ -d "$seed/paks/MinUI.pak" ]; then
		bind_dir "$seed/paks/MinUI.pak" "$SYSTEM_PATH/paks/MinUI.pak"
	fi
	if [ "$refresh" = 1 ] && [ -n "$img_ver" ]; then
		printf '%s\n' "$img_ver" > /storage/.system/version.txt
	fi
fi
boot_mark session-paks
if [ ! -e "$SYSTEM_PATH/system.cfg" ]; then
	cp "$seed/system.cfg" "$SYSTEM_PATH/system.cfg"
fi

rm -f /tmp/poweroff /tmp/reboot

# setsid so MENU+Start can SIGTERM the pak group. Helper dies with the child.
run_pak_cmd() {
	setsid sh -c 'eval "$1"' sh "$1" >> "$LOGS_PATH/next.txt" 2>&1 &
	_pak_pid=$!
	_hk=
	if [ -x /usr/sbin/zlyme-pak-hotkey ]; then
		/usr/sbin/zlyme-pak-hotkey "$_pak_pid" >> "$LOGS_PATH/next.txt" 2>&1 &
		_hk=$!
	fi
	wait "$_pak_pid"
	st=$?
	if [ -n "$_hk" ]; then
		kill "$_hk" 2>/dev/null || true
		wait "$_hk" 2>/dev/null || true
	fi
}

EXEC_PATH=/tmp/nextui_exec
NEXT_PATH=/tmp/next
touch "$EXEC_PATH"
cd /storage

bind_tools_late() {
	# Do not fight nextui.elf for exFAT/CPU. Tools are unused until A.
	n=0
	while [ "$n" -lt 40 ]; do
		grep -q 'nextui-first-flip' /tmp/boot-timing 2>/dev/null && break
		sleep 0.5
		n=$((n + 1))
	done
	mkdir -p "$BIOS_PATH" "$SAVES_PATH" "$CHEATS_PATH"
	# Screen-off / mem suspend. Do not rewrite minuisettings unless
	# a Windows CR is actually there (sed -i on exFAT is a full copy).
	cfg=$SHARED_USERDATA_PATH/minuisettings.txt
	mkdir -p "$SHARED_USERDATA_PATH"
	if [ -f "$cfg" ] && grep -q $'\r' "$cfg"; then
		sed -i 's/\r$//' "$cfg"
	fi
	if [ ! -f "$cfg" ]; then
		printf '%s\n' 'screentimeout=120' 'suspendTimeout=600' > "$cfg"
	else
		grep -q '^screentimeout=' "$cfg" || echo 'screentimeout=120' >> "$cfg"
		grep -q '^suspendTimeout=' "$cfg" || echo 'suspendTimeout=600' >> "$cfg"
	fi
	if [ -f "$cfg" ] && grep -q '^palette=Zlyme' "$cfg"; then
		sed -i \
			-e 's/^color1=0xF7B07CFF$/color1=0xFA7C08FF/' \
			-e 's/^color6=0xB9BDC4FF$/color6=0xEC2A01FF/' \
			-e 's/^color6=0xF7B07CFF$/color6=0xEC2A01FF/' \
			-e 's/^color6=0xE99962FF$/color6=0xEC2A01FF/' \
			"$cfg"
	fi
	flag=$SHARED_USERDATA_PATH/.zlyme-sleep-defaults
	if [ ! -f "$flag" ]; then
		if [ -f "$cfg" ]; then
			grep -q '^screentimeout=0$' "$cfg" && \
				sed -i 's/^screentimeout=0$/screentimeout=120/' "$cfg"
			grep -q '^suspendTimeout=0$' "$cfg" && \
				sed -i 's/^suspendTimeout=0$/suspendTimeout=600/' "$cfg"
		fi
		: > "$flag"
	fi
	flag2=$SHARED_USERDATA_PATH/.zlyme-sleep-defaults-v2
	flag3=$SHARED_USERDATA_PATH/.zlyme-sleep-defaults-v3
	if [ ! -f "$flag2" ] || [ ! -f "$flag3" ]; then
		if [ -f "$cfg" ]; then
			grep -q '^screentimeout=60$' "$cfg" && \
				sed -i 's/^screentimeout=60$/screentimeout=120/' "$cfg"
			grep -q '^suspendTimeout=30$' "$cfg" && \
				sed -i 's/^suspendTimeout=30$/suspendTimeout=600/' "$cfg"
		fi
		: > "$flag2"
		: > "$flag3"
	fi
	flag_bat=$SHARED_USERDATA_PATH/.zlyme-batteryperc-on
	if [ ! -f "$flag_bat" ]; then
		if [ -f "$cfg" ]; then
			if grep -q '^batteryperc=' "$cfg"; then
				sed -i 's/^batteryperc=.*/batteryperc=1/' "$cfg"
			else
				echo 'batteryperc=1' >> "$cfg"
			fi
		else
			printf '%s\n' 'batteryperc=1' >> "$cfg"
		fi
		: > "$flag_bat"
	fi
	mkdir -p "$SYSTEM_PATH/etc/wifi" "$SYSTEM_PATH/etc/bluetooth" \
		"$SYSTEM_PATH/bin" "$SYSTEM_PATH/lib" /storage/.system/zoneinfo \
		/storage/Tools/my355
	if [ ! -e /storage/.system/zoneinfo/zone.tab ] && [ -r "$seed/zone.tab" ]; then
		cp "$seed/zone.tab" /storage/.system/zoneinfo/zone.tab
	fi
	if [ -d /usr/share/zoneinfo ] && [ ! -e /usr/share/zoneinfo/zone.tab ] && \
		[ -d /storage/.system/zoneinfo ]; then
		mount --bind /storage/.system/zoneinfo /usr/share/zoneinfo 2>/dev/null || true
	fi
	if [ "$refresh" = 1 ] || [ ! -e "$SYSTEM_PATH/etc/wifi/wifi_init.sh" ]; then
		cp "$seed/etc/wifi/wifi_init.sh" "$SYSTEM_PATH/etc/wifi/wifi_init.sh"
		chmod 0755 "$SYSTEM_PATH/etc/wifi/wifi_init.sh"
	fi
	if [ "$refresh" = 1 ] || [ ! -e "$SYSTEM_PATH/etc/bluetooth/bt_init.sh" ]; then
		cp "$seed/etc/bluetooth/bt_init.sh" "$SYSTEM_PATH/etc/bluetooth/bt_init.sh"
		chmod 0755 "$SYSTEM_PATH/etc/bluetooth/bt_init.sh"
	fi
	if [ "$refresh" = 1 ] || [ ! -e "$SYSTEM_PATH/bin/governor.sh" ]; then
		cp "$seed/bin/governor.sh" "$SYSTEM_PATH/bin/governor.sh"
		chmod 0755 "$SYSTEM_PATH/bin/governor.sh"
	fi
	if [ "$refresh" = 1 ] || [ ! -e "$SYSTEM_PATH/bin/suspend" ]; then
		if [ -x "$seed/bin/suspend" ]; then
			cp "$seed/bin/suspend" "$SYSTEM_PATH/bin/suspend"
			chmod 0755 "$SYSTEM_PATH/bin/suspend"
		fi
	fi
	if [ ! -e "$SYSTEM_PATH/bin/show.elf" ] && [ -x /usr/bin/show.elf ]; then
		cp /usr/bin/show.elf "$SYSTEM_PATH/bin/show.elf"
		chmod 0755 "$SYSTEM_PATH/bin/show.elf"
	fi
	if [ ! -e "$SYSTEM_PATH/lib/libmsettings.so" ] && [ -f /usr/lib/libmsettings.so ]; then
		cp /usr/lib/libmsettings.so "$SYSTEM_PATH/lib/libmsettings.so"
	fi
	if [ "$refresh" = 1 ] && [ -x /usr/sbin/zlyme-wifi ]; then
		cp /usr/sbin/zlyme-wifi "$SYSTEM_PATH/bin/zlyme-wifi"
		chmod 0755 "$SYSTEM_PATH/bin/zlyme-wifi"
	fi
	if [ "$refresh" = 1 ] && [ -x /usr/sbin/zlyme-bluetooth ]; then
		cp /usr/sbin/zlyme-bluetooth "$SYSTEM_PATH/bin/zlyme-bluetooth"
		chmod 0755 "$SYSTEM_PATH/bin/zlyme-bluetooth"
	fi
	stamp=/storage/Tools/my355/.zlyme-settings-paks-gone
	if [ ! -f "$stamp" ]; then
		rm -rf \
			/storage/Tools/my355/Wi-Fi.pak \
			/storage/Tools/my355/Bluetooth.pak \
			/storage/Tools/my355/SSH.pak \
			/storage/Tools/my355/Samba.pak \
			/storage/Tools/my355/Syncthing.pak \
			/storage/Tools/my355/GPU.pak \
			/storage/Tools/my355/Display.pak \
			/storage/Tools/my355/Backup.pak
		: > "$stamp"
	fi
	if [ -d "$seed/paks/Tools" ]; then
		for src in "$seed/paks/Tools"/*.pak; do
			[ -d "$src" ] || continue
			base=$(basename "$src")
			case "$base" in
				Wi-Fi.pak|Bluetooth.pak|SSH.pak|Samba.pak|Syncthing.pak|GPU.pak|Display.pak|Backup.pak) continue ;;
			esac
			bind_dir "$src" "/storage/Tools/my355/$base"
		done
	fi
	boot_mark session-tools
}
bind_tools_late &

boot_loop=1
while [ -f "$EXEC_PATH" ]; do
	# Tools/paks write /tmp/last.txt. Restoring into a .pak shows launch.sh
	# and has crashed NextUI after Settings. Stay on the card root.
	# getFile() used to keep a trailing newline; loadLast() then walked
	# "/storage\n" until strrchr was NULL. nextui.c now strips it, and
	# we still never write one.
	if [ -f /tmp/last.txt ]; then
		last=$(cat /tmp/last.txt)
		case "$last" in
			*/Tools/*|*.pak) last=/storage ;;
		esac
		printf '%s' "$last" > /tmp/last.txt
	fi
	# First exec: nothing is running yet. killall walks /proc; zlyme-audio
	# forks a script. Both belong after a pak, not before the list.
	if [ "$boot_loop" = 0 ]; then
		killall -9 pico8-splore-pad pico8_64 2>/dev/null || true
		if command -v zlyme-audio >/dev/null 2>&1; then
			eval "$(zlyme-audio export 2>/dev/null)" || true
		fi
	fi
	boot_loop=0
	boot_mark session-nextui
	# Logs on ZLYME used to be every LOG_info during Menu_init.
	nextui.elf >> /tmp/nextui.txt 2>&1
	# A pak launch is not a shutdown. SDL_QUIT used to touch /tmp/poweroff
	# on SIGTERM; if /tmp/next is set, run that instead.
	if [ -f "$NEXT_PATH" ]; then
		rm -f /tmp/poweroff /tmp/reboot
		cmd=$(cat "$NEXT_PATH")
		rm -f "$NEXT_PATH"
		echo "RUN $cmd" >> "$LOGS_PATH/next.txt"
		# DRM master from nextui.elf is not always gone on the next line.
		sleep 0.4
		# 8733bu drops HID if discovery is still running (Settings
		# used to leave bluetoothctl scan on). Spruce/ROCKNIX
		# stop scan, then reconnect paired pads before the emu.
		dbus-send --system --type=method_call --dest=org.bluez \
			/org/bluez/hci0 org.bluez.Adapter1.StopDiscovery \
			>/dev/null 2>&1 || true
		bluetoothctl scan off >/dev/null 2>&1 || true
		pkill -f 'bluetoothctl scan' 2>/dev/null || true
		sleep 0.3
		modprobe hid-nintendo >/dev/null 2>&1 || true
		# bluetoothctl connect on an already-live HID drops the
		# 8733bu link (status 0x04). Skip pads NextUI is using.
		bluetoothctl devices Paired 2>/dev/null | while read _ mac rest; do
			[ -n "$mac" ] || continue
			bluetoothctl info "$mac" 2>/dev/null | grep -q 'UUID: Human Interface Device' || continue
			bluetoothctl info "$mac" 2>/dev/null | grep -q 'Connected: yes' && continue
			bluetoothctl connect "$mac" >/dev/null 2>&1 || true
		done
		sleep 0.6
		if command -v zlyme-audio >/dev/null 2>&1; then
			eval "$(zlyme-audio export 2>/dev/null)" || true
		fi
		run_pak_cmd "$cmd"
		# A2DP connect/disconnect: zlyme-btsink kills the emu and
		# asks us to open it again with the new ZLYME_SINK.
		while [ -f /tmp/zlyme-sink-reload ]; do
			rm -f /tmp/zlyme-sink-reload
			if command -v zlyme-audio >/dev/null 2>&1; then
				eval "$(zlyme-audio export 2>/dev/null)" || true
			fi
			run_pak_cmd "$cmd"
		done
		# minui-list B/menu is 2/3, not a crash. 143/137 is MENU+Start.
		case "$st" in
			0|2|3|137|143) ;;
			*)
				echo "pak exit $st" >> "$LOGS_PATH/next.txt"
				command -v show.elf >/dev/null 2>&1 && show.elf "Pak failed ($st)" 3
				;;
		esac
		# Splore's pad grab must not outlive the pak.
		killall -9 pico8-splore-pad pico8_64 minui-list minui-presenter scrapegoat 2>/dev/null || true
		sleep 0.2
		continue
	fi
	if [ -f /tmp/poweroff ]; then
		rm -f /tmp/poweroff
		if [ -x /usr/sbin/zlyme-halt ]; then
			exec /usr/sbin/zlyme-halt poweroff
		fi
		poweroff -f
		break
	fi
	if [ -f /tmp/reboot ]; then
		rm -f /tmp/reboot
		if [ -x /usr/sbin/zlyme-halt ]; then
			exec /usr/sbin/zlyme-halt reboot
		fi
		reboot -f
		break
	fi
done
