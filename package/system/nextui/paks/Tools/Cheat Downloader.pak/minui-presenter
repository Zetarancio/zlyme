#!/bin/sh
# One line per screen when this pak's stderr is being logged.
# Timeouts stay as Cheat Downloader passed them. Upstream uses -1 for a
# status screen it kills itself, and 0 for a confirmation that waits
# for a button. A database download can sit on -1 for much longer than
# a status check.
msg=
prev=
for arg in "$@"; do
	if [ "$prev" = "--message" ]; then
		msg=$arg
	fi
	prev=$arg
done
if [ -n "$msg" ]; then
	echo "cheat: presenter ${msg}" >&2
else
	echo "cheat: presenter" >&2
fi
# The launcher watches this file. It is not the pak log: logging can be off.
mark=${ZLYME_CHEAT_PRESENTER_MARK:-}
if [ -n "$mark" ]; then
	dir=$(dirname "$mark")
	tmp=$(mktemp "$dir/.zlyme-cheat-presenter.XXXXXX") || exit 1
	mv -f "$tmp" "$mark"
fi
exec "${ZLYME_PRESENTER:-/usr/bin/minui-presenter}" "$@"
