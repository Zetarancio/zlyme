#!/bin/sh
# Bound the downloader's curl. A full database fetch may take minutes.
# A header check must not wait forever.
total=25
for arg in "$@"; do
	case $arg in
		-ksL|*releases/download*) total=900 ;;
	esac
done
echo "cheat: curl max=${total}s" >&2
exec /usr/bin/curl --connect-timeout 15 --max-time "$total" "$@"
