+    /// Discover source devices again. Does not change ManageAllDevices.
+    /// Sources already owned by a composite stay attached.
+    async fn rescan_devices(
+        &self,
+        #[zbus(connection)] conn: &Connection,
+        #[zbus(header)] hdr: Header<'_>,
+    ) -> fdo::Result<()> {
+        check_polkit(conn, Some(hdr), "org.shadowblip.InputPlumber.RescanDevices").await?;
+        self.tx
+            .send_timeout(ManagerCommand::RescanDevices, Duration::from_millis(500))
+            .await
+            .map_err(|err| fdo::Error::Failed(err.to_string()))?;
+        Ok(())
+    }
