#!/bin/sh
#
# InputPlumber after system D-Bus. Class B only: rc.late starts this
# after nextui-first-flip. It does not grab the Flip pad; auto_manage
# stays false until an explicit manage-all.

DAEMON="${INPUTPLUMBER_BIN:-/usr/bin/inputplumber}"
PIDFILE="${INPUTPLUMBER_PIDFILE:-/run/inputplumber.pid}"
LOG="${INPUTPLUMBER_LOG:-/tmp/inputplumber.log}"

export PATH=/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}

export INSECURE_DISABLE_POLKIT=1
export HIDE_DEVICES_FROM_ROOT=0
unset ENABLE_METRICS

running() {
	[ -f "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start() {
	if running; then
		echo "Starting inputplumber: already running"
		return 0
	fi
	rm -f "$PIDFILE"
	printf 'Starting inputplumber: '
	mkdir -p /run
	if start-stop-daemon -S -q -b -m -p "$PIDFILE" --exec "$DAEMON" \
		>>"$LOG" 2>&1
	then
		echo "OK"
	else
		echo "FAIL"
		return 1
	fi
}

stop() {
	printf 'Stopping inputplumber: '
	if running; then
		start-stop-daemon -K -q -p "$PIDFILE" --exec "$DAEMON"
		i=0
		while running && [ "$i" -lt 20 ]; do
			sleep 0.1
			i=$((i + 1))
		done
	fi
	rm -f "$PIDFILE"
	echo "OK"
}

status() {
	if running; then
		echo "inputplumber is running"
		return 0
	fi
	echo "inputplumber is stopped"
	return 1
}

restart() {
	stop
	start
}

case "$1" in
	start|stop|status|restart)
		"$1"
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}"
		exit 1
		;;
esac
