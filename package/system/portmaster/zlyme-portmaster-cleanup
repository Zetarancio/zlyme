#!/bin/sh
# Drop PortMaster resources left after a port exits or is killed.
# nextui-session calls this from outside the pak process group, including
# after MENU+START has already killed that group. Idempotent.
#
# WestonPack at /tmp/weston is still cleaned here: TERM holders, KILL
# after 6 s, then unmount deepest child first. Mounts recorded by
# zlyme-portmaster-exec are unmounted after that, deepest first.
# /roms/ports is unbound through zlyme-library.sh. Library roots and
# any mount this launch did not register are left alone.
#
# A stranded wp_weston has ignored SIGTERM for at least four seconds, so
# the TERM grace is longer than the hotkey helper's 1.5s.

set -u

MNT=/tmp/weston
# 6.0s of observable polls. The live holder was still alive after 4.0s of TERM.
TERM_POLLS=60
# After SIGKILL, wait until the task is gone.
KILL_POLLS=20
# Ordinary umount retries while the mount is still busy.
UMOUNT_POLLS=20

log() {
	echo "zlyme-portmaster-cleanup: $*" >&2
}

pm_load() {
	if [ -n "${PM_MOUNTS_LOADED:-}" ]; then
		return 0
	fi
	helper=
	if [ -n "${ZLYME_PM_MOUNTS_SH:-}" ] && [ -r "$ZLYME_PM_MOUNTS_SH" ]; then
		helper=$ZLYME_PM_MOUNTS_SH
	else
		# shellcheck disable=SC1007
		here=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
		if [ -r "$here/zlyme-portmaster-mounts.sh" ]; then
			helper=$here/zlyme-portmaster-mounts.sh
		elif [ -r /usr/share/zlyme/portmaster-mounts.sh ]; then
			helper=/usr/share/zlyme/portmaster-mounts.sh
		fi
	fi
	if [ -z "$helper" ]; then
		log "mount registry helper is missing"
		return 1
	fi
	# shellcheck disable=SC1090
	. "$helper"
	pm_load_decode || return 1
	PM_MOUNTS_LOADED=1
}

under_weston() {
	case "$1" in
		"$MNT"|"$MNT"/*) return 0 ;;
	esac
	return 1
}

mount_present() {
	if pm_load; then
		body=$(mounts_targets "$(pm_mounts_file)") || return 1
		while IFS= read -r target || [ -n "$target" ]; do
			[ -n "$target" ] || continue
			if under_weston "$target"; then
				return 0
			fi
		done <<END_ZLYME_MOUNTS
$body
END_ZLYME_MOUNTS
		return 1
	fi
	awk -v m="$MNT" '
		$2 == m || index($2, m "/") == 1 { found = 1 }
		END { exit found ? 0 : 1 }
	' "${ZLYME_PM_MOUNTS:-/proc/mounts}"
}

# Rewrite $list with one PID per line.
# $1 = light (cwd/exe), maps (also maps), or deep (also fd symlinks).
collect_holders() {
	mode=$1
	: > "$list"
	for d in /proc/[0-9]*; do
		pid=${d#/proc/}
		case "$pid" in
			*[!0-9]*) continue ;;
		esac
		[ "$pid" -eq "$$" ] && continue
		[ "$pid" -eq 1 ] && continue
		cwd=$(readlink "$d/cwd" 2>/dev/null || true)
		exe=$(readlink "$d/exe" 2>/dev/null || true)
		if under_weston "$cwd" || under_weston "$exe"; then
			echo "$pid" >> "$list"
			continue
		fi
		[ "$mode" = light ] && continue
		if [ -r "$d/maps" ] && grep -Eq " ${MNT}(/| |$)" "$d/maps" 2>/dev/null; then
			echo "$pid" >> "$list"
			continue
		fi
		[ "$mode" = deep ] || continue
		for f in "$d"/fd/*; do
			[ -L "$f" ] || continue
			target=$(readlink "$f" 2>/dev/null || true)
			if under_weston "$target"; then
				echo "$pid" >> "$list"
				break
			fi
		done
	done
	sort -u "$list" > "$list.sorted"
	mv "$list.sorted" "$list"
}

have_holders() {
	[ -s "$list" ]
}

signal_holders() {
	sig=$1
	[ -s "$list" ] || return 0
	while read -r pid; do
		[ -n "$pid" ] || continue
		kill "-$sig" "$pid" 2>/dev/null || true
	done < "$list"
}

# Return 0 when none of the already listed PIDs still reference the runtime.
# Do not rescan every process; that made the grace last minutes.
wait_holders_gone() {
	n=0
	max=$1
	while [ "$n" -lt "$max" ]; do
		alive=0
		while read -r pid; do
			[ -n "$pid" ] || continue
			[ -d "/proc/$pid" ] || continue
			cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null || true)
			exe=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
			if under_weston "$cwd" || under_weston "$exe"; then
				alive=1
				break
			fi
			if [ -r "/proc/$pid/maps" ] && grep -Eq " ${MNT}(/| |$)" "/proc/$pid/maps" 2>/dev/null; then
				alive=1
				break
			fi
		done < "$list"
		[ "$alive" = 0 ] && return 0
		n=$((n + 1))
		sleep 0.1
	done
	return 1
}

unmount_children() {
	# Deepest path first so a file bind under /tmp/weston goes before the parent.
	ranked=$(mktemp) || return 1
	if pm_load; then
		body=$(mounts_targets "$(pm_mounts_file)") || {
			rm -f "$ranked"
			return 1
		}
		while IFS= read -r target || [ -n "$target" ]; do
			[ -n "$target" ] || continue
			case "$target" in
				"$MNT"/*)
					printf '%08d %s\n' "${#target}" "$target"
					;;
			esac
		done > "$ranked" <<END_ZLYME_MOUNTS
$body
END_ZLYME_MOUNTS
	else
		awk -v p="$MNT/" '
			index($2, p) == 1 { printf "%08d %s\n", length($2), $2 }
		' "${ZLYME_PM_MOUNTS:-/proc/mounts}" > "$ranked"
	fi
	sort -nr -o "$ranked" "$ranked"
	while IFS= read -r rec || [ -n "$rec" ]; do
		[ -n "$rec" ] || continue
		path=${rec#???????? }
		path=${path# }
		[ -n "$path" ] || continue
		if command umount "$path" 2>/dev/null; then
			log "unmounted $path"
		else
			log "umount $path failed"
		fi
	done < "$ranked"
	rm -f "$ranked"
}

unmount_parent() {
	n=0
	while [ "$n" -lt "$UMOUNT_POLLS" ]; do
		if ! mount_present; then
			return 0
		fi
		# Children may still be mounted after the parent check matches them.
		unmount_children
		if pm_load; then
			if ! mounts_has "$(pm_mounts_file)" "$MNT"; then
				return 0
			fi
		elif ! awk -v m="$MNT" '$2 == m { found = 1 } END { exit found ? 0 : 1 }' \
			"${ZLYME_PM_MOUNTS:-/proc/mounts}"; then
			return 0
		fi
		if command umount "$MNT" 2>/dev/null; then
			return 0
		fi
		collect_holders maps
		if ! have_holders; then
			collect_holders deep
		fi
		if have_holders; then
			log "mount busy; killing remaining holders"
			signal_holders KILL
			wait_holders_gone "$KILL_POLLS" || true
		fi
		n=$((n + 1))
		sleep 0.1
	done
	if pm_load; then
		if mounts_has "$(pm_mounts_file)" "$MNT"; then
			log "umount $MNT still busy"
			return 1
		fi
	elif awk -v m="$MNT" '$2 == m { found = 1 } END { exit found ? 0 : 1 }' \
		"${ZLYME_PM_MOUNTS:-/proc/mounts}"; then
		log "umount $MNT still busy"
		return 1
	fi
	return 0
}

weston_cleanup() {

list=$(mktemp) || {
	log "mktemp failed"
	exit 1
}
trap 'rm -f "$list"' EXIT INT TERM

if ! mount_present; then
	collect_holders light
	if ! have_holders; then
		return 0
	fi
fi

collect_holders maps
if have_holders; then
	signal_holders TERM
	if ! wait_holders_gone "$TERM_POLLS"; then
		collect_holders maps
		signal_holders KILL
		if ! wait_holders_gone "$KILL_POLLS"; then
			log "holders still present after SIGKILL"
		fi
	fi
fi

if ! unmount_parent; then
	return 1
fi

if mount_present; then
	log "$MNT is still mounted"
	return 1
fi
return 0
}

rc=0
weston_cleanup || rc=$?
if pm_load; then
	pm_cleanup_owned || rc=$?
else
	rc=1
fi
libsh=${ZLYME_LIBRARY_SH:-/usr/share/nextui/bin/zlyme-library.sh}
if [ -r "$libsh" ]; then
	# shellcheck disable=SC1090
	. "$libsh"
	zlyme_ports_unbind || true
fi
exit "$rc"
