#!/bin/sh
# One PortMaster lifecycle: selected library, live tree, Zlyme integration,
# and the /run/portmaster/PortMaster link.
#
# The squashfs copy is the seed. The selected library's
# Roms/.portmaster/PortMaster directory is the only live installation.
# A valid live tree is kept. A missing or structurally invalid tree is
# replaced from the seed. Nothing is merged from /storage/PortMaster or
# from a Ports (PORTS)/PortMaster directory.
#
# Test seams: ZLYME_PM_SEED, ZLYME_PM_OVERLAY, ZLYME_PM_RUN, ZLYME_PM_ROOT_BIN,
# ZLYME_PM_MIN_FREE_KB. ZLYME_PM_FAIL_PUBLISH and ZLYME_PM_FAIL_ROLLBACK
# force the corresponding mv to fail. They are unset on the device.
# Library selection stays in zlyme-portmaster-root
# (ZLYME_PM_STORAGE, ZLYME_PM_FLAG, ZLYME_LIBRARIES_FILE).

set -eu

stage=""
backup=""
# Set when the previous live tree could not be moved back. The EXIT trap
# must leave that backup in place.
backup_hold=0
cleanup_tmp() {
	status=$?
	if [ -n "$stage" ]; then
		rm -rf "$stage"
	fi
	if [ -n "$backup" ] && [ "$backup_hold" -eq 0 ]; then
		rm -rf "$backup"
	fi
	trap - EXIT
	exit "$status"
}
trap cleanup_tmp EXIT

seed=${ZLYME_PM_SEED:-/usr/share/portmaster/PortMaster.zip}
overlay=${ZLYME_PM_OVERLAY:-/usr/share/portmaster/zlyme}
run=${ZLYME_PM_RUN:-/run/portmaster}
rootbin=${ZLYME_PM_ROOT_BIN:-/usr/sbin/zlyme-portmaster-root}
cfg=${ZLYME_CFG:-/storage/.config}

die() {
	echo "zlyme-portmaster-prepare: $*" >&2
	exit 1
}

engine_ok() {
	d=$1
	[ -f "$d/pugwash" ] && [ -s "$d/pugwash" ] || return 1
	[ -f "$d/harbourmaster" ] && [ -s "$d/harbourmaster" ] || return 1
	return 0
}

pylibs_ok() {
	[ -d "$1/pylibs/harbourmaster" ] && [ ! -L "$1/pylibs" ]
}

# A symlink here is the old /run/portmaster/libs layout. Do not follow it.
materialize_dir() {
	path=$1
	if [ -L "$path" ] || [ -f "$path" ]; then
		rm -f "$path"
	fi
	mkdir -p "$path"
}

# pugwash and harbourmaster are present, and the mutable directories are
# real directories. A symlink, including the old libs link, is not a live
# tree. pylibs.zip may still be waiting to be expanded.
live_ok() {
	d=$1
	[ -d "$d" ] && [ ! -L "$d" ] || return 1
	engine_ok "$d" || return 1
	if [ -L "$d/pylibs" ]; then
		return 1
	fi
	if [ -d "$d/pylibs" ]; then
		pylibs_ok "$d" || return 1
	elif [ ! -f "$d/pylibs.zip" ] || [ -L "$d/pylibs.zip" ]; then
		return 1
	fi
	if [ -e "$d/libs" ]; then
		if [ -L "$d/libs" ] || [ ! -d "$d/libs" ]; then
			return 1
		fi
	fi
	if [ -e "$d/runtimes" ]; then
		if [ -L "$d/runtimes" ] || [ ! -d "$d/runtimes" ]; then
			return 1
		fi
	fi
	return 0
}

expand_pylibs() {
	d=$1
	tmp=""
	if [ -f "$d/pylibs.zip" ]; then
		tmp=$(mktemp -d "$d/.pylibs.XXXXXX") || return 1
		if ! unzip -q -o "$d/pylibs.zip" -d "$tmp"; then
			rm -rf "$tmp"
			die "PortMaster pylibs could not be extracted"
		fi
		if [ ! -d "$tmp/pylibs/harbourmaster" ]; then
			rm -rf "$tmp"
			die "PortMaster pylibs could not be extracted"
		fi
		rm -rf "$d/pylibs" "$d/exlibs"
		mv "$tmp/pylibs" "$d/pylibs"
		if [ -d "$tmp/exlibs" ]; then
			mv "$tmp/exlibs" "$d/exlibs"
		fi
		rm -rf "$tmp"
		rm -f "$d/pylibs.zip"
	fi
	if ! pylibs_ok "$d"; then
		die "PortMaster installation is incomplete"
	fi
	expand_fonts "$d"
}

# BusyBox tar does not decompress .xz unless asked, and this image's
# tar is BusyBox. Decompress beside the archive, on the live filesystem,
# then unpack the plain tar. Remove the compressed source only after
# the sentinel font is present. Always remove the temporary tar.
expand_fonts() {
	d=$1
	res=$d/pylibs/resources
	src=$res/NotoSans.tar.xz
	font=$res/NotoSansJP-Regular.ttf
	tmp=""
	[ -f "$src" ] || return 0
	[ ! -f "$font" ] || return 0
	tmp=$(mktemp "$res/.fonts.XXXXXX") || die "PortMaster fonts could not be extracted"
	if ! xz -dc "$src" > "$tmp"; then
		rm -f "$tmp"
		die "PortMaster fonts could not be extracted"
	fi
	if ! tar -C "$res" -xf "$tmp"; then
		rm -f "$tmp"
		die "PortMaster fonts could not be extracted"
	fi
	rm -f "$tmp"
	if [ ! -f "$font" ]; then
		die "PortMaster fonts could not be extracted"
	fi
	rm -f "$src"
	mkdir -p "$d/resources"
	cp -f "$res/"*.ttf "$d/resources/" 2>/dev/null || true
	rm -f "$d/resources/do_init"
}

fail_integ() {
	if [ -n "${integ:-}" ]; then
		rm -rf "$integ"
		integ=
	fi
	die "$1"
}

# Replace dest only when the bytes differ, so a repeat prepare does not
# touch the mtime of an integration file that is already current.
install_if_changed() {
	src=$1
	dest=$2
	if [ -f "$dest" ] && cmp -s "$src" "$dest"; then
		return 0
	fi
	dir=$(dirname "$dest")
	mkdir -p "$dir" || return 1
	tmp=$(mktemp "$dir/.zlyme-pm.XXXXXX") || return 1
	if ! cp -f "$src" "$tmp"; then
		rm -f "$tmp"
		return 1
	fi
	mv -f "$tmp" "$dest"
}

# The staged copies are the only files the patchers may write. Live
# files stay as they are until every postcondition holds.
prove_integration() {
	python3 - "$1" << 'PY'
import json
import re
import sys
from pathlib import Path

root = Path(sys.argv[1])
errors = []
hw = (root / "hardware.py").read_text()
plat = (root / "platform.py").read_text()
theme = json.loads((root / "theme.json").read_text())
control = (root / "control.txt").read_text()
mod = (root / "mod_Zlyme.txt").read_text()
if "('miyoo flip*', 'miyoo-flip')" not in hw:
    errors.append("Miyoo Flip hardware identity")
if '"Miyoo Flip"' not in hw or '"device": "miyoo-flip"' not in hw or '"Zlyme"' not in hw:
    errors.append("Miyoo Flip device entry")
if not re.search(r"'zlyme'\s*:\s*PlatformROCKNIX\b", plat):
    errors.append("zlyme platform mapping")
scheme = theme.get("#schemes", {}).get("Zlyme")
pallet = scheme.get("#pallet", {}) if isinstance(scheme, dict) else {}
if pallet.get("list_unselectable", [None])[:3] != [250, 124, 8]:
    errors.append("Zlyme colour scheme")
if pallet.get("list_selected", [None])[:3] != [252, 156, 20]:
    errors.append("Zlyme selection colour")
if pallet.get("selection-fill", [None])[:3] != [138, 62, 6]:
    errors.append("Zlyme selection fill")
if "export CFW_NAME=Zlyme" not in control or "ESUDO=/usr/sbin/zlyme-portmaster-exec" not in control:
    errors.append("control.txt")
if "pm_platform_helper" not in mod:
    errors.append("mod_Zlyme.txt")
if errors:
    sys.stderr.write(
        "zlyme-portmaster-prepare: integration incomplete: " + ", ".join(errors) + "\n"
    )
    sys.exit(1)
PY
}

apply_integration() {
	d=$1
	integ=
	[ -f "$overlay/control.txt" ] || die "Zlyme PortMaster integration is missing"
	[ -f "$overlay/mod_Zlyme.txt" ] || die "Zlyme PortMaster integration is missing"
	[ -f "$overlay/patch-hardware.py" ] || die "Zlyme PortMaster integration is missing"
	[ -f "$overlay/inject-scheme.py" ] || die "Zlyme PortMaster integration is missing"
	[ -f "$overlay/select-scheme.py" ] || die "Zlyme PortMaster integration is missing"
	command -v python3 >/dev/null 2>&1 || die "python3 is missing"
	expand_pylibs "$d"
	integ=$(mktemp -d) || die "PortMaster Zlyme integration could not be applied"
	hm_py=$d/pylibs/harbourmaster
	if ! cp -f "$hm_py/hardware.py" "$integ/hardware.py"; then
		fail_integ "PortMaster Zlyme integration could not be applied"
	fi
	if ! cp -f "$hm_py/platform.py" "$integ/platform.py"; then
		fail_integ "PortMaster Zlyme integration could not be applied"
	fi
	if ! cp -f "$d/pylibs/default_theme/theme.json" "$integ/theme.json"; then
		fail_integ "PortMaster Zlyme integration could not be applied"
	fi
	if ! python3 "$overlay/patch-hardware.py" "$integ/hardware.py"; then
		fail_integ "PortMaster Zlyme integration could not be applied"
	fi
	if ! python3 "$overlay/inject-scheme.py" "$integ/theme.json"; then
		fail_integ "PortMaster Zlyme integration could not be applied"
	fi
	cp -f "$overlay/control.txt" "$integ/control.txt" ||
		fail_integ "PortMaster Zlyme integration could not be applied"
	cp -f "$overlay/mod_Zlyme.txt" "$integ/mod_Zlyme.txt" ||
		fail_integ "PortMaster Zlyme integration could not be applied"
	if [ -f "$d/config/config.json" ]; then
		cp -f "$d/config/config.json" "$integ/config.json"
	fi
	# A scratch themes directory keeps the obsolete-theme removal off the
	# live tree until the rest of the integration has been proven.
	themes_scratch=$(mktemp -d) || fail_integ "PortMaster Zlyme integration could not be applied"
	if ! python3 "$overlay/select-scheme.py" "$integ/config.json" "$themes_scratch"; then
		rm -rf "$themes_scratch"
		fail_integ "PortMaster Zlyme integration could not be applied"
	fi
	rm -rf "$themes_scratch"
	if ! prove_integration "$integ"; then
		fail_integ "PortMaster Zlyme integration could not be applied"
	fi
	materialize_dir "$d/libs"
	materialize_dir "$d/runtimes"
	materialize_dir "$d/config"
	materialize_dir "$d/themes"
	install_if_changed "$integ/hardware.py" "$hm_py/hardware.py" ||
		fail_integ "PortMaster Zlyme integration could not be applied"
	install_if_changed "$integ/platform.py" "$hm_py/platform.py" ||
		fail_integ "PortMaster Zlyme integration could not be applied"
	install_if_changed "$integ/theme.json" "$d/pylibs/default_theme/theme.json" ||
		fail_integ "PortMaster Zlyme integration could not be applied"
	install_if_changed "$integ/control.txt" "$d/control.txt" ||
		fail_integ "PortMaster Zlyme integration could not be applied"
	install_if_changed "$integ/mod_Zlyme.txt" "$d/mod_Zlyme.txt" ||
		fail_integ "PortMaster Zlyme integration could not be applied"
	if [ -f "$integ/config.json" ]; then
		install_if_changed "$integ/config.json" "$d/config/config.json" ||
			fail_integ "PortMaster Zlyme integration could not be applied"
	fi
	if [ -d "$d/themes/Zlyme" ]; then
		rm -rf "$d/themes/Zlyme"
	fi
	mkdir -p "$cfg/PortMaster"
	install_if_changed "$overlay/control.txt" "$cfg/PortMaster/control.txt" ||
		fail_integ "PortMaster Zlyme integration could not be applied"
	if [ ! -s "$cfg/PortMaster/gamecontrollerdb.txt" ] && [ -s "$d/gamecontrollerdb.txt" ]; then
		cp -f "$d/gamecontrollerdb.txt" "$cfg/PortMaster/gamecontrollerdb.txt"
	fi
	if [ ! -e "$cfg/PortMaster/mapper.txt" ]; then
		: > "$cfg/PortMaster/mapper.txt"
	fi
	rm -rf "$integ"
	integ=
	# Best effort. exFAT may ignore the mode. Validity does not depend on it.
	chmod -R a+x "$d" 2>/dev/null || true
}

free_ok() {
	dir=$1
	need=${ZLYME_PM_MIN_FREE_KB:-}
	avail=""
	if [ -z "$need" ]; then
		[ -s "$seed" ] || die "PortMaster seed is missing"
		need=$(( $(wc -c < "$seed") / 1024 * 4 + 20480 ))
	fi
	avail=$(df -k "$dir" 2>/dev/null | awk 'NR==2 { print $4 }')
	if [ -z "${avail:-}" ] || [ "$avail" -lt "$need" ]; then
		die "Not enough free space for PortMaster"
	fi
}

publish_tree() {
	stage=$1
	new=$stage/PortMaster
	name=""
	engine_ok "$new" || die "PortMaster seed is not a PortMaster tree"
	for name in libs runtimes config themes; do
		materialize_dir "$new/$name"
	done
	apply_integration "$new"
	backup=$(mktemp -d "$tools/.pm-old.XXXXXX")
	# Success and a successful rollback remove this directory. A failed
	# rollback leaves the previous tree at backup/old, and the EXIT trap
	# does not delete it.
	if [ -e "$live" ] || [ -L "$live" ]; then
		if ! mv "$live" "$backup/old"; then
			rm -rf "$stage" "$backup"
			stage=""
			backup=""
			die "PortMaster seed could not be installed"
		fi
	fi
	published=0
	if [ "${ZLYME_PM_FAIL_PUBLISH:-0}" != 1 ] && mv "$new" "$live"; then
		published=1
	fi
	if [ "$published" -eq 1 ]; then
		rm -rf "$stage" "$backup"
		stage=""
		backup=""
		return 0
	fi
	restored=0
	if [ -e "$backup/old" ] || [ -L "$backup/old" ]; then
		if [ "${ZLYME_PM_FAIL_ROLLBACK:-0}" != 1 ] && mv "$backup/old" "$live"; then
			restored=1
		fi
	else
		restored=1
	fi
	rm -rf "$stage"
	stage=""
	if [ "$restored" -eq 1 ]; then
		rm -rf "$backup"
		backup=""
		die "PortMaster seed could not be installed"
	fi
	# shellcheck disable=SC1007
	held=$(CDPATH= cd -- "$backup" && pwd)/old
	backup_hold=1
	die "PortMaster seed could not be installed; previous installation remains at $held"
}

install_from_seed() {
	stage=""
	[ -s "$seed" ] || die "PortMaster seed is missing"
	free_ok "$tools"
	stage=$(mktemp -d "$tools/.pm-stage.XXXXXX") || die "PortMaster seed could not be installed"
	if ! unzip -q "$seed" -d "$stage"; then
		rm -rf "$stage"
		die "PortMaster seed could not be installed"
	fi
	if [ ! -d "$stage/PortMaster" ]; then
		rm -rf "$stage"
		die "PortMaster seed is not a PortMaster tree"
	fi
	publish_tree "$stage"
}

# /run/portmaster is tmpfs. A leftover directory must not become the
# parent of a new link, and removing a symlink must not follow it into
# the live tree.
link_runtime() {
	dest=$run/PortMaster
	mkdir -p "$run"
	if [ -L "$dest" ]; then
		rm -f "$dest"
	elif [ -e "$dest" ]; then
		rm -rf "$dest"
	fi
	ln -s "$live" "$dest"
}

validate_live() {
	engine_ok "$live" || die "PortMaster installation is incomplete"
	pylibs_ok "$live" || die "PortMaster installation is incomplete"
	[ -f "$live/control.txt" ] || die "PortMaster installation is incomplete"
	[ -f "$live/mod_Zlyme.txt" ] || die "PortMaster installation is incomplete"
	if [ ! -d "$live/libs" ] || [ -L "$live/libs" ]; then
		die "PortMaster installation is incomplete"
	fi
	if [ ! -d "$live/runtimes" ] || [ -L "$live/runtimes" ]; then
		die "PortMaster installation is incomplete"
	fi
	[ -f "$run/PortMaster/pugwash" ] || die "PortMaster installation is incomplete"
}

load_hm() {
	hm=$("$rootbin" export) || exit 1
	eval "$hm"
	[ -n "${HM_TOOLS_DIR:-}" ] || die "PortMaster library is not selected"
	[ -n "${HM_PORTS_DIR:-}" ] || die "PortMaster library is not selected"
	tools=$HM_TOOLS_DIR
	live=$tools/PortMaster
}

prepare() {
	load_hm
	mkdir -p "$tools" || die "PortMaster disk is not writable"
	if ! live_ok "$live"; then
		install_from_seed
	fi
	apply_integration "$live"
	link_runtime
	validate_live
}

case "${1:-}" in
	""|prepare) prepare ;;
	expand-fonts)
		[ -n "${2:-}" ] || die "usage: $0 expand-fonts DIR"
		expand_fonts "$2"
		;;
	export)
		prepare
		"$rootbin" export
		;;
	*)
		echo "usage: $0 [export]" >&2
		exit 2
		;;
esac
