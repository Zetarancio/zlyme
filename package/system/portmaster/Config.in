config BR2_PACKAGE_PORTMASTER
	bool "portmaster"
	select BR2_PACKAGE_BOX64
	select BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON3_PY_PYC
	select BR2_PACKAGE_PYTHON3_SSL
	select BR2_PACKAGE_PYTHON3_SQLITE
	select BR2_PACKAGE_PYTHON3_PYEXPAT
	select BR2_PACKAGE_PYTHON3_ZLIB
	select BR2_PACKAGE_CA_CERTIFICATES
	select BR2_PACKAGE_XZ
	help
	  PortMaster stable seed 2026.06.23-0015. The image keeps the
	  immutable seed /usr/share/portmaster/PortMaster.zip. First
	  launch unpacks the live tree on the selected library at
	  Roms/.portmaster/PortMaster. That library is authoritative.
	  Needs Python 3 (ssl, sqlite, xml), XZ, CA certificates, and
	  box64.

	  https://github.com/PortsMaster/PortMaster-GUI
