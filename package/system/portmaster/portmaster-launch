#!/bin/sh
# First run copies the release onto /storage so PortMaster can update
# itself. GUI is pugwash (python3) under PortMaster/, not a top-level
# PortMaster.sh. exFAT has no +x, so never test -x on the card copy.
#
# Run from the squashfs copy when the card copy is incomplete. Python
# 3.14 pyc-only sysconfigdata was crashing loguru (pak exit 1).

. /etc/zlyme.conf
DEST="${ZLYME_STORAGE}/PortMaster"
IMG=/usr/share/portmaster/PortMaster

msg() {
	echo "$1"
	if command -v show.elf >/dev/null 2>&1; then
		show.elf "$1" 3
	fi
}

pm_ok() {
	[ -f "$1/pugwash" ] && [ -d "$1/pylibs" ]
}

if [ ! -f "$DEST/PortMaster/pugwash" ] && [ -f "$IMG/pugwash" ]; then
	avail=$(df -k "$ZLYME_STORAGE" 2>/dev/null | awk 'NR==2 { print $4 }')
	if [ "${avail:-0}" -ge 102400 ]; then
		mkdir -p "$DEST"
		cp -a /usr/share/portmaster/. "$DEST/" 2>/dev/null || true
	fi
fi

root=""
if pm_ok "$DEST/PortMaster"; then
	root="$DEST/PortMaster"
elif pm_ok "$DEST"; then
	root="$DEST"
elif pm_ok "$IMG"; then
	root="$IMG"
fi

if [ -z "$root" ]; then
	msg "PortMaster files missing"
	exit 1
fi

cd "$root" || exit 1

if [ -f "$root/pylibs/harbourmaster/hardware.py" ] && \
	[ -f /usr/share/portmaster/patch-hardware.py ]; then
	python3 /usr/share/portmaster/patch-hardware.py \
		"$root/pylibs/harbourmaster/hardware.py" >/dev/null 2>&1 || true
fi

seed_zlyme_theme() {
	src=/usr/share/portmaster/PortMaster/themes/Zlyme
	[ -f "$src/theme.json" ] || return 0
	# pugwash reads HM_TOOLS_DIR/PortMaster/themes, not pylibs/.
	tools="${HM_TOOLS_DIR:-/storage/Roms/.portmaster}/PortMaster"
	dest="$tools/themes/Zlyme"
	mkdir -p "$dest"
	cp -a "$src/." "$dest/" 2>/dev/null || true

	stamp="${ZLYME_CFG:-/storage/.config}/portmaster/.zlyme-theme-seeded"
	[ -f "$stamp" ] && return 0
	mkdir -p "$(dirname "$stamp")" "$tools/config"
	cfg="$tools/config/config.json"
	if command -v python3 >/dev/null 2>&1; then
		python3 - "$cfg" <<'PY'
import json, sys
from pathlib import Path
p = Path(sys.argv[1])
data = {}
if p.is_file():
    try:
        data = json.loads(p.read_text() or "{}")
    except json.JSONDecodeError:
        data = {}
theme = data.get("theme", "default_theme")
if theme in ("default_theme", "Zlyme", None, ""):
    data["theme"] = "Zlyme"
    data["theme-scheme"] = "Zlyme"
    p.write_text(json.dumps(data, indent=4) + "\n")
PY
	fi
	: >"$stamp"
}


export HOME="${ZLYME_CFG}/portmaster"
mkdir -p "$HOME" "$HOME/.local/share"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME"
export controlfolder="$root"
export PYSDL2_DLL_PATH=/usr/lib
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-kmsdrm}"
export SDL_GAMECONTROLLERCONFIG_FILE=/usr/lib/gamecontrollerdb.txt
export LD_LIBRARY_PATH="${SYSTEM_PATH:-/usr/share/nextui}/lib:/usr/lib:${LD_LIBRARY_PATH:-}"
# pugwash calls pgrep/pkill; busybox here has neither. Overlay stubs live
# on the card so they survive a RO /usr.
export PATH="${SYSTEM_PATH:-/usr/share/nextui}/bin:/usr/bin:/usr/sbin:/bin:/sbin${PATH:+:$PATH}"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="$root/exlibs:$root/pylibs${PYTHONPATH:+:$PYTHONPATH}"
# harbourmaster defaults to /roms/ports (RO squashfs). Zlyme ROMs live here.
ports_dir="/storage/Roms/Ports (PORTS)"
if [ ! -d "$ports_dir" ] && [ -d /storage/Roms/ports ]; then
	ports_dir=/storage/Roms/ports
fi
mkdir -p "$ports_dir" /storage/Roms/.portmaster/PortMaster
export HM_PORTS_DIR="$ports_dir"
export HM_SCRIPTS_DIR="$ports_dir"
export HM_TOOLS_DIR=/storage/Roms/.portmaster
seed_zlyme_theme
# Saying yes to a GUI self-update (or a timed-out one) leaves this
# flag; pugwash then skips the main loop and exits 0.
rm -f "$HM_TOOLS_DIR/PortMaster/.pugwash-reboot"
if [ -f /etc/ssl/certs/ca-certificates.crt ]; then
	export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
	export REQUESTS_CA_BUNDLE="$SSL_CERT_FILE"
	export CURL_CA_BUNDLE="$SSL_CERT_FILE"
fi
# harbourmaster ignores CFW_NAME/DEVICE_NAME. It reads ~/.config/.DEVICE
# (ArkOS) and quoted NAME/HW_DEVICE in /etc/os-release. DTB "Miyoo Flip"
# is not in its table; miyoo-flip is (RK3566, 640x480, two sticks).
mkdir -p "$HOME/.config"
printf '%s\n' 'miyoo-flip' > "$HOME/.config/.DEVICE"
export CFW_NAME="${CFW_NAME:-ROCKNIX}"
export DEVICE_NAME="${DEVICE_NAME:-Miyoo Flip}"

sleep 0.4

log=/tmp/portmaster.log
if [ -n "${LOGS_PATH:-}" ]; then
	log="$LOGS_PATH/portmaster.txt"
	mkdir -p "$LOGS_PATH"
fi

st=1
if [ -f ./pugwash ]; then
	# Self-update downloads a GitHub zip and freezes the GUI on this
	# link; the image copy is the one we patched (pgrep, paths, jpeg).
	if command -v python3 >/dev/null 2>&1; then
		python3 ./pugwash --no-check "$@" >"$log" 2>&1
		st=$?
	else
		/usr/bin/python3 ./pugwash --no-check "$@" >"$log" 2>&1
		st=$?
	fi
elif [ -f ./PortMaster.sh ]; then
	/bin/bash ./PortMaster.sh "$@" >"$log" 2>&1
	st=$?
else
	msg "PortMaster has no pugwash"
	exit 1
fi

if [ "$st" -ne 0 ]; then
	echo "portmaster exit $st" >>"$log"
	tail -n 8 "$log"
	err=$(grep -E 'Error|Error:|ModuleNotFound|ValueError|Traceback' "$log" | tail -n 1)
	[ -n "$err" ] || err="PortMaster failed ($st)"
	msg "$err"
fi
exit "$st"
