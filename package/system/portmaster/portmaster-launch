#!/bin/sh
# PortMaster GUI. The live tree is prepared by zlyme-portmaster-prepare.
# pugwash --no-check is not used: that flag only skips the startup
# version offer. Update PortMaster in the GUI still installs a zip and
# writes .pugwash-reboot. This wrapper consumes that file by preparing
# again and starting the new pugwash, which is the upstream restart loop.

if [ -r /etc/zlyme.conf ]; then
	# shellcheck disable=SC1091
	. /etc/zlyme.conf
fi

DEST_PREPARE=${ZLYME_PM_PREPARE:-/usr/sbin/zlyme-portmaster-prepare}
DEST_ROOT=${ZLYME_PM_ROOT_BIN:-/usr/sbin/zlyme-portmaster-root}

msg() {
	echo "$1"
	if command -v show.elf >/dev/null 2>&1; then
		show.elf "$1" 3
	fi
}

fail_prepare() {
	err=$1
	line=""
	if [ -s "$err" ]; then
		line=$(tail -n 1 "$err")
	fi
	rm -f "$err"
	msg "${line:-PortMaster is not ready}"
	exit 1
}

if [ ! -x "$DEST_PREPARE" ]; then
	msg "PortMaster is not installed"
	exit 1
fi

err=$(mktemp)
if ! "$DEST_PREPARE" 2>"$err"; then
	fail_prepare "$err"
fi
rm -f "$err"

hm=$("$DEST_ROOT" export) || {
	msg "PortMaster disk is not inserted"
	exit 1
}
eval "$hm"
export HM_TOOLS_DIR HM_PORTS_DIR HM_SCRIPTS_DIR
root=$HM_TOOLS_DIR/PortMaster
cd "$root" || exit 1

export HOME="${ZLYME_CFG:-/storage/.config}/portmaster-home"
mkdir -p "$HOME" "$HOME/.local/share" "$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME"
export controlfolder="$root"
export PYSDL2_DLL_PATH=/usr/lib
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-kmsdrm}"
export SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT="${SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT:-0x045e/0x028e}"
export SDL_GAMECONTROLLERCONFIG_FILE=/usr/lib/gamecontrollerdb.txt
export LD_LIBRARY_PATH="${SYSTEM_PATH:-/usr/share/nextui}/lib:/usr/lib:${LD_LIBRARY_PATH:-}"
export PATH="${SYSTEM_PATH:-/usr/share/nextui}/bin:/usr/bin:/usr/sbin:/bin:/sbin${PATH:+:$PATH}"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONUNBUFFERED=1
export PYTHONPATH="$root/exlibs:$root/pylibs${PYTHONPATH:+:$PYTHONPATH}"
mkdir -p "$HM_PORTS_DIR"
if [ -f /etc/ssl/certs/ca-certificates.crt ]; then
	export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
	export REQUESTS_CA_BUNDLE="$SSL_CERT_FILE"
	export CURL_CA_BUNDLE="$SSL_CERT_FILE"
fi
printf '%s\n' 'miyoo-flip' > "$HOME/.config/.DEVICE"
export CFW_NAME="${CFW_NAME:-Zlyme}"
export DEVICE_NAME="${DEVICE_NAME:-Miyoo Flip}"

if [ "${ZLYME_PM_NO_SLEEP:-}" != 1 ]; then
	sleep 0.4
fi

# nextui-session always exports LOGS_PATH. When system logs are off
# that path is the NextUI userdata directory, not a pak log.
# pak-log.sh sets ZLYME_PAK_LOG only when system logs are on.
log=/tmp/portmaster.log
if [ -n "${ZLYME_PAK_LOG:-}" ] && [ -n "${LOGS_PATH:-}" ]; then
	log="$LOGS_PATH/portmaster.txt"
	mkdir -p "$LOGS_PATH"
fi

run_pugwash() {
	if [ -n "${ZLYME_PM_PUGWASH:-}" ]; then
		"$ZLYME_PM_PUGWASH" "$@"
		return $?
	fi
	if [ ! -f "$root/pugwash" ]; then
		msg "PortMaster has no pugwash"
		return 1
	fi
	if command -v python3 >/dev/null 2>&1; then
		python3 "$root/pugwash" "$@"
	else
		/usr/bin/python3 "$root/pugwash" "$@"
	fi
}

# pugwash has closed the transcript. Shorten a finished file. Do not
# do this while pugwash is still running.
trim_closed_log() {
	[ -f "$log" ] || return 0
	[ ! -L "$log" ] || return 0
	_pmsz=$(wc -c < "$log" 2>/dev/null) || return 0
	_pmsz=$(printf '%s\n' "$_pmsz" | tr -d ' ')
	[ "$_pmsz" -gt 1048576 ] || return 0
	_pmtmp=$(mktemp "${log}.trim.XXXXXX") || return 0
	if tail -c 1048576 "$log" > "$_pmtmp"; then
		mv -f "$_pmtmp" "$log"
	else
		rm -f "$_pmtmp"
	fi
	unset _pmsz _pmtmp
}

# A leftover flag means the new files are already installed. Prepare
# already refreshed Zlyme integration, so drop the flag and open the GUI.
if [ -f "$root/.pugwash-reboot" ]; then
	rm -f "$root/.pugwash-reboot"
fi

st=1
log_open=0
while true; do
	# A failed open must not skip the GUI. The probe writes nothing.
	# Later appends stay inside this success path: a failed redirect is
	# fatal in BusyBox ash, and the probe already knows the file is closed.
	if cat /dev/null >>"$log" 2>/dev/null; then
		log_open=1
		run_pugwash "$@" >"$log" 2>&1
		st=$?
	else
		log_open=0
		run_pugwash "$@"
		st=$?
	fi
	if [ ! -f "$root/.pugwash-reboot" ]; then
		break
	fi
	rm -f "$root/.pugwash-reboot"
	err=$(mktemp)
	if ! "$DEST_PREPARE" 2>"$err"; then
		trim_closed_log
		fail_prepare "$err"
	fi
	rm -f "$err"
	hm=$("$DEST_ROOT" export) || {
		trim_closed_log
		msg "PortMaster disk is not inserted"
		exit 1
	}
	eval "$hm"
	export HM_TOOLS_DIR HM_PORTS_DIR HM_SCRIPTS_DIR
	root=$HM_TOOLS_DIR/PortMaster
	export controlfolder="$root"
	export PYTHONPATH="$root/exlibs:$root/pylibs${PYTHONPATH:+:$PYTHONPATH}"
	if ! cd "$root"; then
		trim_closed_log
		exit 1
	fi
done

# pugwash has returned, so an install's files are on the selected card.
# This does not change that card, and a failure here keeps pugwash's status.
_art=${ZLYME_PM_ART:-/usr/sbin/zlyme-portmaster-art}
if [ -x "$_art" ]; then
	"$_art" || true
fi
unset _art

# Take the on-screen line from the full transcript, then shorten the
# file. A match that sits more than 1 MiB before the end still shows.
if [ "$log_open" = 1 ]; then
	shown=
	if [ "$st" -ne 0 ]; then
		shown=$(grep -E 'Error|Error:|ModuleNotFound|ValueError|Traceback' "$log" 2>/dev/null | tail -n 1)
		[ -n "$shown" ] || shown="PortMaster failed ($st)"
	fi
	trim_closed_log
	if [ "$st" -ne 0 ]; then
		echo "portmaster exit $st" >>"$log"
		tail -n 8 "$log"
		msg "$shown"
	fi
elif [ "$st" -ne 0 ]; then
	msg "PortMaster failed ($st)"
fi
exit "$st"
