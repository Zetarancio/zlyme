#!/bin/sh
# MTP session for the Miyoo Flip lower USB-C port.
# Tools starts and stops this. Nothing in init does.
# The controller name comes from device.conf (ZLYME_USB_GADGET_UDC).
# Test seams override every host path. Configfs is mounted only while
# a transfer starts, and only when it is not already mounted.
# Each MTP entry is one mounted data filesystem root: /storage,
# /mnt/sd2, and /mnt/media/<name>. ROM and BIOS directories are not
# required. /boot is never an entry. ext4 is shared only when the
# responder is started in the private mount namespace built by
# zlyme-usb-enter. ZLYME_USB_JAIL=0 is the host-test seam that keeps
# the exFAT-only path.
# This script does not change USB role, VBUS, or regulators.
# On RK3566, binding while the lower port has no VBUS can make DWC3
# fail "failed to enable ep0out". The controller then stays bound and
# the host never finishes enumeration. After bind, this session
# soft-disconnects until that port's PHY reports SDP or CDP, then
# soft-connects once. A later unplug soft-disconnects once, and the
# next data cable soft-connects once. DCP is not a data host. A
# healthy control endpoint is left alone. ROCKNIX documents the same
# failure and uses UDC soft_connect; this behavior is Zlyme's and
# does not copy that script. Debugfs is optional. state=bound is not
# host enumeration.

RUN=${ZLYME_USB_RUN:-/run/zlyme/usb-transfer}
CONFIGFS=${ZLYME_USB_CONFIGFS:-/sys/kernel/config}
UDC_CLASS=${ZLYME_USB_UDC_CLASS:-/sys/class/udc}
MOUNTS=${ZLYME_USB_MOUNTS:-/proc/mounts}
FFS=${ZLYME_USB_FFS:-/dev/ffs-mtp}
UMTPRD=${ZLYME_USB_UMTPRD:-/usr/sbin/umtprd}
GADGET_NAME=${ZLYME_USB_GADGET_NAME:-zlyme-mtp}
LIBS=${ZLYME_LIBRARIES_FILE:-/run/zlyme/libraries}
STORAGE=${ZLYME_USB_STORAGE:-/storage}
SD2=${ZLYME_USB_SD2:-/mnt/sd2}
MEDIA=${ZLYME_USB_MEDIA:-/mnt/media}
BOOT=${ZLYME_USB_BOOT:-/boot}
MOUNT=${ZLYME_USB_MOUNT:-mount}
UMOUNT=${ZLYME_USB_UMOUNT:-umount}
READY_POLLS=${ZLYME_USB_READY_POLLS:-30}
READY_SLEEP=${ZLYME_USB_READY_SLEEP:-0.1}
KILL_POLLS=${ZLYME_USB_KILL_POLLS:-20}
KILL_SLEEP=${ZLYME_USB_KILL_SLEEP:-0.1}
SPAWN_POLLS=${ZLYME_USB_SPAWN_POLLS:-20}
SPAWN_SLEEP=${ZLYME_USB_SPAWN_SLEEP:-0.05}
REAP_SLEEP=${ZLYME_USB_REAP_SLEEP:-0.2}
REAP_WAIT=${ZLYME_USB_REAP_WAIT:-0.05}
LINK_SLEEP=${ZLYME_USB_LINK_SLEEP:-0.2}
LINK=${ZLYME_USB_LINK:-1}
ENTER=${ZLYME_USB_ENTER:-/usr/sbin/zlyme-usb-enter}
JAIL=${ZLYME_USB_JAIL:-1}
CONF=$RUN/umtprd.conf
PIDFILE=$RUN/responder.pid
EXPORTS=$RUN/exports
GADGET=$CONFIGFS/usb_gadget/$GADGET_NAME

if [ -z "${ZLYME_USB_UDC_NAME:-}" ]; then
	_ident=${ZLYME_DEVICE_CONF:-/usr/share/zlyme/device.conf}
	if [ -r "$_ident" ]; then
		# shellcheck disable=SC1090
		. "$_ident"
	fi
	ZLYME_USB_UDC_NAME=${ZLYME_USB_GADGET_UDC:-}
fi
UDC_NAME=${ZLYME_USB_UDC_NAME:-}

say() {
	printf '%s\n' "$*" >&2
}

trim() {
	_t=$1
	while :; do
		case "$_t" in
			[[:space:]]*) _t=${_t#?} ;;
			*[[:space:]]) _t=${_t%?} ;;
			*) break ;;
		esac
	done
	printf '%s\n' "$_t"
}

lock_session() {
	mkdir -p "$RUN" || {
		say "cannot create $RUN"
		return 1
	}
	exec 9>"$RUN/lock" || {
		say "cannot open $RUN/lock"
		return 1
	}
	if ! command -v flock >/dev/null 2>&1; then
		say "flock is not available"
		return 1
	fi
	flock 9 || {
		say "usb transfer lock failed"
		return 1
	}
}

decode_mount() {
	printf '%s' "$1" | sed 's/\\040/ /g; s/\\011/	/g; s/\\134/\\/g'
}

mounts_has() {
	_want=$1
	[ -r "$MOUNTS" ] || return 1
	while read -r _dev _mp _rest; do
		[ -n "${_mp:-}" ] || continue
		_mp=$(decode_mount "$_mp")
		[ "$_mp" = "$_want" ] && return 0
	done < "$MOUNTS"
	return 1
}

# Exact mountpoint. Sets EXACT_TYPE.
exact_mount() {
	EXACT_TYPE=
	_ex_path=$1
	[ -r "$MOUNTS" ] || return 1
	while read -r _ex_dev _ex_mp _ex_type _ex_opts _ex_rest; do
		[ -n "${_ex_mp:-}" ] || continue
		_ex_mp=$(decode_mount "$_ex_mp")
		[ "$_ex_mp" = "$_ex_path" ] || continue
		EXACT_TYPE=$_ex_type
		return 0
	done < "$MOUNTS"
	return 1
}

# Longest mount covering the path. Sets COVER_*.
cover_mount() {
	_cm_path=$1
	COVER_DEV=
	COVER_MP=
	COVER_TYPE=
	COVER_OPTS=
	_cm_best=0
	[ -r "$MOUNTS" ] || return 1
	while read -r _cm_dev _cm_mp _cm_type _cm_opts _cm_dump _cm_pass; do
		[ -n "${_cm_mp:-}" ] || continue
		_cm_mp=$(decode_mount "$_cm_mp")
		_cm_dev=$(decode_mount "$_cm_dev")
		_cm_hit=0
		if [ "$_cm_mp" = "$_cm_path" ]; then
			_cm_hit=1
		else
			case "$_cm_path" in
				"$_cm_mp"/*) _cm_hit=1 ;;
			esac
		fi
		[ "$_cm_hit" = 1 ] || continue
		_cm_len=${#_cm_mp}
		if [ "$_cm_len" -ge "$_cm_best" ]; then
			_cm_best=$_cm_len
			COVER_DEV=$_cm_dev
			COVER_MP=$_cm_mp
			COVER_TYPE=$_cm_type
			COVER_OPTS=$_cm_opts
		fi
	done < "$MOUNTS"
	[ -n "$COVER_MP" ]
}

nested_mount() {
	_nm_path=$1
	[ -r "$MOUNTS" ] || return 1
	while read -r _nm_dev _nm_mp _nm_rest; do
		[ -n "${_nm_mp:-}" ] || continue
		_nm_mp=$(decode_mount "$_nm_mp")
		case "$_nm_mp" in
			"$_nm_path"/*) return 0 ;;
		esac
	done < "$MOUNTS"
	return 1
}

opt_has() {
	case ",$1," in
		*",$2,"*) return 0 ;;
		*) return 1 ;;
	esac
}

# Kernel exFAT and VFAT have no POSIX symlink object. ext4 is allowed
# only while JAIL is 1, because zlyme-usb-enter then confines the
# responder. uMTP 1.8.1 follows links: fs_entry_stat() uses stat64,
# and entry_open() uses open.
fs_allowed() {
	case "$1" in
		exfat|vfat) return 0 ;;
		ext4) [ "$JAIL" = 1 ] ;;
		*) return 1 ;;
	esac
}

mounted_rw() {
	opt_has "$1" ro && return 1
	opt_has "$1" rw
}

# Field N after the comm in /proc/pid/stat. 1 is state, 3 is pgrp,
# 20 is starttime. Runs in a subshell so set does not replace $1.
proc_stat() {
	_ps_pid=$1
	_ps_idx=$2
	case "$_ps_pid" in
		''|*[!0-9]*) return 1 ;;
	esac
	case "$_ps_idx" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ -r "/proc/$_ps_pid/stat" ] || return 1
	_ps_line=$(cat "/proc/$_ps_pid/stat" 2>/dev/null) || return 1
	_ps_val=$(
		rest=${_ps_line#*)}
		idx=$_ps_idx
		set -f
		# shellcheck disable=SC2086
		set -- $rest
		set +f
		if [ "$#" -lt "$idx" ]; then
			exit 1
		fi
		shift $((idx - 1))
		printf '%s\n' "${1:-}"
	) || return 1
	[ -n "$_ps_val" ] || return 1
	printf '%s\n' "$_ps_val"
}

ppid_of() {
	_pp_pid=$1
	[ -r "/proc/$_pp_pid/status" ] || return 1
	_pp_line=$(sed -n 's/^PPid:[[:space:]]*//p' "/proc/$_pp_pid/status") || return 1
	case "$_pp_line" in
		''|*[!0-9]*) return 1 ;;
	esac
	printf '%s\n' "$_pp_line"
}

signal_pid() {
	_sig=$1
	_pid=$2
	if [ -n "${ZLYME_USB_SIGNAL:-}" ]; then
		"$ZLYME_USB_SIGNAL" -s "$_sig" "$_pid" 2>/dev/null || return 1
		return 0
	fi
	kill -s "$_sig" "$_pid" 2>/dev/null || return 1
}

pid_alive() {
	kill -0 "$1" 2>/dev/null
}

path_forbidden() {
	case "$1" in
		/dev|/dev/*|/sys|/sys/*|/proc|/proc/*|/boot|/boot/*) return 0 ;;
	esac
	case "$1" in
		*/.config|*/.config/*|*/.update|*/.update/*|*/.logs|*/.logs/*) return 0 ;;
	esac
	return 1
}

# A permitted export is one mount root. Hidden directories on that
# filesystem are part of the share. /boot, /dev, /proc, and /sys are not.
root_path_ok() {
	_p=$1
	case "$_p" in
		*'"'*|*'	'*|*'*'*) return 1 ;;
	esac
	path_forbidden "$_p" && return 1
	_old=
	while [ "$_p" != "$_old" ]; do
		_old=$_p
		_p=${_p%/}
	done
	case "$_p" in
		/*) ;;
		*) return 1 ;;
	esac
	case "$_p" in
		*"/../"*|*/..|*"//"*) return 1 ;;
	esac
	if [ -L "$_p" ] || [ ! -d "$_p" ]; then
		return 1
	fi
	return 0
}

boot_dev_now() {
	if cover_mount "$BOOT"; then
		printf '%s\n' "$COVER_DEV"
	fi
}

is_boot_dev() {
	_ib_dev=$1
	_ib_boot=$(boot_dev_now)
	if [ -n "$_ib_boot" ] && [ "$_ib_dev" = "$_ib_boot" ]; then
		return 0
	fi
	if [ -n "${ZLYME_BOOT_DEVICE:-}" ] && [ "$_ib_dev" = "$ZLYME_BOOT_DEVICE" ]; then
		return 0
	fi
	return 1
}

is_boot_path() {
	case "$1" in
		"$BOOT"|"$BOOT"/*) return 0 ;;
	esac
	return 1
}

name_taken() {
	[ -f "$EXPORTS" ] || return 1
	# Do not reuse _path. add_export calls this and keeps its own _path.
	while IFS='	' read -r _seen_path _seen_name _; do
		[ -n "$_seen_path" ] || continue
		[ "$_seen_name" = "$1" ] && return 0
	done < "$EXPORTS"
	return 1
}

path_exported() {
	[ -f "$EXPORTS" ] || return 1
	while IFS='	' read -r _xp _ _rest; do
		[ "$_xp" = "$1" ] && return 0
	done < "$EXPORTS"
	return 1
}

export_count() {
	if [ ! -s "$EXPORTS" ]; then
		printf '0\n'
		return 0
	fi
	wc -l < "$EXPORTS" | tr -d ' '
}

add_export() {
	_path=$1
	_name=$2
	_mode=$3
	_n=$(export_count)
	if [ "$_n" -ge 16 ]; then
		: > "$RUN/truncated"
		return 1
	fi
	_try=$_name
	_i=2
	while name_taken "$_try"; do
		_try="$_name $_i"
		_i=$((_i + 1))
	done
	printf '%s	%s	%s\n' "$_path" "$_try" "$_mode" >> "$EXPORTS"
}

# The directory name is already zlyme-storage's mountpoint component,
# including its collision suffix. MTP shows that name.
volume_label() {
	_base=${1##*/}
	_base=$(trim "$_base")
	if [ -z "$_base" ] || [ "$_base" = "." ] || [ "$_base" = ".." ]; then
		_base=Volume
	fi
	printf '%s\n' "$_base"
}

record_skip() {
	printf '%s	%s\n' "$1" "$2" >> "$RUN/skipped"
	say "skipped $1: $2"
}

listed_in_libraries() {
	[ -r "$LIBS" ] || return 1
	while IFS= read -r _listed || [ -n "$_listed" ]; do
		[ "$_listed" = "$1" ] && return 0
	done < "$LIBS"
	return 1
}

# 0 when the root was added or deliberately skipped. 1 when the
# primary root cannot be shared at all.
add_mount_root() {
	_ar_path=$1
	_ar_label=$2
	_ar_primary=$3
	if ! listed_in_libraries "$_ar_path" && [ "$_ar_primary" != 1 ]; then
		return 0
	fi
	if path_exported "$_ar_path"; then
		return 0
	fi
	if is_boot_path "$_ar_path"; then
		if [ "$_ar_primary" = 1 ]; then
			say "primary storage is the boot volume"
			return 1
		fi
		record_skip "$_ar_path" "is the boot volume"
		return 0
	fi
	if ! mounts_has "$_ar_path"; then
		if [ "$_ar_primary" = 1 ]; then
			say "primary storage is not mounted"
			return 1
		fi
		record_skip "$_ar_path" "is not mounted"
		return 0
	fi
	if ! cover_mount "$_ar_path" || [ "$COVER_MP" != "$_ar_path" ]; then
		if [ "$_ar_primary" = 1 ]; then
			say "primary storage is not mounted"
			return 1
		fi
		record_skip "$_ar_path" "is not the mounted filesystem root"
		return 0
	fi
	if is_boot_dev "$COVER_DEV"; then
		if [ "$_ar_primary" = 1 ]; then
			say "primary storage is the boot volume"
			return 1
		fi
		record_skip "$_ar_path" "is the boot volume"
		return 0
	fi
	if ! fs_allowed "$COVER_TYPE"; then
		if [ "$_ar_primary" = 1 ]; then
			if [ "$JAIL" = 1 ]; then
				say "primary storage filesystem is $COVER_TYPE, not exfat, vfat, or ext4"
			else
				say "primary storage filesystem is $COVER_TYPE, not exfat or vfat"
			fi
			return 1
		fi
		if [ "$COVER_TYPE" = ext4 ]; then
			record_skip "$_ar_path" "filesystem is ext4, which can contain symlinks"
		else
			record_skip "$_ar_path" "filesystem is $COVER_TYPE, which is not shared"
		fi
		return 0
	fi
	if nested_mount "$_ar_path"; then
		if [ "$_ar_primary" = 1 ]; then
			say "primary storage contains a nested mount"
			return 1
		fi
		record_skip "$_ar_path" "contains a nested mount"
		return 0
	fi
	case "$COVER_DEV" in
		''|"$_ar_path"|"$_ar_path"/*)
			if [ "$_ar_primary" = 1 ]; then
				say "primary storage has no mount source"
				return 1
			fi
			record_skip "$_ar_path" "has no mount source"
			return 0
			;;
	esac
	if ! root_path_ok "$_ar_path"; then
		if [ "$_ar_primary" = 1 ]; then
			say "primary storage path is not exportable"
			return 1
		fi
		record_skip "$_ar_path" "is not an exportable directory"
		return 0
	fi
	if mounted_rw "$COVER_OPTS"; then
		if [ ! -w "$_ar_path" ]; then
			if [ "$_ar_primary" = 1 ]; then
				say "primary storage is not writable"
				return 1
			fi
			record_skip "$_ar_path" "is not writable"
			return 0
		fi
		_ar_mode=rw
	else
		if [ ! -r "$_ar_path" ]; then
			record_skip "$_ar_path" "is not readable"
			return 0
		fi
		_ar_mode=ro
	fi
	if [ "$_ar_primary" != 1 ]; then
		_ar_mode="$_ar_mode,removable"
	fi
	if ! add_export "$_ar_path" "$_ar_label" "$_ar_mode"; then
		record_skip "$_ar_path" "exceeds the 16 storage limit"
	fi
	return 0
}

build_exports() {
	rm -f "$EXPORTS" "$RUN/truncated" "$RUN/skipped"
	: > "$EXPORTS"
	add_mount_root "$STORAGE" "ZLYME" 1 || return 1
	if listed_in_libraries "$SD2"; then
		add_mount_root "$SD2" "SD Card" 0 || return 1
	fi
	if [ -r "$LIBS" ]; then
		while IFS= read -r _line || [ -n "$_line" ]; do
			[ -n "$_line" ] || continue
			[ "$_line" = "$STORAGE" ] && continue
			[ "$_line" = "$SD2" ] && continue
			case "$_line" in
				"$MEDIA"/*/*|"$MEDIA") continue ;;
				"$MEDIA"/*) ;;
				*) continue ;;
			esac
			_label=$(volume_label "$_line")
			add_mount_root "$_line" "$_label" 0 || return 1
		done < "$LIBS"
	fi
	if [ ! -s "$EXPORTS" ]; then
		say "no exportable storage"
		return 1
	fi
}

write_conf() {
	case "$FFS" in
		/|/boot|/boot/*|/storage|/storage/*) say "refusing FunctionFS path $FFS"; return 1 ;;
	esac
	_tmp=$RUN/umtprd.conf.tmp
	{
		printf '%s\n' "loop_on_disconnect 1"
		printf '%s\n' "sync_when_close 0x1"
		printf '%s\n' 'manufacturer "Zlyme"'
		printf '%s\n' 'product "Zlyme File Transfer"'
		printf '%s\n' 'serial "zlyme"'
		printf '%s\n' 'firmware_version "Zlyme"'
		printf '%s\n' 'mtp_extensions ""'
		printf '%s\n' 'interface "MTP"'
		# Linux Foundation PTP gadget. Shared with other uMTP devices.
		# Not a Miyoo, Rockchip, or Zlyme-assigned id.
		printf '%s\n' "usb_vendor_id 0x1D6B"
		printf '%s\n' "usb_product_id 0x0100"
		printf '%s\n' "usb_class 0x6"
		printf '%s\n' "usb_subclass 0x1"
		printf '%s\n' "usb_protocol 0x1"
		printf '%s\n' "usb_dev_version 0x3008"
		printf '%s\n' "usb_functionfs_mode 0x1"
		printf '%s\n' "usb_dev_path \"$FFS/ep0\""
		printf '%s\n' "usb_epin_path \"$FFS/ep1\""
		printf '%s\n' "usb_epout_path \"$FFS/ep2\""
		printf '%s\n' "usb_epint_path \"$FFS/ep3\""
		printf '%s\n' "usb_max_packet_size 0x200"
	} > "$_tmp" || return 1
	while IFS='	' read -r _path _name _mode; do
		[ -n "$_path" ] || continue
		case "$_path" in
			/dev|/dev/*)
				say "refusing block or device path $_path"
				rm -f "$_tmp"
				return 1
				;;
		esac
		if path_forbidden "$_path"; then
			say "refusing private path $_path"
			rm -f "$_tmp"
			return 1
		fi
		case "$_mode" in
			rw|ro|rw,removable|ro,removable) ;;
			*)
				say "refusing storage access $_mode"
				rm -f "$_tmp"
				return 1
				;;
		esac
		printf 'storage "%s" "%s" "%s"\n' "$_path" "$_name" "$_mode" >> "$_tmp"
	done < "$EXPORTS"
	mv -f "$_tmp" "$CONF"
}

write_attr() {
	_file=$1
	_val=$2
	if [ ! -e "$_file" ]; then
		if [ "${ZLYME_USB_TEST_LAYOUT:-}" != 1 ]; then
			say "missing gadget attribute $_file"
			return 1
		fi
		mkdir -p "$(dirname "$_file")" || return 1
		: > "$_file" || return 1
	fi
	printf '%s\n' "$_val" > "$_file"
}

materialize_test_gadget() {
	[ "${ZLYME_USB_TEST_LAYOUT:-}" = 1 ] || return 0
	for _f in bcdUSB bDeviceClass bDeviceSubClass bDeviceProtocol \
		idVendor idProduct bcdDevice max_speed UDC; do
		[ -e "$GADGET/$_f" ] || : > "$GADGET/$_f"
	done
	mkdir -p "$GADGET/strings/0x409" \
		"$GADGET/configs/c.1/strings/0x409" \
		"$GADGET/functions"
	for _f in manufacturer product serialnumber; do
		[ -e "$GADGET/strings/0x409/$_f" ] || : > "$GADGET/strings/0x409/$_f"
	done
	for _f in bmAttributes MaxPower; do
		[ -e "$GADGET/configs/c.1/$_f" ] || : > "$GADGET/configs/c.1/$_f"
	done
	[ -e "$GADGET/configs/c.1/strings/0x409/configuration" ] || \
		: > "$GADGET/configs/c.1/strings/0x409/configuration"
}

make_gadget() {
	if [ ! -d "$CONFIGFS/usb_gadget" ]; then
		say "configfs usb_gadget is not available"
		return 1
	fi
	mkdir -p "$GADGET" || {
		say "cannot create gadget $GADGET_NAME"
		return 1
	}
	materialize_test_gadget || return 1
	# uMTP FunctionFS descriptors are full and high speed. A SuperSpeed
	# UDC with no SuperSpeed configuration stalls the host at address.
	write_attr "$GADGET/max_speed" "high-speed" || return 1
	write_attr "$GADGET/bcdUSB" "0x0200" || return 1
	write_attr "$GADGET/bDeviceClass" "0x00" || return 1
	write_attr "$GADGET/bDeviceSubClass" "0x00" || return 1
	write_attr "$GADGET/bDeviceProtocol" "0x00" || return 1
	write_attr "$GADGET/idVendor" "0x1d6b" || return 1
	write_attr "$GADGET/idProduct" "0x0100" || return 1
	write_attr "$GADGET/bcdDevice" "0x0100" || return 1
	mkdir -p "$GADGET/strings/0x409" || return 1
	materialize_test_gadget || return 1
	write_attr "$GADGET/strings/0x409/manufacturer" "Zlyme" || return 1
	write_attr "$GADGET/strings/0x409/product" "Zlyme File Transfer" || return 1
	write_attr "$GADGET/strings/0x409/serialnumber" "zlyme" || return 1
	mkdir -p "$GADGET/configs/c.1/strings/0x409" || return 1
	materialize_test_gadget || return 1
	# Self-powered. MaxPower is milliamps on Linux 7.0.2 (2 mA here).
	# Charging stays on the RK817 path. This does not switch VBUS.
	write_attr "$GADGET/configs/c.1/bmAttributes" "0xC0" || return 1
	write_attr "$GADGET/configs/c.1/MaxPower" "2" || return 1
	write_attr "$GADGET/configs/c.1/strings/0x409/configuration" "MTP" || return 1
	mkdir -p "$GADGET/functions/ffs.mtp" || return 1
	if [ ! -L "$GADGET/configs/c.1/ffs.mtp" ] && [ ! -e "$GADGET/configs/c.1/ffs.mtp" ]; then
		ln -s "$GADGET/functions/ffs.mtp" "$GADGET/configs/c.1/ffs.mtp" || return 1
	fi
}

other_gadget() {
	_og=$CONFIGFS/usb_gadget
	[ -d "$_og" ] || return 1
	for _og_d in "$_og"/*; do
		[ -d "$_og_d" ] || continue
		[ "${_og_d##*/}" = "$GADGET_NAME" ] && continue
		return 0
	done
	return 1
}

other_configfs() {
	[ -r "$MOUNTS" ] || return 1
	while read -r _oc_dev _oc_mp _oc_type _oc_rest; do
		[ "$_oc_type" = configfs ] || continue
		_oc_mp=$(decode_mount "$_oc_mp")
		[ "$_oc_mp" = "$CONFIGFS" ] && continue
		return 0
	done < "$MOUNTS"
	return 1
}

# Mount configfs only for this start. An existing configfs mount is reused
# and is not marked as ours. A different filesystem already at this path
# is left in place.
ensure_configfs() {
	if exact_mount "$CONFIGFS"; then
		if [ "$EXACT_TYPE" != configfs ]; then
			say "configfs path $CONFIGFS is mounted as $EXACT_TYPE, not configfs"
			return 1
		fi
		return 0
	fi
	if [ -e "$CONFIGFS" ] && [ ! -d "$CONFIGFS" ]; then
		say "configfs path $CONFIGFS is not a directory"
		return 1
	fi
	if [ ! -d "$CONFIGFS" ]; then
		say "configfs path $CONFIGFS does not exist"
		return 1
	fi
	"$MOUNT" -t configfs configfs "$CONFIGFS" || {
		say "configfs mount failed"
		return 1
	}
	if ! exact_mount "$CONFIGFS" || [ "$EXACT_TYPE" != configfs ]; then
		say "configfs mount is not in the mount table"
		return 1
	fi
	: > "$RUN/configfs-mounted-by-us"
}

# Unmount only a configfs this session mounted, and only when nothing else
# is using it. Leaving it mounted is not an active gadget.
release_configfs() {
	[ -f "$RUN/configfs-mounted-by-us" ] || return 0
	if [ -d "$GADGET" ] || other_gadget || nested_mount "$CONFIGFS" || other_configfs; then
		return 0
	fi
	if ! exact_mount "$CONFIGFS"; then
		rm -f "$RUN/configfs-mounted-by-us"
		return 0
	fi
	if [ "$EXACT_TYPE" != configfs ]; then
		return 0
	fi
	"$UMOUNT" "$CONFIGFS" || true
	if exact_mount "$CONFIGFS"; then
		return 0
	fi
	rm -f "$RUN/configfs-mounted-by-us"
}

mount_ffs() {
	mkdir -p "$FFS" || return 1
	if mounts_has "$FFS"; then
		return 0
	fi
	"$MOUNT" -t functionfs mtp "$FFS" || {
		say "FunctionFS mount failed"
		return 1
	}
	if ! mounts_has "$FFS"; then
		say "FunctionFS mount is not in the mount table"
		return 1
	fi
}

pid_is_ours() {
	_pid=$1
	case "$_pid" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ -r "/proc/$_pid/cmdline" ] || return 1
	_cmd=$(2>/dev/null tr '\000' ' ' < "/proc/$_pid/cmdline") || return 1
	# Parse in a subshell so set -- does not replace this script's arguments.
	_ok=$(
		set -f
		# shellcheck disable=SC2086
		set -- $_cmd
		set +f
		_saw=
		while [ $# -gt 0 ]; do
			if [ "$1" = "$UMTPRD" ]; then
				_saw=1
			elif [ "$_saw" = 1 ] && [ "$1" = "-conf" ]; then
				if [ "${2:-}" = "$CONF" ]; then
					printf '%s\n' yes
				fi
				break
			fi
			shift
		done
	)
	[ "$_ok" = yes ]
}

read_pid() {
	_pid=
	[ -r "$PIDFILE" ] || return 1
	read -r _pid < "$PIDFILE" || return 1
	printf '%s\n' "$_pid"
}

spawn_responder() {
	if [ ! -x "$UMTPRD" ]; then
		say "umtprd is not executable ($UMTPRD)"
		return 1
	fi
	: > "$RUN/umtprd.log"
	# Close the lifecycle lock in the child. Otherwise the responder
	# inherits fd 9 and the next start/stop/status waits on flock forever.
	# The jail program reads these from the environment. The defaults
	# above are not exported unless a caller set them.
	export ZLYME_USB_RUN="$RUN"
	export ZLYME_USB_FFS="$FFS"
	export ZLYME_USB_UMTPRD="$UMTPRD"
	if [ "$JAIL" = 1 ]; then
		if [ ! -x "$ENTER" ]; then
			say "usb jail is not installed ($ENTER)"
			return 1
		fi
		"$ENTER" >> "$RUN/umtprd.log" 2>&1 9>&- < /dev/null &
	else
		"$UMTPRD" -conf "$CONF" >> "$RUN/umtprd.log" 2>&1 9>&- < /dev/null &
	fi
	_pid=$!
	printf '%s\n' "$_pid" > "$PIDFILE"
	# exec is not instant. Wait on the clock, not a tight spin, and do not
	# treat the child as ready until its cmdline is this umtprd and conf.
	_i=0
	while [ "$_i" -lt "$SPAWN_POLLS" ]; do
		if pid_is_ours "$_pid"; then
			return 0
		fi
		if ! pid_alive "$_pid"; then
			say "responder exited immediately"
			return 1
		fi
		_i=$((_i + 1))
		if [ "$_i" -lt "$SPAWN_POLLS" ] && [ "$SPAWN_SLEEP" != 0 ]; then
			sleep "$SPAWN_SLEEP" || true
		fi
	done
	say "responder pid $_pid is not the umtprd we started"
	return 1
}

reaper_alive() {
	_ra_pid=
	[ -r "$RUN/reaper.pid" ] || return 1
	read -r _ra_pid < "$RUN/reaper.pid" || return 1
	case "$_ra_pid" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ -r "/proc/$_ra_pid/cmdline" ] || return 1
	_ra_cmd=$(2>/dev/null tr '\000' ' ' < "/proc/$_ra_pid/cmdline") || return 1
	case "$_ra_cmd" in
		*"$0"*" reap "*) return 0 ;;
		*) return 1 ;;
	esac
}

# BusyBox 1.38 setsid calls setsid() and, when that fails because the
# caller is already a process-group leader, forks so the child can
# create the session. The rootfs applet is /usr/bin/setsid. The initramfs
# busybox does not have it; this helper does not run there.
# fd 9 is the lifecycle lock. The reaper must not inherit it.
spawn_reaper() {
	_sr_pgrp=$(proc_stat $$ 3) || {
		say "cannot read process group"
		return 1
	}
	case "$_sr_pgrp" in
		''|*[!0-9]*|0|1)
			say "refusing to watch process group ${_sr_pgrp:-empty}"
			return 1
			;;
	esac
	if reaper_alive; then
		_sr_watch=
		if [ -r "$RUN/reaper.watch" ]; then
			read -r _sr_watch < "$RUN/reaper.watch" || _sr_watch=
		fi
		if [ "$_sr_watch" = "$_sr_pgrp" ]; then
			return 0
		fi
	fi
	if ! command -v setsid >/dev/null 2>&1; then
		say "setsid is not available"
		return 1
	fi
	_sr_start=$(proc_stat "$_sr_pgrp" 20) || {
		say "cannot read process group leader $_sr_pgrp"
		return 1
	}
	_sr_gen=$(proc_stat $$ 20).$$
	printf '%s\n' "$_sr_gen" > "$RUN/generation" || return 1
	rm -f "$RUN/reaper.pid" "$RUN/reaper.pgid" "$RUN/reaper.watch"
	# shellcheck disable=SC2094
	setsid "$0" reap "$_sr_pgrp" "$_sr_start" "$_sr_gen" \
		>> "$RUN/reaper.log" 2>&1 9>&- < /dev/null &
	_i=0
	while [ "$_i" -lt 30 ]; do
		if [ -r "$RUN/reaper.pgid" ]; then
			_sr_pg=
			read -r _sr_pg < "$RUN/reaper.pgid" || true
			if [ -n "$_sr_pg" ] && [ "$_sr_pg" != "$_sr_pgrp" ]; then
				return 0
			fi
		fi
		if [ -r "$RUN/reaper.pid" ]; then
			_sr_rp=
			read -r _sr_rp < "$RUN/reaper.pid" || true
			if [ -n "$_sr_rp" ] && ! pid_alive "$_sr_rp"; then
				say "usb transfer cleanup process exited"
				return 1
			fi
		fi
		_i=$((_i + 1))
		if [ "$REAP_WAIT" != 0 ]; then
			sleep "$REAP_WAIT" || true
		fi
	done
	say "usb transfer cleanup process did not leave the session"
	return 1
}

cmd_reap() {
	_watch=$1
	_start=$2
	_gen=$3
	case "$_watch" in
		''|*[!0-9]*|0|1) exit 1 ;;
	esac
	trap '' HUP
	printf '%s\n' "$$" > "$RUN/reaper.pid"
	printf '%s\n' "$_watch" > "$RUN/reaper.watch"
	_pg=$(proc_stat $$ 3) || exit 1
	printf '%s\n' "$_pg" > "$RUN/reaper.pgid"
	if [ "$_pg" = "$_watch" ]; then
		say "cleanup process stayed in the pak process group"
		exit 1
	fi
	while :; do
		_now=$(proc_stat "$_watch" 20 || true)
		if [ -z "$_now" ] || [ "$_now" != "$_start" ]; then
			break
		fi
		sleep "$REAP_SLEEP" || true
	done
	lock_session || exit 1
	_now=$(cat "$RUN/generation" 2>/dev/null || true)
	if [ "$_now" != "$_gen" ]; then
		exit 0
	fi
	cleanup_owned
	exit $?
}

wait_ready() {
	_pid=$(read_pid || true)
	_i=0
	while [ "$_i" -lt "$READY_POLLS" ]; do
		if [ -e "$FFS/ep1" ] && [ -e "$FFS/ep2" ] && [ -e "$FFS/ep3" ]; then
			return 0
		fi
		if [ -z "$_pid" ] || ! pid_is_ours "$_pid"; then
			say "responder exited before FunctionFS endpoints were ready"
			return 1
		fi
		_i=$((_i + 1))
		if [ "$_i" -lt "$READY_POLLS" ] && [ "$READY_SLEEP" != 0 ]; then
			sleep "$READY_SLEEP" || true
		fi
	done
	say "FunctionFS endpoints were not ready"
	return 1
}

udc_present() {
	[ -n "$UDC_NAME" ] || return 1
	[ -d "$UDC_CLASS/$UDC_NAME" ]
}

foreign_owner() {
	_g=$CONFIGFS/usb_gadget
	[ -d "$_g" ] || return 1
	for _u in "$_g"/*/UDC; do
		[ -f "$_u" ] || continue
		_val=$(trim "$(cat "$_u" 2>/dev/null || true)")
		[ "$_val" = "$UDC_NAME" ] || continue
		_name=${_u%/UDC}
		_name=${_name##*/}
		[ "$_name" = "$GADGET_NAME" ] && continue
		printf '%s\n' "$_name"
		return 0
	done
	return 1
}

list_udcs() {
	[ -d "$UDC_CLASS" ] || return 0
	for _d in "$UDC_CLASS"/*; do
		[ -d "$_d" ] || continue
		printf '%s\n' "${_d##*/}"
	done
}

explain_missing_udc() {
	_seen=
	_n=0
	while IFS= read -r _name; do
		[ -n "$_name" ] || continue
		_n=$((_n + 1))
		if [ -z "$_seen" ]; then
			_seen=$_name
		else
			_seen="$_seen $_name"
		fi
	done <<EOF
$(list_udcs)
EOF
	if [ -z "$UDC_NAME" ]; then
		say "lower USB-C controller name is unset"
		return 1
	fi
	if [ "$_n" -eq 0 ]; then
		say "no UDC is registered. The lower USB-C controller $UDC_NAME is not available. USB OTG in Settings disables the upper host port and does not enable this gadget. No boot setting was changed."
		return 1
	fi
	if [ "$_n" -gt 1 ]; then
		say "ambiguous UDC list ($_seen). The lower USB-C controller $UDC_NAME is not among them. None were bound."
		return 1
	fi
	say "lower USB-C controller $UDC_NAME is not available. Saw $_seen, which is not that controller. It was left alone."
	return 1
}

bind_udc() {
	if ! udc_present; then
		explain_missing_udc
		return 1
	fi
	_owner=$(foreign_owner || true)
	if [ -n "$_owner" ]; then
		say "UDC $UDC_NAME is owned by gadget $_owner. It was left alone."
		return 1
	fi
	printf '%s\n' "$UDC_NAME" > "$GADGET/UDC" || {
		say "failed to bind $UDC_NAME"
		return 1
	}
	_got=$(trim "$(cat "$GADGET/UDC" 2>/dev/null || true)")
	if [ "$_got" != "$UDC_NAME" ]; then
		say "UDC bind did not stick (wanted $UDC_NAME, have ${_got:-empty})"
		return 1
	fi
}

our_udc_bound() {
	[ -f "$GADGET/UDC" ] || return 1
	_got=$(trim "$(cat "$GADGET/UDC" 2>/dev/null || true)")
	[ -n "$_got" ] && [ "$_got" = "$UDC_NAME" ]
}

unbind_udc() {
	[ -f "$GADGET/UDC" ] || return 0
	_got=$(trim "$(cat "$GADGET/UDC" 2>/dev/null || true)")
	[ -n "$_got" ] || return 0
	printf '%s\n' "" > "$GADGET/UDC" || return 1
	_got=$(trim "$(cat "$GADGET/UDC" 2>/dev/null || true)")
	[ -z "$_got" ]
}

# Lower-port PHY extcon for this UDC. SDP and CDP are data-capable.
# DCP, USB-HOST, and the RK817 charger type are not.
extcon_dir() {
	if [ -n "${ZLYME_USB_EXTCON:-}" ]; then
		[ -d "$ZLYME_USB_EXTCON" ] || return 1
		printf '%s\n' "$ZLYME_USB_EXTCON"
		return 0
	fi
	_plat=${ZLYME_USB_PLATFORM:-/sys/devices/platform/$UDC_NAME}
	_found=
	for _s in "$_plat"/supplier:platform:*usb2phy; do
		[ -e "$_s" ] || continue
		_phy=${_s##*supplier:platform:}
		_ext=/sys/devices/platform/$_phy/extcon
		[ -d "$_ext" ] || continue
		for _e in "$_ext"/*; do
			[ -d "$_e" ] || continue
			_found=$_e
			break
		done
		[ -n "$_found" ] && break
	done
	[ -n "$_found" ] || return 1
	printf '%s\n' "$_found"
}

cable_is_one() {
	_cd=$1
	_want=$2
	_c=
	for _c in "$_cd"/cable.*; do
		[ -e "$_c/name" ] || continue
		[ "$(trim "$(cat "$_c/name" 2>/dev/null || true)")" = "$_want" ] || continue
		[ "$(trim "$(cat "$_c/state" 2>/dev/null || true)")" = 1 ]
		return
	done
	return 1
}

data_cable() {
	_cd=$(extcon_dir) || return 1
	cable_is_one "$_cd" SDP && return 0
	cable_is_one "$_cd" CDP && return 0
	return 1
}

# control: EP0 is enabled. failed: this bind logged the enable error,
# or debugfs does not say control. unknown: no evidence either way.
ep0_state() {
	if [ -n "${ZLYME_USB_EP0:-}" ]; then
		printf '%s\n' "$ZLYME_USB_EP0"
		return 0
	fi
	_ef=${ZLYME_USB_EP0_FILE:-/sys/kernel/debug/usb/$UDC_NAME/ep0out/transfer_type}
	if [ -r "$_ef" ]; then
		_et=$(tr -d '[:space:]' < "$_ef" || true)
		case "$_et" in
			*control*) printf '%s\n' control ;;
			*) printf '%s\n' failed ;;
		esac
		return 0
	fi
	if [ -n "${ZLYME_USB_DMESG+x}" ]; then
		if [ -r "${ZLYME_USB_DMESG:-}" ] && grep -q "${UDC_NAME}: failed to enable ep0out" "$ZLYME_USB_DMESG"; then
			printf '%s\n' failed
		else
			printf '%s\n' unknown
		fi
		return 0
	fi
	_mark=0
	if [ -r "$RUN/dmesg.lines" ]; then
		read -r _mark < "$RUN/dmesg.lines" || _mark=0
	fi
	case "$_mark" in
		''|*[!0-9]*) _mark=0 ;;
	esac
	if ! command -v dmesg >/dev/null 2>&1; then
		printf '%s\n' unknown
		return 0
	fi
	_hit=$(dmesg 2>/dev/null | awk -v n="$_mark" -v u="$UDC_NAME" 'NR > n && index($0, u ": failed to enable ep0out") { print; exit }' || true)
	if [ -n "$_hit" ]; then
		printf '%s\n' failed
	else
		printf '%s\n' unknown
	fi
}

mark_dmesg() {
	if [ -n "${ZLYME_USB_DMESG+x}" ]; then
		return 0
	fi
	_n=$(dmesg 2>/dev/null | wc -l) || _n=0
	case "$_n" in
		''|*[!0-9]*) _n=0 ;;
	esac
	printf '%s\n' "$_n" > "$RUN/dmesg.lines"
}

latch_get() {
	_lg=
	[ -r "$RUN/link.latch" ] || return 0
	read -r _lg < "$RUN/link.latch" || true
	printf '%s\n' "$_lg"
}

latch_set() {
	printf '%s\n' "$1" > "$RUN/link.latch"
}

note_link() {
	if [ -s "$RUN/link.err" ]; then
		return 0
	fi
	printf '%s\n' "$1" > "$RUN/link.err"
	printf '%s\n' "$1" >> "$RUN/link.log"
	say "$1"
}

# One write. A missing or refusing soft_connect is recorded once.
soft_write() {
	_sw=$1
	_sp=$UDC_CLASS/$UDC_NAME/soft_connect
	if [ ! -e "$_sp" ]; then
		note_link "soft_connect is not available on $UDC_NAME"
		return 1
	fi
	if [ ! -w "$_sp" ]; then
		note_link "soft_connect on $UDC_NAME is not writable"
		return 1
	fi
	if ! printf '%s\n' "$_sw" > "$_sp"; then
		note_link "soft_connect $_sw failed on $UDC_NAME"
		return 1
	fi
	printf '%s\n' "$_sw" >> "$RUN/link.writes"
}

# Decide once. Duplicate cable notifications do not write again.
# A control endpoint is not reset. Connecting from a failed enable
# disconnects first, because a connect while pull-ups are already on
# does not re-run endpoint setup.
link_once() {
	our_udc_bound || return 0
	_fo=$(foreign_owner || true)
	if [ -n "$_fo" ]; then
		return 0
	fi
	if ! extcon_dir >/dev/null; then
		note_link "lower PHY extcon for $UDC_NAME was not found"
		return 0
	fi
	_ep=$(ep0_state)
	if [ "$_ep" = control ]; then
		latch_set healthy
		return 0
	fi
	if data_cable; then
		_want=connect
	else
		_want=disconnect
	fi
	_last=$(latch_get)
	if [ "$_last" = "$_want" ] || [ "$_last" = "${_want}-failed" ]; then
		return 0
	fi
	if [ "$_want" = connect ] && [ "$_ep" = failed ] && [ "$_last" != disconnect ]; then
		if ! soft_write disconnect; then
			latch_set connect-failed
			return 0
		fi
		if ! soft_write connect; then
			latch_set connect-failed
			return 0
		fi
		latch_set connect
		return 0
	fi
	if [ "$_want" = connect ] && [ "$_ep" != failed ] && [ "$_last" != disconnect ]; then
		latch_set connect
		return 0
	fi
	if ! soft_write "$_want"; then
		latch_set "${_want}-failed"
		return 0
	fi
	latch_set "$_want"
}

link_pid_ours() {
	_lp=$1
	case "$_lp" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ -r "/proc/$_lp/cmdline" ] || return 1
	_lc=$(2>/dev/null tr '\000' ' ' < "/proc/$_lp/cmdline") || return 1
	# tr turns the trailing NUL into a space, so the last argument
	# is followed by a space. "link-once" does not match " link ".
	case "$_lc" in
		*"$0 link "*) return 0 ;;
		*) return 1 ;;
	esac
}

stop_link() {
	_lp=
	[ -r "$RUN/link.pid" ] || return 0
	read -r _lp < "$RUN/link.pid" || true
	if link_pid_ours "$_lp"; then
		signal_pid TERM "$_lp" || true
		_i=0
		while [ "$_i" -lt "$KILL_POLLS" ]; do
			link_pid_ours "$_lp" || break
			_i=$((_i + 1))
			if [ "$_i" -lt "$KILL_POLLS" ] && [ "$KILL_SLEEP" != 0 ]; then
				sleep "$KILL_SLEEP" || true
			fi
		done
		if link_pid_ours "$_lp"; then
			signal_pid KILL "$_lp" || true
		fi
	fi
	rm -f "$RUN/link.pid"
}

spawn_link() {
	[ "$LINK" = 1 ] || return 0
	stop_link
	: > "$RUN/link.log"
	link_once
	if link_pid_ours "$(cat "$RUN/link.pid" 2>/dev/null || true)"; then
		return 0
	fi
	_gen=$(cat "$RUN/generation" 2>/dev/null || true)
	printf '%s\n' "$_gen" > "$RUN/link.gen" || return 1
	# Same process group as the PAK, so MENU+START kills it with the
	# group. stop kills it on a normal exit. fd 9 is the lifecycle lock.
	"$0" link >> "$RUN/link.log" 2>&1 9>&- < /dev/null &
	printf '%s\n' "$!" > "$RUN/link.pid"
}

cmd_link() {
	while :; do
		lock_session || exit 0
		if ! our_udc_bound; then
			exit 0
		fi
		_now=$(cat "$RUN/generation" 2>/dev/null || true)
		_own=$(cat "$RUN/link.gen" 2>/dev/null || true)
		if [ -z "$_own" ] || [ "$_now" != "$_own" ]; then
			exit 0
		fi
		link_once
		exec 9>&-
		sleep "$LINK_SLEEP" || exit 0
	done
}

cmd_link_once() {
	lock_session || return 1
	link_once
}

# True while the pid is still the responder we started, or still our child.
ours_or_child() {
	_oc_pid=$1
	pid_is_ours "$_oc_pid" && return 0
	_oc_pp=$(ppid_of "$_oc_pid" || true)
	[ "$_oc_pp" = "$$" ]
}

wait_owned_gone() {
	_pid=$1
	_i=0
	while [ "$_i" -lt "$KILL_POLLS" ]; do
		ours_or_child "$_pid" || return 0
		_i=$((_i + 1))
		if [ "$_i" -lt "$KILL_POLLS" ] && [ "$KILL_SLEEP" != 0 ]; then
			sleep "$KILL_SLEEP" || true
		fi
	done
	ours_or_child "$_pid" && return 1
	return 0
}

signal_down() {
	_pid=$1
	signal_pid TERM "$_pid" || true
	if wait_owned_gone "$_pid"; then
		return 0
	fi
	if ours_or_child "$_pid"; then
		signal_pid KILL "$_pid" || true
	fi
	wait_owned_gone "$_pid"
}

kill_owned() {
	_pid=$(read_pid || true)
	if [ -z "$_pid" ]; then
		rm -f "$PIDFILE"
		return 0
	fi
	if ! ours_or_child "$_pid"; then
		rm -f "$PIDFILE"
		return 0
	fi
	if signal_down "$_pid"; then
		rm -f "$PIDFILE"
		return 0
	fi
	say "owned responder $_pid is still running"
	return 1
}

umount_ffs() {
	if ! mounts_has "$FFS"; then
		return 0
	fi
	"$UMOUNT" "$FFS" || return 1
	if mounts_has "$FFS"; then
		say "FunctionFS is still mounted"
		return 1
	fi
}

remove_gadget() {
	[ -d "$GADGET" ] || return 0
	rm -f "$GADGET/configs/c.1/ffs.mtp"
	if [ "${ZLYME_USB_TEST_LAYOUT:-}" = 1 ]; then
		rm -f "$GADGET/bcdUSB" "$GADGET/bDeviceClass" \
			"$GADGET/bDeviceSubClass" "$GADGET/bDeviceProtocol" \
			"$GADGET/idVendor" "$GADGET/idProduct" "$GADGET/bcdDevice" \
			"$GADGET/max_speed" "$GADGET/UDC" \
			"$GADGET/strings/0x409/manufacturer" \
			"$GADGET/strings/0x409/product" \
			"$GADGET/strings/0x409/serialnumber" \
			"$GADGET/configs/c.1/bmAttributes" \
			"$GADGET/configs/c.1/MaxPower" \
			"$GADGET/configs/c.1/strings/0x409/configuration"
	fi
	rmdir "$GADGET/configs/c.1/strings/0x409" 2>/dev/null || true
	rmdir "$GADGET/configs/c.1/strings" 2>/dev/null || true
	rmdir "$GADGET/configs/c.1" 2>/dev/null || true
	rmdir "$GADGET/configs" 2>/dev/null || true
	rmdir "$GADGET/functions/ffs.mtp" 2>/dev/null || true
	rmdir "$GADGET/functions" 2>/dev/null || true
	rmdir "$GADGET/strings/0x409" 2>/dev/null || true
	rmdir "$GADGET/strings" 2>/dev/null || true
	rmdir "$GADGET" 2>/dev/null || true
	if [ -d "$GADGET" ]; then
		say "gadget $GADGET_NAME is still present"
		return 1
	fi
}

session_left() {
	[ -d "$GADGET" ] && return 0
	mounts_has "$FFS" && return 0
	_pid=$(read_pid || true)
	if [ -n "$_pid" ] && pid_is_ours "$_pid"; then
		return 0
	fi
	return 1
}

cleanup_owned() {
	_fail=0
	_keep_owner=0
	stop_link
	unbind_udc || _fail=1
	if ! kill_owned; then
		_fail=1
		_keep_owner=1
	fi
	umount_ffs || _fail=1
	remove_gadget || _fail=1
	release_configfs || true
	# generation stays. The reaper compares it after this process is gone.
	# Deleting it here would make that reaper skip a half-built gadget.
	if [ "$_keep_owner" = 1 ]; then
		rm -f "$EXPORTS" "$RUN/truncated" "$RUN/umtprd.log" "$RUN/skipped" \
			"$RUN/link.gen" "$RUN/link.latch" "$RUN/link.writes" \
			"$RUN/link.err" "$RUN/link.log" "$RUN/dmesg.lines"
	else
		rm -f "$CONF" "$CONF.tmp" "$PIDFILE" "$EXPORTS" \
			"$RUN/truncated" "$RUN/umtprd.log" "$RUN/skipped" \
			"$RUN/link.gen" "$RUN/link.latch" "$RUN/link.writes" \
			"$RUN/link.err" "$RUN/link.log" "$RUN/dmesg.lines"
	fi
	if session_left || [ "$_keep_owner" = 1 ]; then
		say "usb transfer cleanup incomplete"
		return 1
	fi
	[ "$_fail" -eq 0 ]
}

healthy() {
	our_udc_bound || return 1
	mounts_has "$FFS" || return 1
	[ -s "$CONF" ] || return 1
	_pid=$(read_pid || true)
	[ -n "$_pid" ] || return 1
	pid_is_ours "$_pid" || return 1
	[ -e "$FFS/ep1" ] && [ -e "$FFS/ep2" ] && [ -e "$FFS/ep3" ]
}

on_signal() {
	say "interrupted"
	cleanup_owned || true
	exit 143
}

cmd_start() {
	lock_session || return 1
	trap on_signal INT TERM
	if [ -z "$UDC_NAME" ]; then
		say "lower USB-C controller name is unset"
		trap - INT TERM
		return 1
	fi
	if [ "$JAIL" = 1 ] && [ ! -x "$ENTER" ]; then
		say "usb jail is not installed ($ENTER)"
		trap - INT TERM
		return 1
	fi
	if [ -e "$STORAGE/.update/reconstruct" ] || [ -e "$STORAGE/.update/pending/zlyme" ]; then
		say "an update is staged; file transfer waits until it finishes"
		trap - INT TERM
		return 1
	fi
	# The reaper is outside this process group before any gadget exists.
	# MENU+START SIGKILLs the group after 1.5s. The reaper is not in it.
	if ! spawn_reaper; then
		trap - INT TERM
		return 1
	fi
	if healthy; then
		trap - INT TERM
		return 0
	fi
	cleanup_owned || {
		trap - INT TERM
		return 1
	}
	_owner=$(foreign_owner || true)
	if [ -n "$_owner" ]; then
		say "UDC $UDC_NAME is owned by gadget $_owner. It was left alone."
		trap - INT TERM
		return 1
	fi
	if ! udc_present; then
		explain_missing_udc
		trap - INT TERM
		return 1
	fi
	if ! build_exports; then
		cleanup_owned || true
		trap - INT TERM
		return 1
	fi
	if ! write_conf; then
		cleanup_owned || true
		trap - INT TERM
		return 1
	fi
	if ! ensure_configfs; then
		cleanup_owned || true
		trap - INT TERM
		return 1
	fi
	_owner=$(foreign_owner || true)
	if [ -n "$_owner" ]; then
		say "UDC $UDC_NAME is owned by gadget $_owner. It was left alone."
		cleanup_owned || true
		trap - INT TERM
		return 1
	fi
	if ! make_gadget; then
		say "gadget setup failed"
		cleanup_owned || true
		trap - INT TERM
		return 1
	fi
	if ! mount_ffs; then
		cleanup_owned || true
		trap - INT TERM
		return 1
	fi
	if ! spawn_responder; then
		cleanup_owned || true
		trap - INT TERM
		return 1
	fi
	if ! wait_ready; then
		cleanup_owned || true
		trap - INT TERM
		return 1
	fi
	mark_dmesg
	if ! bind_udc; then
		cleanup_owned || true
		trap - INT TERM
		return 1
	fi
	if ! spawn_link; then
		say "usb link watcher did not start"
		cleanup_owned || true
		trap - INT TERM
		return 1
	fi
	trap - INT TERM
	return 0
}

host_state() {
	if ! our_udc_bound; then
		printf '%s\n' "unbound"
		return 0
	fi
	_sf=$UDC_CLASS/$UDC_NAME/state
	if [ ! -r "$_sf" ]; then
		printf '%s\n' "unknown"
		return 0
	fi
	trim "$(cat "$_sf")"
}

cmd_status() {
	lock_session || return 1
	if ! session_left && ! our_udc_bound; then
		printf '%s\n' "state=off"
		return 0
	fi
	_pid=$(read_pid || true)
	_responder=0
	if [ -n "$_pid" ] && pid_is_ours "$_pid"; then
		_responder=1
	fi
	if our_udc_bound; then
		printf '%s\n' "state=bound"
	elif [ -d "$GADGET" ] || mounts_has "$FFS" || [ "$_responder" = 1 ]; then
		printf '%s\n' "state=partial"
	else
		printf '%s\n' "state=off"
	fi
	printf 'udc=%s\n' "$UDC_NAME"
	printf 'gadget=%s\n' "$GADGET_NAME"
	if [ "$_responder" = 1 ]; then
		printf '%s\n' "responder=running"
	else
		printf '%s\n' "responder=stopped"
	fi
	printf 'host=%s\n' "$(host_state)"
	if [ -s "$RUN/link.err" ]; then
		printf 'link=%s\n' "$(head -n 1 "$RUN/link.err")"
	fi
	if [ -f "$EXPORTS" ]; then
		while IFS='	' read -r _path _name _mode; do
			[ -n "$_path" ] || continue
			printf 'export=%s\n' "$_path"
			printf 'export_name=%s\n' "$_name"
			printf 'export_access=%s\n' "${_mode%%,*}"
		done < "$EXPORTS"
	fi
	if [ -f "$RUN/truncated" ]; then
		printf '%s\n' "truncated=1"
	fi
	if [ -s "$RUN/skipped" ]; then
		while IFS='	' read -r _path _why; do
			[ -n "$_path" ] || continue
			printf 'skipped=%s %s\n' "$_path" "$_why"
		done < "$RUN/skipped"
	fi
	return 0
}

cmd_stop() {
	lock_session || return 1
	stop_link
	if ! session_left; then
		rm -f "$PIDFILE" "$CONF" "$EXPORTS" "$RUN/truncated" "$RUN/generation" \
			"$RUN/link.gen" "$RUN/link.latch" "$RUN/link.writes" \
			"$RUN/link.err" "$RUN/link.log" "$RUN/dmesg.lines"
		return 0
	fi
	cleanup_owned
}

case "${1:-}" in
	start) cmd_start ;;
	stop) cmd_stop ;;
	status) cmd_status ;;
	reap) cmd_reap "${2:-}" "${3:-}" "${4:-}" ;;
	link) cmd_link ;;
	link-once) cmd_link_once ;;
	*)
		say "usage: zlyme-usb-transfer {start|stop|status}"
		exit 1
		;;
esac
