#!/bin/sh
# Fail-closed preloader recovery for the Miyoo Flip running Zlyme.
#
# Zlyme's kernel exports one SPI NAND partition, label "preloader",
# 0x0 size 0x200000 (board/my355/linux/dts/.../rk3566-miyoo-flip.dts).
# That is mtd0. Stock's apommel installer instead sees "spl" as mtd5
# because it runs on stock. This tool does not retarget mtd5.
#
# ZLYME_PRELOADER_TEST=1 reads a fixture tree at ZLYME_PRELOADER_ROOT
# and never opens a real /dev/mtd node. The Settings page does not set it.

set -eu

SIZE=2097152
ERASE=131072
WRITE=2048
OOB=64
MIN_BATTERY=25
# install.sh in the pinned apommel tree retries a write three times,
# then retries restoring the previous image three times.
WRITE_ATTEMPTS=3
IMAGE_PY=/usr/lib/zlyme/preloader_image.py
CURRENT=

TEST=${ZLYME_PRELOADER_TEST:-0}
ROOT=${ZLYME_PRELOADER_ROOT:-}

log() { printf 'zlyme-preloader: %s\n' "$*" >&2; }
die() { log "$*"; exit 1; }

if [ "$TEST" = 1 ]; then
	[ -n "$ROOT" ] && [ -d "$ROOT" ] || die "fixture root is missing"
	IMAGE_PY=${ZLYME_PRELOADER_IMAGE_PY:-$IMAGE_PY}
fi

p() {
	if [ "$TEST" = 1 ]; then
		printf '%s%s' "$ROOT" "$1"
	else
		printf '%s' "$1"
	fi
}

act() {
	if [ "$TEST" = 1 ]; then
		printf '%s\n' "$*" >> "$ROOT/actions.log"
	fi
}

need_tool() {
	command -v "$1" >/dev/null 2>&1 || die "missing $1"
}

read_text() {
	# Device-tree files are NUL-terminated.
	tr -d '\000' < "$(p "$1")"
}

identity() {
	conf=$(p /usr/share/zlyme/device.conf)
	[ -r "$conf" ] || die "device.conf is missing"
	# shellcheck disable=SC1090
	. "$conf"
	[ "${ZLYME_DEVICE_ID:-}" = "my355" ] || die "platform is not my355"
	model=$(read_text /proc/device-tree/model)
	[ "$model" = "Miyoo Flip" ] || die "model is not Miyoo Flip"
	comp=$(read_text /proc/device-tree/compatible | tr '\n' ' ')
	case "$comp" in
		*miyoo,flip*) ;;
		*) die "compatible does not include miyoo,flip" ;;
	esac
	case "$comp" in
		*rockchip,rk3566*) ;;
		*) die "compatible does not include rockchip,rk3566" ;;
	esac
}

# Prints the device node, /dev/mtd0, after the partition checks.
mtd_node() {
	table=$(p /proc/mtd)
	[ -r "$table" ] || die "no mtd table"
	# One data line. Header is "dev:".
	data=$(awk 'NR>1 && NF { print }' "$table")
	[ -n "$data" ] || die "no mtd partitions"
	lines=$(printf '%s\n' "$data" | wc -l | tr -d ' ')
	[ "$lines" = "1" ] || die "expected one mtd partition, found $lines"
	# mtd0: 00200000 00020000 "preloader"
	set -- $data
	dev=$1
	sz=$2
	er=$3
	name=$4
	dev=${dev%:}
	name=$(printf '%s' "$name" | tr -d '"')
	[ "$dev" = "mtd0" ] || die "preloader is not mtd0"
	[ "$name" = "preloader" ] || die "mtd0 is not named preloader"
	[ "$sz" = "00200000" ] || die "proc size is not 2 MiB"
	[ "$er" = "00020000" ] || die "proc erase size is not 128 KiB"
	sys=$(p /sys/class/mtd/mtd0)
	[ "$(cat "$sys/name")" = "preloader" ] || die "sysfs name is not preloader"
	[ "$(cat "$sys/type")" = "nand" ] || die "mtd type is not nand"
	[ "$(cat "$sys/size")" = "$SIZE" ] || die "sysfs size is not $SIZE"
	[ "$(cat "$sys/erasesize")" = "$ERASE" ] || die "erase size is not $ERASE"
	[ "$(cat "$sys/writesize")" = "$WRITE" ] || die "write size is not $WRITE"
	[ "$(cat "$sys/oobsize")" = "$OOB" ] || die "oob size is not $OOB"
	[ "$(cat "$sys/bad_blocks")" = "0" ] || die "preloader has bad blocks"
	printf '%s\n' /dev/mtd0
}

power_ok() {
	capf=$(p /sys/class/power_supply/battery/capacity)
	[ -r "$capf" ] || die "battery capacity is unreadable"
	cap=$(cat "$capf")
	case "$cap" in
		*[!0-9]*) die "battery capacity is not a number" ;;
	esac
	ac=0
	dir=$(p /sys/class/power_supply)
	for s in "$dir"/*/online; do
		[ -r "$s" ] || continue
		[ "$(cat "$s")" = "1" ] && ac=1
	done
	if [ "$cap" -lt "$MIN_BATTERY" ] && [ "$ac" != "1" ]; then
		die "battery ${cap}% and no charger"
	fi
	log "battery ${cap}%, charger $ac"
}

image_ok() {
	img=$1
	[ -f "$img" ] || return 1
	[ "$(wc -c < "$img" | tr -d ' ')" = "$SIZE" ] || return 1
	need_tool python3
	python3 "$IMAGE_PY" "$img"
}

validate_image() {
	image_ok "$1" || die "image structure refused: $1"
}

# Entry 0 of each RKNS copy is the DDR blob. The /pinctrl repair
# changes the SPL, so the whole image is not required to match.
ddr_compatible() {
	python3 "$IMAGE_PY" ddr "$1" "$2" || die "DDR payload does not match this unit"
}

sha_file() {
	sha256sum "$1" | awk '{print $1}'
}

boot_dir() {
	if [ "$TEST" = 1 ]; then
		printf '%s\n' "$ROOT/boot"
	else
		printf '%s\n' /boot
	fi
}

current_dir() {
	if [ "$TEST" = 1 ]; then
		printf '%s\n' "$ROOT/storage/.config/zlyme/preloader-backups"
	else
		printf '%s\n' /storage/.config/zlyme/preloader-backups
	fi
}

# Prints the one original backup path.
find_original() {
	dir=$(boot_dir)
	[ -d "$dir" ] || die "boot directory is missing"
	set -- "$dir"/mtd5-original-*.img
	if [ ! -e "$1" ]; then
		die "no original preloader backup"
	fi
	if [ "$#" -ne 1 ]; then
		die "more than one original preloader backup"
	fi
	base=$(basename "$1")
	want=${base#mtd5-original-}
	want=${want%.img}
	[ "$base" != "$want" ] || die "backup name is not mtd5-original-<sha256>.img"
	[ "${#want}" -eq 64 ] || die "backup name is not mtd5-original-<sha256>.img"
	case "$want" in
		*[!0-9a-f]*) die "backup name is not mtd5-original-<sha256>.img" ;;
	esac
	got=$(sha_file "$1")
	[ "$want" = "$got" ] || die "backup filename hash does not match the file"
	validate_image "$1"
	printf '%s\n' "$1"
}

read_live() {
	out=$1
	if [ "$TEST" = 1 ]; then
		cp "$(p /live/preloader.img)" "$out" || die "could not read fixture preloader"
	else
		dd if="${DEV}ro" of="$out" bs="$WRITE" status=none || die "could not read preloader"
	fi
	[ "$(wc -c < "$out" | tr -d ' ')" = "$SIZE" ] || die "live preloader size is not $SIZE"
}

save_current() {
	dir=$(current_dir)
	mkdir -p "$dir" || die "could not create the current-backup directory"
	tmp=$(mktemp)
	read_live "$tmp"
	sum=$(sha_file "$tmp")
	dest="$dir/preloader-current-$sum.img"
	cp "$tmp" "$dest" || { rm -f "$tmp"; die "could not write the current backup"; }
	sync
	[ "$(sha_file "$dest")" = "$sum" ] || { rm -f "$tmp"; die "current backup did not verify"; }
	rm -f "$tmp"
	# Refuse before any erase when the installed image is not a preloader.
	validate_image "$dest"
	CURRENT=$dest
	act "CURRENT_BACKUP $dest"
	log "current preloader saved as $dest"
}

# Erase, write, and read back one image. A failing flash_erase is a
# failed attempt: its status is not ignored, and nandwrite does not run
# for that attempt. Success is an exact 2 MiB SHA-256 match.
write_and_verify() {
	img=$1
	image_ok "$img" || return 1
	expect=$(sha_file "$img")
	n=0
	while [ "$n" -lt "$WRITE_ATTEMPTS" ]; do
		n=$((n + 1))
		log "write attempt $n of $img"
		act "CMD flash_erase $DEV 0 0"
		if ! flash_erase "$DEV" 0 0; then
			log "flash_erase failed"
			continue
		fi
		act "CMD nandwrite -p $DEV $img"
		if ! nandwrite -p "$DEV" "$img"; then
			log "nandwrite failed"
			continue
		fi
		if read_back_matches "$expect"; then
			return 0
		fi
		log "readback mismatch"
	done
	return 1
}

# Rollback uses the saved current image, never the requested target.
# One pass of write_and_verify is already three attempts.
rollback_current() {
	act "ROLLBACK"
	log "rolling back $CURRENT"
	if write_and_verify "$CURRENT"; then
		act "ROLLBACK_READBACK ok"
		return 0
	fi
	return 1
}

critical_failure() {
	what=$1
	log "CRITICAL: $what failed and rollback could not be verified."
	log "do not assume internal boot works"
	log "backup preserved at $CURRENT"
	log "sha256 $(sha_file "$CURRENT")"
	log "MASKROM/xrock recovery may be required"
	exit 1
}

require_tools() {
	need_tool flash_erase
	need_tool nandwrite
	need_tool mtdinfo
	need_tool dd
	need_tool sha256sum
}

prepare() {
	identity
	DEV=$(mtd_node)
	power_ok
	require_tools
	act "GATES $DEV"
}

read_back_matches() {
	want=$1
	tmp=$(mktemp)
	read_live "$tmp"
	got=$(sha_file "$tmp")
	rm -f "$tmp"
	[ "$got" = "$want" ]
}

cmd_status() {
	prepare
	log "preloader $DEV size $SIZE erase $ERASE"
	if orig=$(find_original 2>/tmp/zlyme-preloader-find.err); then
		log "original backup available: $orig"
	else
		log "original backup unavailable: $(cat /tmp/zlyme-preloader-find.err)"
	fi
	rm -f /tmp/zlyme-preloader-find.err
}

# One key=value line per fact. Settings reads this. It is not a shell script.
cmd_status_machine() {
	tmp=$(mktemp)
	rc=0
	# die() exits. A subshell keeps that exit in this command.
	( cmd_status ) >"$tmp" 2>&1 || rc=$?
	preloader=
	backup=
	battery=
	charger=
	error=
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in
		"zlyme-preloader: battery "*)
			rest=${line#"zlyme-preloader: battery "}
			case "$rest" in
			[0-9]*%", charger "[01] | [0-9][0-9]*%", charger "[01] | 100%", charger "[01])
				battery=${rest%%\%*}
				bit=${rest##*charger }
				if [ "$bit" = "1" ]; then
					charger=charging
				else
					charger=off
				fi
				;;
			*)
				error=${line#"zlyme-preloader: "}
				;;
			esac
			;;
		"zlyme-preloader: preloader "*)
			# Partition identity passed. This is not a NAND content hash.
			preloader=valid
			;;
		"zlyme-preloader: original backup available:"*)
			backup=available
			;;
		"zlyme-preloader: original backup unavailable:"*)
			backup=unavailable
			;;
		"zlyme-preloader: "*)
			error=${line#"zlyme-preloader: "}
			;;
		esac
	done <"$tmp"
	rm -f "$tmp"
	[ -n "$preloader" ] && printf 'preloader=%s\n' "$preloader"
	[ -n "$backup" ] && printf 'backup=%s\n' "$backup"
	[ -n "$battery" ] && printf 'battery=%s\n' "$battery"
	[ -n "$charger" ] && printf 'charger=%s\n' "$charger"
	if [ "$rc" != 0 ]; then
		[ -n "$error" ] || error="status failed"
		printf 'error=%s\n' "$error"
		return "$rc"
	fi
}

cmd_restore() {
	prepare
	orig=$(find_original)
	save_current
	ddr_compatible "$CURRENT" "$orig"
	if write_and_verify "$orig"; then
		act "READBACK target ok"
		log "restored original preloader"
		return 0
	fi
	log "restore write failed"
	if rollback_current; then
		log "Restore failed; previous preloader restored and verified."
		exit 3
	fi
	critical_failure restore
}

cmd_erase() {
	prepare
	save_current
	# flash_erase's own status is the erase result. Do not treat a
	# read of 0xff as proof: ECC on this NAND can report an error or
	# corrected data for an erased page. A finished erase is not USB
	# MASKROM. BootROM can load another loader, including a Zlyme
	# card idbloader.
	act "CMD flash_erase $DEV 0 0"
	if flash_erase "$DEV" 0 0; then
		act "ERASE ok"
		log "preloader erased"
		log "BootROM can try another boot source"
		log "a bootable SD idbloader can start instead of USB MASKROM"
		log "Zlyme will not reboot"
		return 0
	fi
	log "flash_erase failed; the preloader was not erased"
	if rollback_current; then
		log "Erase failed; previous preloader restored and verified."
		exit 3
	fi
	critical_failure erase
}

case "${1:-}" in
	status) cmd_status ;;
	status-machine) cmd_status_machine ;;
	restore) cmd_restore ;;
	erase-preloader) cmd_erase ;;
	*)
		log "usage: zlyme-preloader status|status-machine|restore|erase-preloader"
		exit 2
		;;
esac
