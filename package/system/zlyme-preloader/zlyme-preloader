#!/bin/sh
# Fail-closed preloader recovery for the Miyoo Flip running Zlyme.
#
# Zlyme's kernel exports one SPI NAND partition, label "preloader",
# 0x0 size 0x200000 (board/my355/linux/dts/.../rk3566-miyoo-flip.dts).
# That is mtd0. Stock's apommel installer instead sees "spl" as mtd5
# because it runs on stock. This tool does not retarget mtd5.
#
# ZLYME_PRELOADER_TEST=1 reads a fixture tree at ZLYME_PRELOADER_ROOT
# and never opens a real /dev/mtd node. The Settings page does not set it.

set -eu

SIZE=2097152
ERASE=131072
WRITE=2048
OOB=64
MIN_BATTERY=25
# install.sh in the pinned apommel tree retries a write three times,
# then retries restoring the previous image three times.
WRITE_ATTEMPTS=3
IMAGE_PY=/usr/lib/zlyme/preloader_image.py
CURRENT=
# Status facts live in this shell. collect_status fills them. Writers do not
# read them, and nothing here is taken from the human log.
DEV=
ST_BATTERY=
ST_CHARGER=
ST_PRELOADER=
ST_BACKUP=
ST_BACKUP_REASON=
ST_ORIGINAL=
ST_FALLBACK=
ST_STOCK=
ST_MODE=
ST_RECOVERY=
ST_SOURCE=
ST_ERROR=
ORIG=
ORIG_ERROR=

TEST=${ZLYME_PRELOADER_TEST:-0}
ROOT=${ZLYME_PRELOADER_ROOT:-}

# Records a status failure. Returns 0 so set -e does not abort the caller
# before that caller can return the failure itself.
fail_status() {
	ST_ERROR=$1
	log "$1"
}

log() { printf 'zlyme-preloader: %s\n' "$*" >&2; }
die() { log "$*"; exit 1; }

if [ "$TEST" = 1 ]; then
	if [ -z "$ROOT" ] || [ ! -d "$ROOT" ]; then
		die "fixture root is missing"
	fi
	IMAGE_PY=${ZLYME_PRELOADER_IMAGE_PY:-$IMAGE_PY}
fi

p() {
	if [ "$TEST" = 1 ]; then
		printf '%s%s' "$ROOT" "$1"
	else
		printf '%s' "$1"
	fi
}

act() {
	if [ "$TEST" = 1 ]; then
		printf '%s\n' "$*" >> "$ROOT/actions.log"
	fi
}

need_tool() {
	command -v "$1" >/dev/null 2>&1 || die "missing $1"
}

read_text() {
	# Device-tree files are NUL-terminated.
	tr -d '\000' < "$(p "$1")"
}

identity() {
	conf=$(p /usr/share/zlyme/device.conf)
	[ -r "$conf" ] || { fail_status "device.conf is missing"; return 1; }
	# shellcheck disable=SC1090 # device.conf is the board contract, not a library
	. "$conf"
	[ "${ZLYME_DEVICE_ID:-}" = "my355" ] || { fail_status "platform is not my355"; return 1; }
	model=$(read_text /proc/device-tree/model)
	[ "$model" = "Miyoo Flip" ] || { fail_status "model is not Miyoo Flip"; return 1; }
	comp=$(read_text /proc/device-tree/compatible | tr '\n' ' ')
	case "$comp" in
		*miyoo,flip*) ;;
		*) fail_status "compatible does not include miyoo,flip"; return 1 ;;
	esac
	case "$comp" in
		*rockchip,rk3566*) ;;
		*) fail_status "compatible does not include rockchip,rk3566"; return 1 ;;
	esac
}

# Sets DEV to /dev/mtd0 after the partition checks. Runs in the caller's shell.
mtd_node() {
	table=$(p /proc/mtd)
	[ -r "$table" ] || { fail_status "no mtd table"; return 1; }
	# One data line. Header is "dev:".
	data=$(awk 'NR>1 && NF { print }' "$table")
	[ -n "$data" ] || { fail_status "no mtd partitions"; return 1; }
	lines=$(printf '%s\n' "$data" | wc -l | tr -d ' ')
	[ "$lines" = "1" ] || { fail_status "expected one mtd partition, found $lines"; return 1; }
	# mtd0: 00200000 00020000 "preloader"
	# shellcheck disable=SC2086 # /proc/mtd columns are whitespace-separated
	set -- $data
	dev=${1:-}
	sz=${2:-}
	er=${3:-}
	name=${4:-}
	if [ -z "$dev" ] || [ -z "$sz" ] || [ -z "$er" ] || [ -z "$name" ]; then
		fail_status "mtd table is incomplete"
		return 1
	fi
	dev=${dev%:}
	name=$(printf '%s' "$name" | tr -d '"')
	[ "$dev" = "mtd0" ] || { fail_status "preloader is not mtd0"; return 1; }
	[ "$name" = "preloader" ] || { fail_status "mtd0 is not named preloader"; return 1; }
	[ "$sz" = "00200000" ] || { fail_status "proc size is not 2 MiB"; return 1; }
	[ "$er" = "00020000" ] || { fail_status "proc erase size is not 128 KiB"; return 1; }
	sys=$(p /sys/class/mtd/mtd0)
	[ "$(cat "$sys/name")" = "preloader" ] || { fail_status "sysfs name is not preloader"; return 1; }
	[ "$(cat "$sys/type")" = "nand" ] || { fail_status "mtd type is not nand"; return 1; }
	[ "$(cat "$sys/size")" = "$SIZE" ] || { fail_status "sysfs size is not $SIZE"; return 1; }
	[ "$(cat "$sys/erasesize")" = "$ERASE" ] || { fail_status "erase size is not $ERASE"; return 1; }
	[ "$(cat "$sys/writesize")" = "$WRITE" ] || { fail_status "write size is not $WRITE"; return 1; }
	[ "$(cat "$sys/oobsize")" = "$OOB" ] || { fail_status "oob size is not $OOB"; return 1; }
	[ "$(cat "$sys/bad_blocks")" = "0" ] || { fail_status "preloader has bad blocks"; return 1; }
	DEV=/dev/mtd0
}

power_ok() {
	capf=$(p /sys/class/power_supply/battery/capacity)
	[ -r "$capf" ] || { fail_status "battery capacity is unreadable"; return 1; }
	cap=$(cat "$capf")
	case "$cap" in
		*[!0-9]*) fail_status "battery capacity is not a number"; return 1 ;;
	esac
	ac=0
	dir=$(p /sys/class/power_supply)
	for s in "$dir"/*/online; do
		[ -r "$s" ] || continue
		[ "$(cat "$s")" = "1" ] && ac=1
	done
	if [ "$cap" -lt "$MIN_BATTERY" ] && [ "$ac" != "1" ]; then
		fail_status "battery ${cap}% and no charger"
		return 1
	fi
	ST_BATTERY=$cap
	if [ "$ac" = "1" ]; then
		ST_CHARGER=charging
	else
		ST_CHARGER=off
	fi
	log "battery ${cap}%, charger $ac"
}

image_ok() {
	img=$1
	[ -f "$img" ] || return 1
	[ "$(wc -c < "$img" | tr -d ' ')" = "$SIZE" ] || return 1
	need_tool python3
	python3 "$IMAGE_PY" "$img"
}

validate_image() {
	image_ok "$1" || die "image structure refused: $1"
}

# Entry 0 of each RKNS copy is the DDR blob. The /pinctrl repair
# changes the SPL, so the whole image is not required to match.
ddr_compatible() {
	python3 "$IMAGE_PY" ddr "$1" "$2" || die "DDR payload does not match this unit"
}

sha_file() {
	sha256sum "$1" | awk '{print $1}'
}

boot_dir() {
	if [ "$TEST" = 1 ]; then
		printf '%s\n' "$ROOT/boot"
	else
		printf '%s\n' /boot
	fi
}

current_dir() {
	if [ "$TEST" = 1 ]; then
		printf '%s\n' "$ROOT/storage/.config/zlyme/preloader-backups"
	else
		printf '%s\n' /storage/.config/zlyme/preloader-backups
	fi
}

# Recovery state is separate from the stock-restore backup. The manifest
# names the pre-recovery image. It is not a signature: disarm recomputes
# the recovery image from that file and compares the bytes.
recovery_dir() {
	if [ "$TEST" = 1 ]; then
		printf '%s\n' "$ROOT/storage/.config/zlyme/preloader-recovery"
	else
		printf '%s\n' /storage/.config/zlyme/preloader-recovery
	fi
}

manifest_path() {
	printf '%s/manifest.json\n' "$(recovery_dir)"
}

# Arm reads the FAT copies. It does not publish them. A fixture with no
# mounts file is treated as read-only; a real boot checks /proc/mounts.
require_boot_readonly() {
	if [ "$TEST" = 1 ]; then
		mounts=$(p /proc/mounts)
		if [ ! -f "$mounts" ]; then
			return 0
		fi
	else
		mounts=/proc/mounts
	fi
	[ -r "$mounts" ] || die "boot mount table is unreadable"
	opts=$(awk '$2 == "/boot" { print $4; exit }' "$mounts")
	[ -n "$opts" ] || die "boot volume is not mounted"
	case ",$opts," in
		*,rw,*) die "boot volume is writable" ;;
		*,ro,*) return 0 ;;
	esac
	die "boot volume is not read-only"
}

# Print the prepared recovery path and the source SHA, or refuse.
# The caller does not choose an image. The manifest only names hashes;
# the bytes have to be the derivative of the live source, and the FAT
# copies have to match before any erase.
arm_bind() {
	python3 - "$IMAGE_PY" "$1" "$2" "$3" "$4" "$5" <<'PY'
import importlib.util, json, sys
py, man_path, live_path, backups, recdir, boot = sys.argv[1:]
spec = importlib.util.spec_from_file_location("preloader_image", py)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
doc = mod._manifest(man_path)
live = mod._load(live_path)
mod._paired(live)
live_sha = mod._sha(live)
if live_sha == doc["recovery_sha256"] and live_sha != doc["source_sha256"]:
    raise SystemExit("live preloader is already the recovery image")
if live_sha != doc["source_sha256"]:
    raise SystemExit("live preloader is not the source image in the manifest")
name = doc["source_backup"]
source_path = backups.rstrip("/") + "/" + name
try:
    source = mod._load(source_path)
except OSError:
    raise SystemExit("source backup is missing")
if mod._sha(source) != doc["source_sha256"]:
    raise SystemExit("source backup sha does not match the manifest")
if source != live:
    raise SystemExit("source backup is not the live preloader")
rec_path = recdir.rstrip("/") + "/recovery-" + doc["recovery_sha256"] + ".img"
try:
    prepared = mod._load(rec_path)
except OSError:
    raise SystemExit("prepared recovery image is missing")
if mod._sha(prepared) != doc["recovery_sha256"]:
    raise SystemExit("prepared recovery sha does not match the manifest")
source_ddr, source_spl = mod._paired(source)
rec_ddr, rec_spl = mod._paired(prepared)
if source_ddr != rec_ddr or mod._sha(source_ddr) != doc["source_ddr_sha256"]:
    raise SystemExit("DDR payload does not match the source backup")
source_payload = source_spl[0]["payload"]
rec_payload = rec_spl[0]["payload"]
if mod.SPL_BANNER.encode() not in source_payload[:mod.DTB_OFF]:
    raise SystemExit("source backup is a different SPL build")
if source_payload[:mod.DTB_OFF] != rec_payload[:mod.DTB_OFF]:
    raise SystemExit("recovery image changed SPL executable bytes")
if mod._sha(source_payload[:mod.DTB_OFF]) != doc["executable_sha256"]:
    raise SystemExit("source executable sha does not match the manifest")
blob = mod._fdt(rec_payload)
_prop, order = mod._boot_order(blob)
if order != [mod.RIGHT_SLOT]:
    if len(order) != 1:
        raise SystemExit("recovery boot order has an extra boot device")
    raise SystemExit("recovery boot order is not the right-hand slot")
derived = mod.derive_bytes(source)
if derived != prepared or mod._sha(derived) != doc["recovery_sha256"]:
    raise SystemExit("prepared recovery image is not the derivative of the source backup")
boot = boot.rstrip("/")
try:
    fat = mod._load(boot + "/" + name)
except OSError:
    raise SystemExit("FAT source backup is missing")
if fat != source or mod._sha(fat) != doc["source_sha256"]:
    raise SystemExit("FAT source backup does not match the source")
fat_man = boot + "/preloader-recovery-manifest.json"
try:
    fat_raw = open(fat_man, encoding="utf-8").read()
except OSError:
    raise SystemExit("FAT recovery manifest is missing")
try:
    fat_doc = json.loads(fat_raw)
except (UnicodeError, json.JSONDecodeError):
    raise SystemExit("FAT recovery manifest does not match")
if fat_doc != doc:
    raise SystemExit("FAT recovery manifest does not match")
note_path = boot + "/" + name[:-4] + ".txt"
try:
    note = open(note_path, encoding="utf-8").read()
except (OSError, UnicodeError):
    raise SystemExit("recovery note is missing")
if doc["source_sha256"] not in note or "2097152" not in note:
    raise SystemExit("recovery note does not identify the source")
if "Miyoo Flip" not in note and "my355" not in note:
    raise SystemExit("recovery note does not identify the device")
if "2207:350a" not in note:
    raise SystemExit("recovery note does not name the xrock prerequisite")
command = "xrock flash write 0 " + name
if command not in note:
    raise SystemExit("recovery note does not name the xrock command")
sys.stdout.write(rec_path + "\n" + doc["source_sha256"] + "\n")
PY
}

publish_boot() {
	src=$1
	name=$2
	case "$name" in
		*/* | "") die "boot publication name is not a file name" ;;
	esac
	if [ "$TEST" = 1 ]; then
		cp "$src" "$(boot_dir)/$name"
		act "BOOT_WRITE $name"
		return
	fi
	zlyme-boot-write cp "$src" "/boot/$name"
}

# Sets ORIG to the one original backup. A missing or unusable backup returns 1
# and sets ORIG_ERROR. It does not exit: status has to report that state.
find_original() {
	ORIG=
	ORIG_ERROR=
	dir=$(boot_dir)
	if [ ! -d "$dir" ]; then
		ORIG_ERROR="boot directory is missing"
		return 1
	fi
	set -- "$dir"/mtd5-original-*.img
	if [ ! -e "$1" ]; then
		ORIG_ERROR="No original preloader backup. Stock restore is unavailable."
		return 1
	fi
	if [ "$#" -ne 1 ]; then
		ORIG_ERROR="more than one original preloader backup"
		return 1
	fi
	base=$(basename "$1")
	want=${base#mtd5-original-}
	want=${want%.img}
	if [ "$base" = "$want" ] || [ "${#want}" -ne 64 ]; then
		ORIG_ERROR="backup name is not mtd5-original-<sha256>.img"
		return 1
	fi
	case "$want" in
		*[!0-9a-f]*)
			ORIG_ERROR="backup name is not mtd5-original-<sha256>.img"
			return 1
			;;
	esac
	got=$(sha_file "$1")
	if [ "$want" != "$got" ]; then
		ORIG_ERROR="backup filename hash does not match the file"
		return 1
	fi
	if ! image_ok "$1"; then
		ORIG_ERROR="image structure refused: $1"
		return 1
	fi
	ORIG=$1
	return 0
}

read_live() {
	out=$1
	# DEV is assigned by mtd_node in this shell. ${DEV:-} keeps an unset node
	# from tripping set -u; the read then fails with a status line instead.
	node=${DEV:-}
	if [ -z "$node" ]; then
		fail_status "preloader device is not established"
		return 1
	fi
	if [ "$node" != "/dev/mtd0" ]; then
		fail_status "preloader device is not mtd0"
		return 1
	fi
	if [ "$TEST" = 1 ]; then
		cp "$(p /live/preloader.img)" "$out" || {
			fail_status "could not read fixture preloader"
			return 1
		}
	else
		dd if="${node}ro" of="$out" bs="$WRITE" status=none || {
			fail_status "could not read preloader"
			return 1
		}
	fi
	if [ "$(wc -c < "$out" | tr -d ' ')" != "$SIZE" ]; then
		fail_status "live preloader size is not $SIZE"
		return 1
	fi
}

save_current() {
	dir=$(current_dir)
	mkdir -p "$dir" || die "could not create the current-backup directory"
	tmp=$(mktemp)
	read_live "$tmp" || exit 1
	sum=$(sha_file "$tmp")
	dest="$dir/preloader-current-$sum.img"
	cp "$tmp" "$dest" || { rm -f "$tmp"; die "could not write the current backup"; }
	sync
	[ "$(sha_file "$dest")" = "$sum" ] || { rm -f "$tmp"; die "current backup did not verify"; }
	rm -f "$tmp"
	# Refuse before any erase when the installed image is not a preloader.
	validate_image "$dest"
	CURRENT=$dest
	act "CURRENT_BACKUP $dest"
	log "current preloader saved as $dest"
}

# Erase, write, and read back one image. A failing flash_erase is a
# failed attempt: its status is not ignored, and nandwrite does not run
# for that attempt. Success is an exact 2 MiB SHA-256 match.
write_and_verify() {
	img=$1
	image_ok "$img" || return 1
	expect=$(sha_file "$img")
	n=0
	while [ "$n" -lt "$WRITE_ATTEMPTS" ]; do
		n=$((n + 1))
		log "write attempt $n of $img"
		act "CMD flash_erase $DEV 0 0"
		if ! flash_erase "$DEV" 0 0; then
			log "flash_erase failed"
			continue
		fi
		act "CMD nandwrite -p $DEV $img"
		if ! nandwrite -p "$DEV" "$img"; then
			log "nandwrite failed"
			continue
		fi
		if read_back_matches "$expect"; then
			return 0
		fi
		log "readback mismatch"
	done
	return 1
}

# Rollback uses the saved current image, never the requested target.
# One pass of write_and_verify is already three attempts.
rollback_current() {
	act "ROLLBACK"
	log "rolling back $CURRENT"
	if write_and_verify "$CURRENT"; then
		act "ROLLBACK_READBACK ok"
		return 0
	fi
	return 1
}

critical_failure() {
	what=$1
	log "CRITICAL: $what failed and rollback could not be verified."
	log "do not assume internal boot works"
	log "backup preserved at $CURRENT"
	log "sha256 $(sha_file "$CURRENT")"
	log "MASKROM/xrock recovery may be required"
	exit 1
}

require_tools() {
	need_tool flash_erase
	need_tool nandwrite
	need_tool mtdinfo
	need_tool dd
	need_tool sha256sum
}

# Read-only gates. flash_erase and nandwrite are not required to report state.
prepare_read() {
	identity || return 1
	mtd_node || return 1
	power_ok || return 1
	command -v dd >/dev/null 2>&1 || { fail_status "missing dd"; return 1; }
	command -v sha256sum >/dev/null 2>&1 || { fail_status "missing sha256sum"; return 1; }
	command -v python3 >/dev/null 2>&1 || { fail_status "missing python3"; return 1; }
}

prepare_write() {
	prepare_read || exit 1
	require_tools
	act "GATES $DEV"
}

read_back_matches() {
	want=$1
	tmp=$(mktemp)
	read_live "$tmp" || return 1
	got=$(sha_file "$tmp")
	rm -f "$tmp"
	[ "$got" = "$want" ]
}

# One pass fills the ST_* facts in this shell, including the live-image class.
# status prints those facts. status-machine prints the same facts as keys.
collect_status() {
	ST_BATTERY=
	ST_CHARGER=
	ST_PRELOADER=
	ST_BACKUP=unavailable
	ST_BACKUP_REASON=
	ST_ORIGINAL=
	ST_FALLBACK=
	ST_STOCK=unavailable
	ST_MODE=
	ST_RECOVERY=
	ST_SOURCE=
	ST_ERROR=
	DEV=
	ORIG=
	ORIG_ERROR=
	prepare_read || return 1
	if find_original; then
		ST_BACKUP=available
		ST_ORIGINAL=$ORIG
		ST_STOCK=available
	else
		ST_BACKUP=unavailable
		ST_BACKUP_REASON=${ORIG_ERROR:-original preloader backup was not usable}
		ST_FALLBACK=incompatible
		ST_STOCK=unavailable
	fi
	live=$(mktemp)
	if ! read_live "$live"; then
		rm -f "$live"
		[ -n "$ST_ERROR" ] || ST_ERROR="could not read preloader"
		return 1
	fi
	ST_PRELOADER=valid
	state=$(python3 "$IMAGE_PY" recovery-state \
		"$(manifest_path)" "$live" "$(current_dir)" "$(recovery_dir)" 2>/dev/null || true)
	rm -f "$live"
	ST_MODE=
	ST_RECOVERY=
	ST_SOURCE=
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in
			mode=*) ST_MODE=${line#mode=} ;;
			recovery=*) ST_RECOVERY=${line#recovery=} ;;
			source_backup=*) ST_SOURCE=${line#source_backup=} ;;
		esac
	done <<EOF
$state
EOF
	[ -n "$ST_MODE" ] || ST_MODE=unknown
	[ -n "$ST_RECOVERY" ] || ST_RECOVERY=invalid
	[ -n "$ST_SOURCE" ] || ST_SOURCE=missing
	return 0
}

cmd_status() {
	collect_status || exit 1
	log "preloader $DEV size $SIZE erase $ERASE"
	if [ "$ST_BACKUP" = "available" ]; then
		log "original backup available: $ST_ORIGINAL"
	else
		log "original backup unavailable: $ST_BACKUP_REASON"
	fi
}

# One key=value line per fact. Settings reads this. It is not a shell script.
cmd_status_machine() {
	if ! collect_status; then
		printf 'error=%s\n' "${ST_ERROR:-status failed}"
		return 1
	fi
	printf 'preloader=%s\n' "$ST_PRELOADER"
	printf 'mode=%s\n' "$ST_MODE"
	printf 'recovery=%s\n' "$ST_RECOVERY"
	printf 'source_backup=%s\n' "$ST_SOURCE"
	printf 'stock_restore=%s\n' "$ST_STOCK"
	printf 'backup=%s\n' "$ST_BACKUP"
	if [ -n "$ST_FALLBACK" ]; then
		printf 'fallback=%s\n' "$ST_FALLBACK"
	fi
	printf 'battery=%s\n' "$ST_BATTERY"
	printf 'charger=%s\n' "$ST_CHARGER"
}

cmd_restore() {
	prepare_write
	find_original || die "${ORIG_ERROR:-original preloader backup was not usable}"
	orig=$ORIG
	save_current
	ddr_compatible "$CURRENT" "$orig"
	if write_and_verify "$orig"; then
		act "READBACK target ok"
		log "restored original preloader"
		return 0
	fi
	log "restore write failed"
	if rollback_current; then
		log "Restore failed; previous preloader restored and verified."
		exit 3
	fi
	critical_failure restore
}

# Read the live preloader, keep that exact image, and derive the
# right-slot recovery image. This does not erase or program NAND.
cmd_prepare_recovery() {
	prepare_write
	dir=$(recovery_dir)
	mkdir -p "$dir" || die "could not create the recovery directory"
	save_current
	rec=$(mktemp)
	man=$(mktemp)
	note=$(mktemp)
	if ! python3 "$IMAGE_PY" derive "$CURRENT" "$rec"; then
		rm -f "$rec" "$man" "$note"
		die "this preloader is not a supported recovery source"
	fi
	if ! python3 "$IMAGE_PY" recovery-manifest "$CURRENT" "$rec" >"$man"; then
		rm -f "$rec" "$man" "$note"
		die "recovery manifest was refused"
	fi
	sum=$(sha_file "$rec")
	# save_current reuses dir, so take the recovery directory again.
	dest="$(recovery_dir)/recovery-$sum.img"
	cp "$rec" "$dest" || { rm -f "$rec" "$man" "$note"; die "could not store the recovery image"; }
	sync
	[ "$(sha_file "$dest")" = "$sum" ] || { rm -f "$rec" "$man" "$note"; die "recovery image did not verify"; }
	cp "$man" "$(manifest_path)"
	sync
	base=$(basename "$CURRENT")
	cat >"$note" <<EOF
device: Miyoo Flip / my355
source SHA-256: $(sha_file "$CURRENT")
recovery SHA-256: $sum
source size: $SIZE
role: pre-recovery source backup
xrock recovery prerequisite: enter MASKROM 2207:350a, load the RK3566 DDR plus usbplug or a combined loader, then run xrock flash
command that would restore it:
xrock flash write 0 $base
NOT EXECUTED DURING RECOVERY PREPARATION
EOF
	publish_boot "$CURRENT" "$base"
	publish_boot "$note" "${base%.img}.txt"
	publish_boot "$(manifest_path)" preloader-recovery-manifest.json
	rm -f "$rec" "$man" "$note"
	act "PREPARE_RECOVERY $dest"
	log "recovery preloader prepared"
	log "NAND was not written"
	log "Zlyme will not reboot"
}

# Restore the pre-recovery image only when the live NAND image is the
# byte-for-byte derivative of that saved file. The current recovery
# image is the rollback target. The source backup is left in place.
cmd_disarm_recovery() {
	prepare_write
	live=$(mktemp)
	read_live "$live" || exit 1
	validate_image "$live"
	man=$(manifest_path)
	if [ ! -f "$man" ]; then
		rm -f "$live"
		die "recovery manifest is missing"
	fi
	if ! origin=$(python3 "$IMAGE_PY" recovery-source "$man" "$live" "$(current_dir)"); then
		rm -f "$live"
		die "recovery binding refused"
	fi
	rm -f "$live"
	[ -f "$origin" ] || die "source backup is missing"
	save_current
	if [ "$CURRENT" = "$origin" ]; then
		die "rollback image is the source backup"
	fi
	ddr_compatible "$CURRENT" "$origin"
	if write_and_verify "$origin"; then
		act "READBACK target ok"
		log "disarmed recovery preloader"
		log "Zlyme will not reboot"
		return 0
	fi
	log "disarm write failed"
	if rollback_current; then
		log "Disarm failed; recovery preloader restored and verified."
		exit 3
	fi
	critical_failure disarm
}

# Install the recovery image already derived from the live source.
# Binding, including the FAT copies, finishes before save_current.
# save_current then preserves that source as the rollback image.
cmd_arm_recovery() {
	prepare_write
	require_boot_readonly
	live=$(mktemp)
	read_live "$live" || exit 1
	validate_image "$live"
	if [ ! -f "$(manifest_path)" ]; then
		rm -f "$live"
		die "recovery manifest is missing"
	fi
	if ! info=$(arm_bind "$(manifest_path)" "$live" "$(current_dir)" "$(recovery_dir)" "$(boot_dir)"); then
		rm -f "$live"
		die "recovery arming refused"
	fi
	rm -f "$live"
	target=$(printf '%s\n' "$info" | sed -n '1p')
	want=$(printf '%s\n' "$info" | sed -n '2p')
	[ -f "$target" ] || die "prepared recovery image is missing"
	save_current
	got=$(sha_file "$CURRENT")
	if [ "$got" != "$want" ] || ! cmp -s "$CURRENT" "$(boot_dir)/preloader-current-$want.img"; then
		die "saved current image is not the source"
	fi
	if write_and_verify "$target"; then
		act "READBACK target ok"
		log "conditional recovery preloader installed and verified"
		log "device was not rebooted"
		return 0
	fi
	log "arm write failed"
	if rollback_current; then
		log "Arm failed; source preloader restored and verified."
		exit 3
	fi
	critical_failure arm
}

cmd_erase() {
	prepare_write
	save_current
	# flash_erase's own status is the erase result. Do not treat a
	# read of 0xff as proof: ECC on this NAND can report an error or
	# corrected data for an erased page. A finished erase is not USB
	# MASKROM. BootROM can load another loader, including a Zlyme
	# card idbloader.
	act "CMD flash_erase $DEV 0 0"
	if flash_erase "$DEV" 0 0; then
		act "ERASE ok"
		log "preloader erased"
		log "BootROM can try another boot source"
		log "a bootable SD idbloader can start instead of USB MASKROM"
		log "Zlyme will not reboot"
		return 0
	fi
	log "flash_erase failed; the preloader was not erased"
	if rollback_current; then
		log "Erase failed; previous preloader restored and verified."
		exit 3
	fi
	critical_failure erase
}

case "${1:-}" in
	status) cmd_status ;;
	status-machine) cmd_status_machine ;;
	restore) cmd_restore ;;
	erase-preloader) cmd_erase ;;
	prepare-recovery) cmd_prepare_recovery ;;
	arm-recovery) cmd_arm_recovery ;;
	disarm-recovery) cmd_disarm_recovery ;;
	*)
		log "usage: zlyme-preloader status|status-machine|restore|erase-preloader|prepare-recovery|arm-recovery|disarm-recovery"
		exit 2
		;;
esac
