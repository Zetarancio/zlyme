#!/bin/ash
# Mount LABEL=ZLYMEBOOT. If ZLYME has a staged squashfs, copy it over
# /zlyme (the live file stays on FAT; the payload lives on exFAT).
# Then loop-mount zlyme and switch_root.

log() {
	echo "zlyme-init: $*"
	# Do not scribble on the panel while the lockup is up.
	if [ -f /zlyme-splash.progress ] || [ -f /boot_root/zlyme-splash.progress ]; then
		return 0
	fi
	[ -w /dev/console ] && echo "zlyme-init: $*" >/dev/console 2>/dev/null
	[ -w /dev/tty1 ] && echo "zlyme-init: $*" >/dev/tty1 2>/dev/null
}

mount_boot() {
	mount -t vfat -o rw,noatime,utf8 "$1" /boot_root 2>/dev/null
}

mount_storage() {
	mount -t exfat -o rw,noatime "$1" /storage_root 2>/dev/null
}

# Initramfs busybox sleep is whole seconds. GPT nodes appear a few
# hundred ms after mmcblk0. Do not hammer LABEL= while the parts are
# still missing (that was ~50 failed mounts per second).
wait_mount() {
	fn=$1
	spec=$2
	n=0
	while [ "$n" -lt 400 ]; do
		for node in /dev/mmcblk0p2 /dev/mmcblk0p1 /dev/mmcblk1p2 /dev/mmcblk1p1; do
			[ -b "$node" ] || continue
			if "$fn" "$node"; then
				return 0
			fi
		done
		if [ -b /dev/mmcblk0p1 ] || [ -b /dev/mmcblk0p2 ] || \
			[ -b /dev/mmcblk1p1 ] || [ -b /dev/mmcblk1p2 ]; then
			if "$fn" "$spec"; then
				return 0
			fi
		fi
		n=$((n + 1))
	done
	n=0
	while [ "$n" -lt 20 ]; do
		if "$fn" "$spec"; then
			return 0
		fi
		for node in /dev/mmcblk0p2 /dev/mmcblk0p1 /dev/mmcblk1p2 /dev/mmcblk1p1; do
			[ -b "$node" ] || continue
			if "$fn" "$node"; then
				return 0
			fi
		done
		n=$((n + 1))
		sleep 1
	done
	return 1
}

commit_update() {
	src=/storage_root/.update/pending/zlyme
	[ -f "$src" ] || return 0

	log "copying new zlyme from ZLYME"
	if ! cp -f "$src" /boot_root/zlyme; then
		log "copy failed, keeping current zlyme"
		return 1
	fi
	sync
	if [ -x /storage_root/.update/pending/post-update.sh ]; then
		log "running post-update.sh"
		/storage_root/.update/pending/post-update.sh || log "post-update.sh failed (ignored)"
	elif [ -f /storage_root/.update/pending/post-update.sh ]; then
		log "running post-update.sh"
		sh /storage_root/.update/pending/post-update.sh || log "post-update.sh failed (ignored)"
	fi
	rm -rf /storage_root/.update/pending
	rm -f /storage_root/.update/zlyme-my355-update.tar
	rm -f /storage_root/.update/WANT
	rm -f /storage_root/.update/zlyme-my355-[0-9]*.tar \
		/storage_root/.update/zlyme-my355-[0-9]*.sha256 \
		/storage_root/.update/zlyme-my355-[0-9]*.tar.sha256
	sync
	log "zlyme committed"
	return 0
}

do_root() {
	mkdir -p /boot_root /storage_root /new_root /sys /proc /dev || return 1
	mount -t proc -o nodev,noexec,nosuid proc /proc || return 1
	mount -t sysfs -o nodev,noexec,nosuid sysfs /sys || return 1
	mount -t devtmpfs none /dev 2>/dev/null || true

	# Loop the splash in the background so MMC mount is not waiting
	# on fb0. Leave it running across switch_root until S12splash
	# restarts it from the squashfs copy (initramfs splash cannot
	# see /usr/share/zlyme). NextUI kills it when KMSDRM takes the panel.
	# One try at FAT first so an OTA reboot paints galaxy, not slime.
	if [ -b /dev/mmcblk0p2 ]; then
		mount_boot /dev/mmcblk0p2 || true
	elif [ -b /dev/mmcblk1p2 ]; then
		mount_boot /dev/mmcblk1p2 || true
	fi
	if [ -f /boot_root/zlyme-splash.progress ]; then
		: > /zlyme-splash.progress
	fi
	if [ -x /zlyme-splash ]; then
		# Stills from the ramdisk. Anims appear on FAT at
		# /boot_root once MMC is up; splash loads them then.
		/zlyme-splash /splash.rgb565 /boot_root/splash.anim \
			/progress.rgb565 /boot_root/progress.anim &
	fi

	read -r cmdline < /proc/cmdline

	label=ZLYMEBOOT
	for param in ${cmdline}; do
		case ${param} in
			label=*) label=${param#label=} ;;
		esac
	done

	if ! grep -q " /boot_root " /proc/mounts; then
		if ! wait_mount mount_boot "LABEL=${label}"; then
			log "could not mount LABEL=${label}"
			return 1
		fi
	fi

	if wait_mount mount_storage "LABEL=ZLYME"; then
		if [ -f /storage_root/.update/pending/zlyme ]; then
			: > /zlyme-splash.progress
			: > /boot_root/zlyme-splash.progress
		fi
		commit_update || true
	else
		log "ZLYME not mounted (ok if no pending update)"
	fi

	if [ ! -e /boot_root/zlyme ]; then
		log "no /zlyme on ${label}"
		return 1
	fi

	if ! mount -t squashfs -o loop /boot_root/zlyme /new_root; then
		if ! mount -t squashfs /boot_root/zlyme /new_root; then
			log "squashfs mount failed"
			return 1
		fi
	fi

	mkdir -p /new_root/boot /new_root/proc /new_root/sys /new_root/dev \
		/new_root/storage
	mount --move /boot_root /new_root/boot || return 1
	# Keep ZLYME mounted. S15 remount of a 58 G exFAT was ~0.8 s.
	if ! mount --move /storage_root /new_root/storage 2>/dev/null; then
		umount /storage_root 2>/dev/null || true
	fi

	mount --move /sys /new_root/sys || return 1
	mount --move /proc /new_root/proc || return 1
	mount --move /dev /new_root/dev || return 1

	exec switch_root /new_root /sbin/init
}

if ! do_root; then
	log "failed, dropping to ash"
	exec /bin/ash
fi
