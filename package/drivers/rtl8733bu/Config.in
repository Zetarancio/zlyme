config BR2_PACKAGE_RTL8733BU
	bool "rtl8733bu"
	depends on BR2_LINUX_KERNEL
	help
	  Realtek RTL8733BU WiFi driver, out of tree.

	  This is the WiFi half of the Miyoo Flip's USB WiFi/Bluetooth combo
	  chip. Both halves share one firmware load, so this wants
	  rtl8733bu-power alongside it and btusb blacklisted; see
	  package/drivers/rtl8733bu-power and board/my355/fsoverlay/etc/modprobe.d.

	  https://github.com/Charliechen114514/rtl8733bu-linux-driver

comment "rtl8733bu needs a kernel to build against"
	depends on !BR2_LINUX_KERNEL
