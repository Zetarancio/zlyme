config BR2_PACKAGE_MIYOO_FLIP_GAMEPAD
	bool "miyoo-flip-gamepad"
	depends on BR2_ZLYME_DEVICE_MY355
	depends on BR2_LINUX_KERNEL
	help
	  Miyoo Flip gamepad tracer. UART1 serdev axes, GPIO-irq
	  buttons, one input device named "Miyoo Flip Gamepad".

comment "miyoo-flip-gamepad needs the Miyoo Flip target and a kernel"
	depends on !BR2_ZLYME_DEVICE_MY355 || !BR2_LINUX_KERNEL
