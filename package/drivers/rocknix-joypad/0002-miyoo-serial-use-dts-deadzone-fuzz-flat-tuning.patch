+	/* Simple radial deadzone — zero inside, no remapping.
+	 * Matches stock miyoo_inputd behaviour: compare squared
+	 * magnitude against squared deadzone to avoid int_sqrt. */
+	if (joypad->bt_adc_deadzone) {
+		long long mag_sq = (long long)x * x + (long long)y * y;
+		long long dz = joypad->bt_adc_deadzone;
+
+		if (mag_sq <= dz * dz) {
+			*px = 0;
+			*py = 0;
+			return;
+		}
