config BR2_PACKAGE_ROCKNIX_JOYPAD
	bool "rocknix-joypad"
	depends on BR2_ZLYME_DEVICE_MY355
	depends on BR2_LINUX_KERNEL
	help
	  rocknix-singleadc-joypad. The DTS node is already in
	  board/my355/linux/dts (compatible "rocknix-singleadc-joypad",
	  rocknix,use-miyoo-serial-joypad). Without this module the
	  buttons and stick do not exist as an input device.

	  https://github.com/ROCKNIX/rocknix-joypad

comment "rocknix-joypad needs the Miyoo Flip target and a kernel"
	depends on !BR2_ZLYME_DEVICE_MY355 || !BR2_LINUX_KERNEL
