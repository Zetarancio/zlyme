config BR2_PACKAGE_RTL8733BU_POWER
	bool "rtl8733bu-power"
	depends on BR2_ZLYME_DEVICE_MY355
	depends on BR2_LINUX_KERNEL
	help
	  Power and rfkill control for the RTL8733BU combo chip.

	  Owns the chip's enable GPIO and registers one WLAN and one Bluetooth
	  rfkill against it, cutting power only when both are blocked. Needs the
	  "rockchip,rtl8733bu-power" node in the device tree, which
	  board/my355/linux/dts already carries.

comment "rtl8733bu-power needs the Miyoo Flip target and a kernel"
	depends on !BR2_ZLYME_DEVICE_MY355 || !BR2_LINUX_KERNEL
