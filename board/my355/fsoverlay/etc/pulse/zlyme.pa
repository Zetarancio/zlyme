# One local server. No network listener, no udev autodetect, no
# stream-restore, no BlueZ module. zlyme-audio owns the default sink.
#
# PulseAudio 17 chmod's the socket inode 0777 and says to put it in a
# directory with real permissions. S21pulse creates
# /run/zlyme/pulse mode 0700, owned by pulse. Anonymous access is off.
# The pulse-access group may connect. Root is not in that group.
# Root clients present the cookie in this directory.
.fail

load-module module-native-protocol-unix auth-anonymous=0 auth-group=pulse-access auth-group-enable=1 auth-cookie=/run/zlyme/pulse/cookie auth-cookie-enabled=1 socket=/run/zlyme/pulse/native
load-module module-alsa-sink device=hw:rk817ext,0 sink_name=codec channels=2 rate=48000 format=s16le tsched=0 fragments=12 fragment_size=1024

set-default-sink codec
