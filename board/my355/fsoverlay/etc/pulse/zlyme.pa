# One local server. No network listener, no udev autodetect, no
# stream-restore. zlyme-audio owns the default sink.
.fail

load-module module-native-protocol-unix auth-anonymous=1 socket=/run/zlyme/pulse/native
load-module module-alsa-sink device=hw:rk817ext,0 sink_name=codec channels=2 rate=48000 format=s16le tsched=0 fragments=4 fragment_size=1024

set-default-sink codec
