# Linux 7.2 sends HDMI hotplug as HOTPLUG=1 on the primary DRM card.
# drm_sysfs_hotplug_event and drm_sysfs_connector_hotplug_event both
# use that card (card0 or card1, DEVTYPE drm_minor). DesignWare HDMI
# reaches them through drm_helper_hpd_irq_event. The handler reads
# HDMI-A status and the ELD. The card name is not a connector name.
# A connected port whose ELD is not ready gets one detached recheck.
# eudev 3.2.14 waits for this program and kills that pid on timeout.
# start-stop-daemon -b has already setsid'd the recheck before this
# program returns, so the recheck is not that pid. Render nodes, lease
# changes, and connector sysfs devices do not match. Sound-card events
# are not used: they ran before the sink existed and blocked the
# Bluetooth udev worker.
ACTION=="change", SUBSYSTEM=="drm", ENV{DEVTYPE}=="drm_minor", KERNEL=="card[0-9]*", ENV{HOTPLUG}=="1", ENV{ZLYME_HDMI_RECHECK}="1", RUN+="/usr/sbin/zlyme-audio hdmi-event"
