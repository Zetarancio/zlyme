#!/bin/sh
#
# Class A only, then fork NextUI. Class B is /etc/init.d/rc.late via
# inittab ::once:. Do not wait for dbus: dbus-uuidgen --ensure blocks
# until crng init (~9 s). BlueZ starts dbus in rc.late.

boot_mark() {
	echo "$(cut -d' ' -f1 /proc/uptime 2>/dev/null) $*" >> /tmp/boot-timing
}

# Panel, pad, storage, GPU, ALSA, keymon, then the list. Everything
# else is rc.late (wifi/BT/ssh/dbus/syslog/avahi/cron/sd2).
is_class_a() {
	case "$1" in
		S10udevd|S11modules|S12bootfs|S13resize|S15bootpart|S15gpudriver|S16display|S18zlymeupdate|S20alsa|S25jackd|S26joypadcal|S26keymon|S28minui)
			return 0
			;;
	esac
	return 1
}

boot_mark rcS-start

for i in /etc/init.d/S??*; do
	[ -f "$i" ] || continue
	base=${i##*/}
	case "$base" in
		S90*) continue ;;
	esac
	is_class_a "$base" || continue
	boot_mark "start $base"
	case "$i" in
		*.sh)
			(
				trap - INT QUIT TSTP
				set start
				# shellcheck disable=SC1090
				. "$i"
			)
			;;
		*)
			"$i" start
			;;
	esac
	boot_mark "done $base"
done

boot_mark rcS-nextui-ready
