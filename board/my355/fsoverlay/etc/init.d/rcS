#!/bin/sh
#
# Class A only, then fork NextUI. Class B is /etc/init.d/rc.late via
# inittab ::once:. Do not wait for dbus: dbus-uuidgen --ensure blocks
# until crng init (~9 s). BlueZ starts dbus in rc.late.

boot_mark() {
	echo "$(cut -d' ' -f1 /proc/uptime 2>/dev/null) $*" >> /tmp/boot-timing
}

# Panel, pad, storage, GPU, ALSA, keylidmon, then the list. S17 is forked
# (not waited): zlyme35 reached the list without blocking on mergerfs.
# Session bind of .roms_base; zlyme-storage unmounts that and merges.
is_class_a() {
	case "$1" in
		S10udevd|S11modules|S12bootfs|S13resize|S15bootpart|S15gpudriver|S16display|S17sd2|S18zlymeupdate|S20alsa|S25jackd|S26joypadcal|S26keylidmon|S28minui)
			return 0
			;;
	esac
	return 1
}

boot_mark rcS-start

# Session + NextUI are the remaining seconds. schedutil leaves the
# A55s idle while we mount and bind.
for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
	[ -w "$g" ] && echo performance > "$g"
done

for i in /etc/init.d/S??*; do
	[ -f "$i" ] || continue
	base=${i##*/}
	case "$base" in
		S90*) continue ;;
	esac
	is_class_a "$base" || continue
	# Merge SD2 / check OTA while GPU/ALSA/keylidmon/NextUI run. Do not
	# wait: a hung blkid/mergerfs left the splash up on Etcher.
	case "$base" in
		S17sd2|S18zlymeupdate)
			boot_mark "fork $base"
			"$i" start &
			continue
			;;
	esac
	boot_mark "start $base"
	case "$i" in
		*.sh)
			(
				trap - INT QUIT TSTP
				set start
				# shellcheck disable=SC1090
				. "$i"
			)
			;;
		*)
			"$i" start
			;;
	esac
	boot_mark "done $base"
done

boot_mark rcS-nextui-ready
