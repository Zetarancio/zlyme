#!/bin/sh
# Mount the primary exFAT partition and seed .config.
# The device node selects the card. The label confirms it.
# Never mount a second card that happens to use the same label.

CONF=${ZLYME_OS_CONF:-/etc/zlyme.conf}
# shellcheck disable=SC1090
. "$CONF"

MOUNTS=${ZLYME_PROC_MOUNTS:-/proc/mounts}
IDENT=${ZLYME_DEVICE_CONF:-/usr/share/zlyme/device.conf}
if [ -r "$IDENT" ]; then
	# shellcheck disable=SC1090
	. "$IDENT"
fi

dev_label() {
	line=$(blkid "$1" 2>/dev/null) || return 1
	case "$line" in
		*LABEL=\"*)
			rest=${line#*LABEL=\"}
			label=${rest%%\"*}
			;;
		*) return 1 ;;
	esac
	[ -n "$label" ] || return 1
	printf '%s\n' "$label"
}

canon() {
	if [ -e "$1" ]; then
		readlink -f "$1" 2>/dev/null || printf '%s\n' "$1"
		return 0
	fi
	printf '%s\n' "$1"
}

same_dev() {
	[ -n "$1" ] && [ -n "$2" ] || return 1
	[ "$(canon "$1")" = "$(canon "$2")" ]
}

mount_source() {
	point=$1
	found=""
	while read -r dev mp _rest; do
		[ "$mp" = "$point" ] || continue
		found=$dev
		break
	done < "$MOUNTS"
	[ -n "$found" ] || return 1
	printf '%s\n' "$found"
}

start() {
	printf "Mounting %s: " "$ZLYME_STORAGE"

	if [ -z "${ZLYME_STORAGE_DEVICE:-}" ] || [ -z "${ZLYME_STORAGE_LABEL:-}" ]; then
		echo "FAIL (storage identity unset)"
		return 1
	fi

	src=$(mount_source "$ZLYME_STORAGE" || true)
	if [ -n "$src" ]; then
		got=$(dev_label "$src" || true)
		if ! same_dev "$src" "$ZLYME_STORAGE_DEVICE" || [ "$got" != "$ZLYME_STORAGE_LABEL" ]; then
			echo "FAIL ($src is not $ZLYME_STORAGE_DEVICE $ZLYME_STORAGE_LABEL)"
			return 1
		fi
		echo "already mounted ($src)"
	else
		got=$(dev_label "$ZLYME_STORAGE_DEVICE" || true)
		if [ "$got" != "$ZLYME_STORAGE_LABEL" ]; then
			echo "FAIL ($ZLYME_STORAGE_DEVICE is not $ZLYME_STORAGE_LABEL)"
			return 1
		fi
		if mount -t exfat -o rw,noatime "$ZLYME_STORAGE_DEVICE" "$ZLYME_STORAGE" 2>/dev/null; then
			echo "OK ($ZLYME_STORAGE_DEVICE)"
		else
			echo "FAIL ($ZLYME_STORAGE_DEVICE)"
			return 1
		fi
	fi
	_up=0
	read -r _up _rest < /proc/uptime || true
	echo "$_up S15-mounted" >> "${ZLYME_BOOT_TIMING:-/tmp/boot-timing}"

	# /etc/localtime points here. The file must exist before rcS
	# reaches NextUI. The rest of the seed stays off the critical path.
	[ -x /usr/sbin/zlyme-timezone ] && /usr/sbin/zlyme-timezone ensure

	# mkdir of flags that already exist is not needed before the list.
	seed &
	return 0
}

seed() {
	for d in "$ZLYME_CFG" "$ZLYME_CFG/ssh" "$ZLYME_CFG/seedrng" \
		"$ZLYME_CFG/retroarch" "$ZLYME_CFG/zlyme" \
		"$ZLYME_CFG/samba" "$ZLYME_CFG/syncthing"; do
		[ -d "$d" ] || mkdir -p "$d" 2>/dev/null
	done

	for d in "$ZLYME_CFG/nextui/shared" "$ZLYME_CFG/nextui/my355"; do
		[ -d "$d" ] || mkdir -p "$d" 2>/dev/null
	done

	# Manual OTA drop folder. S18 does not start zlyme-update unless a
	# tar is already queued, and the first-boot mkfs wipes the exFAT
	# seed, so a fresh card otherwise has nowhere obvious to put one.
	[ -d "$ZLYME_STORAGE/.update" ] || mkdir -p "$ZLYME_STORAGE/.update" 2>/dev/null

	for kv in wifi=on bluetooth=on ssh=on samba=off syncthing=off gpu=libmali refresh=60 undervolt=off led=battery otg=on hdmi=on sd2=on zram=on logs=off update_channel=releases; do
		n=${kv%%=*}
		v=${kv#*=}
		[ -e "$ZLYME_CFG/zlyme/$n" ] && continue
		printf '%s\n' "$v" > "$ZLYME_CFG/zlyme/$n" 2>/dev/null
	done
	# Retired settings. An older card may still have the files.
	for n in boost merge; do
		[ -f "$ZLYME_CFG/zlyme/$n" ] && rm -f "$ZLYME_CFG/zlyme/$n"
	done

	for f in wpa_supplicant.conf.example retroarch/retroarch.cfg; do
		[ -e "$ZLYME_CFG/$f" ] && continue
		[ -r "$ZLYME_DEFAULTS/$f" ] || continue
		cp "$ZLYME_DEFAULTS/$f" "$ZLYME_CFG/$f" 2>/dev/null
	done
	# seedrng waits for crng. rc.late S01seedrng owns it after
	# the list is up.
	[ -x /usr/sbin/zlyme-logs ] && /usr/sbin/zlyme-logs start
}

stop() {
	if grep -q " $ZLYME_STORAGE " "$MOUNTS"; then
		printf "Unmounting %s: " "$ZLYME_STORAGE"
		umount "$ZLYME_STORAGE" 2>/dev/null && echo "OK" || echo "FAIL"
	fi
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
