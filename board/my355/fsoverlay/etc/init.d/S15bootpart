#!/bin/sh
# Mount the exFAT partition (label ZLYME) and seed .config. Never fail the boot.

. /etc/zlyme.conf

STORAGE_LABEL="ZLYME"

start() {
	printf "Mounting %s: " "$ZLYME_STORAGE"

	if grep -q " $ZLYME_STORAGE " /proc/mounts; then
		echo "already mounted"
	else
		dev=
		if [ -b /dev/mmcblk0p3 ]; then
			dev=/dev/mmcblk0p3
		else
			dev=$(blkid | sed -n "s|^\([^:]*\):.*LABEL=\"${STORAGE_LABEL}\".*|\1|p" | head -n 1)
		fi

		if [ -z "$dev" ]; then
			echo "no filesystem labelled ${STORAGE_LABEL}"
			return 0
		fi

		if mount -t exfat -o rw,noatime "$dev" "$ZLYME_STORAGE" 2>/dev/null; then
			echo "OK ($dev)"
		else
			echo "FAIL ($dev)"
			return 0
		fi
	fi
	echo "$(cut -d' ' -f1 /proc/uptime 2>/dev/null) S15-mounted" >> /tmp/boot-timing

	# mkdir of flags that already exist is not needed before the list.
	seed &
	return 0
}

seed() {
	for d in "$ZLYME_CFG" "$ZLYME_CFG/ssh" "$ZLYME_CFG/seedrng" \
		"$ZLYME_CFG/retroarch" "$ZLYME_CFG/zlyme" \
		"$ZLYME_CFG/samba" "$ZLYME_CFG/syncthing"; do
		[ -d "$d" ] || mkdir -p "$d" 2>/dev/null
	done

	for d in "$ZLYME_CFG/nextui/shared" "$ZLYME_CFG/nextui/my355"; do
		[ -d "$d" ] || mkdir -p "$d" 2>/dev/null
	done

	for kv in wifi=on bluetooth=on ssh=on samba=off syncthing=off gpu=libmali refresh=60 undervolt=off led=battery otg=on hdmi=on sd2=on boost=off zram=on merge=on logs=off update_channel=releases; do
		n=${kv%%=*}
		v=${kv#*=}
		[ -e "$ZLYME_CFG/zlyme/$n" ] && continue
		printf '%s\n' "$v" > "$ZLYME_CFG/zlyme/$n" 2>/dev/null
	done

	for f in wpa_supplicant.conf.example retroarch/retroarch.cfg; do
		[ -e "$ZLYME_CFG/$f" ] && continue
		[ -r "$ZLYME_DEFAULTS/$f" ] || continue
		cp "$ZLYME_DEFAULTS/$f" "$ZLYME_CFG/$f" 2>/dev/null
	done
	# seedrng waits for crng. rc.late S01seedrng owns it after
	# the list is up.
	[ -x /usr/sbin/zlyme-logs ] && /usr/sbin/zlyme-logs start
}

stop() {
	if grep -q " $ZLYME_STORAGE " /proc/mounts; then
		printf "Unmounting %s: " "$ZLYME_STORAGE"
		umount "$ZLYME_STORAGE" 2>/dev/null && echo "OK" || echo "FAIL"
	fi
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
