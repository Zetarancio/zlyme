#!/bin/sh
#
# Class B: wifi, BT, ssh, dbus, LED, zram, irq, extra storage, udev.
# Started from inittab ::once: (init does not wait). Ignore HUP so the
# children survive when this script exits.

trap '' HUP
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

. /etc/zlyme.conf 2>/dev/null || true

_up=0
read -r _up _rest < /proc/uptime || true
echo "$_up rc.late" >> /tmp/boot-timing

# inittab starts us the moment rcS forks NextUI. wifi/udev/sshd used
# to fight nextui.elf for the A55s (~3 s of session-nextui).
if type wait_boot_list >/dev/null 2>&1; then
	wait_boot_list
else
	n=0
	while [ "$n" -lt 40 ]; do
		grep -q 'nextui-first-flip' /tmp/boot-timing 2>/dev/null && break
		sleep 0.5
		n=$((n + 1))
	done
fi
_up=0
read -r _up _rest < /proc/uptime || true
echo "$_up rc.late-after-list" >> /tmp/boot-timing
echo "$_up joypad-restore-start" >> /tmp/boot-timing
if [ -x /usr/sbin/zlyme-gamepad-cal ]; then
	/usr/sbin/zlyme-gamepad-cal restore || echo "zlyme-gamepad-cal restore failed" >&2
fi
_up=0
read -r _up _rest < /proc/uptime || true
echo "$_up joypad-restore-end" >> /tmp/boot-timing

start_bg() {
	[ -x "$1" ] || return 0
	"$1" start >/dev/null 2>&1 &
}

start_bg /etc/init.d/S01seedrng
start_bg /etc/init.d/S01syslogd
start_bg /etc/init.d/S02klogd
start_bg /etc/init.d/S02sysctl
start_bg /etc/init.d/S05avahi-setup.sh
start_bg /etc/init.d/S22zram
start_bg /etc/init.d/S27led
# Daemon is Class A. Trigger after the list so USB MODALIAS (8733bu)
# does not share the A55s with nextui.elf.
start_bg /etc/init.d/S29udevtrigger
start_bg /etc/init.d/S36irqaffinity
start_bg /etc/init.d/S40network
start_bg /etc/init.d/S46btsink
start_bg /etc/init.d/S50avahi-daemon
start_bg /etc/init.d/S50crond
start_bg /etc/init.d/S50sshd
start_bg /etc/init.d/S70samba
start_bg /etc/init.d/S75syncthing
start_bg /etc/init.d/S91smb

start_bg /etc/init.d/S30wifi
start_bg /etc/init.d/S49ntp

# dbus-uuidgen used to run in rcS and wait for crng (~9 s). Seed
# /tmp/dbus from the squashfs id so this is cheap, then BT.
(
	[ -x /etc/init.d/S30dbus-daemon ] && /etc/init.d/S30dbus-daemon start
	[ -x /etc/init.d/S35btusb ] && /etc/init.d/S35btusb start
	[ -x /etc/init.d/S40bluetoothd ] && /etc/init.d/S40bluetoothd start
	[ -x /etc/init.d/S45bluealsa ] && /etc/init.d/S45bluealsa start
) >/tmp/zlyme-bt-late.log 2>&1 &

_up=0
read -r _up _rest < /proc/uptime || true
echo "$_up rc.late-forked" >> /tmp/boot-timing

# After an OTA squashfs swap. Never from S18: that blocked the list.
if [ -f /storage/.update/reapply ] && [ -x /usr/sbin/zlyme-update ]; then
	/usr/sbin/zlyme-update reapply >/dev/null 2>&1 &
fi

# /tmp is gone if the panel hangs and the card is pulled. Snapshot after
# NextUI has had a chance at DRM.
(
	n=0
	while [ "$n" -lt 6 ]; do
		sleep 5
		cp /tmp/boot-timing /storage/.config/zlyme/boot-timing 2>/dev/null || true
		cp /tmp/nextui.txt /storage/.config/nextui/my355/logs/nextui.txt 2>/dev/null || true
		n=$((n + 1))
	done
) &
