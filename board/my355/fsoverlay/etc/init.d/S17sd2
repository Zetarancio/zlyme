#!/bin/sh
#
# Mount a library card (second SD / OTG) into NextUI. Hotplug is eudev;
# this covers devices that were already present before udevd started.

start() {
	printf "Storage extras: "
	if [ -x /usr/sbin/zlyme-storage ]; then
		/usr/sbin/zlyme-storage start >>/tmp/zlyme-storage.log 2>&1
		/usr/sbin/zlyme-storage status | tr '\n' ' '
		echo
	else
		echo "missing"
	fi
	return 0
}

stop() {
	[ -x /usr/sbin/zlyme-storage ] && /usr/sbin/zlyme-storage eject >/dev/null 2>&1
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
