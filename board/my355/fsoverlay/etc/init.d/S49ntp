#!/bin/sh
#
# Clock bootstrap, then BusyBox ntpd.
#
# The RK3566 RTC often sits at 2017 without a battery. TLS then fails
# because the certificate is "not yet valid". An HTTP Date sample from
# 1.1.1.1 corrects that before ntpd starts. ntpd corrects drift after
# that, including a later association and a resume. rc.late starts this
# in the background after the first frame. No route, or Wi-Fi left off,
# is not a boot failure.
#
# RTC writes are UTC. The bootstrap writes the RTC. The timezone file
# is not touched.
#
# BusyBox 1.37.0 ntpd -S runs this script. The argument is an action:
# step, stratum, periodic, or unsync. The offset is the environment
# variable offset (printf %f), not an argument. Only step writes the
# RTC, and only when the absolute integer seconds are 30 or more.
# stratum, periodic (about every 11 minutes), and unsync do not.
#
# start, kick, and reopen share one mkdir lock so two callers cannot
# launch two clients and reopen cannot kill the client it just
# started. rc.late, Wi-Fi, and resume already background this script.
# No route means no client is left polling.

http_date_to_stamp() {
	# "Tue, 15 Sep 2026 01:32:00 GMT" → "2026-09-15 01:32:00"
	# shellcheck disable=SC2086
	set -- $1
	day=$2
	mon=$3
	year=$4
	time=$5
	case "$mon" in
		Jan) m=01 ;; Feb) m=02 ;; Mar) m=03 ;; Apr) m=04 ;;
		May) m=05 ;; Jun) m=06 ;; Jul) m=07 ;; Aug) m=08 ;;
		Sep) m=09 ;; Oct) m=10 ;; Nov) m=11 ;; Dec) m=12 ;;
		*) return 1 ;;
	esac
	[ -n "$day" ] && [ -n "$year" ] && [ -n "$time" ] || return 1
	printf '%s-%s-%02d %s' "$year" "$m" "$day" "$time"
}

ntp_sleep() {
	[ "${ZLYME_NTP_NO_SLEEP:-}" = 1 ] && return 0
	sleep "$1"
}

pid_dir() {
	printf '%s' "${ZLYME_NTP_PIDDIR:-/var/run}"
}

ntpd_pid() {
	printf '%s/zlyme-ntpd.pid' "$(pid_dir)"
}

worker_pid() {
	printf '%s/zlyme-ntp.pid' "$(pid_dir)"
}

pid_alive() {
	f=$1
	[ -f "$f" ] || return 1
	pid=$(tr -d ' \t\r\n' < "$f")
	case "$pid" in
		''|*[!0-9]*) return 1 ;;
	esac
	kill -0 "$pid" 2>/dev/null
}

stop_pid() {
	f=$1
	[ -f "$f" ] || return 0
	pid=$(tr -d ' \t\r\n' < "$f")
	# The lock holder records itself as the worker. Stopping that
	# file from inside the holder would kill the replacement.
	# read is a builtin. A command substitution would be a different pid.
	read -r self _ < /proc/self/stat
	if [ "$pid" = "$self" ]; then
		return 0
	fi
	rm -f "$f"
	case "$pid" in
		''|*[!0-9]*) return 0 ;;
	esac
	kill "$pid" 2>/dev/null || true
	wait "$pid" 2>/dev/null || true
}

have_route() {
	if [ -n "${ZLYME_NTP_ROUTE+x}" ]; then
		[ "$ZLYME_NTP_ROUTE" = 1 ]
		return
	fi
	gw=$(ip -4 route show default 2>/dev/null | awk '{print $3; exit}')
	[ -n "$gw" ]
}

clock_year() {
	if [ -n "${ZLYME_NTP_YEAR:-}" ]; then
		printf '%s' "$ZLYME_NTP_YEAR"
		return 0
	fi
	date +%Y
}

fetch_date() {
	if [ -n "${ZLYME_NTP_CURL_DATE+x}" ]; then
		printf '%s\n' "$ZLYME_NTP_CURL_DATE"
		return 0
	fi
	curl -sI --max-time 4 http://1.1.1.1 2>/dev/null \
		| sed -n 's/^[Dd]ate:[[:space:]]*//p' | tr -d '\r' | head -n 1
}

write_rtc_if_large() {
	off=$1
	case "$off" in
		+*) off=${off#+} ;;
		-*) off=${off#-} ;;
	esac
	int=${off%%.*}
	frac=${off#*.}
	[ "$frac" = "$off" ] && frac=
	case "$int" in
		''|*[!0-9]*) return 0 ;;
	esac
	case "$frac" in
		*[!0-9]*) return 0 ;;
	esac
	[ "$int" -ge 30 ] || return 0
	hwclock -u -w >/dev/null 2>&1 || true
}

bootstrap() {
	year=$(clock_year)
	case "$year" in
		''|*[!0-9]*) return 0 ;;
	esac
	[ "$year" -lt 2024 ] || return 0
	i=0
	tries=${ZLYME_NTP_BOOT_TRIES:-8}
	while [ "$i" -lt "$tries" ]; do
		hdr=$(fetch_date)
		stamp=
		[ -n "$hdr" ] && stamp=$(http_date_to_stamp "$hdr")
		if [ -n "$stamp" ] && date -u -s "$stamp" >/dev/null 2>&1; then
			hwclock -u -w >/dev/null 2>&1 || true
			return 0
		fi
		if [ -n "$hdr" ] && date -u -D "%a, %d %b %Y %H:%M:%S GMT" -s "$hdr" >/dev/null 2>&1; then
			hwclock -u -w >/dev/null 2>&1 || true
			return 0
		fi
		ntp_sleep 2
		i=$((i + 1))
	done
	return 0
}

wait_route() {
	# Wi-Fi off and no route: do not poll. A route from something else
	# still syncs.
	if command -v zlyme-ctl >/dev/null 2>&1 && ! zlyme-ctl want wifi; then
		have_route
		return
	fi
	n=0
	tries=${ZLYME_NTP_TRIES:-40}
	while [ "$n" -lt "$tries" ]; do
		if have_route; then
			return 0
		fi
		ntp_sleep 0.5
		n=$((n + 1))
	done
	return 1
}

lock_dir() {
	printf '%s/zlyme-ntp.lock' "$(pid_dir)"
}

release_lock() {
	# The directory holds the owner pid, so rmdir would leave it behind.
	rm -rf "$(lock_dir)"
}

acquire_lock() {
	mkdir -p "$(pid_dir)" 2>/dev/null || return 1
	i=0
	while ! mkdir "$(lock_dir)" 2>/dev/null; do
		i=$((i + 1))
		# Longer than a route wait plus the HTTP bootstrap. sleep is
		# real here: ZLYME_NTP_NO_SLEEP must not make a waiter give up
		# while the holder is still inside the lock.
		[ "$i" -ge 2000 ] && return 1
		holder=$(tr -d ' \t\r\n' < "$(lock_dir)/pid" 2>/dev/null || true)
		case "$holder" in
			''|*[!0-9]*)
				# The owner publishes its pid immediately. An empty
				# pid after a couple of seconds is a leaked lock.
				if [ "$i" -ge 40 ]; then
					rm -rf "$(lock_dir)"
				fi
				;;
			*)
				if ! kill -0 "$holder" 2>/dev/null; then
					rm -rf "$(lock_dir)"
				fi
				;;
		esac
		sleep 0.05
	done
	read -r self _ < /proc/self/stat
	printf '%s\n' "$self" > "$(lock_dir)/pid" || {
		release_lock
		return 1
	}
	return 0
}

sync_body() {
	if ! wait_route; then
		# The network is down. Do not leave the client polling.
		stop_pid "$(ntpd_pid)"
		return 0
	fi
	if [ -z "${ZLYME_NTP_ROUTE+x}" ]; then
		gw=$(ip -4 route show default 2>/dev/null | awk '{print $3; exit}')
		if [ -n "$gw" ]; then
			ping -c 1 -W 2 "$gw" >/dev/null 2>&1 || ping -c 2 -W 2 "$gw" >/dev/null 2>&1 || true
		fi
	fi
	bootstrap || true
	if ! command -v ntpd >/dev/null 2>&1; then
		return 0
	fi
	if pid_alive "$(ntpd_pid)"; then
		return 0
	fi
	# Host tests hold the lock across this pause so overlapping
	# start/kick/reopen calls are forced to meet.
	if [ -n "${ZLYME_NTP_HOLD:-}" ]; then
		sleep "$ZLYME_NTP_HOLD"
	fi
	if pid_alive "$(ntpd_pid)"; then
		return 0
	fi
	ntpd -n -p time.cloudflare.com -p pool.ntp.org -S "$0" >/dev/null 2>&1 &
	echo $! > "$(ntpd_pid)"
}

spawn_locked() {
	mode=$1
	mkdir -p "$(pid_dir)" 2>/dev/null || return 0
	if [ "${ZLYME_NTP_FOREGROUND:-}" = 1 ]; then
		acquire_lock || return 0
		if [ "$mode" = reopen ]; then
			stop_pid "$(ntpd_pid)"
		fi
		sync_body
		release_lock
		return 0
	fi
	(
		owned=0
		release_owned() {
			if [ "$owned" = 1 ]; then
				owned=0
				release_lock
			fi
		}
		trap 'release_owned; exit 0' INT TERM
		trap release_owned EXIT
		if ! acquire_lock; then
			exit 0
		fi
		owned=1
		if [ "$mode" = reopen ]; then
			stop_pid "$(ntpd_pid)"
		fi
		sync_body
		release_owned
	) >/dev/null 2>&1 &
	echo $! > "$(worker_pid)"
}

start() {
	mkdir -p "$(pid_dir)" 2>/dev/null || return 0
	# ZLYME_NTP_FORCE skips this shortcut so host tests can overlap
	# callers that would otherwise see the worker and return.
	if [ "${ZLYME_NTP_FORCE:-}" != 1 ] \
		&& have_route \
		&& { pid_alive "$(ntpd_pid)" || pid_alive "$(worker_pid)"; }; then
		return 0
	fi
	spawn_locked start
}

stop() {
	stop_pid "$(worker_pid)"
	if acquire_lock; then
		stop_pid "$(ntpd_pid)"
		release_lock
	else
		stop_pid "$(ntpd_pid)"
	fi
}

case "${1:-}" in
	start|kick) start ;;
	stop) stop ;;
	reopen) spawn_locked reopen ;;
	restart|reload) stop; start ;;
	step) write_rtc_if_large "${offset:-}" ;;
	stratum|periodic|unsync) ;;
	"") ;;
	*) ;;
esac
