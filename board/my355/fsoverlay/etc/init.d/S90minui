#!/bin/sh
#
# Stop NextUI on shutdown (busybox init stops higher S## first).
# Start is S28minui so the panel is up before WiFi/BT waits.

start() {
	return 0
}

stop() {
	# Session already exec'd zlyme-halt. Killing it mid-unmount leaves
	# squashfs busy and the board never powers off.
	if [ -f /tmp/poweroff ] || [ -f /tmp/reboot ]; then
		return 0
	fi
	killall -9 nextui.elf settings.elf minui.elf 2>/dev/null
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; /etc/init.d/S28minui start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
