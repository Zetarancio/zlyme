#!/bin/sh
#
# Frontend. Serial stays on ttyS2; this takes the panel.
# Touch /storage/.minui-disable or /storage/.nextui-disable
# to keep a shell-only boot.

bind_if() {
	[ -e "$1" ] && [ -e "$2" ] && mount --bind "$1" "$2" 2>/dev/null || true
}

start() {
	if [ -e /storage/.minui-disable ] || [ -e /storage/.nextui-disable ]; then
		echo "NextUI: disabled"
		return 0
	fi
	if [ ! -x /usr/sbin/nextui-session ] && [ ! -x /usr/sbin/minui-session ]; then
		echo "NextUI: missing"
		return 0
	fi
	# Card copies survive a reboot; squashfs does not.
	bind_if /storage/.system/nextui-session /usr/sbin/nextui-session
	bind_if /storage/.system/minui-session /usr/sbin/minui-session
	bind_if /storage/.system/my355/bin/nextui.elf /usr/bin/nextui.elf
	bind_if /storage/.system/my355/bin/settings.elf /usr/bin/settings.elf
	bind_if /storage/.system/my355/bin/show.elf /usr/bin/show.elf
	bind_if /storage/.system/my355/bin/minarch.elf /usr/bin/minarch.elf
	bind_if /storage/.system/my355/lib/libmsettings.so /usr/lib/libmsettings.so
	bind_if /storage/.system/nextui-paks /usr/share/nextui/paks
	bind_if /storage/.system/minui-paks /usr/share/minui/paks
	bind_if /storage/.system/S30wifi /etc/init.d/S30wifi
	bind_if /storage/.system/zoneinfo /usr/share/zoneinfo
	printf "Starting NextUI: "
	# Background: busybox init waits for S## start to return.
	if [ -x /usr/sbin/nextui-session ]; then
		nextui-session > /tmp/nextui.log 2>&1 &
	else
		minui-session > /tmp/minui.log 2>&1 &
	fi
	echo "OK"
}

stop() {
	# SIGTERM becomes SDL_QUIT and used to call PWR_powerOff.
	killall -9 nextui.elf settings.elf minui.elf nextui-session minui-session 2>/dev/null
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
