#!/bin/sh
# One PulseAudio 17 process, as the pulse user Buildroot creates.
#
# Do not pass --system. PulseAudio 17 system mode calls
# pa_make_secure_dir() on /var/lib/pulse before it drops privileges.
# /var/lib is on the read-only squashfs, so the process exits with
# "Failed to create '/var/lib/pulse': Read-only file system" and never
# creates the socket. start-stop-daemon -c pulse:pulse runs initgroups,
# so the process is in audio and pulse-access and can open the RK817
# and talk to BlueALSA. It is not a root daemon.
#
# Buildroot's own service refuses module loads after startup.
# This instance does not. zlyme-audio loads the HDMI and
# Bluetooth sinks later. There is still one server and no TCP module.
#
# The socket inode is mode 0777 because that is what PulseAudio 17
# does. The directory is mode 0700 and owned by pulse. auth-anonymous
# is off. Clients authenticate with the pulse-access group or the
# cookie file in that directory. Root is not in pulse-access. Root
# reads the cookie. There is no other local user.
#
# daemonize is not used. A fork is not a running server. This script
# returns as soon as the process is launched. A later check records
# alive, socket, or ready. ready means the codec sink is listed.
# A dead process records failed and the daemon's own error line.
# That check does not delay the frontend. The log is
# /run/zlyme/pulse/daemon.log, not syslog: syslogd starts later.

DAEMON=/usr/bin/pulseaudio
LAUNCH=/usr/sbin/zlyme-pulse-launch

pulse_paths() {
	RUNTIME=${ZLYME_PULSE_RUNTIME:-/run/zlyme/pulse}
	PIDFILE=$RUNTIME/pid
	STATUS=$RUNTIME/service
	DAEMON=${ZLYME_PULSE_BIN:-/usr/bin/pulseaudio}
	LAUNCH=${ZLYME_PULSE_LAUNCH:-/usr/sbin/zlyme-pulse-launch}
}

pulse_token_ok() {
	pulse_paths
	[ -n "${1:-}" ] || return 1
	[ -f "$RUNTIME/boot-id" ] || return 1
	got=$(cat "$RUNTIME/boot-id" 2>/dev/null || true)
	[ "$got" = "$1" ]
}

pulse_set_status() {
	pulse_paths
	pulse_token_ok "${2:-}" || return 0
	printf '%s\n' "$1" > "$STATUS"
}

# Last Pulse error line, without the cookie and without control bytes.
pulse_fail_reason() {
	pulse_paths
	log=$RUNTIME/daemon.log
	exitf=$RUNTIME/exit
	code=
	msg=
	if [ -f "$exitf" ]; then
		code=$(tr -cd '0-9' < "$exitf" | head -c 3)
	fi
	if [ -f "$log" ]; then
		open=$(grep -E 'Error opening PCM|Failed to set hardware parameters' "$log" 2>/dev/null | tail -n 1 || true)
		if [ -n "$open" ]; then
			line=$open
		else
			line=$(grep '^E:' "$log" 2>/dev/null | tail -n 1 || true)
		fi
		# BusyBox tr does not treat a POSIX character class as one.
		# Keep the ASCII range instead of that class.
		msg=${line#[EIW]: }
		case $msg in
			*.c:*) msg=${msg#*.c: } ;;
		esac
		msg=$(printf '%s' "$msg" | tr -cd ' -~' | head -c 160)
	fi
	if [ -n "$code" ] && [ -n "$msg" ]; then
		printf 'failed: exit %s: %s\n' "$code" "$msg"
	elif [ -n "$msg" ]; then
		printf 'failed: %s\n' "$msg"
	elif [ -n "$code" ]; then
		printf 'failed: exit %s\n' "$code"
	else
		printf '%s\n' 'failed: daemon exited during startup'
	fi
}

pulse_set_failed() {
	pulse_paths
	pulse_token_ok "${1:-}" || return 0
	pulse_fail_reason > "$STATUS"
}

pulse_cmd_is_launcher() {
	cmd=$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null || true)
	case $cmd in
		*zlyme-pulse-launch*) return 0 ;;
	esac
	return 1
}

pulse_environ_is_ours() {
	tr '\0' '\n' < "/proc/$1/environ" 2>/dev/null |
		grep -Fx "PULSE_RUNTIME_PATH=$2" >/dev/null 2>&1
}

pulse_our_daemon() {
	pulse_paths
	for pid in $(pidof pulseaudio 2>/dev/null || true); do
		if pulse_environ_is_ours "$pid" "$RUNTIME"; then
			return 0
		fi
	done
	return 1
}

pulse_launcher_alive() {
	pulse_paths
	[ -f "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null || true)
	[ -n "$pid" ] || return 1
	kill -0 "$pid" 2>/dev/null || return 1
	pulse_cmd_is_launcher "$pid"
}

# 0: slot is free. 2: our server is already up. 3: some other
# pulseaudio is running; leave it alone.
pulse_clear_stale() {
	pulse_paths
	if [ -f "$PIDFILE" ]; then
		pid=$(cat "$PIDFILE" 2>/dev/null || true)
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			if pulse_cmd_is_launcher "$pid"; then
				return 2
			fi
			rm -f "$PIDFILE"
		else
			rm -f "$PIDFILE"
		fi
	fi
	if pulse_our_daemon; then
		return 2
	fi
	if pidof pulseaudio >/dev/null 2>&1; then
		printf '%s\n' 'failed: another pulseaudio is running' > "$STATUS"
		return 3
	fi
	if [ -S "$RUNTIME/native" ]; then
		rm -f "$RUNTIME/native"
	fi
	return 0
}

pulse_stop_ours() {
	pulse_paths
	rm -f "$RUNTIME/boot-id"
	if [ -S "$RUNTIME/native" ]; then
		PULSE_SERVER="unix:${RUNTIME}/native" \
		PULSE_COOKIE="$RUNTIME/cookie" \
			pactl exit >/dev/null 2>&1 || true
	fi
	if [ -f "$PIDFILE" ]; then
		pid=$(cat "$PIDFILE" 2>/dev/null || true)
		if [ -n "$pid" ] && pulse_cmd_is_launcher "$pid"; then
			kill "$pid" 2>/dev/null || true
		fi
		rm -f "$PIDFILE"
	fi
	for pid in $(pidof pulseaudio 2>/dev/null || true); do
		if pulse_environ_is_ours "$pid" "$RUNTIME"; then
			kill "$pid" 2>/dev/null || true
		fi
	done
	rm -f "$STATUS" "$RUNTIME/native"
}

pulse_snd_access() {
	# devtmpfs creates these nodes root:root mode 0600. udev later
	# sets group audio. Until then snd_ctl_hw_open fails, and
	# snd_card_get_index reports that as "Cannot get card index".
	# S21 runs immediately after udev is started. This does not
	# choose a card index. It only makes an existing node usable
	# by the pulse user, who is in group audio.
	for node in /dev/snd/controlC* /dev/snd/pcmC*D*p /dev/snd/pcmC*D*c; do
		[ -e "$node" ] || continue
		[ -c "$node" ] || continue
		chgrp audio "$node" 2>/dev/null || true
		chmod 0660 "$node" 2>/dev/null || true
	done
}

ready_check() {
	token=$1
	i=0
	# udev coldplug is still running when this starts. Five seconds
	# was not enough on d1e6368: six lookups of the real id rk817ext
	# failed, and the same id opened later. Thirty seconds stays in
	# the background and does not hold the first frame.
	limit=${ZLYME_PULSE_READY_LIMIT:-30}
	while [ "$i" -lt "$limit" ]; do
		pulse_paths
		if ! pulse_token_ok "$token"; then
			return 0
		fi
		if pulse_our_daemon; then
			if [ -S "$RUNTIME/native" ]; then
				pulse_set_status socket "$token"
				pulse_snd_access
				zlyme-audio codec-up >/dev/null 2>&1 || true
				if zlyme-audio pulse-service; then
					pulse_set_status ready "$token"
					if [ "${ZLYME_PULSE_NO_MIGRATE:-}" != 1 ]; then
						zlyme-audio migrate-volume ||
							printf '%s\n' 'volume migration deferred' >> "$STATUS"
					fi
					return 0
				fi
			else
				pulse_set_status alive "$token"
			fi
		elif ! pulse_launcher_alive; then
			pulse_set_failed "$token"
			return 0
		fi
		i=$((i + 1))
		sleep 1
	done
	pulse_paths
	if ! pulse_token_ok "$token"; then
		return 0
	fi
	if zlyme-audio codec-up >/dev/null 2>&1 && zlyme-audio pulse-service; then
		pulse_set_status ready "$token"
		if [ "${ZLYME_PULSE_NO_MIGRATE:-}" != 1 ]; then
			zlyme-audio migrate-volume ||
				printf '%s\n' 'volume migration deferred' >> "$STATUS"
		fi
	elif [ -S "$RUNTIME/native" ] && pulse_our_daemon; then
		if grep -q '^E:' "$RUNTIME/daemon.log" 2>/dev/null; then
			pulse_set_failed "$token"
		else
			pulse_set_status 'failed: socket is up, codec sink is not usable' "$token"
		fi
	elif pulse_our_daemon; then
		pulse_set_status 'failed: daemon is up, native socket is not ready' "$token"
	else
		pulse_set_failed "$token"
	fi
	return 0
}

start() {
	pulse_paths
	[ -x "$DAEMON" ] || {
		printf '%s\n' 'pulseaudio: /usr/bin/pulseaudio is missing' > /run/zlyme/pulse-missing
		return 0
	}
	if ! id pulse >/dev/null 2>&1; then
		mkdir -p "$RUNTIME" 2>/dev/null || true
		printf '%s\n' 'pulseaudio: pulse user is missing' > "$STATUS"
		echo "Starting pulseaudio: FAIL"
		return 0
	fi
	if [ ! -x "$LAUNCH" ]; then
		mkdir -p "$RUNTIME" 2>/dev/null || true
		printf '%s\n' 'failed: launcher is missing' > "$STATUS"
		echo "Starting pulseaudio: FAIL"
		return 0
	fi
	mkdir -p "$RUNTIME" || {
		echo "Starting pulseaudio: FAIL"
		return 0
	}
	# The cookie and socket live under /run. Volume migration uses
	# /storage when that card is mounted. A missing card does not
	# stop the server.
	mkdir -p /storage/.config/zlyme 2>/dev/null || true
	chown pulse:pulse "$RUNTIME" || return 0
	chmod 0700 "$RUNTIME" || return 0
	rc=0
	pulse_clear_stale || rc=$?
	if [ "$rc" -eq 2 ]; then
		echo "Starting pulseaudio: already"
		return 0
	fi
	if [ "$rc" -eq 3 ]; then
		echo "Starting pulseaudio: FAIL"
		return 0
	fi
	token=$(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')
	[ -n "$token" ] || token=$$
	printf '%s\n' "$token" > "$RUNTIME/boot-id"
	printf '%s\n' launching > "$STATUS"
	: > "$RUNTIME/daemon.log"
	chown pulse:pulse "$RUNTIME/daemon.log" || true
	chmod 0600 "$RUNTIME/daemon.log" || true
	rm -f "$RUNTIME/exit"
	printf "Starting pulseaudio: "
	# --fail is the documented switch for a startup script error.
	# On PulseAudio 17 a failed module-alsa-sink was observed to be
	# logged while the process kept running. ready_check does not
	# treat that process as ready: ready requires the codec sink.
	if start-stop-daemon -S -b -m -p "$PIDFILE" -c pulse:pulse --exec "$LAUNCH"; then
		echo "launched"
		ready_check "$token" &
	else
		echo "FAIL"
		printf '%s\n' 'failed: could not launch' > "$STATUS"
	fi
	return 0
}

stop() {
	pulse_paths
	printf "Stopping pulseaudio: "
	pulse_stop_ours
	echo "stopped"
	return 0
}

if [ "${ZLYME_PULSE_LIB:-}" != 1 ]; then
	case "$1" in
		start) start ;;
		stop) stop ;;
		restart|reload) stop; start ;;
		*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
	esac
fi
