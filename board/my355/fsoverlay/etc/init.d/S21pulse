#!/bin/sh
# PulseAudio before the frontend and before zlyme-btsink. Daemonize
# returns when the process is up. It does not poll.

DAEMON=/usr/bin/pulseaudio
PIDFILE=/run/zlyme/pulse/pid
export PULSE_RUNTIME_PATH=/run/zlyme/pulse
export PULSE_STATE_PATH=/storage/.config/zlyme/pulse
export PULSE_COOKIE=/storage/.config/zlyme/pulse/cookie

start() {
	[ -x "$DAEMON" ] || return 0
	mkdir -p "$PULSE_RUNTIME_PATH" "$PULSE_STATE_PATH" || return 0
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
		echo "Starting pulseaudio: already"
		return 0
	fi
	printf "Starting pulseaudio: "
	if "$DAEMON" --daemonize=yes --exit-idle-time=-1 \
		--use-pid-file --fail \
		--file=/etc/pulse/zlyme.pa \
		--log-target=syslog; then
		echo OK
	else
		echo FAIL
		return 0
	fi
}

stop() {
	[ -x "$DAEMON" ] || return 0
	printf "Stopping pulseaudio: "
	PULSE_RUNTIME_PATH=/run/zlyme/pulse "$DAEMON" --kill >/dev/null 2>&1 || true
	echo OK
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
