#!/bin/sh
#
# Start NextUI as soon as storage, panel, and ALSA exist. WiFi/BT
# keep their later S## scripts so they do not delay the game list.
# Shutdown still uses S90minui stop (higher number stops first).

start() {
	if [ -e /storage/.minui-disable ] || [ -e /storage/.nextui-disable ]; then
		echo "NextUI: disabled"
		return 0
	fi
	# OTA extracts then reboots. rcS waits for S18; this is a belt
	# if something else calls S28 while boot-apply is still running.
	if [ -f /tmp/zlyme-ota ]; then
		echo "NextUI: deferred (OTA)"
		return 0
	fi
	if [ ! -x /usr/sbin/nextui-session ] && [ ! -x /usr/sbin/minui-session ]; then
		echo "NextUI: missing"
		return 0
	fi
	if pidof nextui-session >/dev/null 2>&1 || pidof minui-session >/dev/null 2>&1; then
		echo "NextUI: already running"
		return 0
	fi
	printf "Starting NextUI: "
	mkdir -p /storage/.config/zlyme /tmp
	# /tmp vanishes when the card is pulled; keep a copy on ZLYME.
	if [ -x /usr/sbin/nextui-session ]; then
		nextui-session >> /storage/.config/zlyme/nextui-session.log 2>&1 &
	else
		minui-session >> /storage/.config/zlyme/nextui-session.log 2>&1 &
	fi
	echo "OK"
}

stop() {
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
