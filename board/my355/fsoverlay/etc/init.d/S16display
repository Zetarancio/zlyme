#!/bin/sh
# Apply the saved DSI refresh once DRM is up. Splash itself is
# restarted in S12splash so S13resize can USR1 galaxy before we get here.

start() {
	# Do not spawn zlyme-ctl (it sources the whole flag script). Skip
	# the DSI write when the connector is already at the saved Hz.
	hz=60
	if [ -r /storage/.config/zlyme/refresh ]; then
		hz=$(tr -d ' \t\r\n' < /storage/.config/zlyme/refresh)
	fi
	case "$hz" in
		50|40|60) ;;
		*) hz=60 ;;
	esac
	want="640x480@${hz}"
	for c in /sys/class/drm/card*-DSI-*; do
		[ -e "$c/mode" ] || continue
		cur=$(tr -d ' \t\r\n' < "$c/mode" 2>/dev/null)
		[ "$cur" = "$want" ] && continue
		printf '%s\n' "$want" > "$c/mode" 2>/dev/null && break
	done
	if [ -s /storage/.config/zlyme/display_mode ]; then
		mode=$(tr -d ' \t\r\n' < /storage/.config/zlyme/display_mode)
		if [ -n "$mode" ]; then
			for c in /sys/class/drm/card*-HDMI-A-1; do
				[ -e "$c/mode" ] || continue
				printf '%s\n' "$mode" > "$c/mode" 2>/dev/null && break
			done
		fi
	fi
	# S12 already started the squashfs splash. Only restart if it
	# died; do not kill a running lockup (flicker, and resize/OTA
	# may already be on galaxy). Anim seed is S12splash.
	if [ -x /usr/sbin/zlyme-splash ] && ! pidof zlyme-splash >/dev/null 2>&1; then
		still=/usr/share/zlyme/splash.rgb565
		anim=/usr/share/zlyme/splash.anim
		pstill=/usr/share/zlyme/progress.rgb565
		panim=/usr/share/zlyme/progress.anim
		[ -f /boot/splash.anim ] && anim=/boot/splash.anim
		[ -f /boot/progress.anim ] && panim=/boot/progress.anim
		[ -f "$still" ] || still=/splash.rgb565
		[ -f "$pstill" ] || pstill=/progress.rgb565
		mode=
		if [ -f /tmp/zlyme-splash.progress ] || [ -f /boot/zlyme-splash.progress ]; then
			mode=progress
		fi
		/usr/sbin/zlyme-splash "$still" "$anim" "$pstill" "$panim" $mode \
			>/dev/null 2>&1 &
		echo $! > /tmp/zlyme-splash.pid
	fi
	# Do not udevtrigger here. A full add at S16 raced S17, loaded
	# 8733bu during nextui.elf, and blocked a udev worker for 180 s.
	# S29 coldplugs after the list (no block devices).
	return 0
}

stop() {
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
