#!/bin/sh
#
# Bring up WiFi. Do not load btusb here (combo chip, shared firmware).

. /etc/zlyme.conf

CONF="${ZLYME_CFG}/wpa_supplicant.conf"
IFACE=wlan0

# DHCP before association gets 169.254. Wait for COMPLETED, then udhcpc.
dhcp_after_assoc() {
	n=0
	while [ "$n" -lt 30 ]; do
		st=$(wpa_cli -p /var/run/wpa_supplicant -i "$IFACE" status 2>/dev/null | sed -n 's/^wpa_state=//p')
		[ "$st" = "COMPLETED" ] && break
		sleep 0.5
		n=$((n + 1))
	done
	if [ -f /var/run/udhcpc.$IFACE.pid ] && kill -0 "$(cat /var/run/udhcpc.$IFACE.pid 2>/dev/null)" 2>/dev/null; then
		return 0
	fi
	printf "Starting udhcpc on %s: " "$IFACE"
	if udhcpc -b -i "$IFACE" -t 8 -T 2 -p /var/run/udhcpc.$IFACE.pid >/dev/null 2>&1; then
		echo "OK"
	else
		echo "FAIL"
	fi
}

maybe_restart_ssh() {
	if command -v zlyme-ctl >/dev/null && zlyme-ctl want ssh; then
		[ -x /etc/init.d/S50dropbear ] && /etc/init.d/S50dropbear restart >/dev/null 2>&1 || true
	fi
}

start() {
	printf "Waiting for %s: " "$IFACE"
	i=0
	while [ ! -d "/sys/class/net/$IFACE" ] && [ $i -lt 50 ]; do
		sleep 0.1
		i=$((i + 1))
	done
	if [ ! -d "/sys/class/net/$IFACE" ]; then
		echo "absent -- check that rtl8733bu_power and 8733bu loaded"
		return 0
	fi
	echo "OK"

	if [ -f /var/run/wpa_supplicant.pid ] && kill -0 "$(cat /var/run/wpa_supplicant.pid)" 2>/dev/null; then
		echo "WiFi: already running"
		ip link set "$IFACE" up 2>/dev/null || true
		dhcp_after_assoc
		maybe_restart_ssh
		return 0
	fi

	if ! zlyme-ctl want wifi; then
		echo "WiFi: disabled by zlyme-ctl"
		return 0
	fi

	# After mem suspend the USB netdev exists but is DOWN. wpa then
	# exits and start-stop-daemon prints FAIL.
	ip link set "$IFACE" up 2>/dev/null || true
	rm -f /var/run/wpa_supplicant.pid

	if [ ! -s "$CONF" ] || ! grep -q ctrl_interface "$CONF" 2>/dev/null; then
		example="${ZLYME_CFG}/wpa_supplicant.conf.example"
		if [ -r "$example" ]; then
			cp "$example" "$CONF"
		else
			printf '%s\n' \
				'ctrl_interface=/var/run/wpa_supplicant' \
				'update_config=1' \
				'ap_scan=1' > "$CONF"
		fi
		echo "Seeded $CONF (no networks yet)"
	fi

	printf "Starting wpa_supplicant: "
	# Not -B: start-stop-daemon would see the parent exit and print FAIL.
	if start-stop-daemon -S -b -q -m -p /var/run/wpa_supplicant.pid \
		--exec /usr/sbin/wpa_supplicant -- \
		-P /var/run/wpa_supplicant.pid -i "$IFACE" -c "$CONF"
	then
		echo "OK"
	else
		echo "FAIL"
		return 0
	fi

	dhcp_after_assoc
	maybe_restart_ssh
	return 0
}

stop() {
	printf "Stopping WiFi: "
	start-stop-daemon -K -q -p /var/run/udhcpc.$IFACE.pid 2>/dev/null
	start-stop-daemon -K -q -p /var/run/wpa_supplicant.pid 2>/dev/null
	echo "OK"
	return 0
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		stop
		start
		;;
	*)
		echo "usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
