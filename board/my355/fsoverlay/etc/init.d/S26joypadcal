#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Phase 3B tracer plumbing. 3C/3D restores calibration restore.
#
# Do not modprobe rocknix-singleadc-joypad.
# Do not run zlyme-joypad-cal. Its restore waits up to 30s for the old
# sysfs node and then sleeps 12s. The tracer does not persist calibration.

start() {
	modprobe miyoo-flip-gamepad 2>/dev/null || true
	return 0
}

stop() {
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	*) echo "usage: $0 {start|stop}"; exit 1 ;;
esac
