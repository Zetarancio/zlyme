#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Load the Miyoo Flip gamepad and restore saved calibration.
#
# Restore does not wait for boot-center. If that center is already
# accepted, the driver keeps it. If it is not, the saved center is
# the runtime center until a later accept replaces it.
# Do not modprobe rocknix-singleadc-joypad.

start() {
	modprobe miyoo-flip-gamepad 2>/dev/null || true
	/usr/sbin/zlyme-gamepad-cal restore || echo "zlyme-gamepad-cal restore failed" >&2
	return 0
}

stop() {
	return 0
}

case "$1" in
start) start ;;
stop) stop ;;
*)
	echo "usage: $0 {start|stop}"
	exit 1
	;;
esac
