#!/bin/sh
# Grow the 32MB ZLYME exFAT seed to fill the card, then format it.
# Never fail the boot.
#
# Knulli S02resize: keep /boot mounted, umount storage, sgdisk -e,
# parted resizepart 100%, mkfs.exfat. ROCKNIX fs-resize: no partprobe,
# reboot -f. Do not umount /boot (squashfs loop). Do not partprobe or
# sed the vfat after GPT work (FAT1 -> u-boot Invalid FAT entry on
# /Image). Comment autoresize only on a later boot that already sees
# a grown ZLYME.

. /etc/zlyme.conf

LOG="/tmp/resize.log"
BOOTCONF="/boot/zlyme-boot.conf"

disk_of() {
	# /dev/mmcblk0p4 -> /dev/mmcblk0 ; /dev/sda1 -> /dev/sda
	if echo "$1" | grep -qE 'p[0-9]+$'; then
		echo "$1" | sed -e 's/p[0-9][0-9]*$//'
		return 0
	fi
	echo "$1" | sed -e 's/[0-9][0-9]*$//'
}

part_num_of() {
	echo "$1" | sed -e 's/.*[^0-9]//'
}

label_dev() {
	blkid | sed -n "s|^\\([^:]*\\):.*LABEL=\"$1\".*|\\1|p" | head -n 1
}

part_size_mb() {
	p=$1
	bytes=$(blockdev --getsize64 "$p" 2>/dev/null || true)
	if [ -z "$bytes" ] || [ "$bytes" = 0 ]; then
		b=$(basename "$p")
		sec=$(cat "/sys/class/block/$b/size" 2>/dev/null || echo 0)
		bytes=$((sec * 512))
	fi
	echo $((bytes / 1024 / 1024))
}

say() {
	msg="$*"
	echo "$msg"
	[ -d "$(dirname "$LOG")" ] && echo "$msg" >>"$LOG" 2>/dev/null || true
}

umount_path() {
	p=$1
	grep -q " $p " /proc/mounts || return 0
	umount "$p" >>"$LOG" 2>&1
}

# No GPT work here. /boot is a normal rw vfat.
remove_trigger() {
	mount -o remount,rw /boot >>"$LOG" 2>&1 || true
	if [ -f "$BOOTCONF" ]; then
		sed -i -e 's/^[ ]*autoresize/#autoresize/' "$BOOTCONF"
	fi
	sync
}

start() {
	if ! grep -qE '^[ ]*autoresize[ ]*=[ ]*true[ ]*$' "$BOOTCONF" 2>/dev/null; then
		return 0
	fi

	PART=$(label_dev ZLYME)
	if [ -z "$PART" ]; then
		for cand in /dev/mmcblk0p3 /dev/mmcblk1p3; do
			[ -b "$cand" ] || continue
			boot=$(label_dev ZLYMEBOOT)
			if [ -n "$boot" ]; then
				bdisk=$(disk_of "$boot")
				[ "$(disk_of "$cand")" = "$bdisk" ] || continue
			fi
			PART=$cand
			break
		done
	fi
	if [ -z "$PART" ]; then
		return 0
	fi

	PARTSIZE=$(part_size_mb "$PART")
	# Already grown. Latch the trigger; never mkfs a games card.
	if [ "$PARTSIZE" -gt 600 ]; then
		remove_trigger
		return 0
	fi

	say "Resizing storage: "
	: > "$LOG"
	if [ -x /usr/sbin/zlyme-splash-progress ]; then
		zlyme-splash-progress on
	else
		: > /tmp/zlyme-splash.progress
		killall -USR1 zlyme-splash >/dev/null 2>&1 || true
	fi

	DISK=$(disk_of "$PART")
	PARTNUM=$(part_num_of "$PART")
	if [ -z "$DISK" ] || [ -z "$PARTNUM" ]; then
		say "cannot parse $PART"
		return 0
	fi

	if [ ! -x /usr/sbin/sgdisk ] || [ ! -x /usr/sbin/parted ] || [ ! -x /usr/sbin/mkfs.exfat ]; then
		say "sgdisk/parted/mkfs.exfat missing"
		return 0
	fi

	# ROCKNIX: umount storage only. Never touch /boot.
	umount_path "$ZLYME_STORAGE"
	if grep -q " $ZLYME_STORAGE " /proc/mounts; then
		say "storage busy"
		return 0
	fi

	echo "Disk=$DISK Part=$PART PartNum=$PARTNUM size=${PARTSIZE}MB" >>"$LOG"
	sync

	TABLETYPE=$(parted -s "$DISK" print 2>/dev/null | grep 'Partition Table' | awk '{print $3}')
	echo "Disk partition table type = $TABLETYPE" >>"$LOG"
	if [ "$TABLETYPE" = "gpt" ]; then
		if ! sgdisk -e "$DISK" >>"$LOG" 2>&1; then
			say "sgdisk -e failed"
			return 0
		fi
	fi

	# parted resizepart uses BLKPG_RESIZE; skip partprobe (that is what
	# smashed FAT1 while this vfat was mounted).
	if ! parted -s -m -f "$DISK" resizepart "$PARTNUM" 100% >>"$LOG" 2>&1; then
		if ! parted -s -m "$DISK" resizepart "$PARTNUM" 100% >>"$LOG" 2>&1; then
			say "parted resizepart failed"
			return 0
		fi
	fi

	sleep 2
	echo "sysfs size=$(cat /sys/class/block/$(basename "$PART")/size 2>/dev/null) sectors" >>"$LOG"

	if ! mkfs.exfat -L ZLYME "$PART" >>"$LOG" 2>&1; then
		say "mkfs.exfat failed"
		return 0
	fi

	sync
	say "OK"
	# ROCKNIX always reboot -f after resize. Leave autoresize set; the
	# next boot sees a grown ZLYME and only comments the trigger.
	reboot -f
	return 0
}

case "$1" in
	start) start ;;
	stop) ;;
	restart|reload) start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
