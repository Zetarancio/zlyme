#!/bin/sh
# Apply a queued OS tar from /storage/.update *before* NextUI.
# rcS waits for this (does not fork it) so the list never comes up
# while the tar is still copying; success reboots and does not return.
#
# Drop /storage/.update/zlyme-my355-update.tar and reboot. This script
# extracts to /storage/.update/pending and copies Image/dtb/overlays
# onto /boot. Initramfs copies pending/zlyme over the live squashfs
# file. Flag reapply is rc.late: doing it here waited on S17's
# storage lock and left the splash on "applying settings after OS swap".

start() {
	[ -x /usr/sbin/zlyme-update ] || return 0
	upd=/usr/sbin/zlyme-update

	if "$upd" queued >/dev/null 2>&1; then
		printf "Zlyme update: "
		touch /tmp/zlyme-ota
		"$upd" boot-apply
		rm -f /tmp/zlyme-ota
		# Success reboots and does not return. Failure leaves
		# the old squashfs in place so boot can continue.
		echo "FAIL"
		return 0
	fi
}

stop() {
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	*) echo "usage: $0 {start|stop}"; exit 1 ;;
esac
