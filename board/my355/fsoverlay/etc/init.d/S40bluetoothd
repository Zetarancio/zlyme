#!/bin/sh
#
# Overlay of BlueZ's bluetoothd so it stays down when Bluetooth is off.
# Restore the tar onto tmpfs before the daemon starts.

NAME=bluetoothd
PIDFILE=/var/run/$NAME.pid

daemon() {
	for d in /usr/libexec/bluetooth/bluetoothd /usr/lib/bluetooth/bluetoothd /usr/sbin/bluetoothd; do
		if [ -x "$d" ]; then
			echo "$d"
			return 0
		fi
	done
	return 1
}

start() {
	if command -v zlyme-ctl >/dev/null && ! zlyme-ctl want bluetooth; then
		echo "bluetoothd: disabled by zlyme-ctl"
		return 0
	fi
	mkdir -p /run/bluetooth
	[ -x /usr/sbin/zlyme-bluetooth ] && /usr/sbin/zlyme-bluetooth restore
	DAEMON=$(daemon) || return 0
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
		echo "Starting $NAME: already running"
		[ -x /usr/sbin/zlyme-bluetooth ] && /usr/sbin/zlyme-bluetooth adapter-on
		[ -x /usr/sbin/zlyme-bluetooth ] && /usr/sbin/zlyme-bluetooth agent
		return 0
	fi
	printf "Starting %s: " "$NAME"
	if start-stop-daemon -S -q -b -m -p "$PIDFILE" --exec "$DAEMON"; then
		echo "OK"
	else
		echo "FAIL"
		return 0
	fi
	[ -x /usr/sbin/zlyme-bluetooth ] && /usr/sbin/zlyme-bluetooth adapter-on
	[ -x /usr/sbin/zlyme-bluetooth ] && /usr/sbin/zlyme-bluetooth agent
}

stop() {
	[ -x /usr/sbin/zlyme-bluetooth ] && /usr/sbin/zlyme-bluetooth save
	[ -x /usr/sbin/zlyme-bluetooth ] && /usr/sbin/zlyme-bluetooth agent-stop
	printf "Stopping %s: " "$NAME"
	start-stop-daemon -K -q -p "$PIDFILE" 2>/dev/null
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
