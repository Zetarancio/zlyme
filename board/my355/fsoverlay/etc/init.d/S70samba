#!/bin/sh
#
# Samba file share of /storage. Off until zlyme-ctl set samba on.

. /etc/zlyme.conf

start() {
	if ! command -v smbd >/dev/null; then
		return 0
	fi
	if ! zlyme-ctl want samba; then
		echo "Samba: disabled"
		return 0
	fi
	# squashfs /var/lib is read-only. Samba requires unix mode 0700 on
	# private/msg.sock; ZLYME is exFAT and cannot. Use tmpfs.
	RUNTIME=/tmp/samba-lib
	mkdir -p "$RUNTIME/private" /var/log/samba /var/run/samba 2>/dev/null
	chmod 0700 "$RUNTIME/private" 2>/dev/null || true
	if [ -d /var/lib/samba ] && [ ! -L /var/lib/samba ]; then
		mountpoint -q /var/lib/samba 2>/dev/null || \
			mount --bind "$RUNTIME" /var/lib/samba 2>/dev/null || true
	fi
	mkdir -p /var/lib/samba/private 2>/dev/null
	chmod 0700 /var/lib/samba/private 2>/dev/null || true
	printf "Starting smbd: "
	if start-stop-daemon -S -q --exec /usr/sbin/smbd -- -D; then
		echo "OK"
	else
		echo "FAIL"
	fi
	# smb.conf sets disable netbios = yes; nmbd then always FAILs.
}

stop() {
	start-stop-daemon -K -q --exec /usr/sbin/smbd 2>/dev/null
	start-stop-daemon -K -q --exec /usr/sbin/nmbd 2>/dev/null
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
