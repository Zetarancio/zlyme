#!/bin/sh
#
# Samba file share of /storage. Off until zlyme-ctl set samba on.
# Guest access is not a fallback. zlyme-samba-auth has to prepare the
# account before smbd starts. nmbd stays off (disable netbios = yes).

if [ -r /etc/zlyme.conf ]; then
	# shellcheck disable=SC1091
	. /etc/zlyme.conf
fi

start() {
	if ! command -v smbd >/dev/null; then
		return 0
	fi
	if ! zlyme-ctl want samba; then
		echo "Samba: disabled"
		return 0
	fi
	if ! zlyme-ctl want wifi; then
		echo "Samba: Wi-Fi is off"
		return 0
	fi
	if ! zlyme-samba-auth prepare; then
		echo "Samba: authentication failed"
		return 1
	fi
	# smbd creates ncalrpc inside this directory and does not create
	# the parent. A missing parent makes the process exit immediately.
	# The log directory is the same class of failure for a daemon start.
	mkdir -p /var/run/samba /var/cache/samba /var/lock/samba /var/log/samba || {
		echo "FAIL"
		return 1
	}
	printf "Starting smbd: "
	if ! start-stop-daemon -S -q --exec /usr/sbin/smbd -- -D; then
		echo "FAIL"
		return 1
	fi
	# start-stop-daemon returns when the parent exits. A child that
	# then quits must not be reported as a running share.
	if ! pidof smbd >/dev/null 2>&1; then
		echo "FAIL"
		start-stop-daemon -K -q --exec /usr/sbin/smbd 2>/dev/null || true
		return 1
	fi
	echo "OK"
}

stop() {
	start-stop-daemon -K -q --exec /usr/sbin/smbd 2>/dev/null
	start-stop-daemon -K -q --exec /usr/sbin/nmbd 2>/dev/null
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
