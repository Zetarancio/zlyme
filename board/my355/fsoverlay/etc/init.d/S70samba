#!/bin/sh
#
# Samba file share of /storage. Off until zlyme-ctl set samba on.
# Guest access is not a fallback. zlyme-samba-auth has to prepare the
# account before smbd starts. nmbd stays off (disable netbios = yes).

if [ -r /etc/zlyme.conf ]; then
	# shellcheck disable=SC1091
	. /etc/zlyme.conf
fi

start() {
	if ! command -v smbd >/dev/null; then
		return 0
	fi
	if ! zlyme-ctl want samba; then
		echo "Samba: disabled"
		return 0
	fi
	if ! zlyme-samba-auth prepare; then
		echo "Samba: authentication failed"
		return 1
	fi
	printf "Starting smbd: "
	if start-stop-daemon -S -q --exec /usr/sbin/smbd -- -D; then
		echo "OK"
	else
		echo "FAIL"
		return 1
	fi
}

stop() {
	start-stop-daemon -K -q --exec /usr/sbin/smbd 2>/dev/null
	start-stop-daemon -K -q --exec /usr/sbin/nmbd 2>/dev/null
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
