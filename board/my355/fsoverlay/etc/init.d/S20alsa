#!/bin/sh
#
# Restore the RK817 hardware mixer from /storage. Playback volume is
# PipeWire. This does not create a software mixer.

. /etc/zlyme.conf

CARD=rk817ext
STATE="${ZLYME_CFG}/asound.state"

start() {
	if [ ! -d "/proc/asound/${CARD}" ]; then
		echo "ALSA: no card ${CARD} -- skipping"
		return 0
	fi
	printf "Restoring hardware mixer: "
	if [ -r "$STATE" ] && alsactl -f "$STATE" -F restore "$CARD" >/dev/null 2>&1; then
		echo "OK"
	else
		echo "skipped"
	fi
	return 0
}

store() {
	[ -d "$(dirname "$STATE")" ] || return 0
	alsactl -f "$STATE" store "$CARD" >/dev/null 2>&1 || true
}

stop() {
	printf "Saving mixer state: "
	store
	echo "OK"
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
