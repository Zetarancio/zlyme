#!/bin/sh
# Coldplug after NextUI is already on screen (S28). No settle.

start() {
	command -v udevadm >/dev/null 2>&1 || return 0
	# S17 already claimed present library cards. Retriggering block
	# queued a second zlyme-storage add (zlyme38, killed at 372 s).
	udevadm trigger --type=subsystems --action=add
	udevadm trigger --type=devices --action=add --subsystem-nomatch=block
	return 0
}

stop() {
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
