#!/bin/sh
#
# After WiFi (or instead of it): tmpfs BlueZ store, hidp, then btusb.
# btusb is blacklisted until then so the combo chip does not reset.

. /etc/zlyme.conf

start() {
	mkdir -p /run/bluetooth
	# Never point this at the card: exFAT rejects colon names.

	if ! zlyme-ctl want bluetooth; then
		echo "Bluetooth: disabled by zlyme-ctl"
		return 0
	fi

	[ -x /usr/sbin/zlyme-combo ] && /usr/sbin/zlyme-combo bt-on

	printf "Loading hidp: "
	if modprobe hidp 2>/dev/null; then
		echo "OK"
	else
		echo "FAIL"
	fi
	modprobe uhid 2>/dev/null || true

	[ -x /usr/sbin/zlyme-bluetooth ] && /usr/sbin/zlyme-bluetooth restore

	printf "Loading btusb: "
	if modprobe btusb 2>/dev/null; then
		echo "OK"
	else
		echo "FAIL"
		return 0
	fi

	printf "Waiting for hci0: "
	i=0
	while [ ! -d /sys/class/bluetooth/hci0 ] && [ $i -lt 50 ]; do
		sleep 0.1
		i=$((i + 1))
	done
	if [ -d /sys/class/bluetooth/hci0 ]; then
		echo "OK"
	else
		echo "absent -- check rtl_bt firmware loaded"
	fi

	return 0
}

stop() {
	[ -x /usr/sbin/zlyme-bluetooth ] && /usr/sbin/zlyme-bluetooth save
	[ -x /usr/sbin/zlyme-combo ] && /usr/sbin/zlyme-combo bt-off
	return 0
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		start
		;;
	*)
		echo "usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
