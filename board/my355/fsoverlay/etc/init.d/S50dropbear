#!/bin/sh
#
# Overlay of Buildroot's S50dropbear so SSH can be off at boot.
# Host key is copied to tmpfs: exFAT has no mode bits, and dropbear
# exits if -r points at a world-readable key (connection refused).

[ -r /etc/default/dropbear ] && . /etc/default/dropbear
. /etc/zlyme.conf

NAME=dropbear
DAEMON=/usr/sbin/dropbear
KEYDIR=/var/run/dropbear
KEYFILE=$KEYDIR/dropbear_ed25519_host_key
STORE=${ZLYME_CFG}/dropbear/dropbear_ed25519_host_key

prepare_key() {
	mkdir -p "$KEYDIR" "${ZLYME_CFG}/dropbear" 2>/dev/null || true
	if [ -s "$STORE" ] && [ ! -s "$KEYFILE" ]; then
		cp "$STORE" "$KEYFILE" 2>/dev/null || true
	fi
	if [ ! -s "$KEYFILE" ] && command -v dropbearkey >/dev/null; then
		dropbearkey -t ed25519 -f "$KEYFILE" >/dev/null 2>&1 || true
		[ -s "$KEYFILE" ] && cp "$KEYFILE" "$STORE" 2>/dev/null || true
	fi
	chmod 600 "$KEYFILE" 2>/dev/null || true
}

start() {
	if command -v zlyme-ctl >/dev/null && ! zlyme-ctl want ssh; then
		echo "SSH: disabled by zlyme-ctl"
		return 0
	fi
	prepare_key
	ARGS="$DROPBEAR_ARGS"
	if [ -s "$KEYFILE" ]; then
		ARGS="-B -r $KEYFILE"
	fi
	printf "Starting %s: " "$NAME"
	if start-stop-daemon -S -q -p /var/run/$NAME.pid \
		--exec "$DAEMON" -- $ARGS
	then
		echo "OK"
	else
		echo "FAIL"
	fi
}

stop() {
	printf "Stopping %s: " "$NAME"
	start-stop-daemon -K -q -p /var/run/$NAME.pid
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
