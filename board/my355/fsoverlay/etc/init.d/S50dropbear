#!/bin/sh
#
# Overlay of Buildroot's S50dropbear so SSH can be off at boot.
# Host key path is still /etc/default/dropbear → ZLYME_CFG.

[ -r /etc/default/dropbear ] && . /etc/default/dropbear

NAME=dropbear
DAEMON=/usr/sbin/dropbear

start() {
	if command -v zlyme-ctl >/dev/null && ! zlyme-ctl want ssh; then
		echo "SSH: disabled by zlyme-ctl"
		return 0
	fi
	printf "Starting %s: " "$NAME"
	start-stop-daemon -S -q -p /var/run/$NAME.pid \
		--exec "$DAEMON" -- $DROPBEAR_ARGS
	echo "OK"
}

stop() {
	printf "Stopping %s: " "$NAME"
	start-stop-daemon -K -q -p /var/run/$NAME.pid
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
