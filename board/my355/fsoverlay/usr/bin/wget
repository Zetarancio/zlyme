#!/bin/sh
# BusyBox wget has no TLS. Pico-8 Splore calls:
#   wget "URL" -q -O "file"
#   wget "URL" -q -O "file" --post-file=...
# URL may come first. Speak a Wget user-agent; lexaloffle 404s curl's.
out=""
url=""
post=""
timeout=""
while [ $# -gt 0 ]; do
	case "$1" in
		-O)
			out=$2
			shift 2
			;;
		-O*)
			out=${1#-O}
			shift
			;;
		-q|--quiet|-c|--continue|--no-check-certificate|--no-verbose|-nv)
			shift
			;;
		--post-file=*)
			post=${1#--post-file=}
			shift
			;;
		--post-file)
			post=$2
			shift 2
			;;
		--timeout=*)
			timeout=${1#--timeout=}
			shift
			;;
		--timeout|-T)
			timeout=$2
			shift 2
			;;
		--header)
			shift 2
			;;
		-h|--help|--version)
			echo "GNU Wget 1.21.4"
			echo "Usage: wget [OPTION]... [URL]"
			echo "HTTPS supported."
			exit 0
			;;
		--)
			shift
			break
			;;
		-*)
			shift
			;;
		*)
			[ -z "$url" ] && url=$1
			shift
			;;
	esac
done
[ -n "$url" ] || url=$1
[ -n "$url" ] || exit 1
[ -n "$out" ] || out=$(printf '%s' "$url" | sed 's/[?#].*//; s|.*/||')
[ -n "$out" ] || exit 1
# No --fail: GNU wget still writes the body on 4xx (exit 8). Pico-8
# looks at the file, not curl's 22.
set -- curl -L -sS -A "Wget/1.21.4" --retry 2
[ -n "$timeout" ] && set -- "$@" --max-time "$timeout"
[ -n "$post" ] && set -- "$@" --data-binary @"$post"
exec "$@" -o "$out" "$url"
