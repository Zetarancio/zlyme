#!/bin/sh
# PortMaster and Wine scripts call lscpu. BusyBox does not ship it.
n=0
for c in /sys/devices/system/cpu/cpu[0-9]*; do
	[ -d "$c" ] && n=$((n + 1))
done
[ "$n" -gt 0 ] || n=4
printf 'Architecture:                aarch64\n'
printf 'CPU(s):                      %s\n' "$n"
printf 'Model name:                  Cortex-A55\n'
printf 'Byte Order:                  Little Endian\n'
exit 0
