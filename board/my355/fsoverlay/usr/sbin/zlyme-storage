#!/bin/sh
#
# Second SD slot and USB disks. Internal ROMs live in /storage/.roms_base.
# MergerFS pools that with SD2/USB Roms onto /storage/Roms so three PSP
# folders appear as one list. Duplicate basename: OS card first.

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

. /etc/zlyme.conf 2>/dev/null || true

SD2=/mnt/sd2
MEDIA=/mnt/media
ROMS=/storage/Roms
ROMS_BASE=/storage/.roms_base
BIOS=/storage/Bios

# /mnt/media is an empty dir on squashfs (read-only). Put a tmpfs on it
# so USB extras can mount as merge branches.
ensure_media() {
	mkdir -p "$MEDIA" 2>/dev/null || true
	if touch "$MEDIA/.w" 2>/dev/null; then
		rm -f "$MEDIA/.w"
		return 0
	fi
	mount -t tmpfs -o size=1M,mode=0755 zlyme-media "$MEDIA" 2>/dev/null || true
	if touch "$MEDIA/.w" 2>/dev/null; then
		rm -f "$MEDIA/.w"
		return 0
	fi
	MEDIA=/tmp/zlyme-media
	mkdir -p "$MEDIA"
}

disk_of() {
	dev=$1
	dev=${dev#/dev/}
	case "$dev" in
		mmcblk*p*) echo "${dev%%p*}" ;;
		nvme*n*p*) echo "${dev%%p*}" ;;
		*) echo "$dev" | sed 's/[0-9]*$//' ;;
	esac
}

os_disk() {
	for m in / /boot /storage; do
		src=$(awk -v m="$m" '$2 == m { print $1; exit }' /proc/mounts)
		[ -n "$src" ] || continue
		disk_of "$src"
		return 0
	done
	return 1
}

is_os_dev() {
	cand=$1
	od=$(os_disk) || return 1
	[ "$(disk_of "$cand")" = "$od" ]
}

is_boot_mmc() {
	case "$(disk_of "$1")" in
		mmcblk0) return 0 ;;
	esac
	return 1
}

unescape_mp() {
	printf '%s' "$1" | sed 's/\\040/ /g; s/\\011/\t/g'
}

unbind_under() {
	prefix=$1
	awk -v p="$prefix" '$2 ~ "^" p { print $2 }' /proc/mounts | sort -r |
		while read -r m; do
			m=$(unescape_mp "$m")
			umount "$m" 2>/dev/null || true
		done
}

is_library_root() {
	root=$1
	[ -d "$root/roms" ] && return 0
	[ -d "$root/Roms" ] && return 0
	[ -d "$root/ROMS" ] && return 0
	for d in "$root"/*; do
		[ -d "$d" ] || continue
		case "$(basename "$d")" in
			*'('*')') return 0 ;;
		esac
	done
	return 1
}

roms_dir_of() {
	root=$1
	if [ -d "$root/roms" ]; then
		echo "$root/roms"
		return 0
	fi
	if [ -d "$root/Roms" ]; then
		echo "$root/Roms"
		return 0
	fi
	if [ -d "$root/ROMS" ]; then
		echo "$root/ROMS"
		return 0
	fi
	for d in "$root"/*; do
		[ -d "$d" ] || continue
		case "$(basename "$d")" in
			*'('*')') echo "$root"; return 0 ;;
		esac
	done
	return 1
}

want_merge() {
	if command -v zlyme-ctl >/dev/null 2>&1; then
		zlyme-ctl want merge
		return $?
	fi
	return 0
}

ensure_roms_base() {
	mkdir -p "$ROMS_BASE" "$ROMS"
	if mountpoint -q "$ROMS" 2>/dev/null; then
		return 0
	fi
	# First image on an old card: move Pretty dirs out of Roms.
	find "$ROMS" -mindepth 1 -maxdepth 1 2>/dev/null |
	while IFS= read -r d; do
		name=$(basename "$d")
		[ -e "$ROMS_BASE/$name" ] && continue
		mv "$d" "$ROMS_BASE/" 2>/dev/null || true
	done
}

branches() {
	printf '%s' "$ROMS_BASE"
	for mp in "$SD2" "$MEDIA"/*; do
		[ -d "$mp" ] || continue
		d=$(roms_dir_of "$mp") || continue
		printf ':%s' "$d"
	done
	printf '\n'
}

rescan_nextui() {
	[ -f /tmp/zlyme-keep-emu ] && return 0
	for p in retroarch PPSSPPSDL flycast drastic moonlight pico8_64; do
		pidof "$p" >/dev/null 2>&1 && return 0
	done
	# SIGKILL before the first flip drops DRM master; deferred
	# takeover then keeps the splash forever (zlyme36 Etcher).
	grep -q 'nextui-first-flip' /tmp/boot-timing 2>/dev/null || return 0
	if pidof nextui.elf >/dev/null 2>&1; then
		kill -9 $(pidof nextui.elf) 2>/dev/null || true
	fi
}

roms_is_mergerfs() {
	awk -v m="$ROMS" '$2 == m && $3 ~ /mergerfs/ { found = 1 } END { exit !found }' /proc/mounts
}

roms_ctl() {
	printf '%s/.mergerfs' "$ROMS"
}

# NextUI bind-mounts .roms_base onto Roms for the first frame. One umount
# is not enough if S17/udev stacked more binds; mergerfs then sees dest
# as a branch ("branches can not include the mountpoint").
unmount_roms() {
	n=0
	while awk -v m="$ROMS" '$2 == m { found = 1 } END { exit !found }' /proc/mounts &&
		[ "$n" -lt 16 ]; do
		umount "$ROMS" 2>/dev/null || umount -l "$ROMS" 2>/dev/null || true
		n=$((n + 1))
	done
	unbind_under "$ROMS/"
}

# If Roms is already FUSE, add missing SD2/USB dirs without remounting
# (avoids "branches can not include the mountpoint").
add_rom_branches() {
	list=$1
	ctl=$(roms_ctl)
	[ -e "$ctl" ] || return 1
	cur=$(getfattr -n user.mergerfs.branches --only-values "$ctl" 2>/dev/null || true)
	added=0
	oldifs=$IFS
	IFS=:
	# shellcheck disable=SC2086
	set -- $list
	IFS=$oldifs
	for b in "$@"; do
		[ -n "$b" ] || continue
		[ -d "$b" ] || continue
		case "$cur" in
			*"$b"*) continue ;;
		esac
		if setfattr -n user.mergerfs.branches -v "+>$b" "$ctl" 2>>/tmp/zlyme-storage.log; then
			echo "merge xattr +$b" >> /tmp/zlyme-storage.log
			added=1
			cur="$cur:$b"
		fi
	done
	[ "$added" = 1 ]
}

merge_roms() {
	ensure_roms_base
	ensure_media
	{
		flock 9
		merge_roms_locked
	} 9>/tmp/zlyme-storage.lock
}

merge_roms_locked() {
	if ! want_merge; then
		if mountpoint -q "$ROMS" 2>/dev/null; then
			return 0
		fi
		mount --bind "$ROMS_BASE" "$ROMS" 2>/dev/null || true
		return 0
	fi
	list=$(branches)
	if ! command -v mergerfs >/dev/null 2>&1; then
		echo "mergerfs missing; bind .roms_base" >> /tmp/zlyme-storage.log
		mountpoint -q "$ROMS" 2>/dev/null ||
			mount --bind "$ROMS_BASE" "$ROMS" 2>/dev/null || true
		return 0
	fi
	if roms_is_mergerfs; then
		add_rom_branches "$list" || true
		return 0
	fi
	unmount_roms
	mkdir -p "$ROMS"
	if mergerfs -o "defaults,allow_other,use_ino,cache.files=off,dropcacheonclose=true,category.create=ff,minfreespace=0" \
		"$list" "$ROMS" 2>>/tmp/zlyme-storage.log
	then
		echo "merge $list" >> /tmp/zlyme-storage.log
	else
		echo "merge fail $list" >> /tmp/zlyme-storage.log
		# Do not stack another bind on a dest that is still a branch.
		if ! mountpoint -q "$ROMS" 2>/dev/null; then
			mount --bind "$ROMS_BASE" "$ROMS" 2>/dev/null || true
		fi
	fi
}

bind_bios() {
	[ -d "$BIOS" ] || mkdir -p "$BIOS" 2>/dev/null || return 0
	mountpoint -q "$BIOS" 2>/dev/null && return 0
	for cand in \
		"$SD2/roms/_orphans/bios" \
		"$SD2/Roms/_orphans/bios" \
		"$SD2/roms/bios" \
		"$SD2/Roms/bios" \
		"$SD2/Bios" \
		"$SD2/bios"
	do
		[ -d "$cand" ] || continue
		n=$(ls -A "$cand" 2>/dev/null | wc -l)
		[ "$n" -gt 0 ] || continue
		mount --bind "$cand" "$BIOS" 2>/dev/null || true
		return 0
	done
}

mount_fs() {
	dev=$1
	mp=$2
	raw=$(blkid "$dev" 2>/dev/null || true)
	typ=$(printf '%s' "$raw" | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p')
	[ -n "$typ" ] || typ=$(printf '%s' "$raw" | sed -n 's/.*TYPE=\([^ ]*\).*/\1/p' | tr -d '"')
	mkdir -p "$mp"
	case "$typ" in
		exfat|vfat|msdos|ext4|ext3|ext2|ntfs|f2fs)
			if mount -t "$typ" -o rw,noatime "$dev" "$mp"; then
				echo "mount $dev $mp type=$typ" >> /tmp/zlyme-storage.log
				return 0
			fi
			;;
	esac
	# blkid often has no TYPE until udev finishes; try the usual USB set.
	for t in ${typ:-} exfat vfat ntfs ext4; do
		[ -n "$t" ] || continue
		if mount -t "$t" -o rw,noatime "$dev" "$mp"; then
			echo "mount $dev $mp type=$t" >> /tmp/zlyme-storage.log
			return 0
		fi
	done
	if mount -o rw,noatime "$dev" "$mp"; then
		echo "mount $dev $mp type=${typ:-guess}" >> /tmp/zlyme-storage.log
		return 0
	fi
	echo "mount fail $dev type=${typ:-empty}" >> /tmp/zlyme-storage.log
	return 1
}

place_volume() {
	dev=$1
	tmp=$2
	label=$3
	name=$4
	if is_library_root "$tmp"; then
		if ! grep -q " $SD2 " /proc/mounts; then
			mkdir -p "$SD2"
			mount --move "$tmp" "$SD2" 2>/dev/null || {
				umount "$tmp" 2>/dev/null || true
				mount_fs "$dev" "$SD2" || return 0
			}
			rmdir "$tmp" 2>/dev/null || true
			return 0
		fi
	fi
	mp=$MEDIA/${label:-$name}
	mkdir -p "$mp"
	mount --move "$tmp" "$mp" 2>/dev/null || {
		umount "$tmp" 2>/dev/null || true
		mount_fs "$dev" "$mp" || true
	}
	rmdir "$tmp" 2>/dev/null || true
}

add_dev() {
	name=$1
	dev=/dev/$name
	[ -b "$dev" ] || return 0
	is_boot_mmc "$dev" && return 0
	is_os_dev "$dev" && return 0
	case "$name" in
		mmcblk[0-9]|mmcblk[0-9][0-9])
			[ -b "/dev/${name}p1" ] && return 0
			;;
		sd[a-z])
			[ -b "/dev/${name}1" ] && return 0
			;;
	esac
	label=$(blkid "$dev" 2>/dev/null | sed -n 's/.*LABEL="\([^"]*\)".*/\1/p')
	case "$label" in
		ZLYME|ZLYMEBOOT) return 0 ;;
	esac
	if awk -v d="$dev" '$1 == d { found=1 } END { exit !found }' /proc/mounts; then
		merge_roms
		bind_bios
		return 0
	fi
	tmp=$(mktemp -d /tmp/zlyme-probe.XXXXXX) || return 0
	if ! mount_fs "$dev" "$tmp"; then
		rmdir "$tmp" 2>/dev/null || true
		return 0
	fi
	ensure_media
	place_volume "$dev" "$tmp" "$label" "$name"
	merge_roms
	bind_bios
	rescan_nextui
}

remove_dev() {
	name=$1
	dev=/dev/$name
	mp=$(awk -v d="$dev" '$1 == d { print $2; exit }' /proc/mounts)
	[ -n "$mp" ] || return 0
	mp=$(unescape_mp "$mp")
	case "$mp" in
		"$SD2"|/mnt/sd2)
			umount "$SD2" 2>/dev/null || true
			;;
		*)
			umount "$mp" 2>/dev/null || true
			;;
	esac
	merge_roms
	rescan_nextui
}

scan_add() {
	for dev in /dev/mmcblk1p1 /dev/mmcblk2p1 /dev/mmcblk1 /dev/sda1 /dev/sdb1 /dev/sdc1 /dev/sda; do
		[ -b "$dev" ] || continue
		add_dev "${dev#/dev/}"
	done
}

status() {
	if grep -q " $SD2 " /proc/mounts; then
		echo "sd2=mounted"
		src=$(awk -v m="$SD2" '$2 == m { print $1; exit }' /proc/mounts)
		echo "sd2_dev=$src"
	else
		echo "sd2=empty"
	fi
	if mountpoint -q "$ROMS" 2>/dev/null; then
		src=$(awk -v m="$ROMS" '$2 == m { print $1; exit }' /proc/mounts)
		echo "roms_fs=$src"
	else
		echo "roms_fs=unmounted"
	fi
}

case "${1:-}" in
	start|scan)
		scan_add
		merge_roms
		bind_bios
		;;
	bind|merge)
		merge_roms
		bind_bios
		rescan_nextui
		;;
	add)
		[ -n "${2:-}" ] || exit 0
		add_dev "$2"
		;;
	remove)
		[ -n "${2:-}" ] || exit 0
		remove_dev "$2"
		;;
	stop|eject)
		unmount_roms
		unbind_under "$BIOS"
		if grep -q " $SD2 " /proc/mounts; then
			umount "$SD2" 2>/dev/null || umount -l "$SD2" 2>/dev/null || true
		fi
		ensure_roms_base
		mount --bind "$ROMS_BASE" "$ROMS" 2>/dev/null || true
		rescan_nextui
		;;
	status) status ;;
	*)
		echo "usage: $0 {start|bind|merge|add <dev>|remove <dev>|eject|status}" >&2
		exit 1
		;;
esac
