#!/bin/sh
#
# Second SD and USB disks. NextUI scans each root from
# /run/zlyme/libraries. No mergerfs, no .roms_base, no Bios bind.
# The second SD slot is the board's sdmmc1 controller (mmc@fe2c0000,
# alias mmc1, regulator vcc_sd2). The boot slot is mmc@fe2b0000.
# A blank card in that slot is still SD2. USB disks stay under
# /mnt/media even when they already contain Roms. The directory name
# is one child of /mnt/media: spaces stay, '/' and control characters
# become '-', and a second disk with the same name uses
# <name>-<device> instead of stacking.

# Tests set ZLYME_STORAGE_PATH so a fake mount(8) is visible. The device
# keeps a fixed PATH because early userspace does not have a login path.
if [ -n "${ZLYME_STORAGE_PATH:-}" ]; then
	export PATH="$ZLYME_STORAGE_PATH"
else
	export PATH=/usr/sbin:/usr/bin:/sbin:/bin
fi

# Optional. A missing file must not abort: "." is a special builtin.
if [ -r /etc/zlyme.conf ]; then
	. /etc/zlyme.conf
fi

# ZLYME_STORAGE_MOUNTS, ZLYME_LIBRARIES_FILE, ZLYME_STORAGE_MEDIA,
# ZLYME_STORAGE_SD2, and ZLYME_STORAGE_DEV_ROOT are test seams.
# ZLYME_MOUNTS_LIB selects the mount-table helper.
SD2=${ZLYME_STORAGE_SD2:-/mnt/sd2}
MEDIA=${ZLYME_STORAGE_MEDIA:-/mnt/media}
LIBRARIES=${ZLYME_LIBRARIES_FILE:-/run/zlyme/libraries}

mounts_file() {
	printf '%s\n' "${ZLYME_STORAGE_MOUNTS:-/proc/mounts}"
}

need_mounts() {
	if command -v mounts_has >/dev/null 2>&1; then
		return 0
	fi
	lib=${ZLYME_MOUNTS_LIB:-/usr/share/zlyme/mounts.sh}
	if [ ! -r "$lib" ]; then
		echo "zlyme-storage: mount table helper is missing" >&2
		return 1
	fi
	# shellcheck disable=SC1090
	. "$lib"
}

block_node() {
	name=${1#/dev/}
	if [ -n "${ZLYME_STORAGE_DEV_ROOT:-}" ]; then
		printf '%s\n' "${ZLYME_STORAGE_DEV_ROOT}/$name"
		return 0
	fi
	printf '%s\n' "/dev/$name"
}

is_block() {
	if [ -n "${ZLYME_STORAGE_DEV_ROOT:-}" ]; then
		[ -e "$1" ]
		return
	fi
	[ -b "$1" ]
}

ensure_media() {
	mkdir -p "$MEDIA" 2>/dev/null || true
	if touch "$MEDIA/.w" 2>/dev/null; then
		rm -f "$MEDIA/.w"
		return 0
	fi
	mount -t tmpfs -o size=1M,mode=0755 zlyme-media "$MEDIA" 2>/dev/null || true
	if touch "$MEDIA/.w" 2>/dev/null; then
		rm -f "$MEDIA/.w"
		return 0
	fi
	MEDIA=/tmp/zlyme-media
	mkdir -p "$MEDIA"
}

disk_of() {
	dev=$1
	dev=${dev#/dev/}
	case "$dev" in
		mmcblk*p*) echo "${dev%%p*}" ;;
		nvme*n*p*) echo "${dev%%p*}" ;;
		*) echo "$dev" | sed 's/[0-9]*$//' ;;
	esac
}

os_disk() {
	need_mounts || return 1
	for m in / /boot /storage; do
		src=$(mounts_source "$(mounts_file)" "$m" 2>/dev/null || true)
		[ -n "$src" ] || continue
		disk_of "$src"
		return 0
	done
	return 1
}

is_os_dev() {
	cand=$1
	od=$(os_disk) || return 1
	[ "$(disk_of "$cand")" = "$od" ]
}

is_boot_mmc() {
	case "$(disk_of "$1")" in
		mmcblk0) return 0 ;;
	esac
	return 1
}

# One directory under MEDIA. Spaces and ordinary punctuation stay.
# '/' would escape the parent, so it becomes '-'. Control characters
# would break the mount table and the library list. '\' stays: the
# mount table stores it as \134 and mounts_decode restores it.
# '.' , '..', and an empty result use the kernel device name.
# tr is already in the minimal userspace.
media_component() {
	label=$1
	name=$2
	if [ -z "$label" ]; then
		printf '%s\n' "$name"
		return 0
	fi
	text=$(printf '%s' "$label" | tr '/\000-\037\177' '-') || text=
	while :; do
		case "$text" in
			' '*) text=${text# } ;;
			*' ') text=${text% } ;;
			*) break ;;
		esac
	done
	if [ -z "$text" ] || [ "$text" = "." ] || [ "$text" = ".." ]; then
		text=$name
	fi
	case "$text" in
		*/*|"."|"..")
			text=$name
			;;
	esac
	printf '%s\n' "$text"
}

# Do not stack a second device on a mountpoint that is already taken.
choose_mountpoint() {
	comp=$1
	dev=$2
	name=$3
	try=$MEDIA/$comp
	owner=$(mounts_source "$(mounts_file)" "$try" 2>/dev/null || true)
	if [ -z "$owner" ] || [ "$owner" = "$dev" ]; then
		printf '%s\n' "$try"
		return 0
	fi
	try=$MEDIA/${comp}-${name}
	owner=$(mounts_source "$(mounts_file)" "$try" 2>/dev/null || true)
	if [ -z "$owner" ] || [ "$owner" = "$dev" ]; then
		printf '%s\n' "$try"
		return 0
	fi
	echo "mountpoint busy $MEDIA/$comp" >> /tmp/zlyme-storage.log
	return 1
}

sysfs_root() {
	printf '%s\n' "${ZLYME_STORAGE_SYSFS:-/sys}"
}

block_syspath() {
	name=$1
	root=$(sysfs_root)
	[ -e "$root/class/block/$name" ] || return 1
	readlink -f "$root/class/block/$name"
}

# disk_of strips the trailing index from a whole mmcblk disk. Slot
# identity needs that index, and the partition's parent disk.
slot_disk() {
	name=${1#/dev/}
	case "$name" in
		mmcblk*p*) printf '%s\n' "${name%%p*}" ;;
		mmcblk*) printf '%s\n' "$name" ;;
		*) disk_of "$name" ;;
	esac
}

# Secondary SD is the controller, not "this volume already looks like a library".
is_secondary_sd() {
	name=${1#/dev/}
	case "$name" in
		mmcblk*) ;;
		*) return 1 ;;
	esac
	disk=$(slot_disk "$name")
	path=$(block_syspath "$disk" || true)
	if [ -z "$path" ]; then
		path=$(block_syspath "$name" || true)
	fi
	case "$path" in
		*fe2c0000.mmc*) return 0 ;;
	esac
	return 1
}

is_usb_disk() {
	name=${1#/dev/}
	disk=$(slot_disk "$name")
	path=$(block_syspath "$disk" || true)
	if [ -z "$path" ]; then
		path=$(block_syspath "$name" || true)
	fi
	case "$path" in
		*usb[0-9]*) return 0 ;;
	esac
	[ "${ID_BUS:-}" = usb ]
}

rescan_nextui() {
	# Libraries are already current. Sync the Splore row before NextUI
	# is told to reread the ROM folders.
	# Bump the BIOS generation. Do not delete a cache or staging tree
	# a launch may be publishing. The same path can be a different card.
	rundir=${ZLYME_STORAGE_RUN:-/run/zlyme}
	mkdir -p "$rundir"
	gen=$rundir/bios-generation
	n=0
	if [ -r "$gen" ]; then
		n=$(tr -cd '0-9' < "$gen")
		[ -n "$n" ] || n=0
	fi
	n=$((n + 1))
	printf '%s\n' "$n" > "$gen"
	rm -f "$rundir/bios"
	if [ -x /usr/sbin/zlyme-pico-splore ]; then
		/usr/sbin/zlyme-pico-splore || true
	fi
	[ -f /tmp/zlyme-keep-emu ] && return 0
	for p in retroarch PPSSPPSDL flycast drastic moonlight pico8_64 aethersx2 dolphin-emu-nogui; do
		pidof "$p" >/dev/null 2>&1 && return 0
	done
	pid=$(pidof nextui.elf 2>/dev/null) || return 0
	[ -n "$pid" ] || return 0
	kill -USR1 $pid 2>/dev/null || true
}

write_libraries() {
	need_mounts || return 0
	mkdir -p "$(dirname "$LIBRARIES")"
	tmp=$(mktemp "$(dirname "$LIBRARIES")/libraries.XXXXXX") || return 0
	{
		echo /storage
		if mounts_has "$(mounts_file)" "$SD2"; then
			echo "$SD2"
		fi
		ensure_media
		for d in "$MEDIA"/*; do
			[ -d "$d" ] || continue
			mounts_has "$(mounts_file)" "$d" || continue
			echo "$d"
		done
	} > "$tmp"
	mv -f "$tmp" "$LIBRARIES"
}

extra_mounted() {
	need_mounts || return 1
	if mounts_has "$(mounts_file)" "$SD2"; then
		return 0
	fi
	body=$(mounts_targets "$(mounts_file)") || return 1
	found=1
	while IFS= read -r target || [ -n "$target" ]; do
		[ -n "$target" ] || continue
		case "$target" in
			"$MEDIA"/*)
				found=0
				break
				;;
		esac
	done <<END_ZLYME_MOUNTS
$body
END_ZLYME_MOUNTS
	return "$found"
}

mount_fs() {
	dev=$1
	mp=$2
	typ=${ID_FS_TYPE:-}
	if [ -z "$typ" ]; then
		raw=$(blkid "$dev" 2>/dev/null || true)
		typ=$(printf '%s' "$raw" | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p')
		[ -n "$typ" ] || typ=$(printf '%s' "$raw" | sed -n 's/.*TYPE=\([^ ]*\).*/\1/p' | tr -d '"')
	fi
	mkdir -p "$mp"
	case "$typ" in
		exfat|vfat|msdos|ext4|ext3|ext2|ntfs|f2fs)
			if mount -t "$typ" -o rw,noatime "$dev" "$mp"; then
				echo "mount $dev $mp type=$typ" >> /tmp/zlyme-storage.log
				return 0
			fi
			;;
	esac
	if mount -o rw,noatime "$dev" "$mp"; then
		echo "mount $dev $mp type=${typ:-guess}" >> /tmp/zlyme-storage.log
		return 0
	fi
	echo "mount fail $dev type=${typ:-empty}" >> /tmp/zlyme-storage.log
	return 1
}

place_volume() {
	dev=$1
	tmp=$2
	label=$3
	name=$4
	if is_secondary_sd "$name"; then
		need_mounts || return 1
		if ! mounts_has "$(mounts_file)" "$SD2"; then
			mkdir -p "$SD2"
			mount --move "$tmp" "$SD2" 2>/dev/null || {
				umount "$tmp" 2>/dev/null || true
				mount_fs "$dev" "$SD2" || return 0
			}
			rmdir "$tmp" 2>/dev/null || true
			return 0
		fi
	fi
	ensure_media
	need_mounts || return 1
	comp=$(media_component "$label" "$name") || return 1
	mp=$(choose_mountpoint "$comp" "$dev" "$name") || {
		umount "$tmp" 2>/dev/null || umount -l "$tmp" 2>/dev/null || true
		rmdir "$tmp" 2>/dev/null || true
		return 1
	}
	case "$mp" in
		"$MEDIA"/*) ;;
		*)
			echo "refusing mountpoint $mp" >> /tmp/zlyme-storage.log
			umount "$tmp" 2>/dev/null || true
			rmdir "$tmp" 2>/dev/null || true
			return 1
			;;
	esac
	# One child. A slash left in the component would mkdir outside MEDIA.
	rest=${mp#"$MEDIA"/}
	case "$rest" in
		*/*|"."|"..")
			echo "refusing mountpoint $mp" >> /tmp/zlyme-storage.log
			umount "$tmp" 2>/dev/null || true
			rmdir "$tmp" 2>/dev/null || true
			return 1
			;;
	esac
	mkdir -p -- "$mp"
	mount --move "$tmp" "$mp" 2>/dev/null || {
		umount "$tmp" 2>/dev/null || true
		mount_fs "$dev" "$mp" || true
	}
	rmdir "$tmp" 2>/dev/null || true
}

add_dev() {
	name=$1
	dev=$(block_node "$name")
	is_block "$dev" || return 0
	is_boot_mmc "$dev" && return 0
	is_os_dev "$dev" && return 0
	case "$name" in
		mmcblk[0-9]|mmcblk[0-9][0-9])
			[ -b "/dev/${name}p1" ] && return 0
			;;
		sd[a-z])
			[ -b "/dev/${name}1" ] && return 0
			;;
	esac
	label=${ID_FS_LABEL:-}
	if [ -z "$label" ]; then
		label=$(blkid "$dev" 2>/dev/null | sed -n 's/.*LABEL="\([^"]*\)".*/\1/p')
	fi
	case "$label" in
		ZLYME|ZLYMEBOOT) return 0 ;;
	esac
	need_mounts || return 0
	# Already mounted: refresh the library list. The source compare is
	# decoded so a space in another field cannot hide this device.
	if mounts_has_source "$(mounts_file)" "$dev"; then
		write_libraries
		rescan_nextui
		return 0
	fi
	tmp=$(mktemp -d /tmp/zlyme-probe.XXXXXX) || return 0
	if ! mount_fs "$dev" "$tmp"; then
		rmdir "$tmp" 2>/dev/null || true
		return 0
	fi
	ensure_media
	place_volume "$dev" "$tmp" "$label" "$name"
	write_libraries
	rescan_nextui
}

remove_dev() {
	name=$1
	dev=$(block_node "$name")
	need_mounts || return 0
	mp=$(mounts_target_of "$(mounts_file)" "$dev" 2>/dev/null || true)
	[ -n "$mp" ] || return 0
	case "$mp" in
		"$SD2"|/mnt/sd2)
			umount "$SD2" 2>/dev/null || umount -l "$SD2" 2>/dev/null || true
			;;
		*)
			umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null || true
			;;
	esac
	write_libraries
	rescan_nextui
}

scan_add() {
	for dev in /dev/mmcblk[1-9]p1 /dev/mmcblk[1-9] /dev/sd[a-z]1 /dev/sd[a-z]; do
		[ -b "$dev" ] || continue
		add_dev "${dev#/dev/}"
	done
}

eject_extras() {
	need_mounts || return 0
	if mounts_has "$(mounts_file)" "$SD2"; then
		umount "$SD2" 2>/dev/null || umount -l "$SD2" 2>/dev/null || true
	fi
	ensure_media
	for d in "$MEDIA"/*; do
		[ -d "$d" ] || continue
		umount "$d" 2>/dev/null || umount -l "$d" 2>/dev/null || true
	done
	write_libraries
	rescan_nextui
}

status() {
	need_mounts || return 1
	if mounts_has "$(mounts_file)" "$SD2"; then
		echo "sd2=mounted"
		src=$(mounts_source "$(mounts_file)" "$SD2" 2>/dev/null || true)
		echo "sd2_dev=$src"
	else
		echo "sd2=empty"
	fi
	if extra_mounted; then
		echo "extra=mounted"
	else
		echo "extra=empty"
	fi
	if [ -f "$LIBRARIES" ]; then
		echo "libraries=$(tr '\n' ' ' < "$LIBRARIES")"
	fi
}

case "${1:-}" in
	start|scan)
		scan_add
		write_libraries
		rescan_nextui
		;;
	add)
		[ -n "${2:-}" ] || exit 0
		add_dev "$2"
		;;
	remove)
		[ -n "${2:-}" ] || exit 0
		remove_dev "$2"
		;;
	stop|eject)
		eject_extras
		;;
	status) status ;;
	classify)
		[ -n "${2:-}" ] || exit 1
		if is_secondary_sd "$2"; then
			echo secondary-sd
		elif is_usb_disk "$2"; then
			echo usb
		else
			echo other
		fi
		;;
	libraries)
		write_libraries
		[ -f "$LIBRARIES" ] && cat "$LIBRARIES"
		;;
	bind|merge)
		# leftover from mergerfs; just refresh the list
		write_libraries
		rescan_nextui
		;;
	*)
		echo "usage: $0 {start|add <dev>|remove <dev>|eject|status|classify <dev>|libraries}" >&2
		exit 1
		;;
esac
