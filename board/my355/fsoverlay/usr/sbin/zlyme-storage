#!/bin/sh
#
# Second SD and USB disks. NextUI scans each root from
# /run/zlyme/libraries. No mergerfs, no .roms_base, no Bios bind.

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

. /etc/zlyme.conf 2>/dev/null || true

SD2=/mnt/sd2
MEDIA=/mnt/media
LIBRARIES=/run/zlyme/libraries

ensure_media() {
	mkdir -p "$MEDIA" 2>/dev/null || true
	if touch "$MEDIA/.w" 2>/dev/null; then
		rm -f "$MEDIA/.w"
		return 0
	fi
	mount -t tmpfs -o size=1M,mode=0755 zlyme-media "$MEDIA" 2>/dev/null || true
	if touch "$MEDIA/.w" 2>/dev/null; then
		rm -f "$MEDIA/.w"
		return 0
	fi
	MEDIA=/tmp/zlyme-media
	mkdir -p "$MEDIA"
}

disk_of() {
	dev=$1
	dev=${dev#/dev/}
	case "$dev" in
		mmcblk*p*) echo "${dev%%p*}" ;;
		nvme*n*p*) echo "${dev%%p*}" ;;
		*) echo "$dev" | sed 's/[0-9]*$//' ;;
	esac
}

os_disk() {
	for m in / /boot /storage; do
		src=$(awk -v m="$m" '$2 == m { print $1; exit }' /proc/mounts)
		[ -n "$src" ] || continue
		disk_of "$src"
		return 0
	done
	return 1
}

is_os_dev() {
	cand=$1
	od=$(os_disk) || return 1
	[ "$(disk_of "$cand")" = "$od" ]
}

is_boot_mmc() {
	case "$(disk_of "$1")" in
		mmcblk0) return 0 ;;
	esac
	return 1
}

unescape_mp() {
	printf '%s' "$1" | sed 's/\\040/ /g; s/\\011/\t/g'
}

is_library_root() {
	root=$1
	[ -d "$root/roms" ] && return 0
	[ -d "$root/Roms" ] && return 0
	[ -d "$root/ROMS" ] && return 0
	for d in "$root"/*; do
		[ -d "$d" ] || continue
		case "$(basename "$d")" in
			*'('*')') return 0 ;;
		esac
	done
	return 1
}

rescan_nextui() {
	[ -f /tmp/zlyme-keep-emu ] && return 0
	for p in retroarch PPSSPPSDL flycast drastic moonlight pico8_64 aethersx2 dolphin-emu-nogui; do
		pidof "$p" >/dev/null 2>&1 && return 0
	done
	pid=$(pidof nextui.elf 2>/dev/null) || return 0
	[ -n "$pid" ] || return 0
	kill -USR1 $pid 2>/dev/null || true
}

write_libraries() {
	mkdir -p /run/zlyme
	tmp=$(mktemp /run/zlyme/libraries.XXXXXX) || return 0
	{
		echo /storage
		if awk -v m="$SD2" '$2 == m { found=1 } END { exit !found }' /proc/mounts; then
			echo "$SD2"
		fi
		ensure_media
		for d in "$MEDIA"/*; do
			[ -d "$d" ] || continue
			awk -v m="$d" '$2 == m { found=1 } END { exit !found }' /proc/mounts || continue
			echo "$d"
		done
	} > "$tmp"
	mv -f "$tmp" "$LIBRARIES"
}

extra_mounted() {
	awk -v s="$SD2" '
		$2 == s { found=1 }
		$2 ~ /^\/mnt\/media\// { found=1 }
		END { exit !found }
	' /proc/mounts
}

mount_fs() {
	dev=$1
	mp=$2
	typ=${ID_FS_TYPE:-}
	if [ -z "$typ" ]; then
		raw=$(blkid "$dev" 2>/dev/null || true)
		typ=$(printf '%s' "$raw" | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p')
		[ -n "$typ" ] || typ=$(printf '%s' "$raw" | sed -n 's/.*TYPE=\([^ ]*\).*/\1/p' | tr -d '"')
	fi
	mkdir -p "$mp"
	case "$typ" in
		exfat|vfat|msdos|ext4|ext3|ext2|ntfs|f2fs)
			if mount -t "$typ" -o rw,noatime "$dev" "$mp"; then
				echo "mount $dev $mp type=$typ" >> /tmp/zlyme-storage.log
				return 0
			fi
			;;
	esac
	if mount -o rw,noatime "$dev" "$mp"; then
		echo "mount $dev $mp type=${typ:-guess}" >> /tmp/zlyme-storage.log
		return 0
	fi
	echo "mount fail $dev type=${typ:-empty}" >> /tmp/zlyme-storage.log
	return 1
}

place_volume() {
	dev=$1
	tmp=$2
	label=$3
	name=$4
	if is_library_root "$tmp"; then
		if ! grep -q " $SD2 " /proc/mounts; then
			mkdir -p "$SD2"
			mount --move "$tmp" "$SD2" 2>/dev/null || {
				umount "$tmp" 2>/dev/null || true
				mount_fs "$dev" "$SD2" || return 0
			}
			rmdir "$tmp" 2>/dev/null || true
			return 0
		fi
	fi
	ensure_media
	mp=$MEDIA/${label:-$name}
	mkdir -p "$mp"
	mount --move "$tmp" "$mp" 2>/dev/null || {
		umount "$tmp" 2>/dev/null || true
		mount_fs "$dev" "$mp" || true
	}
	rmdir "$tmp" 2>/dev/null || true
}

add_dev() {
	name=$1
	dev=/dev/$name
	[ -b "$dev" ] || return 0
	is_boot_mmc "$dev" && return 0
	is_os_dev "$dev" && return 0
	case "$name" in
		mmcblk[0-9]|mmcblk[0-9][0-9])
			[ -b "/dev/${name}p1" ] && return 0
			;;
		sd[a-z])
			[ -b "/dev/${name}1" ] && return 0
			;;
	esac
	label=${ID_FS_LABEL:-}
	if [ -z "$label" ]; then
		label=$(blkid "$dev" 2>/dev/null | sed -n 's/.*LABEL="\([^"]*\)".*/\1/p')
	fi
	case "$label" in
		ZLYME|ZLYMEBOOT) return 0 ;;
	esac
	if awk -v d="$dev" '$1 == d { found=1 } END { exit !found }' /proc/mounts; then
		write_libraries
		return 0
	fi
	tmp=$(mktemp -d /tmp/zlyme-probe.XXXXXX) || return 0
	if ! mount_fs "$dev" "$tmp"; then
		rmdir "$tmp" 2>/dev/null || true
		return 0
	fi
	ensure_media
	place_volume "$dev" "$tmp" "$label" "$name"
	write_libraries
	rescan_nextui
}

remove_dev() {
	name=$1
	dev=/dev/$name
	mp=$(awk -v d="$dev" '$1 == d { print $2; exit }' /proc/mounts)
	[ -n "$mp" ] || return 0
	mp=$(unescape_mp "$mp")
	case "$mp" in
		"$SD2"|/mnt/sd2)
			umount "$SD2" 2>/dev/null || umount -l "$SD2" 2>/dev/null || true
			;;
		*)
			umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null || true
			;;
	esac
	write_libraries
	rescan_nextui
}

scan_add() {
	for dev in /dev/mmcblk1p1 /dev/mmcblk2p1 /dev/mmcblk1 /dev/sda1 /dev/sdb1 /dev/sdc1 /dev/sda; do
		[ -b "$dev" ] || continue
		add_dev "${dev#/dev/}"
	done
}

eject_extras() {
	if grep -q " $SD2 " /proc/mounts; then
		umount "$SD2" 2>/dev/null || umount -l "$SD2" 2>/dev/null || true
	fi
	ensure_media
	for d in "$MEDIA"/*; do
		[ -d "$d" ] || continue
		umount "$d" 2>/dev/null || umount -l "$d" 2>/dev/null || true
	done
	write_libraries
	rescan_nextui
}

status() {
	if grep -q " $SD2 " /proc/mounts; then
		echo "sd2=mounted"
		src=$(awk -v m="$SD2" '$2 == m { print $1; exit }' /proc/mounts)
		echo "sd2_dev=$src"
	else
		echo "sd2=empty"
	fi
	if extra_mounted; then
		echo "extra=mounted"
	else
		echo "extra=empty"
	fi
	if [ -f "$LIBRARIES" ]; then
		echo "libraries=$(tr '\n' ' ' < "$LIBRARIES")"
	fi
}

case "${1:-}" in
	start|scan)
		scan_add
		write_libraries
		;;
	add)
		[ -n "${2:-}" ] || exit 0
		add_dev "$2"
		;;
	remove)
		[ -n "${2:-}" ] || exit 0
		remove_dev "$2"
		;;
	stop|eject)
		eject_extras
		;;
	status) status ;;
	libraries)
		write_libraries
		[ -f "$LIBRARIES" ] && cat "$LIBRARIES"
		;;
	bind|merge)
		# leftover from mergerfs; just refresh the list
		write_libraries
		rescan_nextui
		;;
	*)
		echo "usage: $0 {start|add <dev>|remove <dev>|eject|status|libraries}" >&2
		exit 1
		;;
esac
