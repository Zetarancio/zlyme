#!/bin/sh
# One PipeWire, one WirePlumber, one pipewire-pulse.
# pipewire-pulse is a symlink to the pipewire ELF. Identity is argv[0],
# not the resolved inode. Root owns the processes. Runtime is /run.
set -eu

RT="${ZLYME_PW_RUNTIME:-/run/zlyme/pipewire}"
HOME_DIR="${ZLYME_PW_HOME:-$RT/home}"
STATUS="$RT/service"
PW="${ZLYME_PIPEWIRE:-/usr/bin/pipewire}"
WP="${ZLYME_WIREPLUMBER:-/usr/bin/wireplumber}"
PP="${ZLYME_PIPEWIRE_PULSE:-/usr/bin/pipewire-pulse}"

export XDG_RUNTIME_DIR="$RT"
export PIPEWIRE_RUNTIME_DIR="$RT"
export HOME="$HOME_DIR"
if [ -S /run/dbus/system_bus_socket ]; then
	export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/dbus/system_bus_socket"
fi

status() {
	mkdir -p "$RT" 2>/dev/null || true
	printf '%s\n' "$1" > "$STATUS" 2>/dev/null || true
}

# $1 pidfile $2 argv token that must appear in cmdline
ours() {
	pidf=$1
	token=$2
	[ -f "$pidf" ] || return 1
	pid=$(cat "$pidf" 2>/dev/null) || return 1
	echo "$pid" | grep -Eq '^[0-9]+$' || return 1
	kill -0 "$pid" 2>/dev/null || return 1
	# A script's argv0 is the interpreter. Match any argument's basename
	# so pipewire-pulse is not mistaken for pipewire.
	tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | sed 's|.*/||' | grep -qx "$token"
}

start_one() {
	name=$1
	bin=$2
	token=$3
	pidf="$RT/$name.pid"
	[ -x "$bin" ] || return 1
	if ours "$pidf" "$token"; then
		return 0
	fi
	rm -f "$pidf"
	start-stop-daemon -S -q -b -m -p "$pidf" --exec "$bin"
}

stop_one() {
	name=$1
	token=$2
	pidf="$RT/$name.pid"
	if ours "$pidf" "$token"; then
		start-stop-daemon -K -q -p "$pidf" 2>/dev/null || true
	fi
	rm -f "$pidf"
}

wait_sock() {
	n=0
	while [ "$n" -lt 50 ]; do
		[ -S "$1" ] && return 0
		sleep 0.1
		n=$((n + 1))
	done
	return 1
}

case "${1:-start}" in
start)
	mkdir -p "$RT/pulse" "$HOME_DIR"
	chmod 0755 "$RT" "$RT/pulse" "$HOME_DIR" || true
	status launching
	start_one pipewire "$PW" pipewire || { status "failed: pipewire"; exit 1; }
	wait_sock "$RT/pipewire-0" || { status "failed: core socket"; exit 1; }
	status core
	start_one wireplumber "$WP" wireplumber || { status "failed: wireplumber"; exit 1; }
	status wireplumber
	start_one pulse "$PP" pipewire-pulse || { status "failed: pipewire-pulse"; exit 1; }
	wait_sock "$RT/pulse/native" || { status "failed: pulse socket"; exit 1; }
	status pulse
	audio=${ZLYME_AUDIO:-/usr/sbin/zlyme-audio}
	if [ -x "$audio" ]; then
		"$audio" migrate-volume >/dev/null 2>&1 || true
		"$audio" route >/dev/null 2>&1 || true
	fi
	if [ -x "$audio" ] && "$audio" node-id codec >/dev/null 2>&1; then
		status ready
	else
		status codec-waiting
	fi
	;;
stop)
	stop_one pulse pipewire-pulse
	stop_one wireplumber wireplumber
	stop_one pipewire pipewire
	rm -f "$RT/pipewire-0" "$RT/pulse/native"
	status stopped
	;;
status)
	if [ -r "$STATUS" ]; then
		cat "$STATUS"
	else
		echo stopped
	fi
	;;
*)
	echo "usage: $0 {start|stop|status}" >&2
	exit 1
	;;
esac
