#!/usr/bin/python3
# Syncthing GUI authentication, read from the parsed config.xml.
#
# Syncthing 2.0.13 GUIConfiguration.IsAuthEnabled is true for LDAP, or
# for a nonempty user together with a nonempty password. encoding/xml
# ignores comments. This uses ElementTree, backed by pyexpat, which the
# image already builds (BR2_PACKAGE_PYTHON3 and BR2_PACKAGE_PYTHON3_PYEXPAT).
#
# A document with more than one gui, user, password, or authMode element
# is refused. encoding/xml would keep the last value. An ambiguous file
# does not start the listener and is not shown as a login.

import sys
import xml.etree.ElementTree as ET


def children(parent, tag):
    return [child for child in list(parent) if child.tag == tag]


def element_text(elem):
    if list(elem):
        raise ValueError("nested")
    if elem.text is None:
        return ""
    return elem.text


def load(path):
    try:
        root = ET.parse(path).getroot()
    except (ET.ParseError, OSError, ValueError):
        return None
    if root.tag != "configuration":
        return None
    guis = children(root, "gui")
    if len(guis) != 1:
        return None
    gui = guis[0]
    try:
        users = children(gui, "user")
        passwords = children(gui, "password")
        modes = children(gui, "authMode")
        if len(users) > 1 or len(passwords) > 1 or len(modes) > 1:
            return None
        user = element_text(users[0]) if users else ""
        password = element_text(passwords[0]) if passwords else ""
        mode = element_text(modes[0]) if modes else ""
    except ValueError:
        return None
    return user, password, mode


def auth_enabled(parsed):
    if parsed is None:
        return False
    user, password, mode = parsed
    # UnmarshalText accepts only the exact text "ldap". Anything else,
    # including "static", is static mode.
    if mode == "ldap":
        return True
    return len(user) > 0 and len(password) > 0


def is_bcrypt(value):
    if len(value) < 56:
        return False
    if not (value.startswith("$2a$") or value.startswith("$2b$") or value.startswith("$2y$")):
        return False
    index = 4
    if index >= len(value) or not value[index].isdigit():
        return False
    while index < len(value) and value[index].isdigit():
        index += 1
    if index >= len(value) or value[index] != "$":
        return False
    return len(value) - (index + 1) >= 50


def account_label(user):
    if not user or user == "(unavailable)":
        return "(unavailable)"
    if "\n" in user or "\r" in user or "<" in user or ">" in user:
        return "(unavailable)"
    if is_bcrypt(user) or len(user) > 128:
        return "(unavailable)"
    return user


def password_label(password):
    if is_bcrypt(password):
        return "(set)"
    return "(unavailable)"


def main(argv):
    if len(argv) != 3 or argv[1] not in ("ready", "about"):
        return 1
    parsed = load(argv[2])
    if argv[1] == "ready":
        return 0 if auth_enabled(parsed) else 1
    if parsed is None:
        account, label = "(unavailable)", "(unavailable)"
    else:
        account = account_label(parsed[0])
        label = password_label(parsed[1])
    sys.stdout.write(account + "\n" + label + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
