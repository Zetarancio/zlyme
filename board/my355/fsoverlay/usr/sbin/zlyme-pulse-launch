#!/bin/sh
# Foreground PulseAudio for S21pulse. The caller is already the pulse
# user. This is not Pulse's --system mode: that mode creates
# /var/lib/pulse before dropping privileges, and /var/lib is on the
# read-only squashfs, so the process exits before it loads a module.
#
# Runtime and state stay on tmpfs. HOME is the same directory so
# Pulse does not try to create /run/pulse, which this user cannot.

set -u

RUNTIME=${ZLYME_PULSE_RUNTIME:-/run/zlyme/pulse}
FILE=${ZLYME_PULSE_FILE:-/etc/pulse/zlyme.pa}
BIN=${ZLYME_PULSE_BIN:-/usr/bin/pulseaudio}
LOG=$RUNTIME/daemon.log
EXIT=$RUNTIME/exit

export PULSE_RUNTIME_PATH="$RUNTIME"
export PULSE_STATE_PATH="$RUNTIME"
export PULSE_CONFIG_PATH="$RUNTIME"
export HOME="$RUNTIME"

mkdir -p "$RUNTIME" || exit 1
: > "$LOG" || exit 1
rm -f "$EXIT"

child=
finish() {
	code=$1
	if [ -f "$LOG" ]; then
		size=$(wc -c < "$LOG" | tr -d ' ')
		if [ "${size:-0}" -gt 16384 ]; then
			tail -c 4096 "$LOG" > "$LOG.trim" && mv "$LOG.trim" "$LOG"
		fi
	fi
	printf '%s\n' "$code" > "$EXIT"
	exit "$code"
}
trap 'if [ -n "$child" ]; then kill "$child" 2>/dev/null || true; wait "$child"; finish $?; fi' TERM INT

"$BIN" \
	--daemonize=no \
	--exit-idle-time=-1 \
	--use-pid-file=no \
	--fail \
	-n \
	--file="$FILE" \
	--log-target="file:${LOG}" \
	--log-level=notice &
child=$!
wait "$child"
finish $?
