#!/bin/sh
# Explicit Zlyme settings reset. Does not delete user content.
#
# ZLYME_RESET_ROOT prefixes every path (host tests).
# ZLYME_RESET_SKIP_APPLY=1 skips zlyme-ctl apply (host tests).
# ZLYME_TZ_BIN overrides zlyme-timezone.

root=${ZLYME_RESET_ROOT:-}
cfg=${ZLYME_CFG:-$root/storage/.config}
zlyme=$cfg/zlyme
shared=$cfg/nextui/shared

reset_flags() {
	mkdir -p "$zlyme" || return 1
	for n in \
		wifi bluetooth ssh samba syncthing \
		gpu display_mode refresh undervolt led \
		otg hdmi sd2 boost zram merge logs \
		update_channel cpu_gov gpu_gov
	do
		# Flags are files. Do not follow a directory that shares a name.
		if [ -f "$zlyme/$n" ]; then
			rm -f "$zlyme/$n"
		fi
	done
	# Proxy is one multi-field file, not a zlyme-ctl flag.
	if [ -f "$zlyme/proxy.conf" ]; then
		rm -f "$zlyme/proxy.conf"
	fi
}

reset_ui() {
	rm -f "$shared/minuisettings.txt" "$shared/.zlyme-clock-on-default"
	rm -f "$shared/localtime" "$shared/localtime.zone"
	tz=${ZLYME_TZ_BIN:-/usr/sbin/zlyme-timezone}
	if [ -x "$tz" ]; then
		ZLYME_TZ_FILE=$shared/localtime "$tz" ensure || return 1
	fi
	rm -f "$shared/vtree/config.ini" "$shared/vtree/.zlyme-vtree-v1"
	card=${ZLYME_CARD_DEFAULTS:-/usr/sbin/zlyme-card-defaults}
	if [ -x "$card" ]; then
		SHARED_USERDATA_PATH=$shared \
		BIOS_PATH=$root/storage/Bios \
		SAVES_PATH=$root/storage/Saves \
		CHEATS_PATH=$root/storage/Cheats \
			"$card" || return 1
	fi
}

run_apply() {
	if [ -n "${ZLYME_RESET_APPLY_LOG:-}" ]; then
		printf '%s\n' "$*" >> "$ZLYME_RESET_APPLY_LOG"
		return 0
	fi
	[ "${ZLYME_RESET_SKIP_APPLY:-}" = 1 ] && return 0
	"$@"
}

apply_service() {
	name=$1
	init=$2
	if zlyme-ctl want "$name"; then
		run_apply "$init" start
	else
		run_apply "$init" stop
	fi
}

apply_now() {
	[ "${ZLYME_RESET_SKIP_APPLY:-}" = 1 ] && [ -z "${ZLYME_RESET_APPLY_LOG:-}" ] && return 0
	command -v zlyme-ctl >/dev/null 2>&1 || [ -n "${ZLYME_RESET_APPLY_LOG:-}" ] || return 0
	# Immediate owners. The init scripts and zlyme-ctl apply-* stay the
	# implementation; this only asks them to match the restored default.
	apply_service wifi /etc/init.d/S30wifi || return 1
	apply_service bluetooth /etc/init.d/S40bluetoothd || return 1
	apply_service ssh /etc/init.d/S50sshd || return 1
	apply_service samba /etc/init.d/S70samba || return 1
	apply_service syncthing /etc/init.d/S75syncthing || return 1
	run_apply zlyme-ctl apply-led || return 1
	run_apply zlyme-ctl apply-zram || return 1
	run_apply zlyme-ctl apply-refresh || return 1
	run_apply zlyme-ctl apply-hdmi-mode || return 1
	run_apply zlyme-ctl apply-logs || return 1
	run_apply zlyme-ctl apply-gov || return 1
	# Boot-time flags. Writing the overlay line now does not reboot.
	run_apply zlyme-ctl apply-overlays || return 1
}

settings_reset() {
	reset_flags || return 1
	reset_ui || return 1
	apply_now
}

factory_reset() {
	settings_reset || return 1
	mkdir -p "$zlyme" || return 1
	: > "$zlyme/factory-reset"
}

# Removes the selected PortMaster installation and its Zlyme config.
# Installed ports stay. An explicit missing disk is not redirected.
portmaster_reset() {
	bin=${ZLYME_PM_ROOT_BIN:-/usr/sbin/zlyme-portmaster-root}
	storage=${ZLYME_PM_STORAGE:-${root:+$root/storage}}
	storage=${storage:-/storage}
	hm=""
	tools=""
	ZLYME_CFG=$cfg
	ZLYME_PM_STORAGE=$storage
	export ZLYME_CFG ZLYME_PM_STORAGE
	if ! hm=$("$bin" export); then
		echo "PortMaster disk is not inserted" >&2
		return 1
	fi
	eval "$hm"
	tools=${HM_TOOLS_DIR:-}
	[ -n "$tools" ] || return 1
	rm -rf "$tools/PortMaster"
	rm -rf "$cfg/portmaster-home" "$cfg/PortMaster"
	rm -rf "$storage/PortMaster"
}

case "${1:-}" in
	settings) settings_reset ;;
	factory) factory_reset ;;
	portmaster) portmaster_reset ;;
	*)
		echo "usage: $0 {settings|factory|portmaster}" >&2
		exit 2
		;;
esac
