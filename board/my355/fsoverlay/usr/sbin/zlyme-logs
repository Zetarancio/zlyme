#!/bin/sh
# Bounded diagnostic history under /storage/.logs.
# About → System logs. Off by default.
#
# system-0 is the newest logged boot. Ordering is rotation, not the clock.
# /run is cleared on reboot. A flock makes the one-rotation marker safe
# when S15's seed and a later start overlap.
#
# ZLYME_LOG_ROOT, ZLYME_LOG_MARK, ZLYME_LOG_LOCK, and ZLYME_LOG_FORCE=1
# are test seams. ZLYME_LOG_RACE is a barrier used only by the overlap
# test. Production leaves them unset.

[ -r /etc/zlyme.conf ] && . /etc/zlyme.conf

SYSTEM_LOG_GENERATIONS=5
# Provisional budgets. An open writer can still grow past them until
# the next completed-file trim. See the Phase 16 inventory.
GEN_MAX=2097152
TOTAL_MAX=33554432
SERVICE_TAIL=65536
LOGDIR=${ZLYME_LOG_ROOT:-/storage/.logs}
MARK=${ZLYME_LOG_MARK:-/run/zlyme-logs-generation}
LOCK=${ZLYME_LOG_LOCK:-$(dirname "$MARK")/zlyme-logs.lock}

want_logs() {
	[ "${ZLYME_LOG_FORCE:-}" = 1 ] && return 0
	[ -x /usr/sbin/zlyme-ctl ] && zlyme-ctl want logs
}

storage_ready() {
	[ -n "${ZLYME_LOG_ROOT:-}" ] && return 0
	[ -d /storage ] || return 1
	grep -q " /storage " /proc/mounts
}

write_readme() {
	printf '%s\n' \
		'Send this folder if something goes wrong.' \
		'system-0 is the newest logged boot. system-1 through system-4 are earlier logged boots.' \
		'paks/TAG.log is the newest run of that pak. paks/TAG.log.1 and paks/TAG.log.2 are the previous runs.' \
		> "$LOGDIR/README.txt"
}

regular_file() {
	[ -f "$1" ] || return 1
	[ ! -L "$1" ]
}

# Accounting only. A failed read becomes 0, which under-counts and
# does not delete or trim. Cursor decisions use read_size instead.
file_size() {
	_sz=$(wc -c < "$1" 2>/dev/null) || _sz=0
	printf '%s\n' "$_sz" | tr -d ' '
}

# Print the byte size. Return 1 when the size cannot be read.
# A failure is not a zero-length file.
read_size() {
	rs_raw=$(wc -c < "$1" 2>/dev/null) || return 1
	rs_size=$(printf '%s\n' "$rs_raw" | tr -d ' ')
	case "$rs_size" in
		''|*[!0-9]*) return 1 ;;
	esac
	printf '%s\n' "$rs_size"
}

read_off() {
	_off=0
	if [ -f "$1" ]; then
		_off=$(tr -d ' \t\r\n' < "$1" 2>/dev/null) || _off=0
	fi
	case "$_off" in
		''|*[!0-9]*) _off=0 ;;
	esac
	printf '%s\n' "$_off"
}

# Remember how far a live tmpfs file had been written. No copy.
# A failed read leaves any existing cursor alone and marks the stream
# unread, so the next success records the size without copying the gap.
note_size() {
	ns_src=$1
	ns_state=$2
	if ! regular_file "$ns_src"; then
		printf '%s\n' 0 > "$ns_state"
		rm -f "$ns_state.unread"
		return 0
	fi
	if ! ns_size=$(read_size "$ns_src"); then
		: > "$ns_state.unread"
		return 0
	fi
	printf '%s\n' "$ns_size" > "$ns_state"
	rm -f "$ns_state.unread"
}

# Append only bytes written since the saved offset. The source is the
# live file; this never renames or truncates it, so an open writer fd
# keeps appending to the same inode.
append_since() {
	as_src=$1
	as_dest=$2
	as_state=$3
	regular_file "$as_src" || return 0
	# A failed size read must not rewind the cursor to zero.
	if ! as_size=$(read_size "$as_src"); then
		return 0
	fi
	as_off=$(read_off "$as_state")
	if [ "$as_size" -le "$as_off" ]; then
		printf '%s\n' "$as_size" > "$as_state"
		return 0
	fi
	mkdir -p "$(dirname "$as_dest")" || return 0
	as_piece=$(mktemp "${as_dest}.piece.XXXXXX") || return 0
	as_skip=$((as_off + 1))
	if ! tail -c "+$as_skip" "$as_src" > "$as_piece"; then
		rm -f "$as_piece"
		return 0
	fi
	as_out=$(mktemp "${as_dest}.out.XXXXXX") || { rm -f "$as_piece"; return 0; }
	if [ -f "$as_dest" ]; then
		if ! cat "$as_dest" > "$as_out"; then
			rm -f "$as_piece" "$as_out"
			return 0
		fi
	fi
	if ! cat "$as_piece" >> "$as_out"; then
		rm -f "$as_piece" "$as_out"
		return 0
	fi
	if mv -f "$as_out" "$as_dest"; then
		printf '%s\n' "$as_size" > "$as_state"
	else
		rm -f "$as_out"
	fi
	rm -f "$as_piece"
}

session_sources() {
	WRAP=${ZLYME_SESSION_WRAP:-/tmp/nextui-session.log}
	TEXT=${ZLYME_SESSION_TEXT:-/tmp/nextui-session.txt}
	if [ -n "${ZLYME_LOG_ROOT:-}" ] && [ -z "${ZLYME_SESSION_WRAP:-}" ]; then
		WRAP=
	fi
	if [ -n "${ZLYME_LOG_ROOT:-}" ] && [ -z "${ZLYME_SESSION_TEXT:-}" ]; then
		TEXT=
	fi
}

weston_src() {
	if [ -n "${ZLYME_WESTON_LOG:-}" ]; then
		printf '%s\n' "$ZLYME_WESTON_LOG"
	elif [ -z "${ZLYME_LOG_ROOT:-}" ]; then
		printf '%s\n' /run/zlyme-weston/weston.log
	fi
}

# Append $1 onto $2. The previous $2 stays in place until the new
# bytes are in a temporary file and that file has been renamed.
append_file() {
	af_add=$1
	af_dst=$2
	af_out=$(mktemp "${af_dst}.out.XXXXXX") || return 1
	if [ -f "$af_dst" ]; then
		cat "$af_dst" > "$af_out" || { rm -f "$af_out"; return 1; }
	fi
	cat "$af_add" >> "$af_out" || { rm -f "$af_out"; return 1; }
	# Do not treat an unreadable size as "under the cap" and install it.
	if ! af_osz=$(read_size "$af_out"); then
		rm -f "$af_out"
		return 1
	fi
	if [ "$af_osz" -gt "$SERVICE_TAIL" ]; then
		af_cap=$(mktemp "${af_dst}.cap.XXXXXX") || { rm -f "$af_out"; return 1; }
		if tail -c "$SERVICE_TAIL" "$af_out" > "$af_cap"; then
			mv -f "$af_cap" "$af_out" || { rm -f "$af_cap" "$af_out"; return 1; }
		else
			rm -f "$af_cap" "$af_out"
			return 1
		fi
	fi
	mv -f "$af_out" "$af_dst"
}

# Copy new bytes of a live tmpfs file. The offset moves only after
# those bytes are in the saved file. A failed tail leaves both alone.
capture_stream() {
	cs_src=$1
	cs_dest=$2
	cs_state=$3
	regular_file "$cs_src" || return 0
	if ! cs_size=$(read_size "$cs_src"); then
		return 0
	fi
	# The enable-time read failed. Record this size and copy nothing,
	# including bytes from before logging was on.
	if [ -f "$cs_state.unread" ]; then
		printf '%s\n' "$cs_size" > "$cs_state"
		rm -f "$cs_state.unread"
		return 0
	fi
	cs_off=$(read_off "$cs_state")
	mkdir -p "$(dirname "$cs_dest")" || return 0
	if [ -f "$cs_state" ] && [ "$cs_size" -eq "$cs_off" ]; then
		return 0
	fi
	cs_piece=$(mktemp "${cs_dest}.piece.XXXXXX") || return 0
	if [ ! -f "$cs_state" ] || [ "$cs_size" -lt "$cs_off" ]; then
		if ! copy_tail "$cs_src" "$cs_piece"; then
			rm -f "$cs_piece"
			return 0
		fi
	else
		cs_skip=$((cs_off + 1))
		if ! tail -c "+$cs_skip" "$cs_src" > "$cs_piece"; then
			rm -f "$cs_piece"
			return 0
		fi
	fi
	if append_file "$cs_piece" "$cs_dest"; then
		printf '%s\n' "$cs_size" > "$cs_state"
	fi
	rm -f "$cs_piece"
}

apply_stream() {
	case $4 in
		note) note_size "$1" "$3" ;;
		zero) printf '%s\n' 0 > "$3" ;;
		copy) capture_stream "$1" "$2" "$3" ;;
	esac
}

# Service and frontend text. A byte already in the file when logging
# turns on is not copied. dmesg stays a kernel-ring snapshot.
for_streams() {
	_act=$1
	if [ -n "${ZLYME_SERVICE_DIR:-}" ]; then
		for _svc in "$ZLYME_SERVICE_DIR"/*; do
			regular_file "$_svc" || continue
			_bn=$(basename "$_svc")
			apply_stream "$_svc" "$LOGDIR/system-0/services/$_bn" \
				"$MARK.svc.$_bn" "$_act"
		done
		unset _svc _bn
		return 0
	fi
	[ -z "${ZLYME_LOG_ROOT:-}" ] || return 0
	apply_stream /tmp/boot-timing "$LOGDIR/system-0/boot-timing.txt" \
		"$MARK.boot-timing" "$_act"
	apply_stream /tmp/nextui.txt "$LOGDIR/system-0/nextui.txt" \
		"$MARK.nextui" "$_act"
	apply_stream /tmp/zlyme-input-late.log \
		"$LOGDIR/system-0/services/input-late.log" \
		"$MARK.svc.input-late" "$_act"
	apply_stream /tmp/inputplumber.log \
		"$LOGDIR/system-0/services/inputplumber.log" \
		"$MARK.svc.inputplumber" "$_act"
	apply_stream /tmp/zlyme-input.log \
		"$LOGDIR/system-0/services/zlyme-input.log" \
		"$MARK.svc.zlyme-input" "$_act"
	apply_stream /tmp/zlyme-pipewire-late.log \
		"$LOGDIR/system-0/services/pipewire-late.log" \
		"$MARK.svc.pipewire-late" "$_act"
	apply_stream /tmp/zlyme-bt-late.log \
		"$LOGDIR/system-0/services/bluetooth-late.log" \
		"$MARK.svc.bluetooth-late" "$_act"
	apply_stream /tmp/zlyme-storage.log \
		"$LOGDIR/system-0/services/storage.log" \
		"$MARK.svc.storage" "$_act"
	apply_stream /tmp/zlyme-led.log \
		"$LOGDIR/system-0/services/led.log" \
		"$MARK.svc.led" "$_act"
	apply_stream /tmp/zlyme-net-async.log \
		"$LOGDIR/system-0/services/wifi-async.log" \
		"$MARK.svc.wifi-async" "$_act"
}

# A new Weston run replaces the file, so a smaller size is a new log,
# not a shrink of the one we already copied.
capture_weston() {
	_w=$(weston_src)
	[ -n "$_w" ] || return 0
	# The live file is gone. Forget its size so the next run is not
	# measured against it. Leave the copy already saved.
	if ! regular_file "$_w"; then
		rm -f "$MARK.weston"
		return 0
	fi
	capture_stream "$_w" "$LOGDIR/system-0/services/weston.log" "$MARK.weston"
}

# First start of an on-interval discards bytes already in the tmpfs
# files. Those were written while logging was off.
begin_capture() {
	session_sources
	[ -n "$WRAP" ] && note_size "$WRAP" "$MARK.wrap"
	[ -n "$TEXT" ] && note_size "$TEXT" "$MARK.text"
	for_streams note
	_w=$(weston_src)
	[ -n "$_w" ] && note_size "$_w" "$MARK.weston"
	: > "$MARK.on"
}

follow_capture() {
	cur=$LOGDIR/system-0
	mkdir -p "$cur" || return 0
	session_sources
	[ -n "$WRAP" ] && append_since "$WRAP" "$cur/session.txt" "$MARK.wrap"
	[ -n "$TEXT" ] && append_since "$TEXT" "$cur/next.txt" "$MARK.text"
	for_streams copy
	capture_weston
}

copy_tail() {
	ct_src=$1
	ct_dest=$2
	regular_file "$ct_src" || return 1
	mkdir -p "$(dirname "$ct_dest")" || return 1
	ct_tmp=$(mktemp "${ct_dest}.new.XXXXXX") || return 1
	if tail -c "$SERVICE_TAIL" "$ct_src" > "$ct_tmp"; then
		mv -f "$ct_tmp" "$ct_dest"
	else
		rm -f "$ct_tmp"
		return 1
	fi
}

refresh_snapshots() {
	cur=$LOGDIR/system-0
	mkdir -p "$cur" || return 1
	# Host tests set ZLYME_LOG_ROOT and do not want the machine's kernel log.
	if [ -z "${ZLYME_LOG_ROOT:-}" ]; then
		dmesg > "$cur/dmesg.txt" 2>/dev/null || true
	fi
	if [ -f /boot/zlyme-dmesg.txt ] && [ ! -L /boot/zlyme-dmesg.txt ]; then
		cp -f /boot/zlyme-dmesg.txt "$cur/dmesg-boot.txt" 2>/dev/null || true
	fi
	# boot-timing, nextui.txt, and the service files are copied by
	# for_streams, and only for bytes written while logging is on.
	# syslogd and klogd are not here: Zlyme does not own a file for
	# them, and the stream is not known to be free of unrelated messages.
}

# Oldest generation is deleted, then each directory moves up one index.
rotate_system() {
	last=$((SYSTEM_LOG_GENERATIONS - 1))
	rm -rf "$LOGDIR/system-$last"
	i=$last
	while [ "$i" -gt 0 ]; do
		prev=$((i - 1))
		if [ -d "$LOGDIR/system-$prev" ]; then
			mv "$LOGDIR/system-$prev" "$LOGDIR/system-$i"
		fi
		i=$prev
	done
	mkdir -p "$LOGDIR/system-0"
}

# Names zlyme-logs itself writes. A user file with another name is not
# part of the budget and is not deleted.
snapshot_names() {
	printf '%s\n' dmesg.txt dmesg-boot.txt boot-timing.txt nextui.txt \
		session.txt next.txt
}

service_names() {
	printf '%s\n' input-late.log inputplumber.log zlyme-input.log \
		pipewire-late.log bluetooth-late.log storage.log led.log \
		wifi-async.log weston.log
}

owned_bytes() {
	_sum=0
	_gen=0
	_name=
	_f=
	while [ "$_gen" -le 4 ]; do
		for _name in $(snapshot_names); do
			_f=$LOGDIR/system-$_gen/$_name
			regular_file "$_f" || continue
			_sum=$((_sum + $(file_size "$_f")))
		done
		for _name in $(service_names); do
			_f=$LOGDIR/system-$_gen/services/$_name
			regular_file "$_f" || continue
			_sum=$((_sum + $(file_size "$_f")))
		done
		_gen=$((_gen + 1))
	done
	for _f in "$LOGDIR"/paks/*.log "$LOGDIR"/paks/*.log.[12] \
		"$LOGDIR"/paks/portmaster.txt "$LOGDIR"/paks/OPENBOR/*; do
		regular_file "$_f" || continue
		_sum=$((_sum + $(file_size "$_f")))
	done
	printf '%s\n' "$_sum"
}

generation_bytes() {
	_sum=0
	_name=
	_f=
	for _name in $(snapshot_names); do
		_f=$LOGDIR/system-0/$_name
		regular_file "$_f" || continue
		_sum=$((_sum + $(file_size "$_f")))
	done
	for _name in $(service_names); do
		_f=$LOGDIR/system-0/services/$_name
		regular_file "$_f" || continue
		_sum=$((_sum + $(file_size "$_f")))
	done
	printf '%s\n' "$_sum"
}

cap_one() {
	_cf=$1
	_max=$2
	regular_file "$_cf" || return 0
	_csz=$(file_size "$_cf")
	[ "$_csz" -gt "$_max" ] || return 0
	_ctmp=$(mktemp "${_cf}.trim.XXXXXX") || return 0
	if tail -c "$_max" "$_cf" > "$_ctmp"; then
		mv -f "$_ctmp" "$_cf"
	else
		rm -f "$_ctmp"
	fi
}

# Our copies only. The tmpfs files the session and the services still
# have open are different paths, so this does not replace those inodes.
cap_generation() {
	_gmax=${ZLYME_LOG_GEN_MAX:-$GEN_MAX}
	cur=$LOGDIR/system-0
	cap_one "$cur/session.txt" 1048576
	cap_one "$cur/next.txt" 1048576
	_gsz=$(generation_bytes)
	[ "$_gsz" -le "$_gmax" ] && return 0
	_over=$((_gsz - _gmax))
	for _cf in "$cur/session.txt" "$cur/next.txt"; do
		regular_file "$_cf" || continue
		_csz=$(file_size "$_cf")
		[ "$_csz" -gt 65536 ] || continue
		_room=$((_csz - 65536))
		if [ "$_over" -ge "$_room" ]; then
			_keep=65536
			_over=$((_over - _room))
		else
			_keep=$((_csz - _over))
			_over=0
		fi
		cap_one "$_cf" "$_keep"
		[ "$_over" -le 0 ] && return 0
	done
}

drop_generation_files() {
	_gen=$1
	_name=
	_f=
	for _name in $(snapshot_names); do
		_f=$LOGDIR/system-$_gen/$_name
		regular_file "$_f" || continue
		rm -f "$_f"
	done
	for _name in $(service_names); do
		_f=$LOGDIR/system-$_gen/services/$_name
		regular_file "$_f" || continue
		rm -f "$_f"
	done
	rmdir "$LOGDIR/system-$_gen/services" "$LOGDIR/system-$_gen" 2>/dev/null || true
}

# Oldest owned history first. The current pak log stays: a launch may
# still have it open, and deleting it would drop the newest run.
# Anything left over the total is the unresolved budget.
reclaim() {
	_tcap=${ZLYME_LOG_TOTAL_MAX:-$TOTAL_MAX}
	[ "$(owned_bytes)" -gt "$_tcap" ] || return 0
	drop_generation_files 4
	[ "$(owned_bytes)" -gt "$_tcap" ] || return 0
	drop_generation_files 3
	[ "$(owned_bytes)" -gt "$_tcap" ] || return 0
	_f=
	for _f in "$LOGDIR"/paks/*.log.2 "$LOGDIR"/paks/*.log.1; do
		regular_file "$_f" || continue
		rm -f "$_f"
		[ "$(owned_bytes)" -gt "$_tcap" ] || return 0
	done
}

lock_begin() {
	mkdir -p "$(dirname "$LOCK")" 2>/dev/null || return 1
	# No snapshot without the lock. A missing applet must not rotate.
	if ! command -v flock >/dev/null 2>&1; then
		return 1
	fi
	exec 8>>"$LOCK" || return 1
	flock 8 || return 1
}

lock_end() {
	if command -v flock >/dev/null 2>&1; then
		flock -u 8 2>/dev/null || true
	fi
}

clear_boot_flag() {
	# The initramfs writes a boot dmesg while this file exists.
	# A failed removal is tried again on the next seed, not on every
	# snapshot, so a stuck boot volume is not remounted all day.
	if [ -z "${ZLYME_LOG_ROOT:-}" ] && [ -e /boot/zlyme-logs ] \
		&& [ -x /usr/sbin/zlyme-boot-write ]; then
		zlyme-boot-write rm -f /boot/zlyme-logs || true
	fi
}

start() {
	_mode=${1:-}
	if ! want_logs; then
		if [ "$_mode" = boot ]; then
			clear_boot_flag
		fi
		return 0
	fi
	storage_ready || return 0
	mkdir -p "$LOGDIR" "$(dirname "$MARK")" || return 0
	lock_begin || return 0
	# stop may have finished while this start waited for the lock.
	# Do not open a capture or copy snapshots after the switch is off.
	if ! want_logs; then
		rm -f "$MARK.on"
		clear_boot_flag
		lock_end
		return 0
	fi
	write_readme || true
	_fresh=0
	if [ ! -f "$MARK" ]; then
		# Test barrier. Held under the lock, so a second start waits
		# and then sees the marker.
		if [ -n "${ZLYME_LOG_RACE:-}" ]; then
			echo $$ >> "$ZLYME_LOG_RACE"
			while [ ! -f "${ZLYME_LOG_RACE}.go" ]; do
				sleep 0.05
			done
		fi
		rotate_system || true
		: > "$MARK" || true
		_fresh=1
	fi
	if [ ! -f "$MARK.on" ]; then
		# `start boot` is only the seed, and only when logs were already
		# on. Session bytes that exist then were written with logging on.
		# A later enable in the same boot uses begin_capture and skips
		# the bytes already in the tmpfs files.
		if [ "$_mode" = boot ] && [ "$_fresh" = 1 ]; then
			session_sources
			[ -n "$WRAP" ] && printf '%s\n' 0 > "$MARK.wrap"
			[ -n "$TEXT" ] && printf '%s\n' 0 > "$MARK.text"
			for_streams zero
			_w=$(weston_src)
			[ -n "$_w" ] && printf '%s\n' 0 > "$MARK.weston"
			: > "$MARK.on"
			follow_capture || true
		else
			begin_capture
		fi
	else
		follow_capture || true
	fi
	refresh_snapshots || true
	cap_generation || true
	reclaim || true
	# Re-read the switch under the lock. A stop that landed while this
	# start was waiting must not leave the boot flag behind.
	if ! want_logs; then
		clear_boot_flag
		lock_end
		return 0
	fi
	# The initramfs only checks that this file exists. Touching it
	# again remounts the boot volume, so a later snapshot must not.
	if [ -z "${ZLYME_LOG_ROOT:-}" ] && [ ! -e /boot/zlyme-logs ] \
		&& [ -x /usr/sbin/zlyme-boot-write ]; then
		zlyme-boot-write touch /boot/zlyme-logs || true
	fi
	lock_end
	return 0
}

stop() {
	# Keep the rotation marker. Copy the bytes written while logging was
	# still on, then drop the capture flag. Text written after this is
	# not copied when logs come back on.
	if [ -d "$(dirname "$MARK")" ] || mkdir -p "$(dirname "$MARK")" 2>/dev/null; then
		if ! lock_begin; then
			clear_boot_flag
			return 0
		fi
		if [ -f "$MARK.on" ]; then
			follow_capture || true
			cap_generation || true
			rm -f "$MARK.on"
		fi
		clear_boot_flag
		lock_end
	fi
	return 0
}

apply() {
	if want_logs; then
		start
	else
		stop
	fi
}

current() {
	[ -f "$MARK" ] || return 1
	[ -d "$LOGDIR/system-0" ] || return 1
	printf '%s\n' "$LOGDIR/system-0"
}

case "${1:-start}" in
	start) start "${2:-}" ;;
	stop) stop ;;
	weston-closed)
		lock_begin || exit 0
		rm -f "$MARK.weston"
		lock_end
		;;
	apply) apply ;;
	current) current ;;
	*) echo "usage: $0 {start|stop|apply|current|weston-closed}" >&2; exit 1 ;;
esac
