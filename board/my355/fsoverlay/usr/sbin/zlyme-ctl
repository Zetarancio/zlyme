#!/bin/sh
#
# Persist flags under /storage/.config/zlyme/. Init scripts call
# `want`; Settings calls get/set.

# shellcheck disable=SC1091
. "${ZLYME_CONF:-/etc/zlyme.conf}"

DIR="${ZLYME_CFG}/zlyme"
# Defaults when the file is absent. Keep in sync with S15bootpart seed.
# boost and merge are retired. A leftover file is ignored.
retired() {
	case "$1" in
		boost|merge) return 0 ;;
	esac
	return 1
}

default_of() {
	case "$1" in
		wifi|bluetooth|ssh|otg|hdmi|sd2) echo on ;;
		samba|syncthing) echo off ;;
		gpu) echo libmali ;;
		display_mode) echo "" ;;
		refresh) echo 60 ;;
		undervolt) echo off ;;
		led) echo battery ;;
		cpu_gov) echo schedutil ;;
		gpu_gov) echo simple_ondemand ;;
		zram) echo on ;;
		logs) echo off ;;
		update_channel) echo releases ;;
		*) echo off ;;
	esac
}

get() {
	name=$1
	val=""
	if retired "$name"; then
		default_of "$name"
		return
	fi
	if [ -r "$DIR/$name" ]; then
		val=$(tr -d ' \t\r\n' < "$DIR/$name")
	fi
	# Empty is not "off". A full disk truncates the flag to 0 bytes.
	if [ -n "$val" ]; then
		printf '%s' "$val"
	else
		default_of "$name"
	fi
}

saved_on() {
	val=$(get "$1")
	[ "$val" = "on" ] || [ "$val" = "1" ] || [ "$val" = "yes" ]
}

# Effective System logs for this boot. Absent means off. The file is
# written once by latch-logs and is not updated when Settings changes.
logs_effective() {
	eff=${ZLYME_LOG_EFFECTIVE:-/run/zlyme/logs-effective}
	[ -r "$eff" ] || return 1
	val=$(tr -d ' \t\r\n' < "$eff")
	[ "$val" = "on" ] || [ "$val" = "1" ] || [ "$val" = "yes" ]
}

latch_logs() {
	eff=${ZLYME_LOG_EFFECTIVE:-/run/zlyme/logs-effective}
	[ -f "$eff" ] && return 0
	mkdir -p "$(dirname "$eff")" 2>/dev/null || return 1
	if saved_on logs; then
		printf '%s\n' on > "$eff"
	else
		printf '%s\n' off > "$eff"
	fi
}

want() {
	if [ "$1" = logs ]; then
		logs_effective
		return
	fi
	val=$(get "$1")
	[ "$val" = "on" ] || [ "$val" = "1" ] || [ "$val" = "yes" ]
}

setv() {
	name=$1
	val=$2
	if retired "$name"; then
		rm -f "$DIR/$name"
		return 0
	fi
	mkdir -p "$DIR" 2>/dev/null
	printf '%s\n' "$val" > "$DIR/$name"
}

toggle() {
	name=$1
	if retired "$name"; then
		rm -f "$DIR/$name"
		echo off
		return 0
	fi
	if [ "$name" = logs ]; then
		if saved_on logs; then
			setv logs off
			echo off
		else
			setv logs on
			echo on
		fi
		return 0
	fi
	if want "$name"; then
		setv "$name" off
		echo off
	else
		setv "$name" on
		echo on
	fi
}

apply_refresh() {
	hz=$(get refresh)
	case "$hz" in
		50|40|60) ;;
		*) hz=60 ;;
	esac
	for c in /sys/class/drm/card*-DSI-*; do
		[ -e "$c/mode" ] || continue
		printf '%s\n' "640x480@${hz}" > "$c/mode" 2>/dev/null && return 0
	done
	return 0
}

apply_led() {
	[ -x /usr/sbin/zlyme-led ] && /usr/sbin/zlyme-led apply
}

# Compose every dtbo into one FDTOVERLAYS line. Replacing the line with
# only undervolt used to wipe HDMI/OTG/SD2 overlays.
apply_overlays() {
	conf=/boot/extlinux/extlinux.conf
	[ -f "$conf" ] || return 0
	ovl=""
	val=$(get undervolt)
	case "$val" in
		l1|l2|l3) ovl="$ovl /overlays/rk3566-undervolt-cpu-${val}.dtbo" ;;
	esac
	want otg || ovl="$ovl /overlays/rk3566-disable-otg.dtbo"
	want hdmi || ovl="$ovl /overlays/rk3566-disable-hdmi.dtbo"
	want sd2 || ovl="$ovl /overlays/rk3566-disable-sd2.dtbo"
	ovl=$(printf '%s' "$ovl" | sed 's/^ //')
	tmp=$(mktemp) || return 0
	out=$(mktemp) || { rm -f "$tmp"; return 0; }
	grep -v FDTOVERLAYS "$conf" > "$tmp"
	if [ -n "$ovl" ]; then
		awk -v ovl="$ovl" '
			/^[ \t]*FDT / { print; print "    FDTOVERLAYS " ovl; next }
			{ print }
		' "$tmp" > "$out"
	else
		cat "$tmp" > "$out"
	fi
	rm -f "$tmp"
	if [ ! -x /usr/sbin/zlyme-boot-write ]; then
		rm -f "$out"
		return 0
	fi
	/usr/sbin/zlyme-boot-write cp -f "$out" "$conf"
	rc=$?
	rm -f "$out"
	return "$rc"
}

apply_undervolt() {
	apply_overlays
}

# Profile owns CPU, DMC, GPU, and hotplug. Settings pickers are gone.
apply_gov() {
	if [ -x /usr/sbin/zlyme-governor ]; then
		/usr/sbin/zlyme-governor smart
	elif [ -x /usr/share/nextui/bin/governor.sh ]; then
		/usr/share/nextui/bin/governor.sh smart
	fi
}

apply_zram() {
	[ -x /usr/sbin/zlyme-zram ] || return 0
	if want zram; then
		/usr/sbin/zlyme-zram start
	else
		/usr/sbin/zlyme-zram stop
	fi
}

apply_hdmi_mode() {
	mode=$(get display_mode)
	[ -n "$mode" ] || return 0
	for c in /sys/class/drm/card*-HDMI-A-1; do
		[ -e "$c/mode" ] || continue
		printf '%s\n' "$mode" > "$c/mode" 2>/dev/null && return 0
	done
	return 0
}

# The saved flag is the next boot. This only prepares the initramfs
# marker. It does not start or stop capture in the running boot.
# A failed boot write leaves the saved request as Settings stored it.
apply_logs() {
	flag=${ZLYME_BOOT_LOG_FLAG:-/boot/zlyme-logs}
	if [ -z "${ZLYME_BOOT_WRITE:-}" ] && [ -n "${ZLYME_BOOT_LOG_FLAG:-}" ]; then
		apply_logs_locked
		return $?
	fi
	writer=${ZLYME_BOOT_WRITE:-/usr/sbin/zlyme-boot-write}
	if [ ! -x "$writer" ]; then
		echo "zlyme-ctl: boot write is not available" >&2
		return 1
	fi
	# Always take the boot-write lock. A marker that is present now can
	# still be removed by a reconcile that already passed its off check.
	"$writer" "$0" apply-logs-locked
	return $?
}

# Inside zlyme-boot-write. The saved value is read again under that lock.
# A marker that already matches the saved value is left unchanged.
apply_logs_locked() {
	flag=${ZLYME_BOOT_LOG_FLAG:-/boot/zlyme-logs}
	if saved_on logs; then
		[ -e "$flag" ] && return 0
		: > "$flag" || return 1
		return 0
	fi
	[ -e "$flag" ] || return 0
	rm -f "$flag" || return 1
}

# Inside zlyme-boot-write. The saved value is read again under that
# lock, so a marker armed for the next boot is not removed.
reconcile_boot_logs_locked() {
	flag=${ZLYME_BOOT_LOG_FLAG:-/boot/zlyme-logs}
	if saved_on logs; then
		return 0
	fi
	[ -e "$flag" ] || return 0
	rm -f "$flag"
}

# Once per boot, from the background seed, when the saved request is
# off and the marker is still there. The effective latch is not the
# authority: this boot may still be recording.
reconcile_boot_logs() {
	flag=${ZLYME_BOOT_LOG_FLAG:-/boot/zlyme-logs}
	if saved_on logs; then
		return 0
	fi
	[ -e "$flag" ] || return 0
	if [ -z "${ZLYME_BOOT_WRITE:-}" ] && [ -n "${ZLYME_BOOT_LOG_FLAG:-}" ]; then
		reconcile_boot_logs_locked
		return $?
	fi
	writer=${ZLYME_BOOT_WRITE:-/usr/sbin/zlyme-boot-write}
	if [ ! -x "$writer" ]; then
		echo "zlyme-ctl: boot write is not available" >&2
		return 1
	fi
	"$writer" "$0" reconcile-boot-logs-locked
}

apply_settings() {
	apply_overlays
	apply_gov
	apply_led
	apply_zram
}

cmd=$1
shift
case "$cmd" in
	get) get "$1"; echo ;;
	want) want "$1" ;;
	set) setv "$1" "$2" ;;
	toggle) toggle "$1" ;;
	apply-refresh) apply_refresh ;;
	apply-undervolt) apply_undervolt ;;
	apply-overlays) apply_overlays ;;
	apply-led) apply_led ;;
	apply-gov) apply_gov ;;
	apply-zram) apply_zram ;;
	apply-logs) apply_logs ;;
	apply-logs-locked) apply_logs_locked ;;
	latch-logs) latch_logs ;;
	reconcile-boot-logs) reconcile_boot_logs ;;
	reconcile-boot-logs-locked) reconcile_boot_logs_locked ;;
	apply-hdmi-mode) apply_hdmi_mode ;;
	apply-settings) apply_settings ;;
	status)
		for n in wifi bluetooth ssh samba syncthing gpu display_mode refresh undervolt led otg hdmi sd2 zram logs update_channel; do
			printf '%s=%s\n' "$n" "$(get "$n")"
		done
		;;
	*)
		echo "usage: zlyme-ctl {get|want|set|toggle|apply-refresh|apply-undervolt|apply-overlays|apply-led|apply-gov|apply-zram|apply-logs|latch-logs|reconcile-boot-logs|apply-hdmi-mode|apply-settings|status} [name] [value]" >&2
		exit 1
		;;
esac
