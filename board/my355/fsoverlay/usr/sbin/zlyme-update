#!/bin/sh
# OS update: stage the squashfs on ZLYME, copy kernel files onto FAT.
# Initramfs copies pending/zlyme over the live /boot/zlyme (not mounted
# as a second file on ZLYMEBOOT).
#
# Contract:
#   1. Copy a finished tar to /storage/.update/${ZLYME_UPDATE_PREFIX}-*.tar
#      (update.tar, versioned, or -dirty; newest mtime wins).
#      Incomplete downloads must be named *.tar.part — this script ignores them.
#   2. reboot
# S18 extracts to /storage/.update/pending, copies Image.gz/dtb/overlays
# to /boot, then reboots. Initramfs commits the squashfs from ZLYME.
# A structurally OK tar that fails to apply is moved to .update/failed/.
# Junk archives are deleted.
#
# Do not dd a partition. Do not rewrite GPT.
# A delta tar reconstructs a complete squashfs on storage. It never
# patches /boot/zlyme. Initramfs still copies pending/zlyme.

set -eu

. "${ZLYME_DEVICE_CONF:-/usr/share/zlyme/device.conf}"
: "${ZLYME_UPDATE_PREFIX:?device.conf missing ZLYME_UPDATE_PREFIX}"
: "${ZLYME_DTB:?device.conf missing ZLYME_DTB}"

if [ -f /etc/zlyme.conf ]; then
	. /etc/zlyme.conf
fi
STORAGE="${ZLYME_STORAGE:-/storage}"
BOOT="${ZLYME_BOOT:-/boot}"
STAGEDIR="$STORAGE/.update"
PENDING="$STAGEDIR/pending"
QUEUED_TAR="$STAGEDIR/${ZLYME_UPDATE_PREFIX}-update.tar"
WANT="$STAGEDIR/WANT"
REAPPLY="$STAGEDIR/reapply"
FAILED="$STAGEDIR/FAILED"
LOG="$STAGEDIR/apply.log"
BOOTLOADER="$STAGEDIR/bootloader"

# Member listing for one archive. EXIT removes it if a later fail returns
# before the caller does. tar -tf must exit 0; a partial listing is not
# a structural pass.
TAR_LIST=
cleanup_tar_list() {
	if [ -n "${TAR_LIST:-}" ]; then
		rm -f "$TAR_LIST"
		TAR_LIST=
	fi
}
trap 'cleanup_tar_list' EXIT
trap '' HUP PIPE

list_tar_members() {
	tarf=$1
	cleanup_tar_list
	TAR_LIST=$(mktemp) || fail "could not list the archive"
	if ! tar -tf "$tarf" >"$TAR_LIST"; then
		cleanup_tar_list
		return 1
	fi
	return 0
}

tar_has_member() {
	grep -qx "$1" "$TAR_LIST"
}

FAILED_DIR="$STAGEDIR/failed"
NAMEFILE="$STAGEDIR/NAME"
FAILKIND="$STAGEDIR/.failkind"

log() {
	msg="zlyme-update: $*"
	echo "$msg"
	if [ ! -f /tmp/zlyme-splash.progress ] && \
		[ ! -f /boot/zlyme-splash.progress ]; then
		[ -w /dev/console ] && echo "$msg" >/dev/console 2>/dev/null || true
		[ -w /dev/tty1 ] && echo "$msg" >/dev/tty1 2>/dev/null || true
	fi
	if [ -d "$STAGEDIR" ]; then
		echo "$msg" >>"$LOG" 2>/dev/null || true
	fi
}

fail() {
	log "ERROR: $*"
	echo "$*" >"$FAILED" 2>/dev/null || true
	exit 1
}

mark_fail() {
	kind=$1
	shift
	echo "$kind" >"$FAILKIND" 2>/dev/null || true
	fail "$*"
}

need_cmd() {
	command -v "$1" >/dev/null 2>&1 || fail "missing $1"
}

# Galaxy lockup for the whole extract/copy. persist so the reboot that
# commits the squashfs also starts initramfs on galaxy, not slime.
show_galaxy() {
	# persist keeps the boot splash up across the apply reboot by creating
	# /boot/zlyme-splash.progress. test-stage uses this same path, so a
	# test has to clear that flag before a reboot. It is not a root write.
	if [ -x /usr/sbin/zlyme-splash-progress ]; then
		zlyme-splash-progress on persist || true
	else
		: > /tmp/zlyme-splash.progress 2>/dev/null || true
		if [ -x /usr/sbin/zlyme-boot-write ]; then
			zlyme-boot-write sh -c ': > /boot/zlyme-splash.progress' || true
		fi
		killall -USR1 zlyme-splash >/dev/null 2>&1 || true
	fi
}

queued_tar() {
	# Explicit pin still wins (Settings writes WANT / NAME).
	if [ -s "$WANT" ]; then
		t=$(tr -d '\t\r\n' <"$WANT")
		skip=0
		case "$t" in
			*.part|*.tmp|*.partial|*"/failed/"*) skip=1 ;;
		esac
		if [ "$skip" = 0 ]; then
			if [ -s "$t" ]; then
				printf '%s\n' "$t"
				return 0
			fi
			if [ -s "$STAGEDIR/$t" ]; then
				printf '%s\n' "$STAGEDIR/$t"
				return 0
			fi
		fi
	fi
	best=""
	best_m=0
	for f in "$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.tar; do
		[ -f "$f" ] || continue
		[ -s "$f" ] || continue
		case "$f" in
			*.sha256|*.part|*.tmp|*.partial) continue ;;
		esac
		case "$f" in
			*.tar) ;;
			*) continue ;;
		esac
		m=$(stat -c %Y "$f" 2>/dev/null || echo 0)
		if [ -z "$best" ] || [ "$m" -gt "$best_m" ]; then
			best=$f
			best_m=$m
		fi
	done
	if [ -n "$best" ]; then
		printf '%s\n' "$best"
		return 0
	fi
	return 1
}

is_queued() {
	[ -s "$PENDING/VERSION" ] && [ -s "$PENDING/zlyme" ] && return 0
	queued_tar >/dev/null 2>&1
}

verify_tar() {
	tarf=$1
	[ -s "$tarf" ] || mark_fail junk "empty tar"
	need_cmd tar
	if ! list_tar_members "$tarf"; then
		mark_fail junk "tar listing failed"
	fi
	if tar_has_member DELTA-MANIFEST; then
		verify_delta_tar "$tarf"
		cleanup_tar_list
		return 0
	fi
	tar_has_member "$ZLYME_DTB" || mark_fail junk "tar has no dtb"
	tar_has_member zlyme || mark_fail junk "tar has no zlyme squashfs"
	tar_has_member Image.gz || mark_fail junk "tar has no Image.gz"
	log "tar ok ($tarf)"
	cleanup_tar_list
	tar -xOf "$tarf" VERSION 2>/dev/null | head -n 2 || true
}

is_hex64() {
	v=$1
	[ "${#v}" -eq 64 ] || return 1
	case "$v" in
		*[!0-9a-fA-F]*) return 1 ;;
	esac
	return 0
}

# DELTA-MANIFEST is a fixed key list. Do not eval or source it.
read_delta_manifest() {
	file=$1
	delta_type=""
	delta_schema=""
	delta_device=""
	delta_from=""
	delta_target_ver=""
	delta_base=""
	delta_target=""
	delta_size=""
	delta_patch=""
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in
			""|\#*) continue ;;
		esac
		case "$line" in
			*=*) ;;
			*) mark_fail apply "delta manifest syntax" ;;
		esac
		key=${line%%=*}
		val=${line#*=}
		case "$val" in
			*" "*|*"	"*|*'$'*|*'`'*|*'\'*|*'\"'*|*"'"*)
				mark_fail apply "delta manifest value"
				;;
		esac
		case "$key" in
			TYPE)
				[ -z "$delta_type" ] || mark_fail apply "delta manifest duplicate"
				delta_type=$val
				;;
			SCHEMA)
				[ -z "$delta_schema" ] || mark_fail apply "delta manifest duplicate"
				delta_schema=$val
				;;
			DEVICE)
				[ -z "$delta_device" ] || mark_fail apply "delta manifest duplicate"
				delta_device=$val
				;;
			FROM_VERSION)
				[ -z "$delta_from" ] || mark_fail apply "delta manifest duplicate"
				delta_from=$val
				;;
			TARGET_VERSION)
				[ -z "$delta_target_ver" ] || mark_fail apply "delta manifest duplicate"
				delta_target_ver=$val
				;;
			BASE_SHA256)
				[ -z "$delta_base" ] || mark_fail apply "delta manifest duplicate"
				delta_base=$val
				;;
			TARGET_SHA256)
				[ -z "$delta_target" ] || mark_fail apply "delta manifest duplicate"
				delta_target=$val
				;;
			TARGET_SIZE)
				[ -z "$delta_size" ] || mark_fail apply "delta manifest duplicate"
				delta_size=$val
				;;
			PATCH)
				[ -z "$delta_patch" ] || mark_fail apply "delta manifest duplicate"
				delta_patch=$val
				;;
			*) mark_fail apply "delta manifest key" ;;
		esac
	done <"$file"
	[ "$delta_type" = delta ] || mark_fail apply "delta manifest type"
	[ "$delta_schema" = 1 ] || mark_fail apply "delta manifest schema"
	[ "$delta_device" = my355 ] || mark_fail apply "delta manifest device"
	is_hex64 "$delta_base" || mark_fail apply "delta manifest base hash"
	is_hex64 "$delta_target" || mark_fail apply "delta manifest target hash"
	case "$delta_size" in
		""|*[!0-9]*) mark_fail apply "delta manifest size" ;;
	esac
	[ "$delta_patch" = zlyme.patch.zst ] || mark_fail apply "delta manifest patch"
	delta_base=$(printf '%s' "$delta_base" | tr 'A-F' 'a-f')
	delta_target=$(printf '%s' "$delta_target" | tr 'A-F' 'a-f')
}

verify_delta_tar() {
	tarf=$1
	need_cmd tar
	# verify_tar already listed this archive. A direct caller lists it here.
	if [ -z "${TAR_LIST:-}" ]; then
		if ! list_tar_members "$tarf"; then
			mark_fail junk "tar listing failed"
		fi
	fi
	tar_has_member DELTA-MANIFEST || mark_fail junk "delta tar has no manifest"
	tar_has_member zlyme.patch.zst || mark_fail junk "delta tar has no patch"
	if tar_has_member zlyme; then
		mark_fail junk "delta tar must not contain zlyme"
	fi
	tar_has_member "$ZLYME_DTB" || mark_fail junk "tar has no dtb"
	tar_has_member Image.gz || mark_fail junk "tar has no Image.gz"
	tar_has_member VERSION || mark_fail junk "tar has no VERSION"
	log "delta tar ok ($tarf)"
}

file_sha256() {
	need_cmd sha256sum
	sha256sum "$1" | awk '{ print $1 }' | tr 'A-F' 'a-f'
}

storage_free_bytes() {
	avail=$(df -P "$STORAGE" | awk 'NR==2 { print $4 }')
	[ -n "$avail" ] && [ "$avail" -gt 0 ] || fail "cannot df $STORAGE"
	echo $((avail * 1024))
}

# Tar stays on storage while the new root is written beside it.
storage_has_room() {
	need=$1
	free=$(storage_free_bytes) || return 1
	if [ "$free" -lt "$need" ]; then
		mark_fail apply "not enough space on $STORAGE (need $need bytes, free $free)"
		return 1
	fi
	log "storage free $free bytes, need $need"
}

cleanup_reconstruct() {
	rm -rf "$STAGEDIR/reconstruct"
}

stage_delta() {
	tarf=$1
	need_cmd zstd
	verify_delta_tar "$tarf"
	[ -s "$BOOT/zlyme" ] || mark_fail apply "installed /boot/zlyme is missing; current OS was not modified"
	work=$STAGEDIR/reconstruct
	cleanup_reconstruct
	mkdir -p "$work"
	tar -xOf "$tarf" DELTA-MANIFEST >"$work/DELTA-MANIFEST" || {
		cleanup_reconstruct
		mark_fail apply "cannot read delta manifest"
	}
	read_delta_manifest "$work/DELTA-MANIFEST"
	have=$(file_sha256 "$BOOT/zlyme")
	if [ "$have" != "$delta_base" ]; then
		cleanup_reconstruct
		mark_fail apply "installed root does not match delta base; current OS was not modified"
	fi
	# 64 MiB covers the other boot files extracted next to the new root.
	storage_has_room $((delta_size + 67108864)) || {
		cleanup_reconstruct
		return 1
	}
	log "reconstructing squashfs from delta (base $delta_base)"
	# --memory accepts a root-sized window. It also raises zstd's limit
	# above the base file, so the automatic mmap does not run and zstd
	# copies the squashfs into RAM. That copy is OOM-killed on this 1 GiB
	# device. --mmap-dict keeps /boot/zlyme file-backed.
	if ! tar -xOf "$tarf" zlyme.patch.zst | zstd -d --memory=2048MB --mmap-dict --patch-from="$BOOT/zlyme" -o "$work/zlyme.new" -f; then
		cleanup_reconstruct
		mark_fail apply "zstd reconstruction failed; current OS was not modified"
	fi
	got=$(file_sha256 "$work/zlyme.new")
	got_sz=$(wc -c <"$work/zlyme.new")
	got_sz=$((got_sz))
	if [ "$got" != "$delta_target" ] || [ "$got_sz" -ne "$delta_size" ]; then
		cleanup_reconstruct
		mark_fail apply "reconstructed squashfs hash mismatch; current OS was not modified"
	fi
	mv "$work/zlyme.new" "$work/zlyme"
	tar -xf "$tarf" -C "$work" Image.gz "$ZLYME_DTB" idbloader.img u-boot.itb \
		pre-update.sh post-update.sh VERSION || {
		cleanup_reconstruct
		mark_fail apply "delta boot file extract failed"
	}
	if ! list_tar_members "$tarf"; then
		cleanup_reconstruct
		mark_fail apply "tar listing failed"
	fi
	if tar_has_member splash.anim; then
		tar -xf "$tarf" -C "$work" splash.anim
	fi
	if tar_has_member progress.anim; then
		tar -xf "$tarf" -C "$work" progress.anim
	fi
	if grep -q '^overlays/' "$TAR_LIST"; then
		tar -xf "$tarf" -C "$work" overlays
	fi
	if grep -q '^extlinux/' "$TAR_LIST"; then
		tar -xf "$tarf" -C "$work" extlinux
	fi
	cleanup_tar_list
	rm -f "$work/DELTA-MANIFEST"
	sync
	rm -rf "$PENDING"
	mv "$work" "$PENDING"
	sync
	verify_dir "$PENDING"
	squashfs_fits "$PENDING/zlyme"
	log "delta reconstructed $PENDING/zlyme"
}

verify_dir() {
	dir=$1
	[ -s "$dir/$ZLYME_DTB" ] || mark_fail apply "missing $dir/$ZLYME_DTB"
	[ -s "$dir/zlyme" ] || mark_fail apply "missing $dir/zlyme"
	[ -s "$dir/VERSION" ] || mark_fail apply "missing $dir/VERSION"
	[ -s "$dir/Image.gz" ] || mark_fail apply "missing $dir/Image.gz"
}

boot_free_bytes() {
	avail=$(df -P "$BOOT" | awk 'NR==2 { print $4 }')
	[ -n "$avail" ] && [ "$avail" -gt 0 ] || fail "cannot df $BOOT"
	echo $((avail * 1024))
}

# In-place overwrite on ZLYMEBOOT: free + live zlyme must cover the new file.
squashfs_fits() {
	sq=$1
	sz=$(wc -c <"$sq")
	free=$(boot_free_bytes) || return 1
	now=0
	if [ -f "$BOOT/zlyme" ]; then
		now=$(wc -c <"$BOOT/zlyme")
	fi
	if [ $((free + now)) -lt "$sz" ]; then
		mark_fail apply "squashfs ($sz) does not fit on $BOOT (free $free + live $now)"
		return 1
	fi
	log "squashfs $sz bytes, $BOOT free $free + live $now"
}

stage_tar() {
	tarf=$1
	show_galaxy
	if ! list_tar_members "$tarf"; then
		mark_fail junk "tar listing failed"
	fi
	if tar_has_member DELTA-MANIFEST; then
		cleanup_tar_list
		stage_delta "$tarf"
		return 0
	fi
	cleanup_tar_list
	verify_tar "$tarf"
	rm -rf "$PENDING"
	mkdir -p "$PENDING"
	log "extracting $(basename "$tarf") to $PENDING"
	# The downloaded tar stays until apply finishes, so storage must hold both.
	storage_has_room $(( $(wc -c <"$tarf") + 67108864 ))
	tar -xf "$tarf" -C "$PENDING" || mark_fail apply "extract failed"
	verify_dir "$PENDING"
	squashfs_fits "$PENDING/zlyme"
}

ensure_pending() {
	if [ -s "$PENDING/VERSION" ] && [ -s "$PENDING/zlyme" ]; then
		verify_dir "$PENDING"
		squashfs_fits "$PENDING/zlyme"
		return 0
	fi
	tarf=$(queued_tar) || mark_fail apply "nothing queued (drop $QUEUED_TAR and reboot)"
	stage_tar "$tarf"
}

queue_tar() {
	tarf=$1
	[ -s "$tarf" ] || fail "no tar: $tarf"
	verify_tar "$tarf"
	mkdir -p "$STAGEDIR"
	abs=$(readlink -f "$tarf" 2>/dev/null || echo "$tarf")
	destabs=$(readlink -f "$QUEUED_TAR" 2>/dev/null || echo "$QUEUED_TAR")
	if [ "$abs" != "$destabs" ]; then
		log "copying to $QUEUED_TAR"
		cp -f "$tarf" "$QUEUED_TAR"
		sync
	fi
	printf '%s\n' "$QUEUED_TAR" >"$WANT"
	rm -f "$FAILED"
	log "queued. reboot to apply (or: zlyme-update apply)"
	tar -xOf "$QUEUED_TAR" VERSION 2>/dev/null | head -n 2 || true
}

install_boot() {
	dir=$1
	mkdir -p "$BOOT"
	if ! grep -q " $BOOT " /proc/mounts; then
		mark_fail apply "$BOOT not mounted"
		return 1
	fi
	verify_dir "$dir"
	squashfs_fits "$dir/zlyme" || return 1
	if [ ! -x /usr/sbin/zlyme-boot-write ]; then
		mark_fail apply "zlyme-boot-write missing"
		return 1
	fi

	log "installing kernel/dtb/overlays to $BOOT"
	# Gzip is the only kernel we boot. Drop a leftover uncompressed
	# Image so FAT does not keep a second copy.
	ZLYME_BOOT_SRC=$dir ZLYME_BOOT_DST=$BOOT ZLYME_BOOT_DTB=$ZLYME_DTB \
		/usr/sbin/zlyme-boot-write /bin/sh -c '
			cp -f "$ZLYME_BOOT_SRC/Image.gz" "$ZLYME_BOOT_DST/Image.gz" || exit 1
			rm -f "$ZLYME_BOOT_DST/Image" "$ZLYME_BOOT_DST/zlyme.update"
			cp -f "$ZLYME_BOOT_SRC/$ZLYME_BOOT_DTB" "$ZLYME_BOOT_DST/$ZLYME_BOOT_DTB" || exit 1
			if [ -f "$ZLYME_BOOT_SRC/splash.anim" ]; then
				cp -f "$ZLYME_BOOT_SRC/splash.anim" "$ZLYME_BOOT_DST/splash.anim" || exit 1
			fi
			if [ -f "$ZLYME_BOOT_SRC/progress.anim" ]; then
				cp -f "$ZLYME_BOOT_SRC/progress.anim" "$ZLYME_BOOT_DST/progress.anim" || exit 1
			fi
			if [ -d "$ZLYME_BOOT_SRC/extlinux" ]; then
				mkdir -p "$ZLYME_BOOT_DST/extlinux" || exit 1
				cp -a "$ZLYME_BOOT_SRC/extlinux/." "$ZLYME_BOOT_DST/extlinux/" || exit 1
			fi
			if [ -d "$ZLYME_BOOT_SRC/overlays" ]; then
				mkdir -p "$ZLYME_BOOT_DST/overlays" || exit 1
				cp -a "$ZLYME_BOOT_SRC/overlays/." "$ZLYME_BOOT_DST/overlays/" || exit 1
			fi
		' || {
			mark_fail apply "boot file copy failed"
			return 1
		}
	# Keep loader blobs off FAT. pending/ is wiped when initramfs
	# commits the squashfs, so park them here for `zlyme-update uboot`.
	if [ -s "$dir/idbloader.img" ] && [ -s "$dir/u-boot.itb" ]; then
		mkdir -p "$BOOTLOADER"
		cp -f "$dir/idbloader.img" "$BOOTLOADER/idbloader.img"
		cp -f "$dir/u-boot.itb" "$BOOTLOADER/u-boot.itb"
		sync
		log "U-Boot blobs staged at $BOOTLOADER (not written)"
	fi
	sync
	log "squashfs stays at $PENDING/zlyme until initramfs"
}

# Bootloader writes go to the disk that holds the mounted boot volume.
# Never the first GPT name "uboot" on the system: SD2 or USB can carry
# another one. Host tests point ZLYME_SYS_BLOCK and ZLYME_PROC_MOUNTS
# at a synthetic tree. ZLYME_UPDATE_TEST=1 may resolve the target and
# must not raw-write.
SYS_BLOCK=${ZLYME_SYS_BLOCK:-/sys/class/block}
PROC_MOUNTS=${ZLYME_PROC_MOUNTS:-/proc/mounts}
UBOOT_START_LBA=16384
IDBLOADER_LBA=64
SECTOR=512

boot_mount_spec() {
	found=""
	while read -r dev point _rest; do
		[ "$point" = "$BOOT" ] || continue
		found=$dev
		break
	done < "$PROC_MOUNTS"
	[ -n "$found" ] || return 1
	printf '%s\n' "$found"
}

block_name_of() {
	spec=$1
	case "$spec" in
		/dev/*) ;;
		*) return 1 ;;
	esac
	if [ -L "$spec" ]; then
		spec=$(readlink -f "$spec") || return 1
	fi
	name=$(basename "$spec")
	[ -n "$name" ] && [ "$name" != / ] && [ "$name" != . ] && [ "$name" != dev ] || return 1
	printf '%s\n' "$name"
}

block_realpath() {
	name=$1
	[ -e "$SYS_BLOCK/$name" ] || return 1
	readlink -f "$SYS_BLOCK/$name" 2>/dev/null || return 1
}

parent_disk_name() {
	name=$1
	real=$(block_realpath "$name") || return 1
	[ -f "$real/partition" ] || return 1
	parent=$(basename "$(dirname "$real")")
	[ -n "$parent" ] && [ "$parent" != "$name" ] || return 1
	preal=$(block_realpath "$parent") || return 1
	[ -f "$preal/partition" ] && return 1
	printf '%s\n' "$parent"
}

part_named_uboot() {
	real=$1
	[ -f "$real/uevent" ] || return 1
	grep -qx 'PARTNAME=uboot' "$real/uevent" && return 0
	grep -qx 'PARTLABEL=uboot' "$real/uevent" && return 0
	return 1
}

uboot_parts_on_disk() {
	disk=$1
	for ent in "$SYS_BLOCK"/*; do
		[ -e "$ent" ] || continue
		name=$(basename "$ent")
		[ "$name" = "$disk" ] && continue
		real=$(block_realpath "$name") || continue
		[ -f "$real/partition" ] || continue
		parent=$(parent_disk_name "$name") || continue
		[ "$parent" = "$disk" ] || continue
		part_named_uboot "$real" || continue
		printf '%s\n' "$name"
	done
}

read_sys_num() {
	tr -d ' \t\r\n' < "$1"
}

uboot_geometry_ok() {
	part=$1
	lsz=$2
	fsz=$3
	real=$(block_realpath "$part") || return 1
	[ -f "$real/start" ] && [ -f "$real/size" ] || return 1
	start=$(read_sys_num "$real/start")
	sectors=$(read_sys_num "$real/size")
	case "$start" in
		''|*[!0-9]*) return 1 ;;
	esac
	case "$sectors" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$start" -eq "$UBOOT_START_LBA" ] || return 1
	end=$((IDBLOADER_LBA * SECTOR + lsz))
	limit=$((start * SECTOR))
	[ "$end" -le "$limit" ] || return 1
	cap=$((sectors * SECTOR))
	[ "$cap" -ge "$fsz" ] || return 1
	printf '%s %s\n' "$start" "$sectors"
}

# Prints "disk part start sectors" for the one uboot partition on the
# disk behind $BOOT. Fails closed on every ambiguous or unproven case.
resolve_uboot_target() {
	lsz=$1
	fsz=$2
	spec=$(boot_mount_spec) || {
		echo "zlyme-update: ERROR: $BOOT is not mounted" >&2
		return 1
	}
	bootname=$(block_name_of "$spec") || {
		echo "zlyme-update: ERROR: boot device is not a /dev node: $spec" >&2
		return 1
	}
	disk=$(parent_disk_name "$bootname") || {
		echo "zlyme-update: ERROR: cannot resolve the disk behind $bootname" >&2
		return 1
	}
	want_boot=$(basename "${ZLYME_BOOT_DEVICE:-}")
	want_disk=$(basename "${ZLYME_OS_DISK:-}")
	if [ -z "$want_boot" ] || [ -z "$want_disk" ]; then
		echo "zlyme-update: ERROR: primary OS card identity is unset" >&2
		return 1
	fi
	if [ "$bootname" != "$want_boot" ]; then
		echo "zlyme-update: ERROR: $BOOT is $spec, expected ${ZLYME_BOOT_DEVICE}" >&2
		return 1
	fi
	if [ "$disk" != "$want_disk" ]; then
		echo "zlyme-update: ERROR: $BOOT is on $disk, expected $want_disk" >&2
		return 1
	fi
	dreal=$(block_realpath "$disk") || {
		echo "zlyme-update: ERROR: cannot read $disk" >&2
		return 1
	}
	if [ ! -f "$dreal/queue/logical_block_size" ]; then
		echo "zlyme-update: ERROR: $disk has no logical block size" >&2
		return 1
	fi
	lbs=$(read_sys_num "$dreal/queue/logical_block_size")
	if [ "$lbs" != "$SECTOR" ]; then
		echo "zlyme-update: ERROR: $disk logical block size is ${lbs:-missing}, need $SECTOR" >&2
		return 1
	fi
	parts=$(uboot_parts_on_disk "$disk" || true)
	count=0
	part=""
	for name in $parts; do
		count=$((count + 1))
		part=$name
	done
	if [ "$count" -eq 0 ]; then
		echo "zlyme-update: ERROR: no uboot partition on $disk" >&2
		return 1
	fi
	if [ "$count" -ne 1 ]; then
		echo "zlyme-update: ERROR: $disk has $count uboot partitions" >&2
		return 1
	fi
	again=$(parent_disk_name "$part") || {
		echo "zlyme-update: ERROR: uboot partition $part has no parent" >&2
		return 1
	}
	if [ "$again" != "$disk" ]; then
		echo "zlyme-update: ERROR: uboot partition $part is not on $disk" >&2
		return 1
	fi
	geo=$(uboot_geometry_ok "$part" "$lsz" "$fsz") || {
		echo "zlyme-update: ERROR: uboot geometry on $part is not the 8 MiB slot" >&2
		return 1
	}
	set -- $geo
	printf '%s %s %s %s\n' "$disk" "$part" "$1" "$2"
}

stage_uboot_from_tar() {
	tarf=$1
	[ -s "$tarf" ] || fail "no tar: $tarf"
	need_cmd tar
	tar -tf "$tarf" | grep -qx idbloader.img || fail "tar has no idbloader.img"
	tar -tf "$tarf" | grep -qx u-boot.itb || fail "tar has no u-boot.itb"
	mkdir -p "$BOOTLOADER"
	tar -xf "$tarf" -C "$BOOTLOADER" idbloader.img u-boot.itb || fail "extract U-Boot blobs failed"
}

install_uboot() {
	src=""
	if [ -n "${1:-}" ]; then
		stage_uboot_from_tar "$1"
	fi
	if [ -s "$BOOTLOADER/idbloader.img" ] && [ -s "$BOOTLOADER/u-boot.itb" ]; then
		src=$BOOTLOADER
	elif [ -s "$PENDING/idbloader.img" ] && [ -s "$PENDING/u-boot.itb" ]; then
		src=$PENDING
	else
		fail "no idbloader.img + u-boot.itb (OTA apply first, or: zlyme-update uboot <tar>)"
	fi
	loader="$src/idbloader.img"
	fit="$src/u-boot.itb"
	lsz=$(wc -c <"$loader")
	fsz=$(wc -c <"$fit")
	# Gap from 32K to the 8M GPT part; that part is 4M.
	if [ "$lsz" -gt $((8 * 1024 * 1024 - 32 * 1024)) ]; then
		fail "idbloader.img ($lsz) is larger than the 32K..8M gap"
	fi
	if [ "$fsz" -gt $((4 * 1024 * 1024)) ]; then
		fail "u-boot.itb ($fsz) is larger than the 4M uboot part"
	fi
	[ "${ZLYME_UPDATE_TEST:-}" = 1 ] && fail "refusing raw bootloader write in test mode"
	target=$(resolve_uboot_target "$lsz" "$fsz") || fail "refusing bootloader target"
	set -- $target
	disk=/dev/$1
	part=/dev/$2
	[ -b "$part" ] || fail "uboot partition is not a block device: $part"
	[ -b "$disk" ] || fail "boot disk is not a block device: $disk"
	log "writing idbloader ($lsz) and FIT ($fsz) to $disk (partition $part)"
	# 32K = 64*512; 8M = 16384*512. Block device, not a partition node.
	dd if="$loader" of="$disk" bs=512 seek=64 conv=fsync
	dd if="$fit" of="$disk" bs=512 seek=16384 conv=fsync
	sync
	log "U-Boot written. reboot to use it (this command does not reboot)"
}

apply_overlays_now() {
	if [ -x /usr/sbin/zlyme-ctl ]; then
		log "writing FDTOVERLAYS from flags"
		zlyme-ctl apply-overlays || true
	fi
	touch "$REAPPLY"
}

do_reboot() {
	log "rebooting so initramfs can copy zlyme from ZLYME"
	sync
	reboot -f 2>/dev/null || true
	if [ -w /proc/sys/kernel/sysrq ]; then
		echo 1 >/proc/sys/kernel/sysrq 2>/dev/null || true
	fi
	if [ -w /proc/sysrq-trigger ]; then
		echo b >/proc/sysrq-trigger 2>/dev/null || true
	fi
	while true; do
		sleep 1
	done
}

run_pending_hook() {
	hook=$1
	if [ -x "$PENDING/$hook" ]; then
		log "running $hook"
		"$PENDING/$hook" || log "$hook failed (ignored)"
	elif [ -f "$PENDING/$hook" ]; then
		log "running $hook (sh)"
		sh "$PENDING/$hook" || log "$hook failed (ignored)"
	fi
}

delete_update_tars() {
	rm -f "$WANT" "$NAMEFILE"
	rm -f "$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.tar \
		"$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.tar.part \
		"$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.sha256 \
		"$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.sha256.part \
		"$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.tar.sha256 \
		"$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.partial \
		"$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.tmp 2>/dev/null || true
}

quarantine_update_tars() {
	rm -rf "$FAILED_DIR"
	mkdir -p "$FAILED_DIR"
	for f in "$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.tar; do
		[ -f "$f" ] || continue
		case "$f" in
			*.part|*.tmp|*.partial) continue ;;
		esac
		mv -f "$f" "$FAILED_DIR/" 2>/dev/null || true
	done
	if [ -f "$NAMEFILE" ]; then
		mv -f "$NAMEFILE" "$FAILED_DIR/NAME" 2>/dev/null || true
	fi
	rm -f "$WANT"
}

handle_apply_failure() {
	kind=apply
	if [ -s "$FAILKIND" ]; then
		kind=$(tr -d '\t\r\n' <"$FAILKIND")
	fi
	reason=$(cat "$FAILED" 2>/dev/null || echo "apply failed")
	log "boot-apply failed ($kind): $reason"
	rm -rf "$PENDING"
	if [ "$kind" = junk ]; then
		delete_update_tars
	else
		quarantine_update_tars
	fi
	echo "$reason" >"$FAILED" 2>/dev/null || true
	rm -f "$FAILKIND"
}

# Extract on ZLYME, copy kernel to /boot, leave pending/zlyme for initramfs.
apply_files() {
	show_galaxy
	# A new apply replaces a previous failed leftover.
	rm -rf "$FAILED_DIR"
	rm -f "$FAILED" "$FAILKIND"
	rm -f "${ZLYME_CFG:-/storage/.config}/zlyme/last-ota"
	ensure_pending
	run_pending_hook pre-update.sh
	install_boot "$PENDING" || return 1
	apply_overlays_now
	rm -f "$WANT" "$FAILED" "$FAILKIND" "$NAMEFILE"
	rm -rf "$FAILED_DIR"
	if [ -f "$QUEUED_TAR" ]; then
		rm -f "$QUEUED_TAR"
	fi
	# Versioned leftovers only; the well-known name is already gone.
	rm -f "$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-[0-9]*.tar \
		"$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-[0-9]*.sha256 \
		"$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-[0-9]*.tar.sha256 2>/dev/null || true
	sync
	log "pending squashfs on ZLYME, kernel on $BOOT"
	do_reboot
}

boot_apply() {
	mkdir -p "$STAGEDIR" 2>/dev/null || true
	log "boot-apply"
	rm -f "$FAILED" "$FAILKIND"
	if ! is_queued; then
		log "nothing queued"
		return 0
	fi
	# fail() exits. Catch it so S18 can continue on the old squashfs.
	if ( apply_files ); then
		return 0
	fi
	handle_apply_failure
	return 0
}

dry_run() {
	tarf=$1
	verify_tar "$tarf"
	echo "zlyme-update: would queue $tarf as $QUEUED_TAR"
	echo "zlyme-update: reboot extracts to $PENDING, copies kernel/dtb to $BOOT"
	echo "zlyme-update: initramfs copies $PENDING/zlyme over $BOOT/zlyme"
	echo "zlyme-update: U-Boot blobs are not written unless you run: zlyme-update uboot"
	if grep -q " $BOOT " /proc/mounts; then
		free=$(boot_free_bytes) || free=0
		echo "zlyme-update: $BOOT has $free bytes free"
	fi
}

status() {
	echo "storage=$STORAGE"
	if is_queued; then
		echo "queued=yes"
		queued_tar 2>/dev/null || true
		[ -s "$PENDING/VERSION" ] && echo "pending=$(cat "$PENDING/VERSION" | head -n 1)"
	else
		echo "queued=no"
	fi
	[ -f "$FAILED" ] && echo "failed=$(cat "$FAILED")"
	[ -f "$REAPPLY" ] && echo "reapply=yes"
	[ -f "$PENDING/zlyme" ] && echo "pending/zlyme=yes (reboot to commit)"
	if [ -f "$BOOT/zlyme" ]; then
		echo "root=squashfs-file"
	else
		echo "root=other"
	fi
}

reapply_once() {
	[ -f "$REAPPLY" ] || return 0
	# Drop the flag first. apply-settings used to call mergerfs while
	# S17 held the lock; S18 waited, splash stuck, and this file
	# survived so the next boot hung the same way.
	rm -f "$REAPPLY"
	# Reapply the profile already chosen. Forcing smart here races a
	# game that started after the first frame.
	if [ -x /usr/sbin/zlyme-governor ]; then
		zlyme-governor resume || true
	fi
	if [ -x /usr/sbin/zlyme-ctl ]; then
		zlyme-ctl apply-led || true
		zlyme-ctl apply-zram || true
	fi
}

cmd=${1:-}
if [ "$#" -gt 0 ]; then
	shift
fi

case "$cmd" in
	verify)
		verify_tar "${1:?tar}"
		;;
	queue)
		queue_tar "${1:?tar}"
		;;
	apply)
		if [ -n "${1:-}" ]; then
			queue_tar "$1"
		fi
		apply_files
		;;
	boot-apply | apply-pending)
		boot_apply
		;;
	queued)
		is_queued
		;;
	status)
		status
		;;
	reapply)
		reapply_once
		;;
	cancel)
		rm -rf "$PENDING"
		rm -f "$WANT" "$FAILED"
		log "cancelled queue (tar left in place if present)"
		;;
	uboot)
		install_uboot "${1:-}"
		;;
	uboot-target)
		[ "${ZLYME_UPDATE_TEST:-}" = 1 ] || fail "uboot-target is not a user command"
		lsz=${ZLYME_UBOOT_LOADER_BYTES:-4096}
		fsz=${ZLYME_UBOOT_FIT_BYTES:-4096}
		target=$(resolve_uboot_target "$lsz" "$fsz") || exit 1
		set -- $target
		printf 'disk=/dev/%s\npart=/dev/%s\nstart=%s\nsectors=%s\n' "$1" "$2" "$3" "$4"
		;;
	dry-run)
		dry_run "${1:?tar}"
		;;
	test-stage)
		[ "${ZLYME_UPDATE_TEST:-}" = 1 ] || fail "test-stage is not a user command"
		stage_tar "${1:?tar}"
		;;
	*)
		echo "usage: zlyme-update {queue|apply|boot-apply|verify|status|cancel|dry-run|uboot} [tar]" >&2
		echo "  Settings queues $QUEUED_TAR; reboot applies" >&2
		echo "  uboot writes idbloader + FIT; it is not part of apply" >&2
		exit 1
		;;
esac
