#!/bin/sh
# OS update: stage the squashfs on ZLYME, copy kernel files onto FAT.
# Initramfs copies pending/zlyme over the live /boot/zlyme (not mounted
# as a second file on ZLYMEBOOT).
#
# Contract:
#   1. Copy a finished tar to /storage/.update/${ZLYME_UPDATE_PREFIX}-*.tar
#      (update.tar, versioned, or -dirty; newest mtime wins).
#      Incomplete downloads must be named *.tar.part — this script ignores them.
#   2. reboot
# S18 extracts to /storage/.update/pending, copies Image.gz/dtb/overlays
# to /boot, then reboots. Initramfs commits the squashfs from ZLYME.
# A structurally OK tar that fails to apply is moved to .update/failed/.
# Junk archives are deleted.
#
# Do not dd a partition. Do not rewrite GPT.

set -eu

. /usr/share/zlyme/device.conf
: "${ZLYME_UPDATE_PREFIX:?device.conf missing ZLYME_UPDATE_PREFIX}"
: "${ZLYME_DTB:?device.conf missing ZLYME_DTB}"

. /etc/zlyme.conf 2>/dev/null || true
STORAGE="${ZLYME_STORAGE:-/storage}"
BOOT="${ZLYME_BOOT:-/boot}"
STAGEDIR="$STORAGE/.update"
PENDING="$STAGEDIR/pending"
QUEUED_TAR="$STAGEDIR/${ZLYME_UPDATE_PREFIX}-update.tar"
WANT="$STAGEDIR/WANT"
REAPPLY="$STAGEDIR/reapply"
FAILED="$STAGEDIR/FAILED"
LOG="$STAGEDIR/apply.log"
BOOTLOADER="$STAGEDIR/bootloader"

trap '' HUP PIPE

FAILED_DIR="$STAGEDIR/failed"
NAMEFILE="$STAGEDIR/NAME"
FAILKIND="$STAGEDIR/.failkind"

log() {
	msg="zlyme-update: $*"
	echo "$msg"
	if [ ! -f /tmp/zlyme-splash.progress ] && \
		[ ! -f /boot/zlyme-splash.progress ]; then
		[ -w /dev/console ] && echo "$msg" >/dev/console 2>/dev/null || true
		[ -w /dev/tty1 ] && echo "$msg" >/dev/tty1 2>/dev/null || true
	fi
	if [ -d "$STAGEDIR" ]; then
		echo "$msg" >>"$LOG" 2>/dev/null || true
	fi
}

fail() {
	log "ERROR: $*"
	echo "$*" >"$FAILED" 2>/dev/null || true
	exit 1
}

mark_fail() {
	kind=$1
	shift
	echo "$kind" >"$FAILKIND" 2>/dev/null || true
	fail "$*"
}

need_cmd() {
	command -v "$1" >/dev/null 2>&1 || fail "missing $1"
}

# Galaxy lockup for the whole extract/copy. persist so the reboot that
# commits the squashfs also starts initramfs on galaxy, not slime.
show_galaxy() {
	if [ -x /usr/sbin/zlyme-splash-progress ]; then
		zlyme-splash-progress on persist || true
	else
		: > /tmp/zlyme-splash.progress 2>/dev/null || true
		: > /boot/zlyme-splash.progress 2>/dev/null || true
		killall -USR1 zlyme-splash >/dev/null 2>&1 || true
	fi
}

queued_tar() {
	# Explicit pin still wins (Settings writes WANT / NAME).
	if [ -s "$WANT" ]; then
		t=$(tr -d '\t\r\n' <"$WANT")
		skip=0
		case "$t" in
			*.part|*.tmp|*.partial|*"/failed/"*) skip=1 ;;
		esac
		if [ "$skip" = 0 ]; then
			if [ -s "$t" ]; then
				printf '%s\n' "$t"
				return 0
			fi
			if [ -s "$STAGEDIR/$t" ]; then
				printf '%s\n' "$STAGEDIR/$t"
				return 0
			fi
		fi
	fi
	best=""
	best_m=0
	for f in "$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.tar; do
		[ -f "$f" ] || continue
		[ -s "$f" ] || continue
		case "$f" in
			*.sha256|*.part|*.tmp|*.partial) continue ;;
		esac
		case "$f" in
			*.tar) ;;
			*) continue ;;
		esac
		m=$(stat -c %Y "$f" 2>/dev/null || echo 0)
		if [ -z "$best" ] || [ "$m" -gt "$best_m" ]; then
			best=$f
			best_m=$m
		fi
	done
	if [ -n "$best" ]; then
		printf '%s\n' "$best"
		return 0
	fi
	return 1
}

is_queued() {
	[ -s "$PENDING/VERSION" ] && [ -s "$PENDING/zlyme" ] && return 0
	queued_tar >/dev/null 2>&1
}

verify_tar() {
	tarf=$1
	[ -s "$tarf" ] || mark_fail junk "empty tar"
	need_cmd tar
	tar -tf "$tarf" | grep -qx "$ZLYME_DTB" || mark_fail junk "tar has no dtb"
	tar -tf "$tarf" | grep -qx zlyme || mark_fail junk "tar has no zlyme squashfs"
	tar -tf "$tarf" | grep -qx Image.gz || mark_fail junk "tar has no Image.gz"
	log "tar ok ($tarf)"
	tar -xOf "$tarf" VERSION 2>/dev/null | head -n 2 || true
}

verify_dir() {
	dir=$1
	[ -s "$dir/$ZLYME_DTB" ] || mark_fail apply "missing $dir/$ZLYME_DTB"
	[ -s "$dir/zlyme" ] || mark_fail apply "missing $dir/zlyme"
	[ -s "$dir/VERSION" ] || mark_fail apply "missing $dir/VERSION"
	[ -s "$dir/Image.gz" ] || mark_fail apply "missing $dir/Image.gz"
}

boot_free_bytes() {
	avail=$(df -P "$BOOT" | awk 'NR==2 { print $4 }')
	[ -n "$avail" ] && [ "$avail" -gt 0 ] || fail "cannot df $BOOT"
	echo $((avail * 1024))
}

# In-place overwrite on ZLYMEBOOT: free + live zlyme must cover the new file.
squashfs_fits() {
	sq=$1
	sz=$(wc -c <"$sq")
	free=$(boot_free_bytes) || return 1
	now=0
	if [ -f "$BOOT/zlyme" ]; then
		now=$(wc -c <"$BOOT/zlyme")
	fi
	if [ $((free + now)) -lt "$sz" ]; then
		mark_fail apply "squashfs ($sz) does not fit on $BOOT (free $free + live $now)"
		return 1
	fi
	log "squashfs $sz bytes, $BOOT free $free + live $now"
}

stage_tar() {
	tarf=$1
	show_galaxy
	verify_tar "$tarf"
	rm -rf "$PENDING"
	mkdir -p "$PENDING"
	log "extracting $(basename "$tarf") to $PENDING"
	tar -xf "$tarf" -C "$PENDING" || mark_fail apply "extract failed"
	verify_dir "$PENDING"
	squashfs_fits "$PENDING/zlyme"
}

ensure_pending() {
	if [ -s "$PENDING/VERSION" ] && [ -s "$PENDING/zlyme" ]; then
		verify_dir "$PENDING"
		squashfs_fits "$PENDING/zlyme"
		return 0
	fi
	tarf=$(queued_tar) || mark_fail apply "nothing queued (drop $QUEUED_TAR and reboot)"
	stage_tar "$tarf"
}

queue_tar() {
	tarf=$1
	[ -s "$tarf" ] || fail "no tar: $tarf"
	verify_tar "$tarf"
	mkdir -p "$STAGEDIR"
	abs=$(readlink -f "$tarf" 2>/dev/null || echo "$tarf")
	destabs=$(readlink -f "$QUEUED_TAR" 2>/dev/null || echo "$QUEUED_TAR")
	if [ "$abs" != "$destabs" ]; then
		log "copying to $QUEUED_TAR"
		cp -f "$tarf" "$QUEUED_TAR"
		sync
	fi
	printf '%s\n' "$QUEUED_TAR" >"$WANT"
	rm -f "$FAILED"
	log "queued. reboot to apply (or: zlyme-update apply)"
	tar -xOf "$QUEUED_TAR" VERSION 2>/dev/null | head -n 2 || true
}

install_boot() {
	dir=$1
	mkdir -p "$BOOT"
	if ! grep -q " $BOOT " /proc/mounts; then
		mark_fail apply "$BOOT not mounted"
		return 1
	fi
	verify_dir "$dir"
	squashfs_fits "$dir/zlyme" || return 1
	rm -f "$BOOT/zlyme.update"

	log "installing kernel/dtb/overlays to $BOOT"
	cp -f "$dir/Image.gz" "$BOOT/Image.gz"
	# Gzip is the only kernel we boot. Drop a leftover uncompressed
	# Image so FAT does not keep a second copy.
	rm -f "$BOOT/Image"
	cp -f "$dir/$ZLYME_DTB" "$BOOT/$ZLYME_DTB"
	if [ -f "$dir/splash.anim" ]; then
		cp -f "$dir/splash.anim" "$BOOT/splash.anim"
	fi
	if [ -f "$dir/progress.anim" ]; then
		cp -f "$dir/progress.anim" "$BOOT/progress.anim"
	fi
	if [ -d "$dir/extlinux" ]; then
		mkdir -p "$BOOT/extlinux"
		cp -a "$dir/extlinux/." "$BOOT/extlinux/"
	fi
	if [ -d "$dir/overlays" ]; then
		mkdir -p "$BOOT/overlays"
		cp -a "$dir/overlays/." "$BOOT/overlays/"
	fi
	# Keep loader blobs off FAT. pending/ is wiped when initramfs
	# commits the squashfs, so park them here for `zlyme-update uboot`.
	if [ -s "$dir/idbloader.img" ] && [ -s "$dir/u-boot.itb" ]; then
		mkdir -p "$BOOTLOADER"
		cp -f "$dir/idbloader.img" "$BOOTLOADER/idbloader.img"
		cp -f "$dir/u-boot.itb" "$BOOTLOADER/u-boot.itb"
		sync
		log "U-Boot blobs staged at $BOOTLOADER (not written)"
	fi
	sync
	log "squashfs stays at $PENDING/zlyme until initramfs"
}

# GPT name "uboot" at 8M; idbloader sits at 32K, outside the table.
# Resolve the parent disk at runtime. apply_files never calls this.
uboot_part_dev() {
	if [ -b /dev/disk/by-partlabel/uboot ]; then
		readlink -f /dev/disk/by-partlabel/uboot
		return 0
	fi
	for ue in /sys/class/block/*/uevent; do
		[ -f "$ue" ] || continue
		if grep -qx 'PARTNAME=uboot' "$ue"; then
			printf '/dev/%s\n' "$(basename "$(dirname "$ue")")"
			return 0
		fi
	done
	dev=$(blkid 2>/dev/null | sed -n 's|^\([^:]*\):.*PARTLABEL="uboot".*|\1|p' | head -n 1)
	if [ -n "$dev" ] && [ -b "$dev" ]; then
		printf '%s\n' "$dev"
		return 0
	fi
	return 1
}

parent_block() {
	name=$(basename "$1")
	real=$(readlink -f "/sys/class/block/$name" 2>/dev/null) || return 1
	printf '/dev/%s\n' "$(basename "$(dirname "$real")")"
}

stage_uboot_from_tar() {
	tarf=$1
	[ -s "$tarf" ] || fail "no tar: $tarf"
	need_cmd tar
	tar -tf "$tarf" | grep -qx idbloader.img || fail "tar has no idbloader.img"
	tar -tf "$tarf" | grep -qx u-boot.itb || fail "tar has no u-boot.itb"
	mkdir -p "$BOOTLOADER"
	tar -xf "$tarf" -C "$BOOTLOADER" idbloader.img u-boot.itb || fail "extract U-Boot blobs failed"
}

install_uboot() {
	src=""
	if [ -n "${1:-}" ]; then
		stage_uboot_from_tar "$1"
	fi
	if [ -s "$BOOTLOADER/idbloader.img" ] && [ -s "$BOOTLOADER/u-boot.itb" ]; then
		src=$BOOTLOADER
	elif [ -s "$PENDING/idbloader.img" ] && [ -s "$PENDING/u-boot.itb" ]; then
		src=$PENDING
	else
		fail "no idbloader.img + u-boot.itb (OTA apply first, or: zlyme-update uboot <tar>)"
	fi
	loader="$src/idbloader.img"
	fit="$src/u-boot.itb"
	lsz=$(wc -c <"$loader")
	fsz=$(wc -c <"$fit")
	# Gap from 32K to the 8M GPT part; that part is 4M.
	if [ "$lsz" -gt $((8 * 1024 * 1024 - 32 * 1024)) ]; then
		fail "idbloader.img ($lsz) is larger than the 32K..8M gap"
	fi
	if [ "$fsz" -gt $((4 * 1024 * 1024)) ]; then
		fail "u-boot.itb ($fsz) is larger than the 4M uboot part"
	fi
	part=$(uboot_part_dev) || fail "no GPT partition named uboot"
	disk=$(parent_block "$part") || fail "no parent disk for $part"
	[ -b "$disk" ] || fail "parent disk is not a block device: $disk"
	log "writing idbloader ($lsz) and FIT ($fsz) to $disk"
	# 32K = 64*512; 8M = 16384*512. Block device, not a partition node.
	dd if="$loader" of="$disk" bs=512 seek=64 conv=fsync
	dd if="$fit" of="$disk" bs=512 seek=16384 conv=fsync
	sync
	log "U-Boot written. reboot to use it (this command does not reboot)"
}

apply_overlays_now() {
	if [ -x /usr/sbin/zlyme-ctl ]; then
		log "writing FDTOVERLAYS from flags"
		zlyme-ctl apply-overlays || true
	fi
	touch "$REAPPLY"
}

do_reboot() {
	log "rebooting so initramfs can copy zlyme from ZLYME"
	sync
	reboot -f 2>/dev/null || true
	if [ -w /proc/sys/kernel/sysrq ]; then
		echo 1 >/proc/sys/kernel/sysrq 2>/dev/null || true
	fi
	if [ -w /proc/sysrq-trigger ]; then
		echo b >/proc/sysrq-trigger 2>/dev/null || true
	fi
	while true; do
		sleep 1
	done
}

run_pending_hook() {
	hook=$1
	if [ -x "$PENDING/$hook" ]; then
		log "running $hook"
		"$PENDING/$hook" || log "$hook failed (ignored)"
	elif [ -f "$PENDING/$hook" ]; then
		log "running $hook (sh)"
		sh "$PENDING/$hook" || log "$hook failed (ignored)"
	fi
}

delete_update_tars() {
	rm -f "$WANT" "$NAMEFILE"
	rm -f "$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.tar \
		"$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.tar.part \
		"$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.sha256 \
		"$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.sha256.part \
		"$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.tar.sha256 \
		"$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.partial \
		"$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.tmp 2>/dev/null || true
}

quarantine_update_tars() {
	rm -rf "$FAILED_DIR"
	mkdir -p "$FAILED_DIR"
	for f in "$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-*.tar; do
		[ -f "$f" ] || continue
		case "$f" in
			*.part|*.tmp|*.partial) continue ;;
		esac
		mv -f "$f" "$FAILED_DIR/" 2>/dev/null || true
	done
	if [ -f "$NAMEFILE" ]; then
		mv -f "$NAMEFILE" "$FAILED_DIR/NAME" 2>/dev/null || true
	fi
	rm -f "$WANT"
}

handle_apply_failure() {
	kind=apply
	if [ -s "$FAILKIND" ]; then
		kind=$(tr -d '\t\r\n' <"$FAILKIND")
	fi
	reason=$(cat "$FAILED" 2>/dev/null || echo "apply failed")
	log "boot-apply failed ($kind): $reason"
	rm -rf "$PENDING"
	if [ "$kind" = junk ]; then
		delete_update_tars
	else
		quarantine_update_tars
	fi
	echo "$reason" >"$FAILED" 2>/dev/null || true
	rm -f "$FAILKIND"
}

# Extract on ZLYME, copy kernel to /boot, leave pending/zlyme for initramfs.
apply_files() {
	show_galaxy
	# A new apply replaces a previous failed leftover.
	rm -rf "$FAILED_DIR"
	rm -f "$FAILED" "$FAILKIND"
	rm -f "${ZLYME_CFG:-/storage/.config}/zlyme/last-ota"
	ensure_pending
	run_pending_hook pre-update.sh
	install_boot "$PENDING" || return 1
	apply_overlays_now
	rm -f "$WANT" "$FAILED" "$FAILKIND" "$NAMEFILE"
	rm -rf "$FAILED_DIR"
	if [ -f "$QUEUED_TAR" ]; then
		rm -f "$QUEUED_TAR"
	fi
	# Versioned leftovers only; the well-known name is already gone.
	rm -f "$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-[0-9]*.tar \
		"$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-[0-9]*.sha256 \
		"$STAGEDIR"/${ZLYME_UPDATE_PREFIX}-[0-9]*.tar.sha256 2>/dev/null || true
	sync
	log "pending squashfs on ZLYME, kernel on $BOOT"
	do_reboot
}

boot_apply() {
	mkdir -p "$STAGEDIR" 2>/dev/null || true
	log "boot-apply"
	rm -f "$FAILED" "$FAILKIND"
	if ! is_queued; then
		log "nothing queued"
		return 0
	fi
	# fail() exits. Catch it so S18 can continue on the old squashfs.
	if ( apply_files ); then
		return 0
	fi
	handle_apply_failure
	return 0
}

dry_run() {
	tarf=$1
	verify_tar "$tarf"
	echo "zlyme-update: would queue $tarf as $QUEUED_TAR"
	echo "zlyme-update: reboot extracts to $PENDING, copies kernel/dtb to $BOOT"
	echo "zlyme-update: initramfs copies $PENDING/zlyme over $BOOT/zlyme"
	echo "zlyme-update: U-Boot blobs are not written unless you run: zlyme-update uboot"
	if grep -q " $BOOT " /proc/mounts; then
		free=$(boot_free_bytes) || free=0
		echo "zlyme-update: $BOOT has $free bytes free"
	fi
}

status() {
	echo "storage=$STORAGE"
	if is_queued; then
		echo "queued=yes"
		queued_tar 2>/dev/null || true
		[ -s "$PENDING/VERSION" ] && echo "pending=$(cat "$PENDING/VERSION" | head -n 1)"
	else
		echo "queued=no"
	fi
	[ -f "$FAILED" ] && echo "failed=$(cat "$FAILED")"
	[ -f "$REAPPLY" ] && echo "reapply=yes"
	[ -f "$PENDING/zlyme" ] && echo "pending/zlyme=yes (reboot to commit)"
	if [ -f "$BOOT/zlyme" ]; then
		echo "root=squashfs-file"
	else
		echo "root=other"
	fi
}

reapply_once() {
	[ -f "$REAPPLY" ] || return 0
	# Drop the flag first. apply-settings used to call mergerfs while
	# S17 held the lock; S18 waited, splash stuck, and this file
	# survived so the next boot hung the same way.
	rm -f "$REAPPLY"
	if [ -x /usr/sbin/zlyme-ctl ]; then
		zlyme-ctl apply-gov || true
		zlyme-ctl apply-led || true
		zlyme-ctl apply-zram || true
	fi
}

cmd=${1:-}
if [ "$#" -gt 0 ]; then
	shift
fi

case "$cmd" in
	verify)
		verify_tar "${1:?tar}"
		;;
	queue)
		queue_tar "${1:?tar}"
		;;
	apply)
		if [ -n "${1:-}" ]; then
			queue_tar "$1"
		fi
		apply_files
		;;
	boot-apply | apply-pending)
		boot_apply
		;;
	queued)
		is_queued
		;;
	status)
		status
		;;
	reapply)
		reapply_once
		;;
	cancel)
		rm -rf "$PENDING"
		rm -f "$WANT" "$FAILED"
		log "cancelled queue (tar left in place if present)"
		;;
	uboot)
		install_uboot "${1:-}"
		;;
	dry-run)
		dry_run "${1:?tar}"
		;;
	*)
		echo "usage: zlyme-update {queue|apply|boot-apply|verify|status|cancel|dry-run|uboot} [tar]" >&2
		echo "  Settings queues $QUEUED_TAR; reboot applies" >&2
		echo "  uboot writes idbloader + FIT; it is not part of apply" >&2
		exit 1
		;;
esac
