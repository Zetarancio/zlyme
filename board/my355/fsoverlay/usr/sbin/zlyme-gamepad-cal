#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Restore or show Miyoo Flip gamepad calibration.
#
# The kernel never opens these files. Settings writes each file by
# creating a temporary file, fsyncing it, and renaming it into place.
# This helper only reads them and restores them after the first frame.
#
#   /storage/.config/zlyme/miyoo-flip-gamepad/joypad.config
#   /storage/.config/zlyme/miyoo-flip-gamepad/joypad_right.config
#
# Keys, one per line: x_min x_max y_min y_max x_zero y_zero
#
# Each side of the center must be longer than the kernel deadband
# of 2, so the scale divisor stays positive. Travel-quality checks
# belong in the calibration UI. 3C2b owns that UI.
#
# The kernel also rejects a restore when a preserved boot or apply
# center would fall outside the new range. This script does not
# predict that. A failed write leaves that stick unchanged, and
# boot continues if restore fails.

CAL_DIR=${ZLYME_CAL_DIR:-/storage/.config/zlyme/miyoo-flip-gamepad}
LEFT_FILE=$CAL_DIR/joypad.config
RIGHT_FILE=$CAL_DIR/joypad_right.config
DZ_FILE=$CAL_DIR/deadzone.config
GAMEPAD_SYS=${ZLYME_GAMEPAD_SYS:-/sys/bus/serial/drivers/miyoo-flip-gamepad}
DEADBAND=2

find_dev() {
	for d in "$GAMEPAD_SYS"/*; do
		[ -e "$d/calibration_left" ] && [ -e "$d/calibration_right" ] || continue
		printf '%s\n' "$d"
		return 0
	done
	echo "miyoo-flip-gamepad calibration sysfs is absent" >&2
	return 1
}

# Prints: x_min x_zero x_max y_min y_zero y_max
parse_cal() {
	file=$1
	xmin= xmax= ymin= ymax= xzero= yzero=
	seen_xmin=0 seen_xmax=0 seen_ymin=0 seen_ymax=0
	seen_xzero=0 seen_yzero=0

	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in
		'' | '#'*) continue ;;
		*=*) ;;
		*)
			echo "invalid line in $file" >&2
			return 1
			;;
		esac
		key=${line%%=*}
		val=${line#*=}
		case "$val" in
		'' | *[!0-9]*)
			echo "invalid value for $key in $file" >&2
			return 1
			;;
		esac
		if [ "${#val}" -gt 3 ]; then
			echo "value out of range for $key in $file" >&2
			return 1
		fi
		# Strip leading zeros in POSIX sh. $((10#n)) is not POSIX,
		# and a leading zero would make $((n)) octal.
		n=$val
		while [ "${n#0}" != "$n" ]; do
			n=${n#0}
		done
		[ -n "$n" ] || n=0
		if [ "$n" -gt 255 ]; then
			echo "value out of range for $key in $file" >&2
			return 1
		fi
		case "$key" in
		x_min)
			[ "$seen_xmin" -eq 1 ] && return 1
			xmin=$n
			seen_xmin=1
			;;
		x_max)
			[ "$seen_xmax" -eq 1 ] && return 1
			xmax=$n
			seen_xmax=1
			;;
		y_min)
			[ "$seen_ymin" -eq 1 ] && return 1
			ymin=$n
			seen_ymin=1
			;;
		y_max)
			[ "$seen_ymax" -eq 1 ] && return 1
			ymax=$n
			seen_ymax=1
			;;
		x_zero)
			[ "$seen_xzero" -eq 1 ] && return 1
			xzero=$n
			seen_xzero=1
			;;
		y_zero)
			[ "$seen_yzero" -eq 1 ] && return 1
			yzero=$n
			seen_yzero=1
			;;
		*)
			echo "unknown key $key in $file" >&2
			return 1
			;;
		esac
	done <"$file"

	if [ "$seen_xmin" -ne 1 ] || [ "$seen_xmax" -ne 1 ] ||
		[ "$seen_ymin" -ne 1 ] || [ "$seen_ymax" -ne 1 ] ||
		[ "$seen_xzero" -ne 1 ] || [ "$seen_yzero" -ne 1 ]; then
		echo "missing field in $file" >&2
		return 1
	fi
	if [ "$xmin" -ge "$xzero" ] || [ "$xzero" -ge "$xmax" ] ||
		[ "$ymin" -ge "$yzero" ] || [ "$yzero" -ge "$ymax" ]; then
		echo "center is not strictly inside min/max in $file" >&2
		return 1
	fi
	if [ $((xzero - xmin)) -le "$DEADBAND" ] ||
		[ $((xmax - xzero)) -le "$DEADBAND" ] ||
		[ $((yzero - ymin)) -le "$DEADBAND" ] ||
		[ $((ymax - yzero)) -le "$DEADBAND" ]; then
		echo "side is not longer than deadband $DEADBAND in $file" >&2
		return 1
	fi
	printf '%s %s %s %s %s %s\n' "$xmin" "$xzero" "$xmax" "$ymin" "$yzero" "$ymax"
}

write_restore() {
	dev=$1
	attr=$2
	line=$3
	# shellcheck disable=SC2086
	set -- $line
	if [ "$#" -ne 6 ]; then
		echo "internal parse error" >&2
		return 1
	fi
	printf 'restore %s %s %s %s %s %s\n' "$1" "$2" "$3" "$4" "$5" "$6" \
		>"$dev/$attr"
}

restore_side() {
	dev=$1
	file=$2
	attr=$3
	side=$4
	if [ ! -f "$file" ]; then
		return 0
	fi
	line=$(parse_cal "$file") || {
		echo "$side: malformed $file" >&2
		return 1
	}
	if ! write_restore "$dev" "$attr" "$line"; then
		echo "$side: kernel rejected restore" >&2
		return 1
	fi
	return 0
}

# Prints: apply_left pct_left apply_right pct_right
# A missing key applies 0. A bad or duplicate key is not applied.
parse_deadzone() {
	file=$1
	left=0
	right=0
	apply_l=1
	apply_r=1
	seen_l=0
	seen_r=0
	bad=0
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in
		'' | '#'*) continue ;;
		left=* | right=*) ;;
		*)
			echo "unknown deadzone line in $file" >&2
			bad=1
			continue
			;;
		esac
		key=${line%%=*}
		val=${line#*=}
		ok=1
		case "$val" in
		'' | *[!0-9]*) ok=0 ;;
		esac
		n=$val
		if [ "$ok" -eq 1 ]; then
			while [ "${n#0}" != "$n" ]; do
				n=${n#0}
			done
			[ -n "$n" ] || n=0
			if [ "$n" -gt 30 ]; then
				ok=0
			fi
		fi
		case "$key" in
		left)
			if [ "$seen_l" -eq 1 ] || [ "$ok" -eq 0 ]; then
				echo "left: malformed deadzone in $file" >&2
				apply_l=0
				bad=1
				seen_l=1
				continue
			fi
			left=$n
			seen_l=1
			;;
		right)
			if [ "$seen_r" -eq 1 ] || [ "$ok" -eq 0 ]; then
				echo "right: malformed deadzone in $file" >&2
				apply_r=0
				bad=1
				seen_r=1
				continue
			fi
			right=$n
			seen_r=1
			;;
		esac
	done <"$file"
	printf '%s %s %s %s\n' "$apply_l" "$left" "$apply_r" "$right"
	return "$bad"
}

write_deadzone() {
	dev=$1
	side=$2
	pct=$3
	attr=deadzone_left
	[ "$side" = right ] && attr=deadzone_right
	if ! printf '%s\n' "$pct" >"$dev/$attr"; then
		echo "$side: kernel rejected deadzone" >&2
		return 1
	fi
	return 0
}

restore_deadzone() {
	dev=$1
	if [ ! -f "$DZ_FILE" ]; then
		return 0
	fi
	line=$(parse_deadzone "$DZ_FILE") || bad=1
	# shellcheck disable=SC2086
	set -- $line
	fail=0
	[ "${bad:-0}" -eq 0 ] || fail=1
	if [ "${1:-0}" -eq 1 ]; then
		write_deadzone "$dev" left "${2:-0}" || fail=1
	fi
	if [ "${3:-0}" -eq 1 ]; then
		write_deadzone "$dev" right "${4:-0}" || fail=1
	fi
	return "$fail"
}

restore() {
	if [ ! -f "$LEFT_FILE" ] && [ ! -f "$RIGHT_FILE" ] && [ ! -f "$DZ_FILE" ]; then
		return 0
	fi
	dev=$(find_dev) || return 1
	fail=0
	restore_side "$dev" "$LEFT_FILE" calibration_left left || fail=1
	restore_side "$dev" "$RIGHT_FILE" calibration_right right || fail=1
	restore_deadzone "$dev" || fail=1
	return "$fail"
}

show_file() {
	label=$1
	file=$2
	echo "$label $file"
	if [ -f "$file" ]; then
		cat "$file"
	else
		echo "(none)"
	fi
}

show() {
	dev=$(find_dev) || return 1
	echo "driver $dev"
	show_file persistent-left "$LEFT_FILE"
	echo "active-left"
	cat "$dev/calibration_left"
	show_file persistent-right "$RIGHT_FILE"
	echo "active-right"
	cat "$dev/calibration_right"
	show_file persistent-deadzone "$DZ_FILE"
	echo "active-deadzone-left"
	cat "$dev/deadzone_left"
	echo "active-deadzone-right"
	cat "$dev/deadzone_right"
}

case "${1:-}" in
restore) restore ;;
show) show ;;
*)
	echo "usage: $0 {restore|show}" >&2
	exit 1
	;;
esac
