#!/bin/sh
# Where new PortMaster content is installed.
# An empty choice is the main card. An explicit non-primary choice is
# mounted only when that path is a line in /run/zlyme/libraries and the
# same path is a current mount. A leftover mountpoint directory is not
# enough, a stale registry line is not enough, and a missing disk does
# not fall back to /storage. Nothing is moved when the choice changes.
#
# ZLYME_PM_FLAG, ZLYME_LIBRARIES_FILE, ZLYME_PM_STORAGE, ZLYME_PM_MOUNTS,
# and ZLYME_MOUNTS_LIB are test seams. ZLYME_PM_STORAGE defaults to
# /storage. It does not select a second library.

FLAG=${ZLYME_PM_FLAG:-${ZLYME_CFG:-/storage/.config}/zlyme/portmaster-root}
LIBS=${ZLYME_LIBRARIES_FILE:-/run/zlyme/libraries}
STORAGE=${ZLYME_PM_STORAGE:-/storage}

# One absolute path. Embedded spaces stay. A second line, tab, or CR is
# rejected so the file cannot be concatenated into a different path.
selected() {
	[ -s "$FLAG" ] || return 0
	# A newline inside the case pattern would match every path, so the
	# line count is checked on the file itself.
	if grep -q "$(printf '\r')" "$FLAG" || grep -q "$(printf '\t')" "$FLAG"; then
		echo "zlyme-portmaster-root: malformed selection" >&2
		return 1
	fi
	n=$(grep -c '' "$FLAG" || true)
	if [ "$n" -ne 1 ]; then
		echo "zlyme-portmaster-root: malformed selection" >&2
		return 1
	fi
	IFS= read -r data < "$FLAG" || return 1
	case "$data" in
		" "*) ;;
		*" ") ;;
		/*)
			printf '%s\n' "$data"
			return 0
			;;
	esac
	echo "zlyme-portmaster-root: malformed selection" >&2
	return 1
}

mounts_file() {
	printf '%s\n' "${ZLYME_PM_MOUNTS:-/proc/mounts}"
}

load_mounts() {
	if command -v mounts_has >/dev/null 2>&1; then
		return 0
	fi
	lib=${ZLYME_MOUNTS_LIB:-/usr/share/zlyme/mounts.sh}
	if [ ! -r "$lib" ]; then
		echo "zlyme-portmaster-root: mount table helper is missing" >&2
		return 1
	fi
	# shellcheck disable=SC1090
	. "$lib"
}

# /storage is the built-in primary. Every other library must be listed
# and present as that exact path in the mount table.
is_known() {
	root=$1
	[ "$root" = "$STORAGE" ] && return 0
	[ -n "$root" ] || return 1
	[ -f "$LIBS" ] || return 1
	grep -Fxq -- "$root" "$LIBS" || return 1
	load_mounts || return 1
	mounts_has "$(mounts_file)" "$root"
}

q() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

export_hm() {
	sel=$(selected) || return 1
	root=$STORAGE
	if [ -n "$sel" ]; then
		root=$sel
		# Registry membership without a current mount is not a disk.
		if ! is_known "$root"; then
			echo "PortMaster disk is not inserted" >&2
			return 1
		fi
	fi
	ports="$root/Roms/Ports (PORTS)"
	tools="$root/Roms/.portmaster"
	printf 'export HM_TOOLS_DIR=%s\n' "$(q "$tools")"
	printf 'export HM_PORTS_DIR=%s\n' "$(q "$ports")"
	printf 'export HM_SCRIPTS_DIR=%s\n' "$(q "$ports")"
}

case "${1:-}" in
	export) export_hm ;;
	get)
		sel=$(selected) || exit 1
		if [ -n "$sel" ]; then
			if ! is_known "$sel"; then
				echo "PortMaster disk is not inserted" >&2
				exit 1
			fi
			printf '%s\n' "$sel"
		else
			printf '%s\n' "$STORAGE"
		fi
		;;
	list)
		printf '%s\n' "$STORAGE"
		if [ -f "$LIBS" ]; then
			while IFS= read -r root; do
				[ -n "$root" ] || continue
				[ "$root" = "$STORAGE" ] && continue
				printf '%s\n' "$root"
			done < "$LIBS"
		fi
		;;
	set)
		root=${2:-}
		is_known "$root" || {
			echo "zlyme-portmaster-root: unknown library" >&2
			exit 1
		}
		mkdir -p "$(dirname "$FLAG")" || exit 1
		if [ "$root" = "$STORAGE" ]; then
			rm -f "$FLAG"
		else
			printf '%s\n' "$root" > "$FLAG"
		fi
		;;
	*)
		echo "usage: $0 {export|get|list|set ROOT}" >&2
		exit 2
		;;
esac
