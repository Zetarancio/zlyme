#!/bin/sh
#
# RTL8733BU combo: load the power + Wi-Fi drivers and toggle rfkill.
# GPIO stays up while either radio is unblocked.

HOT=/storage/.config/zlyme

load() {
	if ! grep -q '^rtl8733bu_power ' /proc/modules 2>/dev/null; then
		modprobe rtl8733bu_power 2>/dev/null || true
		[ -f "$HOT/rtl8733bu_power.ko" ] && \
			insmod "$HOT/rtl8733bu_power.ko" 2>/dev/null || true
	fi
	if ! grep -q '^8733bu ' /proc/modules 2>/dev/null; then
		modprobe 8733bu 2>/dev/null || true
		[ -f "$HOT/8733bu.ko" ] && insmod "$HOT/8733bu.ko" 2>/dev/null || true
	fi
}

# sysfs: 0 = soft-blocked, 1 = unblocked
rf_set() {
	typ=$1
	op=$2
	if command -v rfkill >/dev/null 2>&1; then
		rfkill "$op" "$typ" >/dev/null 2>&1 && return 0
	fi
	for d in /sys/class/rfkill/rfkill*; do
		[ -f "$d/type" ] || continue
		t=$(tr -d ' \t\r\n' < "$d/type")
		[ "$t" = "$typ" ] || continue
		if [ "$op" = block ]; then
			echo 0 > "$d/state" 2>/dev/null || true
		else
			echo 1 > "$d/state" 2>/dev/null || true
		fi
	done
}

case "${1:-}" in
	load) load ;;
	wlan-on) load; rf_set wlan unblock ;;
	wlan-off) rf_set wlan block ;;
	bt-on) load; rf_set bluetooth unblock ;;
	bt-off) rf_set bluetooth block ;;
	*)
		echo "usage: $0 {load|wlan-on|wlan-off|bt-on|bt-off}" >&2
		exit 1
		;;
esac
