#!/bin/sh
#
# Live sink choice. A2DP headset wins; else HDMI if the sink has
# audio (ELD SAD); else codec + jack mux. HID pads never change this.
# A failed apply is not remembered, so a server that was down is tried
# again. A module id from an older server is not treated as the
# current headset.

# A missing file must not abort the shell. `.` is a special builtin.
if [ -r /etc/zlyme.conf ]; then
	. /etc/zlyme.conf
fi

want_bt() {
	bluealsa-cli list-pcms 2>/dev/null | grep -q a2dpsrc
}

hdmi_connected() {
	for s in /sys/class/drm/card*-HDMI-A-1/status; do
		[ -r "$s" ] || continue
		st=$(tr -d ' \t\r\n' < "$s")
		[ "$st" = connected ] && return 0
	done
	return 1
}

hdmi_has_audio() {
	hdmi_connected || return 1
	for f in /proc/asound/card*/eld*; do
		[ -r "$f" ] || continue
		# Kernel ELD proc is "sad_count<TAB>N", not sad_count=.
		sc=$(sed -n 's/^sad_count[[:space:]]*//p' "$f" | head -n 1 | tr -d ' \t\r')
		case "$sc" in
			''|0) continue ;;
			*) return 0 ;;
		esac
	done
	return 1
}

pick() {
	if want_bt; then
		echo bt
	elif hdmi_has_audio; then
		echo hdmi
	else
		echo codec
	fi
}

bt_mac() {
	list=${ZLYME_BLUEALSA_LIST:-}
	if [ -n "$list" ]; then
		cat "$list"
	else
		bluealsa-cli list-pcms 2>/dev/null
	fi | sed -n 's/.*dev_\([0-9A-Fa-f][0-9A-Fa-f]_\([0-9A-Fa-f][0-9A-Fa-f]_\)\{4\}[0-9A-Fa-f][0-9A-Fa-f]\).*/\1/p' |
		head -n 1 | tr _ :
}

apply() {
	want=$1
	zlyme-audio pulse-service || return 1
	case "$want" in
		bt)
			mac=$(bt_mac) || mac=
			[ -n "$mac" ] || return 1
			zlyme-audio sink-down hdmi || true
			zlyme-audio sink-up bt "$mac" || return 1
			;;
		hdmi)
			zlyme-audio sink-down bt || true
			zlyme-audio sink-up hdmi || return 1
			;;
		*)
			zlyme-audio sink-down bt || true
			zlyme-audio sink-down hdmi || true
			;;
	esac
	zlyme-audio focus "$want" || return 1
	zlyme-audio remember "$want" || return 1
}

need() {
	case "$1" in
		bt) echo 2 ;;
		hdmi) echo 2 ;;
		*) echo 5 ;;
	esac
}

sink_ready() {
	cur=$1
	if [ "$cur" = bt ]; then
		mac=$(bt_mac) || mac=
		zlyme-audio sink-ok bt "$mac"
	else
		zlyme-audio sink-ok "$cur"
	fi
}

prev=""
pending=""
npending=0
loops=0
limit=${ZLYME_BTSINK_LIMIT:-0}
pause=${ZLYME_BTSINK_SLEEP:-1}
while :; do
	cur=$(pick)
	try=0
	if [ -z "$prev" ]; then
		try=1
	elif [ "$cur" != "$prev" ]; then
		if [ "$pending" = "$cur" ]; then
			npending=$((npending + 1))
		else
			pending=$cur
			npending=1
		fi
		if [ "$npending" -ge "$(need "$cur")" ]; then
			try=1
		fi
	else
		pending=""
		npending=0
		sink_ready "$cur" || try=1
	fi
	if [ "$try" = 1 ]; then
		if apply "$cur"; then
			prev=$cur
			pending=""
			npending=0
		else
			# Do not record prev. The next pass tries again.
			pending=""
			npending=0
		fi
	fi
	loops=$((loops + 1))
	if [ "$limit" -gt 0 ] && [ "$loops" -ge "$limit" ]; then
		printf 'prev=%s\n' "$prev"
		exit 0
	fi
	sleep "$pause"
done
