#!/bin/sh
#
# Live ALSA sink matrix. A2DP headset wins; else HDMI if the sink has
# audio (ELD SAD); else codec + jack mux. HID pads never change this.
# Poll so a cable or buds switch without reboot.

. /etc/zlyme.conf 2>/dev/null || true

want_bt() {
	bluealsa-cli list-pcms 2>/dev/null | grep -q a2dpsrc
}

hdmi_connected() {
	for s in /sys/class/drm/card*-HDMI-A-1/status; do
		[ -r "$s" ] || continue
		st=$(tr -d ' \t\r\n' < "$s")
		[ "$st" = connected ] && return 0
	done
	return 1
}

hdmi_has_audio() {
	hdmi_connected || return 1
	for f in /proc/asound/card*/eld*; do
		[ -r "$f" ] || continue
		# Kernel ELD proc is "sad_count<TAB>N", not sad_count=.
		sc=$(sed -n 's/^sad_count[[:space:]]*//p' "$f" | head -n 1 | tr -d ' \t\r')
		case "$sc" in
			''|0) continue ;;
			*) return 0 ;;
		esac
	done
	return 1
}

pick() {
	if want_bt; then
		echo bt
	elif hdmi_has_audio; then
		echo hdmi
	else
		echo codec
	fi
}

bt_mac() {
	list=${ZLYME_BLUEALSA_LIST:-}
	if [ -n "$list" ]; then
		cat "$list"
	else
		bluealsa-cli list-pcms 2>/dev/null
	fi | sed -n 's/.*dev_\([0-9A-Fa-f][0-9A-Fa-f]_\([0-9A-Fa-f][0-9A-Fa-f]_\)\{4\}[0-9A-Fa-f][0-9A-Fa-f]\).*/\1/p' |
		head -n 1 | tr _ :
}

apply() {
	want=$1
	case "$want" in
		bt)
			mac=$(bt_mac) || mac=
			[ -n "$mac" ] || return 0
			zlyme-audio sink-down hdmi || true
			zlyme-audio sink-up bt "$mac" || return 0
			;;
		hdmi)
			zlyme-audio sink-down bt || true
			zlyme-audio sink-up hdmi || return 0
			;;
		*)
			zlyme-audio sink-down bt || true
			zlyme-audio sink-down hdmi || true
			;;
	esac
	zlyme-audio set "$want" >/dev/null 2>&1 || return 0
	zlyme-audio focus "$want" || true
}

need() {
	case "$1" in
		bt) echo 2 ;;
		hdmi) echo 2 ;;
		*) echo 5 ;;
	esac
}

prev=""
pending=""
npending=0
while :; do
	cur=$(pick)
	if [ -z "$prev" ]; then
		apply "$cur"
		prev=$cur
		pending=""
		npending=0
	elif [ "$cur" = "$prev" ]; then
		pending=""
		npending=0
	else
		if [ "$pending" = "$cur" ]; then
			npending=$((npending + 1))
		else
			pending=$cur
			npending=1
		fi
		if [ "$npending" -ge "$(need "$cur")" ]; then
			apply "$cur"
			prev=$cur
			pending=""
			npending=0
		fi
	fi
	sleep 1
done
