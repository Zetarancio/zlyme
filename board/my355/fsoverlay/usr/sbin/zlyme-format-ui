#!/bin/sh
# Settings launches this. The backend rechecks the device before mkfs.
# Status is one tmpfs file, replaced on each attempt. It is not a log history.

set -u
FMT=${ZLYME_FMT_BIN:-/usr/sbin/zlyme-storage-format}
status=${ZLYME_FORMAT_STATUS:-/tmp/zlyme-format.status}
[ -x "$FMT" ] || exit 1

note() {
	printf '%s\n' "$1" > "$status"
}

work=$(mktemp -d) || exit 1
trap 'rm -rf "$work"' EXIT
note "start"

list=$work/list
if ! "$FMT" list > "$list"; then
	note "list failed"
	exit 1
fi
if [ ! -s "$list" ]; then
	note "no removable storage"
	if command -v show.elf >/dev/null 2>&1; then
		show.elf "No removable storage" 2
	else
		echo "No removable storage" >&2
	fi
	exit 0
fi

pick=$work/pick
if ! command -v minui-list >/dev/null 2>&1; then
	note "minui-list missing"
	exit 1
fi
if ! minui-list --format text --file "$list" --title "Format storage" \
	--confirm-text "SELECT" --cancel-text "BACK" \
	--write-location "$pick" --write-value selected; then
	note "cancelled at device"
	exit 0
fi
chosen=$(cat "$pick" 2>/dev/null || true)
dev=${chosen%%	*}
label=${chosen#*	}
if [ -z "$dev" ] || [ "$dev" = "$chosen" ]; then
	note "cancelled at device"
	exit 0
fi
note "device $dev"

fsfile=$work/fs
printf '%s\n' exFAT ext4 > "$fsfile"
fspick=$work/fspick
if ! minui-list --format text --file "$fsfile" --title "Filesystem" \
	--confirm-text "SELECT" --cancel-text "BACK" \
	--write-location "$fspick" --write-value selected; then
	note "cancelled at filesystem"
	exit 0
fi
fsname=$(cat "$fspick" 2>/dev/null || true)
case "$fsname" in
	exFAT) fs=exfat ;;
	ext4) fs=ext4 ;;
	*)
		note "cancelled at filesystem"
		exit 0
		;;
esac
note "filesystem $fsname"

if ! command -v minui-presenter >/dev/null 2>&1; then
	note "minui-presenter missing"
	exit 1
fi
msg="$label
Erase as $fsname?
ALL DATA WILL BE LOST"
printf '%s\n' "$msg" > "$work/msg"
# confirm-show is required. Without it A does nothing and only BACK is drawn.
if ! minui-presenter --file "$work/msg" --confirm-text "ERASE" \
	--cancel-text "BACK" --confirm-show; then
	note "cancelled at confirm"
	exit 0
fi
note "confirmed $dev $fsname"

if "$FMT" format "$dev" "$fs" ZLYME-LIB; then
	note "format succeeded $dev $fsname"
	command -v show.elf >/dev/null 2>&1 && show.elf "Format finished" 2
else
	note "format failed $dev $fsname"
	command -v show.elf >/dev/null 2>&1 && show.elf "Format failed" 3
	exit 1
fi
