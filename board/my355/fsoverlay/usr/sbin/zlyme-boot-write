#!/bin/sh
# One write transaction against the boot vfat, then put it back read-only.
# Ownership is an exclusive flock on an empty file under /run. The kernel
# drops that lock when this process exits. The file is not a PID record.
# Do not call this helper from inside another zlyme-boot-write: the inner
# call waits for a lock the outer call holds until the inner returns.
#
# INT, TERM, and HUP are ignored once the volume is writable. BusyBox ash
# keeps an empty trap (SIG_IGN) across the fork that runs the command, so
# the write is not killed in the middle of the FAT update. SIGKILL cannot
# be caught. If read-only cannot be restored, a separate /run marker
# refuses later transactions until reboot.

BOOT=${ZLYME_BOOT:-/boot}
MOUNTS=${ZLYME_PROC_MOUNTS:-/proc/mounts}
LOCK=${ZLYME_BOOT_WRITE_LOCK:-/run/zlyme-boot-write.lock}
POISON=${ZLYME_BOOT_WRITE_POISON:-/run/zlyme-boot-write.poison}
WAIT=${ZLYME_BOOT_WRITE_TIMEOUT:-15}
IDENT=${ZLYME_DEVICE_CONF:-/usr/share/zlyme/device.conf}

if [ -r "$IDENT" ]; then
	# shellcheck disable=SC1090
	. "$IDENT"
fi

mounted() {
	grep -q " ${BOOT} " "$MOUNTS"
}

mount_dev() {
	found=""
	while read -r dev point _rest; do
		[ "$point" = "$BOOT" ] || continue
		found=$dev
		break
	done < "$MOUNTS"
	[ -n "$found" ] || return 1
	printf '%s\n' "$found"
}

same_dev() {
	a=$1
	b=$2
	[ -n "$a" ] && [ -n "$b" ] || return 1
	[ "$a" = "$b" ] && return 0
	ca=$a
	cb=$b
	if [ -e "$a" ]; then
		ca=$(readlink -f "$a" 2>/dev/null || printf '%s' "$a")
	fi
	if [ -e "$b" ]; then
		cb=$(readlink -f "$b" 2>/dev/null || printf '%s' "$b")
	fi
	[ "$ca" = "$cb" ]
}

is_ro() {
	while read -r _dev point _fstype opts _rest; do
		if [ "$point" = "$BOOT" ]; then
			case "$opts" in
				ro|ro,*) return 0 ;;
			esac
			return 1
		fi
	done < "$MOUNTS"
	return 1
}

fail_closed() {
	echo "zlyme-boot-write: $*" >&2
	exit 1
}

mark_poison() {
	printf '%s\n' 'boot fat stayed writable' > "$POISON" 2>/dev/null || true
}

restore_ro() {
	mount -o remount,ro "$BOOT" 2>/dev/null || true
	is_ro
}

acquire_lock() {
	mkdir -p "$(dirname "$LOCK")" 2>/dev/null || fail_closed "could not create the lock directory"
	# A failed exec redirection exits this shell before the if can run.
	if [ -d "$LOCK" ]; then
		fail_closed "could not open the boot lock"
	fi
	exec 9>>"$LOCK" || fail_closed "could not open the boot lock"
	if flock -n 9; then
		return 0
	fi
	if [ "$WAIT" -eq 0 ]; then
		echo "zlyme-boot-write: $BOOT is busy" >&2
		exit 1
	fi
	end=$(( $(date +%s) + WAIT ))
	while true; do
		sleep 0.2
		if flock -n 9; then
			return 0
		fi
		if [ "$(date +%s)" -ge "$end" ]; then
			echo "zlyme-boot-write: $BOOT is busy" >&2
			exit 1
		fi
	done
}

if [ "$#" -eq 0 ]; then
	echo "usage: zlyme-boot-write command [args...]" >&2
	exit 2
fi

if ! mounted; then
	echo "zlyme-boot-write: $BOOT is not mounted" >&2
	exit 1
fi

acquire_lock

if [ -e "$POISON" ]; then
	fail_closed "$BOOT was left writable; reboot before another write"
fi

if [ -z "${ZLYME_BOOT_DEVICE:-}" ]; then
	fail_closed "ZLYME_BOOT_DEVICE is unset"
fi
src=$(mount_dev) || fail_closed "$BOOT is not mounted"
if ! same_dev "$src" "$ZLYME_BOOT_DEVICE"; then
	fail_closed "$BOOT is $src, expected $ZLYME_BOOT_DEVICE"
fi

if ! is_ro; then
	if ! restore_ro; then
		mark_poison
		fail_closed "$BOOT was already writable and could not be restored"
	fi
fi

# Ignored here, and inherited by the command. Do not install a handler
# that kills the write so this script can exit sooner.
trap '' INT TERM HUP

if ! mount -o remount,rw "$BOOT"; then
	if ! is_ro; then
		mark_poison
	fi
	fail_closed "remount read-write failed"
fi

"$@"
status=$?

sync
if ! restore_ro; then
	mark_poison
	echo "zlyme-boot-write: $BOOT stayed writable" >&2
	exit 1
fi
exit "$status"
