#!/bin/sh
# One synthetic Splore launcher, and only while a native runtime pair
# exists on an active library. The packaged Splore.p8.png is the
# ownership proof: a different file with "splore" in the name is left
# alone. cdata, bbs, and downloaded carts are never touched.
#
# ZLYME_PICO_ROMDIR, ZLYME_PICO_SHARED, ZLYME_PICO_ART, and
# ZLYME_PICO_LIBRARIES are test seams.

SDCARD=${SDCARD_PATH:-/storage}
ROMDIR=${ZLYME_PICO_ROMDIR:-$SDCARD/Roms/Pico-8 (PICO)}
SHARED=${ZLYME_PICO_SHARED:-${SHARED_USERDATA_PATH:-$SDCARD/.config/nextui/shared}/Pico-8-native}
ART=${ZLYME_PICO_ART:-/usr/share/nextui/paks/Emus/PICO.pak/splore/Splore.p8.png}
marker=$SHARED/splore-installed
rt=${ZLYME_PICO_RUNTIME:-/usr/share/zlyme/pico-runtime.sh}

[ -f "$ART" ] || exit 0
# shellcheck disable=SC1091
. "$rt"

owned() {
	[ -f "$1" ] && cmp -s "$1" "$ART"
}

remove_owned() {
	f=$1
	owned "$f" || return 0
	rm -f "$f"
	dir=$(dirname "$f")
	if owned "$dir/.media/Splore.png"; then
		rm -f "$dir/.media/Splore.png"
	fi
}

drop_other_owned() {
	libs=${ZLYME_PICO_LIBRARIES:-/run/zlyme/libraries}
	[ -r "$libs" ] || return 0
	while IFS= read -r lib || [ -n "$lib" ]; do
		[ -n "$lib" ] || continue
		for folder in \
			"$lib/Roms/Pico-8 (PICO)/Splore.p8" \
			"$lib/roms/Pico-8 (PICO)/Splore.p8"
		do
			[ "$folder" = "$ROMDIR/Splore.p8" ] && continue
			remove_owned "$folder"
		done
	done < "$libs"
}

if zlyme_pico_any; then
	mkdir -p "$ROMDIR" "$SHARED"
	if [ ! -e "$ROMDIR/Splore.p8" ]; then
		other=
		for e in "$ROMDIR"/*; do
			[ -f "$e" ] || continue
			case "$(basename "$e")" in
				*[Ss]plore*) other=1 ;;
			esac
		done
		if [ -z "$other" ]; then
			cp -f "$ART" "$ROMDIR/Splore.p8"
			mkdir -p "$ROMDIR/.media"
			if [ ! -e "$ROMDIR/.media/Splore.png" ]; then
				cp -f "$ART" "$ROMDIR/.media/Splore.png"
			fi
		fi
	fi
	if owned "$ROMDIR/Splore.p8"; then
		: > "$marker"
	fi
	drop_other_owned
	exit 0
fi

remove_owned "$ROMDIR/Splore.p8"
drop_other_owned
if [ ! -e "$ROMDIR/Splore.p8" ]; then
	rm -f "$marker"
fi
exit 0
