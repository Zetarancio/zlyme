#!/bin/sh
# One synthetic Splore launcher, and only while a native runtime pair
# exists on an active library. The file lives in that library's Pico-8
# folder. NextUI lists the folder it is actually browsing; a dummy on
# a different card is not the catalog the runtime belongs to.
# The packaged Splore.p8.png is the ownership proof. A different file
# with "splore" in the name is left alone. cdata, bbs, and downloaded
# carts are never touched.
#
# ZLYME_PICO_ROMDIR, when set, forces the destination (tests).
# ZLYME_PICO_SHARED, ZLYME_PICO_ART, and ZLYME_PICO_LIBRARIES are seams.

SDCARD=${SDCARD_PATH:-/storage}
SHARED=${ZLYME_PICO_SHARED:-${SHARED_USERDATA_PATH:-$SDCARD/.config/nextui/shared}/Pico-8-native}
ART=${ZLYME_PICO_ART:-/usr/share/nextui/paks/Emus/PICO.pak/splore/Splore.p8.png}
marker=$SHARED/splore-installed
rt=${ZLYME_PICO_RUNTIME:-/usr/share/zlyme/pico-runtime.sh}
ROMDIR=

[ -f "$ART" ] || exit 0
# shellcheck disable=SC1091
. "$rt"

owned() {
	[ -f "$1" ] && cmp -s "$1" "$ART"
}

# NextUI sorts "000) Name" before other rows and hides the prefix.
NAME='000) Splore.p8'
ART_NAME='000) Splore.png'
OLD_NAME='Splore.p8'

remove_owned() {
	f=$1
	owned "$f" || return 0
	rm -f "$f"
}

clean_dir() {
	dir=$1
	[ -n "$dir" ] || return 0
	remove_owned "$dir/$OLD_NAME"
	remove_owned "$dir/$NAME"
	remove_owned "$dir/.media/Splore.png"
	remove_owned "$dir/.media/$ART_NAME"
}

each_library_dir() {
	libs=${ZLYME_PICO_LIBRARIES:-/run/zlyme/libraries}
	[ -r "$libs" ] || return 0
	while IFS= read -r lib || [ -n "$lib" ]; do
		[ -n "$lib" ] || continue
		for base in "$lib/Roms" "$lib/roms" "$lib/ROMS"; do
			[ -d "$base/Pico-8 (PICO)" ] || continue
			printf '%s\n' "$base/Pico-8 (PICO)"
		done
	done < "$libs"
}

drop_other_owned() {
	each_library_dir | while IFS= read -r dir; do
		[ -n "$dir" ] || continue
		[ "$dir" = "$ROMDIR" ] && continue
		clean_dir "$dir"
	done
}

drop_all_owned() {
	each_library_dir | while IFS= read -r dir; do
		[ -n "$dir" ] || continue
		clean_dir "$dir"
	done
	rm -f "$marker"
}

pick_romdir() {
	if [ -n "${ZLYME_PICO_ROMDIR:-}" ]; then
		ROMDIR=$ZLYME_PICO_ROMDIR
		return 0
	fi
	root=$ZLYME_PICO_LAUNCH
	case "$root" in
		*/Bios|*/Bios/*) root=${root%%/Bios*} ;;
	esac
	base=
	for d in "$root/Roms" "$root/roms" "$root/ROMS"; do
		if [ -d "$d" ]; then
			base=$d
			break
		fi
	done
	[ -n "$base" ] || base=$root/Roms
	ROMDIR="$base/Pico-8 (PICO)"
}

if ! zlyme_pico_any; then
	drop_all_owned
	exit 0
fi
pick_romdir

mkdir -p "$ROMDIR" "$SHARED"
# Old owned names are ours. A different file that merely contains
# "splore" is the user's and blocks a second row.
remove_owned "$ROMDIR/$OLD_NAME"
remove_owned "$ROMDIR/.media/Splore.png"
if [ ! -e "$ROMDIR/$NAME" ]; then
	other=
	for e in "$ROMDIR"/*; do
		[ -f "$e" ] || continue
		owned "$e" && continue
		case "$(basename "$e")" in
			*[Ss]plore*) other=1 ;;
		esac
	done
	if [ -z "$other" ]; then
		cp -f "$ART" "$ROMDIR/$NAME"
		mkdir -p "$ROMDIR/.media"
		if [ ! -e "$ROMDIR/.media/$ART_NAME" ]; then
			cp -f "$ART" "$ROMDIR/.media/$ART_NAME"
		fi
	fi
fi
if owned "$ROMDIR/$NAME"; then
	: > "$marker"
fi
drop_other_owned
if [ -x /usr/sbin/zlyme-pico-bbs ]; then
	/usr/sbin/zlyme-pico-bbs || true
fi
exit 0
