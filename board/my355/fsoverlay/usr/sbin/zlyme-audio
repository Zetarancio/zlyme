#!/bin/sh
#
# Sink preference and the 0-100 volume. PipeWire is the mixer on both
# images. audio.conf is data. It is never sourced.

# shellcheck disable=SC1090
. "${ZLYME_CONF:-/etc/zlyme.conf}"

STATE="${ZLYME_CFG}/audio.conf"
CARD=rk817ext
VOLCTL=FlipVolume
RT="${ZLYME_PW_RUNTIME:-/run/zlyme/pipewire}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$RT}"
export PIPEWIRE_RUNTIME_DIR="${PIPEWIRE_RUNTIME_DIR:-$RT}"

do_usage() {
	cat <<EOF
usage: $(basename "$0") <command>

  list
  get
  set {auto|codec|hdmi|bt}
  status
  getSystemVolume
  setSystemVolume {mute|unmute|mute-toggle|[+-]<0-100>}
  test
  export
  route
  hdmi-event
  policy
  migrate-volume
  hold {0-100}
EOF
}

saved() {
	[ -r "$STATE" ] || return 1
	sed -n "s/^$1=//p" "$STATE" | tail -n 1
}

save() {
	key=$1
	val=$2
	dir=$(dirname "$STATE")
	if [ ! -d "$dir" ]; then
		echo "$(basename "$0"): ${dir} is not there -- is the card mounted?" >&2
		return 1
	fi
	lock="$dir/audio.conf.lock"
	n=0
	while ! mkdir "$lock" 2>/dev/null; do
		n=$((n + 1))
		[ "$n" -gt 50 ] && return 1
		sleep 0.02
	done
	tmp=$(mktemp "$dir/audio.conf.XXXXXX") || {
		rmdir "$lock" 2>/dev/null || true
		return 1
	}
	if [ -r "$STATE" ]; then
		grep -v "^${key}=" "$STATE" > "$tmp" 2>/dev/null || : > "$tmp"
	else
		: > "$tmp"
	fi
	printf '%s=%s\n' "$key" "$val" >> "$tmp" || {
		rm -f "$tmp"
		rmdir "$lock" 2>/dev/null || true
		return 1
	}
	mv -f "$tmp" "$STATE"
	rmdir "$lock" 2>/dev/null || true
}

drop_key() {
	key=$1
	[ -r "$STATE" ] || return 0
	grep -q "^${key}=" "$STATE" || return 0
	dir=$(dirname "$STATE")
	lock="$dir/audio.conf.lock"
	n=0
	while ! mkdir "$lock" 2>/dev/null; do
		n=$((n + 1))
		[ "$n" -gt 50 ] && return 1
		sleep 0.02
	done
	tmp=$(mktemp "$dir/audio.conf.XXXXXX") || {
		rmdir "$lock" 2>/dev/null || true
		return 1
	}
	grep -v "^${key}=" "$STATE" > "$tmp" 2>/dev/null || : > "$tmp"
	mv -f "$tmp" "$STATE"
	rmdir "$lock" 2>/dev/null || true
}

clamp_volume() {
	v=$1
	echo "$v" | grep -Eq '^[0-9]+$' || return 1
	[ "$v" -gt 100 ] && v=100
	printf '%s\n' "$v"
}

pref() {
	p=$(saved ZLYME_SINK_PREF || true)
	case "$p" in
		auto|codec|hdmi|bt) printf '%s\n' "$p"; return ;;
	esac
	s=$(saved ZLYME_SINK || true)
	case "$s" in
		codec|hdmi|bt) printf '%s\n' "$s"; return ;;
	esac
	printf '%s\n' auto
}

# Historical ZLYME_SINK. The route that is playing is active_role.
current() {
	s=$(saved ZLYME_SINK || true)
	case "$s" in
		codec|hdmi|bt) printf '%s\n' "$s"; return ;;
	esac
	printf '%s\n' codec
}

describe() {
	case "$1" in
		codec) echo "Speaker or headphones" ;;
		hdmi) echo "HDMI" ;;
		bt) echo "Bluetooth" ;;
		*) echo "$1" ;;
	esac
}

pipewire_up() {
	if { [ -n "${ZLYME_PW_NODES:-}" ] || [ -n "${ZLYME_PW_DUMP:-}" ]; } && { [ -n "${ZLYME_WPCTL:-}" ] || [ -x /usr/bin/wpctl ]; }; then
		return 0
	fi
	[ -S "$RT/pipewire-0" ] || return 1
	[ -n "${ZLYME_WPCTL:-}" ] || [ -x /usr/bin/wpctl ]
}

# role<TAB>id
nodes() {
	if [ -n "${ZLYME_PW_NODES:-}" ] && [ -r "$ZLYME_PW_NODES" ]; then
		cat "$ZLYME_PW_NODES"
		return 0
	fi
	# The dump seam is for the host fixture. A running image uses wpctl,
	# so the minimal image does not need Python.
	if [ -n "${ZLYME_PW_DUMP:-}" ]; then
		command -v python3 >/dev/null 2>&1 || return 1
		_nodes_from_dump "$ZLYME_PW_DUMP"
		return $?
	fi
	_nodes_from_wpctl
}

_nodes_from_dump() {
	python3 - "$1" << 'PY'
import json, sys
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
for obj in data:
    if obj.get("type") != "PipeWire:Interface:Node":
        continue
    props = (obj.get("info") or {}).get("props") or {}
    if props.get("media.class") != "Audio/Sink":
        continue
    name = props.get("node.name") or ""
    if "null" in name or "dummy" in name:
        continue
    # Live playback nodes publish alsa.id. They do not publish
    # api.alsa.card.id. The descriptive name is rk817_ext.
    card = props.get("alsa.id") or ""
    role = ""
    if name.startswith("bluez_output."):
        role = "bt"
    elif card == "rk817ext":
        role = "codec"
    elif card == "HDMI":
        role = "hdmi"
    if role and obj.get("id") is not None:
        print("%s\t%s" % (role, obj.get("id")))
PY
}

_nodes_from_wpctl() {
	command -v "${ZLYME_WPCTL:-wpctl}" >/dev/null 2>&1 || return 1
	# wpctl 0.5.14 prints " │  *   56. name" under Audio → Sinks.
	# The first number-dot on that line is the node id. The volume
	# "0.09" is later on the same line. Video has its own Sinks heading.
	ids=$("${ZLYME_WPCTL:-wpctl}" status 2>/dev/null | awk '
		/^Audio$/ { audio = 1; next }
		/^Video$/ { audio = 0; on = 0; next }
		audio && /Sinks:/ { on = 1; next }
		audio && /Sources:/ { on = 0; next }
		on && match($0, /[0-9]+\./) {
			print substr($0, RSTART, RLENGTH - 1)
		}
	') || return 1
	[ -n "$ids" ] || return 1
	for id in $ids; do
		props=$("${ZLYME_WPCTL:-wpctl}" inspect "$id" 2>/dev/null) || continue
		class=$(printf '%s\n' "$props" | sed -n 's/.*media.class = "\([^"]*\)".*/\1/p' | head -n 1)
		[ "$class" = "Audio/Sink" ] || continue
		name=$(printf '%s\n' "$props" | sed -n 's/.*node.name = "\([^"]*\)".*/\1/p' | head -n 1)
		case "$name" in
			*null*|*dummy*) continue ;;
		esac
		card=$(printf '%s\n' "$props" | sed -n 's/.*alsa.id = "\([^"]*\)".*/\1/p' | head -n 1)
		role=
		case "$name" in
			bluez_output.*) role=bt ;;
		esac
		if [ -z "$role" ]; then
			case "$card" in
				rk817ext) role=codec ;;
				HDMI) role=hdmi ;;
			esac
		fi
		[ -n "$role" ] || continue
		printf '%s\t%s\n' "$role" "$id"
	done
}

node_id() {
	role=$1
	nodes | awk -F '\t' -v r="$role" '$1 == r { print $2; exit }'
}

# yes: ELD advertises a format. no: a parsed ELD has no audio.
# pending: the connector is mid-modeset and the ELD is still version 0
# or empty. That is not a reason to leave HDMI or to enter it.
hdmi_audio_state() {
	eld=${ZLYME_HDMI_ELD:-}
	[ "${ZLYME_HDMI_AUDIO:-}" = 1 ] && { printf '%s\n' yes; return; }
	[ "${ZLYME_HDMI_AUDIO:-}" = 0 ] && { printf '%s\n' no; return; }
	if [ -z "$eld" ]; then
		eld=$(ls /proc/asound/HDMI/eld#* 2>/dev/null | head -n 1)
	fi
	[ -n "$eld" ] || { printf '%s\n' pending; return; }
	# The kernel separates the field with tabs, not spaces.
	if grep -q 'sad_count[[:space:]]*[1-9]' "$eld"; then
		printf '%s\n' yes
		return
	fi
	if grep -q 'sad_count[[:space:]]*0' "$eld"; then
		printf '%s\n' no
		return
	fi
	printf '%s\n' pending
}

hdmi_has_audio() {
	[ "$(hdmi_audio_state)" = yes ]
}

# Displayed percent stays the stored integer. PipeWire's wpctl float is
# linear gain. The old Pulse percent was cubic, so 40 there is gain
# (0.40)^3. Apply that curve so the first PipeWire boot is not louder.
linear_gain() {
	awk -v p="$1" 'BEGIN {
		if (p+0 <= 0) { print "0"; exit }
		if (p+0 >= 100) { print "1"; exit }
		printf "%.6f", (p/100) * (p/100) * (p/100)
	}'
}

wp() {
	# The worker's life lock is fd 8. A child must not inherit it, or
	# killing the worker leaves the lock held by wpctl.
	if [ -n "${ZLYME_VOLUME_WORKER:-}" ]; then
		"${ZLYME_WPCTL:-wpctl}" "$@" 8>&-
	else
		"${ZLYME_WPCTL:-wpctl}" "$@"
	fi
}

# 0 applied to every listed sink, 2 no sinks, 1 a command failed.
apply_gain() {
	v=$1
	g=$(linear_gain "$v")
	tab=$(printf '\t')
	list=$(nodes 2>/dev/null) || return 1
	[ -n "$list" ] || return 2
	mark=$(mktemp) || return 1
	listfile=$(mktemp) || { rm -f "$mark"; return 1; }
	printf '%s\n' "$list" > "$listfile"
	while IFS="$tab" read -r role nid; do
		[ -n "$nid" ] || continue
		wp set-volume "$nid" "$g" >/dev/null 2>&1 || echo fail >> "$mark"
	done < "$listfile"
	rm -f "$listfile"
	if [ -s "$mark" ]; then
		rm -f "$mark"
		return 1
	fi
	rm -f "$mark"
	return 0
}

# Opt-in. Touch the flag before one HDMI launch. Each DRM event appends
# one line, at most twelve, then removes the flag. The line is the ELD
# and the policy decision. It does not set a sink.
hdmi_trace() {
	flag=${ZLYME_HDMI_TRACE:-/storage/.config/zlyme/hdmi-audio-trace}
	[ -f "$flag" ] || return 0
	[ -L "$flag" ] && return 0
	log=${ZLYME_HDMI_TRACE_LOG:-/storage/.logs/hdmi-audio-trace.log}
	mkdir -p "$(dirname "$log")" 2>/dev/null || return 0
	state=$1
	up=$(awk '{print $1; exit}' /proc/uptime 2>/dev/null || printf '%s\n' 0)
	sad=
	eld=${ZLYME_HDMI_ELD:-}
	if [ -z "$eld" ]; then
		eld=$(ls /proc/asound/HDMI/eld#* 2>/dev/null | head -n 1)
	fi
	if [ -n "$eld" ] && [ -r "$eld" ]; then
		sad=$(grep 'sad_count' "$eld" 2>/dev/null | head -n 1 | tr -s '[:space:]' ' ')
	fi
	active=$(cat "$RT/active" 2>/dev/null || true)
	choice=$(policy_role 2>/dev/null || true)
	def=
	if pipewire_up; then
		def=$(default_sink_id || true)
	fi
	conn=${ZLYME_HDMI_CONNECTOR:-}
	printf '%s eld=%s connector=%s pref=%s choice=%s default=%s active=%s %s\n' \
		"$up" "$state" "$conn" "$(pref)" "$choice" "$def" "$active" "$sad" >> "$log" 2>/dev/null || return 0
	n=$(wc -l < "$log" 2>/dev/null || printf '%s\n' 0)
	if [ "$n" -ge 12 ]; then
		rm -f "$flag"
	fi
}

# The same decision as zlyme-policy.lua. The active file is what the
# graph last published. It is not a preference.
policy_role() {
	pol=${ZLYME_POLICY:-/usr/share/wireplumber/scripts/zlyme-policy.lua}
	[ -f "$pol" ] || return 1
	cur=$(cat "$RT/active" 2>/dev/null || true)
	case "$cur" in
		codec|hdmi|bt) ;;
		*) cur=- ;;
	esac
	nodes | lua "$pol" "$(pref)" "$(hdmi_audio_state)" "$cur"
}

# Publish the ELD and wake WirePlumber. A configured default outranks
# node priority for the rest of the session, so this does not set one.
signal_graph() {
	state=$(hdmi_audio_state)
	if mkdir -p "$RT" 2>/dev/null; then
		printf '%s\n' "$state" > "$RT/hdmi-audio" 2>/dev/null || true
	fi
	hdmi_trace "$state"
	if [ -S "$RT/pipewire-0" ] && command -v pw-metadata >/dev/null 2>&1; then
		pw-metadata -n default 0 zlyme.hdmi "$state" >/dev/null 2>&1 || true
	fi
	return 0
}

# wpctl prints "id 64, type PipeWire:Interface:Node". The comma is not
# part of the id. An empty result is not a successful match.
default_sink_id() {
	wp inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null |
		awk '/^id / { gsub(/,/, "", $2); print $2; exit }'
}

route() {
	signal_graph
}

why_unavailable() {
	pipewire_up || { echo "PipeWire is down"; return 1; }
	case "$1" in
		codec)
			[ -n "$(node_id codec || true)" ] || { echo "codec node absent"; return 1; }
			;;
		hdmi)
			[ -n "$(node_id hdmi || true)" ] || { echo "HDMI node absent"; return 1; }
			hdmi_has_audio || { echo "HDMI ELD has no audio"; return 1; }
			;;
		bt)
			[ -n "$(node_id bt || true)" ] || { echo "Bluetooth node absent"; return 1; }
			;;
	esac
	return 0
}

volume() {
	v=$(saved ZLYME_VOLUME || true)
	[ -n "$v" ] || return 1
	printf '%s\n' "$v"
}

# One worker holds the life lock for its whole life, including the
# slow wpctl. The state lock is only the handoff. A caller writes the
# percent first, then takes the state lock and tries the life lock.
# The worker re-reads the percent while it still holds the state lock,
# and drops the life lock before it releases that state lock. A caller
# blocked on the state lock therefore either sees the new percent
# applied by this worker or starts the next one. There is no pid file.
# Closing the life fd, or killing the worker, releases the lock.
spawn_apply() {
	state=$RT/volume.state
	life=$RT/volume.life
	mkdir -p "$RT" 2>/dev/null || return 0
	exec 9>>"$state"
	flock 9 || { exec 9>&-; return 0; }
	exec 8>>"$life"
	if flock -n 8; then
		(
			trap '' HUP INT
			ZLYME_VOLUME_WORKER=1
			export ZLYME_VOLUME_WORKER
			exec 9>&-
			exec "$0" apply-saved
		) >/dev/null 2>&1 &
		exec 8>&-
	else
		exec 8>&-
	fi
	flock -u 9
	exec 9>&-
}

apply_saved() {
	state=$RT/volume.state
	want=
	while :; do
		exec 7>>"$state"
		flock 7 || { exec 7>&-; exec 8>&-; return 0; }
		want=$(saved ZLYME_VOLUME || true)
		flock -u 7
		exec 7>&-
		[ -n "$want" ] || break
		if ! pipewire_up; then
			break
		fi
		apply_gain "$want" || true
		exec 7>>"$state"
		flock 7 || { exec 7>&-; exec 8>&-; return 0; }
		now=$(saved ZLYME_VOLUME || true)
		if [ "$now" = "$want" ]; then
			exec 8>&-
			flock -u 7
			exec 7>&-
			return 0
		fi
		flock -u 7
		exec 7>&-
	done
	exec 8>&-
}

set_volume() {
	v=$(clamp_volume "$1") || return 1
	cur=$(saved ZLYME_VOLUME || true)
	if [ "$cur" != "$v" ]; then
		save ZLYME_VOLUME "$v" || return 1
	fi
	# PipeWire may still be down. The saved percent is the intention.
	# The volume hook applies it when a sink appears.
	spawn_apply
	return 0
}

# Saved percent is the user intention. It is applied on every graph.
# ZLYME_GAIN_STATE from the previous candidate is not that intention.
migrate_volume() {
	src=$(saved ZLYME_VOLUME_SRC || true)
	if [ "$src" != pipewire-cubic ]; then
		now=$(saved ZLYME_VOLUME || true)
		if [ -z "$now" ]; then
			now=$(amixer -c "$CARD" sget "$VOLCTL" 2>/dev/null |
				sed -n 's/.*\[\([0-9]*\)%\].*/\1/p' | head -n 1)
		fi
		if ! now=$(clamp_volume "$now"); then
			now=40
		fi
		save ZLYME_VOLUME "$now" || return 1
		save ZLYME_VOLUME_SRC pipewire-cubic || return 1
	fi
	# Old ZLYME_SINK was the last automatic route, not a manual choice.
	if [ -z "$(saved ZLYME_SINK_PREF || true)" ]; then
		save ZLYME_SINK_PREF auto || return 1
	fi
	drop_key ZLYME_GAIN_STATE || true
	vol=$(saved ZLYME_VOLUME || true)
	[ -n "$vol" ] || return 0
	pipewire_up || return 0
	apply_gain "$vol"
	rc=$?
	[ "$rc" -eq 2 ] && return 0
	return "$rc"
}

active_role() {
	role=
	if [ -r "$RT/active" ]; then
		read -r role < "$RT/active" || role=
	fi
	case "$role" in
		codec|hdmi|bt) printf '%s\n' "$role"; return ;;
	esac
	s=$(saved ZLYME_SINK || true)
	case "$s" in
		codec|hdmi|bt) printf '%s\n' "$s"; return ;;
	esac
	printf '%s\n' codec
}

case "${1:-status}" in
list)
	for s in codec hdmi bt; do
		if reason=$(why_unavailable "$s"); then
			printf '%s\t%s\n' "$s" "$(describe "$s")"
		else
			printf '%s\t%s (unavailable: %s)\n' "$s" "$(describe "$s")" "$reason"
		fi
	done
	;;
get)
	pref
	;;
set)
	case "$2" in
		auto|codec|hdmi|bt) save ZLYME_SINK_PREF "$2" || exit 1 ;;
		*) echo "$(basename "$0"): unknown sink '${2}'" >&2; exit 1 ;;
	esac
	signal_graph
	if [ -S "$RT/pipewire-0" ] && command -v pw-metadata >/dev/null 2>&1; then
		pw-metadata -n default 0 zlyme.pref "$2" >/dev/null 2>&1 || true
	fi
	echo "preference: $2"
	;;
hdmi-event)
	signal_graph
	;;
policy)
	policy_role
	;;
hold)
	# Apply a gain without rewriting the saved percent. Power-off uses
	# this so the next boot is not left muted.
	v=$(clamp_volume "$2") || exit 1
	pipewire_up || {
		echo "$(basename "$0"): PipeWire is not running" >&2
		exit 1
	}
	apply_gain "$v"
	rc=$?
	[ "$rc" -eq 2 ] && exit 0
	exit "$rc"
	;;
remember)
	case "$2" in
		auto|codec|hdmi|bt) save ZLYME_SINK_PREF "$2" || exit 1 ;;
		*) echo "$(basename "$0"): unknown sink '${2}'" >&2; exit 1 ;;
	esac
	;;
status)
	sink=$(active_role)
	printf 'sink: %s\n' "$sink"
	printf 'preference: %s\n' "$(pref)"
	if reason=$(why_unavailable "$sink"); then
		echo "state: available"
	else
		printf 'state: unavailable -- %s\n' "$reason"
	fi
	printf 'volume: %s\n' "$(volume)"
	;;
getSystemVolume)
	volume
	;;
setSystemVolume)
	v="$2"
	now=$(volume)
	: "${now:=0}"
	case "$v" in
		mute)
			[ "$now" -gt 0 ] && save ZLYME_PREMUTE "$now"
			set_volume 0 || exit 1
			;;
		unmute)
			restore=$(saved ZLYME_PREMUTE) || restore=""
			set_volume "${restore:-50}" || exit 1
			;;
		mute-toggle)
			if [ "$now" -gt 0 ]; then
				save ZLYME_PREMUTE "$now"
				set_volume 0 || exit 1
			else
				restore=$(saved ZLYME_PREMUTE) || restore=""
				set_volume "${restore:-50}" || exit 1
			fi
			;;
		[+-]*)
			delta=${v#[+-]}
			case "$v" in
				+*) new=$((now + delta)) ;;
				-*) new=$((now - delta)) ;;
			esac
			[ "$new" -lt 0 ] && new=0
			[ "$new" -gt 100 ] && new=100
			set_volume "$new" || exit 1
			;;
		*)
			if echo "$v" | grep -qE '^[0-9]+$' && [ "$v" -le 100 ]; then
				set_volume "$v" || exit 1
			else
				echo "$(basename "$0"): invalid volume '${v}'" >&2
				exit 1
			fi
			;;
	esac
	;;
test)
	speaker-test -D default -c 2 -t sine -f 440 -l 1 >/dev/null 2>&1 || {
		echo "$(basename "$0"): could not open the current sink" >&2
		exit 1
	}
	;;
export)
	printf 'XDG_RUNTIME_DIR=%s; export XDG_RUNTIME_DIR\n' "$RT"
	printf 'PIPEWIRE_RUNTIME_DIR=%s; export PIPEWIRE_RUNTIME_DIR\n' "$RT"
	printf 'ZLYME_SINK=%s; export ZLYME_SINK\n' "$(active_role)"
	;;
apply-saved)
	apply_saved
	;;
route)
	route
	;;
node-id)
	id=$(node_id "$2" || true)
	[ -n "$id" ] || exit 1
	printf '%s\n' "$id"
	;;
pulse-service)
	pipewire_up || exit 1
	[ -n "$(node_id codec || true)" ]
	exit $?
	;;
migrate-volume)
	migrate_volume
	;;
focus)
	case "$2" in
		auto|codec|hdmi|bt) save ZLYME_SINK_PREF "$2" || exit 1 ;;
		*) echo "$(basename "$0"): unknown sink '${2}'" >&2; exit 1 ;;
	esac
	signal_graph
	;;
-h|--help|help)
	do_usage
	;;
*)
	do_usage >&2
	exit 1
	;;
esac
