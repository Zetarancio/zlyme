#!/bin/sh
#
# Sink preference and the 0-100 volume. PipeWire is the product graph.
# The minimal image has no wpctl and uses the RK817 mixer instead.
# audio.conf is data. It is never sourced.

# shellcheck disable=SC1090
. "${ZLYME_CONF:-/etc/zlyme.conf}"

STATE="${ZLYME_CFG}/audio.conf"
CARD=rk817ext
VOLCTL=FlipVolume
RT="${ZLYME_PW_RUNTIME:-/run/zlyme/pipewire}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$RT}"
export PIPEWIRE_RUNTIME_DIR="${PIPEWIRE_RUNTIME_DIR:-$RT}"

do_usage() {
	cat <<EOF
usage: $(basename "$0") <command>

  list
  get
  set {auto|codec|hdmi|bt}
  status
  getSystemVolume
  setSystemVolume {mute|unmute|mute-toggle|[+-]<0-100>}
  test
  export
  route
  migrate-volume
EOF
}

saved() {
	[ -r "$STATE" ] || return 1
	sed -n "s/^$1=//p" "$STATE" | tail -n 1
}

save() {
	key=$1
	val=$2
	dir=$(dirname "$STATE")
	if [ ! -d "$dir" ]; then
		echo "$(basename "$0"): ${dir} is not there -- is the card mounted?" >&2
		return 1
	fi
	lock="$dir/audio.conf.lock"
	n=0
	while ! mkdir "$lock" 2>/dev/null; do
		n=$((n + 1))
		[ "$n" -gt 50 ] && return 1
		sleep 0.02
	done
	tmp=$(mktemp "$dir/audio.conf.XXXXXX") || {
		rmdir "$lock" 2>/dev/null || true
		return 1
	}
	if [ -r "$STATE" ]; then
		grep -v "^${key}=" "$STATE" > "$tmp" 2>/dev/null || : > "$tmp"
	else
		: > "$tmp"
	fi
	printf '%s=%s\n' "$key" "$val" >> "$tmp" || {
		rm -f "$tmp"
		rmdir "$lock" 2>/dev/null || true
		return 1
	}
	mv -f "$tmp" "$STATE"
	rmdir "$lock" 2>/dev/null || true
}

drop_key() {
	key=$1
	[ -r "$STATE" ] || return 0
	grep -q "^${key}=" "$STATE" || return 0
	dir=$(dirname "$STATE")
	lock="$dir/audio.conf.lock"
	n=0
	while ! mkdir "$lock" 2>/dev/null; do
		n=$((n + 1))
		[ "$n" -gt 50 ] && return 1
		sleep 0.02
	done
	tmp=$(mktemp "$dir/audio.conf.XXXXXX") || {
		rmdir "$lock" 2>/dev/null || true
		return 1
	}
	grep -v "^${key}=" "$STATE" > "$tmp" 2>/dev/null || : > "$tmp"
	mv -f "$tmp" "$STATE"
	rmdir "$lock" 2>/dev/null || true
}

clamp_volume() {
	v=$1
	echo "$v" | grep -Eq '^[0-9]+$' || return 1
	[ "$v" -gt 100 ] && v=100
	printf '%s\n' "$v"
}

pref() {
	p=$(saved ZLYME_SINK_PREF || true)
	case "$p" in
		auto|codec|hdmi|bt) printf '%s\n' "$p"; return ;;
	esac
	s=$(saved ZLYME_SINK || true)
	case "$s" in
		codec|hdmi|bt) printf '%s\n' "$s"; return ;;
	esac
	printf '%s\n' auto
}

current() {
	s=$(saved ZLYME_SINK || true)
	case "$s" in
		codec|hdmi|bt) printf '%s\n' "$s"; return ;;
	esac
	printf '%s\n' codec
}

describe() {
	case "$1" in
		codec) echo "Speaker or headphones" ;;
		hdmi) echo "HDMI" ;;
		bt) echo "Bluetooth" ;;
		*) echo "$1" ;;
	esac
}

pipewire_up() {
	if [ "${ZLYME_AUDIO_BACKEND:-}" = alsa ]; then
		return 1
	fi
	if [ -n "${ZLYME_PW_NODES:-}" ] && { [ -n "${ZLYME_WPCTL:-}" ] || [ -x /usr/bin/wpctl ]; }; then
		return 0
	fi
	[ -S "$RT/pipewire-0" ] || return 1
	[ -n "${ZLYME_WPCTL:-}" ] || [ -x /usr/bin/wpctl ]
}

# role<TAB>id
nodes() {
	if [ -n "${ZLYME_PW_NODES:-}" ] && [ -r "$ZLYME_PW_NODES" ]; then
		cat "$ZLYME_PW_NODES"
		return 0
	fi
	command -v pw-dump >/dev/null 2>&1 || return 1
	command -v python3 >/dev/null 2>&1 || return 1
	dump=$(mktemp) || return 1
	if ! pw-dump > "$dump" 2>/dev/null; then
		rm -f "$dump"
		return 1
	fi
	python3 - "$dump" << 'PY'
import json, sys
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
for obj in data:
    if obj.get("type") != "PipeWire:Interface:Node":
        continue
    props = (obj.get("info") or {}).get("props") or {}
    if props.get("media.class") != "Audio/Sink":
        continue
    name = props.get("node.name") or ""
    if "null" in name or "dummy" in name:
        continue
    card = props.get("api.alsa.card.id") or ""
    role = ""
    if name.startswith("bluez_output."):
        role = "bt"
    elif card == "rk817ext":
        role = "codec"
    elif card == "HDMI":
        role = "hdmi"
    if role and obj.get("id") is not None:
        print("%s\t%s" % (role, obj.get("id")))
PY
	rc=$?
	rm -f "$dump"
	return "$rc"
}

node_id() {
	role=$1
	nodes | awk -F '\t' -v r="$role" '$1 == r { print $2; exit }'
}

hdmi_has_audio() {
	[ "${ZLYME_HDMI_AUDIO:-}" = 1 ] && return 0
	[ "${ZLYME_HDMI_AUDIO:-}" = 0 ] && return 1
	eld=$(ls /proc/asound/HDMI/eld#* 2>/dev/null | head -n 1)
	[ -n "$eld" ] || return 1
	grep -q 'sad_count *[1-9]' "$eld"
}

# Displayed percent stays the stored integer. PipeWire's wpctl float is
# linear gain. The old Pulse percent was cubic, so 40 there is gain
# (0.40)^3. Apply that curve so the first PipeWire boot is not louder.
linear_gain() {
	awk -v p="$1" 'BEGIN {
		if (p+0 <= 0) { print "0"; exit }
		if (p+0 >= 100) { print "1"; exit }
		printf "%.6f", (p/100) * (p/100) * (p/100)
	}'
}

wp() {
	"${ZLYME_WPCTL:-wpctl}" "$@"
}

# 0 applied to every listed sink, 2 no sinks, 1 a command failed.
apply_gain() {
	v=$1
	g=$(linear_gain "$v")
	tab=$(printf '\t')
	list=$(nodes 2>/dev/null) || return 1
	[ -n "$list" ] || return 2
	mark=$(mktemp) || return 1
	printf '%s\n' "$list" | while IFS="$tab" read -r role nid; do
		[ -n "$nid" ] || continue
		wp set-volume "$nid" "$g" >/dev/null 2>&1 || echo fail >> "$mark"
	done
	if [ -s "$mark" ]; then
		rm -f "$mark"
		return 1
	fi
	rm -f "$mark"
	return 0
}

choose() {
	want=$1
	case "$want" in
		codec|hdmi|bt)
			id=$(node_id "$want" || true)
			if [ -n "$id" ]; then
				if [ "$want" = hdmi ] && ! hdmi_has_audio; then
					:
				else
					printf '%s\n' "$want"
					return 0
				fi
			fi
			;;
	esac
	if [ -n "$(node_id bt || true)" ]; then
		printf '%s\n' bt
		return 0
	fi
	if [ -n "$(node_id hdmi || true)" ] && hdmi_has_audio; then
		printf '%s\n' hdmi
		return 0
	fi
	if [ -n "$(node_id codec || true)" ]; then
		printf '%s\n' codec
		return 0
	fi
	printf '%s\n' codec
}

focus_role() {
	role=$1
	id=$(node_id "$role" || true)
	[ -n "$id" ] || return 1
	wp set-default "$id" >/dev/null 2>&1 || return 1
	if mkdir -p "$RT" 2>/dev/null; then
		printf '%s\n' "$role" > "$RT/active" 2>/dev/null || true
	fi
	return 0
}

route() {
	pipewire_up || return 0
	choice=$(choose "$(pref)")
	focus_role "$choice" || true
	vol=$(saved ZLYME_VOLUME || true)
	[ -n "$vol" ] || return 0
	apply_gain "$vol"
}

why_unavailable() {
	case "$1" in
		codec)
			if pipewire_up; then
				[ -n "$(node_id codec || true)" ] || { echo "codec node absent"; return 1; }
			else
				[ -d "/proc/asound/${CARD}" ] || { echo "codec card absent"; return 1; }
			fi
			;;
		hdmi)
			if pipewire_up; then
				[ -n "$(node_id hdmi || true)" ] || { echo "HDMI node absent"; return 1; }
				hdmi_has_audio || { echo "HDMI ELD has no audio"; return 1; }
			else
				[ -d /proc/asound/HDMI ] || { echo "HDMI card absent"; return 1; }
			fi
			;;
		bt)
			if pipewire_up; then
				[ -n "$(node_id bt || true)" ] || { echo "Bluetooth node absent"; return 1; }
			else
				echo "Bluetooth audio needs PipeWire"
				return 1
			fi
			;;
	esac
	return 0
}

volume() {
	v=$(saved ZLYME_VOLUME || true)
	if [ -n "$v" ]; then
		printf '%s\n' "$v"
		return 0
	fi
	amixer -c "$CARD" sget "$VOLCTL" 2>/dev/null |
		sed -n 's/.*\[\([0-9]*\)%\].*/\1/p' | head -n 1
}

set_volume() {
	v=$(clamp_volume "$1") || return 1
	cur=$(saved ZLYME_VOLUME || true)
	if [ "$cur" != "$v" ]; then
		save ZLYME_VOLUME "$v" || return 1
	fi
	if pipewire_up; then
		apply_gain "$v"
		rc=$?
		# No sink yet: the saved number is applied when one appears.
		[ "$rc" -eq 2 ] && return 0
		return "$rc"
	fi
	amixer -q -c "$CARD" sset "$VOLCTL" "${v}%" 2>/dev/null || true
}

# Saved percent is the user intention. It is applied on every graph.
# ZLYME_GAIN_STATE from the previous candidate is not that intention.
migrate_volume() {
	src=$(saved ZLYME_VOLUME_SRC || true)
	if [ "$src" != pipewire-cubic ]; then
		now=$(saved ZLYME_VOLUME || true)
		if [ -z "$now" ]; then
			now=$(amixer -c "$CARD" sget "$VOLCTL" 2>/dev/null |
				sed -n 's/.*\[\([0-9]*\)%\].*/\1/p' | head -n 1)
		fi
		if ! now=$(clamp_volume "$now"); then
			now=40
		fi
		save ZLYME_VOLUME "$now" || return 1
		save ZLYME_VOLUME_SRC pipewire-cubic || return 1
	fi
	# Old ZLYME_SINK was the last automatic route, not a manual choice.
	if [ -z "$(saved ZLYME_SINK_PREF || true)" ]; then
		save ZLYME_SINK_PREF auto || return 1
	fi
	drop_key ZLYME_GAIN_STATE || true
	vol=$(saved ZLYME_VOLUME || true)
	[ -n "$vol" ] || return 0
	pipewire_up || return 0
	apply_gain "$vol"
	rc=$?
	[ "$rc" -eq 2 ] && return 0
	return "$rc"
}

active_role() {
	role=
	if [ -r "$RT/active" ]; then
		read -r role < "$RT/active" || role=
	fi
	case "$role" in
		codec|hdmi|bt) printf '%s\n' "$role"; return ;;
	esac
	s=$(saved ZLYME_SINK || true)
	case "$s" in
		codec|hdmi|bt) printf '%s\n' "$s"; return ;;
	esac
	printf '%s\n' codec
}

case "${1:-status}" in
list)
	for s in codec hdmi bt; do
		if reason=$(why_unavailable "$s"); then
			printf '%s\t%s\n' "$s" "$(describe "$s")"
		else
			printf '%s\t%s (unavailable: %s)\n' "$s" "$(describe "$s")" "$reason"
		fi
	done
	;;
get)
	pref
	;;
set)
	case "$2" in
		auto|codec|hdmi|bt) save ZLYME_SINK_PREF "$2" || exit 1 ;;
		*) echo "$(basename "$0"): unknown sink '${2}'" >&2; exit 1 ;;
	esac
	route
	echo "sink: $(current)"
	;;
remember)
	case "$2" in
		auto|codec|hdmi|bt) save ZLYME_SINK_PREF "$2" || exit 1 ;;
		*) echo "$(basename "$0"): unknown sink '${2}'" >&2; exit 1 ;;
	esac
	;;
status)
	sink=$(active_role)
	printf 'sink: %s\n' "$sink"
	printf 'preference: %s\n' "$(pref)"
	if reason=$(why_unavailable "$sink"); then
		echo "state: available"
	else
		printf 'state: unavailable -- %s\n' "$reason"
	fi
	printf 'volume: %s\n' "$(volume)"
	;;
getSystemVolume)
	volume
	;;
setSystemVolume)
	v="$2"
	now=$(volume)
	: "${now:=0}"
	case "$v" in
		mute)
			[ "$now" -gt 0 ] && save ZLYME_PREMUTE "$now"
			set_volume 0
			;;
		unmute)
			restore=$(saved ZLYME_PREMUTE) || restore=""
			set_volume "${restore:-50}"
			;;
		mute-toggle)
			if [ "$now" -gt 0 ]; then
				save ZLYME_PREMUTE "$now"
				set_volume 0
			else
				restore=$(saved ZLYME_PREMUTE) || restore=""
				set_volume "${restore:-50}"
			fi
			;;
		[+-]*)
			delta=${v#[+-]}
			case "$v" in
				+*) new=$((now + delta)) ;;
				-*) new=$((now - delta)) ;;
			esac
			[ "$new" -lt 0 ] && new=0
			[ "$new" -gt 100 ] && new=100
			set_volume "$new"
			;;
		*)
			if echo "$v" | grep -qE '^[0-9]+$' && [ "$v" -le 100 ]; then
				set_volume "$v"
			else
				echo "$(basename "$0"): invalid volume '${v}'" >&2
				exit 1
			fi
			;;
	esac
	;;
test)
	speaker-test -D default -c 2 -t sine -f 440 -l 1 >/dev/null 2>&1 ||
		echo "$(basename "$0"): could not open the current sink" >&2
	;;
export)
	printf 'XDG_RUNTIME_DIR=%s; export XDG_RUNTIME_DIR\n' "$RT"
	printf 'PIPEWIRE_RUNTIME_DIR=%s; export PIPEWIRE_RUNTIME_DIR\n' "$RT"
	printf 'ZLYME_SINK=%s; export ZLYME_SINK\n' "$(active_role)"
	;;
route)
	route
	;;
node-id)
	id=$(node_id "$2" || true)
	[ -n "$id" ] || exit 1
	printf '%s\n' "$id"
	;;
pulse-service)
	if pipewire_up; then
		[ -n "$(node_id codec || true)" ]
		exit $?
	fi
	command -v pactl >/dev/null 2>&1 || exit 1
	pactl list short sinks 2>/dev/null | awk '$2 == "codec" { found = 1 } END { exit !found }'
	;;
migrate-volume)
	migrate_volume
	;;
focus)
	case "$2" in
		codec|hdmi|bt) focus_role "$2" || exit 1 ;;
		*) echo "$(basename "$0"): unknown sink '${2}'" >&2; exit 1 ;;
	esac
	;;
-h|--help|help)
	do_usage
	;;
*)
	do_usage >&2
	exit 1
	;;
esac
