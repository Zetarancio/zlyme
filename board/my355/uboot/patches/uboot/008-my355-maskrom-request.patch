Consume a one-shot ZLYMEBOOT marker before the fuel gauge, and enter
the existing rbrom path only after that marker is gone.

diff --git a/cmd/my355.c b/cmd/my355.c
--- a/cmd/my355.c
+++ b/cmd/my355.c
@@ -11,6 +11,8 @@
 #include <env.h>
 #include <i2c.h>
 #include <mapmem.h>
+#include <fs.h>
+#include "maskrom_request.h"
 #include <membuf.h>
 #include <asm/global_data.h>
 #include <linux/string.h>
@@ -22,6 +24,80 @@
 
 DECLARE_GLOBAL_DATA_PTR;
 
+int zlyme_rbrom(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[]);
+
+static int maskrom_open(void)
+{
+	/* mmc0 partition 2 is the right-hand ZLYMEBOOT volume. */
+	return fs_set_blk_dev("mmc", "0:2", FS_TYPE_FAT);
+}
+
+static int maskrom_exists(void)
+{
+	return fs_exists(ZLYME_MASKROM_PATH);
+}
+
+static int maskrom_size(int *out)
+{
+	loff_t sz = 0;
+
+	if (fs_size(ZLYME_MASKROM_PATH, &sz))
+		return -1;
+	if (sz < 0 || sz > 64)
+		return -1;
+	*out = (int)sz;
+	return 0;
+}
+
+static int maskrom_read(void *buf, int len, int *nread)
+{
+	loff_t act = 0;
+	int ret;
+
+	ret = fs_read(ZLYME_MASKROM_PATH, (ulong)(uintptr_t)buf, 0, len, &act);
+	if (nread)
+		*nread = (int)act;
+	return ret;
+}
+
+static int maskrom_unlink(void)
+{
+	return fs_unlink(ZLYME_MASKROM_PATH);
+}
+
+static const struct maskrom_fs maskrom_ops = {
+	.open_volume = maskrom_open,
+	.exists = maskrom_exists,
+	.size = maskrom_size,
+	.read = maskrom_read,
+	.unlink = maskrom_unlink,
+	.magic = ZLYME_MASKROM_MAGIC,
+	.magic_len = sizeof(ZLYME_MASKROM_MAGIC) - 1,
+};
+
+static int do_my355_maskrom(struct cmd_tbl *cmdtp, int flag, int argc,
+			    char *const argv[])
+{
+	int rc;
+
+	(void)argc;
+	(void)argv;
+	rc = maskrom_request_consume(&maskrom_ops);
+	if (rc == MASKROM_ENTER)
+		return zlyme_rbrom(cmdtp, flag, 0, NULL);
+	if (rc == MASKROM_REJECT)
+		printf("my355 maskrom-request: marker not consumed, booting normally\n");
+	return CMD_RET_SUCCESS;
+}
+
+/* The stock subcommand macro stringifies one identifier, so a hyphenated
+ * name has to be a string literal. The field list matches U_BOOT_SUBCMD_MKENT.
+ */
+#define ZLYME_SUBCMD(_namestr, _maxargs, _rep, _do_cmd)			\
+	{ _namestr, _maxargs,						\
+	  (_rep) ? cmd_always_repeatable : cmd_never_repeatable,	\
+	  _do_cmd, "", _CMD_HELP("") _CMD_COMPLETE(NULL) }
+
 static int do_my355_mark(struct cmd_tbl *cmdtp, int flag, int argc,
 			 char *const argv[])
 {
@@ -284,10 +360,12 @@
 	"my355 log <addr> <max> - copy the console record to <addr>;\n"
 	"                        its length goes in $my355_logsize\n"
 	"my355 cpu <MHz>        - raise vdd_cpu if needed, then set the core clock\n"
+	"my355 maskrom-request  - consume /zlyme-maskrom.request, then rbrom\n"
 	"my355 fg               - reconcile the RK817 fuel gauge for the kernel");
 
 U_BOOT_CMD_WITH_SUBCMDS(my355, "BaseOS my355 boot helpers", my355_help_text,
 	U_BOOT_SUBCMD_MKENT(mark, 2, 1, do_my355_mark),
 	U_BOOT_SUBCMD_MKENT(log, 3, 1, do_my355_log),
 	U_BOOT_SUBCMD_MKENT(cpu, 2, 1, do_my355_cpu),
+	ZLYME_SUBCMD("maskrom-request", 1, 1, do_my355_maskrom),
 	U_BOOT_SUBCMD_MKENT(fg, 1, 1, do_my355_fg));
diff --git a/cmd/rbrom.c b/cmd/rbrom.c
--- a/cmd/rbrom.c
+++ b/cmd/rbrom.c
@@ -3,13 +3,21 @@
 
 void set_back_to_bootrom_dnl_flag(void);
 
-static int do_rbrom(struct cmd_tbl *cmdtp, int flag, int argc,
-		    char *const argv[])
+int zlyme_rbrom(struct cmd_tbl *cmdtp, int flag, int argc,
+		char *const argv[]);
+
+int zlyme_rbrom(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
 {
 	set_back_to_bootrom_dnl_flag();
 	return do_reset(cmdtp, flag, argc, argv);
 }
 
+static int do_rbrom(struct cmd_tbl *cmdtp, int flag, int argc,
+		    char *const argv[])
+{
+	return zlyme_rbrom(cmdtp, flag, argc, argv);
+}
+
 U_BOOT_CMD(rbrom, 1, 0, do_rbrom,
 	   "reset into Rockchip bootrom USB download",
 	   ""
