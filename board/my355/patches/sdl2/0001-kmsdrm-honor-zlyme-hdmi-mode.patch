+/* Zlyme: optional HDMI mode. Unset ZLYME_HDMI_720P leaves this path unused.
+ * The connector id has to match, and the connector has to be HDMI-A.
+ * A matching width on the panel is not accepted. */
+static drmModeModeInfo *KMSDRM_ZlymeFindMode(SDL_VideoDisplay *display)
+{
+    const char *gate = SDL_getenv("ZLYME_HDMI_720P");
+    const char *spec = SDL_getenv("ZLYME_HDMI_SDL_MODE");
+    const char *id_text = SDL_getenv("ZLYME_HDMI_SDL_CONNECTOR");
+    SDL_DisplayData *dispdata;
+    int want_id = 0;
+    int want_w = 0;
+    int want_h = 0;
+    int want_hz = 0;
+    int i;
+    int best = -1;
+    int best_delta = 0;
+
+    if (!gate || SDL_strcmp(gate, "1") != 0 || !spec || !id_text)
+        return NULL;
+    if (SDL_sscanf(id_text, "%d", &want_id) != 1 || want_id <= 0)
+        return NULL;
+    if (SDL_sscanf(spec, "%dx%d@%d", &want_w, &want_h, &want_hz) != 3)
+        return NULL;
+    if (want_w <= 0 || want_h <= 0 || want_hz <= 0)
+        return NULL;
+    dispdata = (SDL_DisplayData *)display->driverdata;
+    if (!dispdata || !dispdata->connector)
+        return NULL;
+    if ((int)dispdata->connector->connector_id != want_id)
+        return NULL;
+    if (dispdata->connector->connector_type != DRM_MODE_CONNECTOR_HDMIA)
+        return NULL;
+    for (i = 0; i < dispdata->connector->count_modes; i++) {
+        drmModeModeInfo *mode = &dispdata->connector->modes[i];
+        int delta;
+
+        if ((int)mode->hdisplay != want_w || (int)mode->vdisplay != want_h)
+            continue;
+        delta = (int)mode->vrefresh - want_hz;
+        if (delta < 0)
+            delta = -delta;
+        if (best < 0 || delta < best_delta) {
+            best = i;
+            best_delta = delta;
+        }
+    }
+    if (best < 0)
+        return NULL;
+    return &dispdata->connector->modes[best];
+}
+
+static SDL_VideoDisplay *KMSDRM_ZlymePlace(_THIS, SDL_Window *window)
+{
+    int i;
+    int n = SDL_GetNumVideoDisplays();
+
+    for (i = 0; i < n; i++) {
+        SDL_VideoDisplay *display = &_this->displays[i];
+        drmModeModeInfo *mode = KMSDRM_ZlymeFindMode(display);
+        SDL_Rect bounds;
+
+        if (!mode)
+            continue;
+        SDL_zero(bounds);
+        if (SDL_GetDisplayBounds(i, &bounds) != 0)
+            return NULL;
+        window->x = bounds.x;
+        window->y = bounds.y;
+        window->windowed.x = window->x;
+        window->windowed.y = window->y;
+        return display;
+    }
+    return NULL;
+}
