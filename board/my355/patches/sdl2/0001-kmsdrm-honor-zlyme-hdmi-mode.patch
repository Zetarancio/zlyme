+/* Zlyme HDMI policy. Inactive unless ZLYME_HDMI_720P is exactly "1".
+ * The mode is connector->modes[index] on the HDMI-A connector id from
+ * zlyme-hdmi. Width and height only confirm that index. Integer
+ * vrefresh is not the selector: 59.94 Hz and 60 Hz share it.
+ * The window flags and SDL fullscreen_mode are left to SDL. */
+static drmModeModeInfo *KMSDRM_ZlymeFindMode(SDL_VideoDisplay *display)
+{
+    const char *gate = SDL_getenv("ZLYME_HDMI_720P");
+    const char *id_text = SDL_getenv("ZLYME_HDMI_SDL_CONNECTOR");
+    const char *index_text = SDL_getenv("ZLYME_HDMI_SDL_INDEX");
+    const char *width_text = SDL_getenv("ZLYME_HDMI_WIDTH");
+    const char *height_text = SDL_getenv("ZLYME_HDMI_HEIGHT");
+    SDL_DisplayData *dispdata;
+    drmModeModeInfo *mode;
+    int want_id = 0;
+    int want_index = -1;
+    int want_w = 0;
+    int want_h = 0;
+
+    if (!gate || SDL_strcmp(gate, "1") != 0)
+        return NULL;
+    if (!id_text || !index_text || !width_text || !height_text)
+        return NULL;
+    if (SDL_sscanf(id_text, "%d", &want_id) != 1 || want_id <= 0)
+        return NULL;
+    if (SDL_sscanf(index_text, "%d", &want_index) != 1 || want_index < 0)
+        return NULL;
+    if (SDL_sscanf(width_text, "%d", &want_w) != 1 || want_w <= 0)
+        return NULL;
+    if (SDL_sscanf(height_text, "%d", &want_h) != 1 || want_h <= 0)
+        return NULL;
+    dispdata = (SDL_DisplayData *)display->driverdata;
+    if (!dispdata || !dispdata->connector)
+        return NULL;
+    if ((int)dispdata->connector->connector_id != want_id)
+        return NULL;
+    if (dispdata->connector->connector_type != DRM_MODE_CONNECTOR_HDMIA)
+        return NULL;
+    if (want_index >= dispdata->connector->count_modes)
+        return NULL;
+    mode = &dispdata->connector->modes[want_index];
+    if ((int)mode->hdisplay != want_w || (int)mode->vdisplay != want_h)
+        return NULL;
+    return mode;
+}
+
+static SDL_VideoDisplay *KMSDRM_ZlymePlace(_THIS, SDL_Window *window)
+{
+    int i;
+    int n = SDL_GetNumVideoDisplays();
+
+    if (window->flags & SDL_WINDOW_VULKAN)
+        return NULL;
+    for (i = 0; i < n; i++) {
+        SDL_VideoDisplay *display = &_this->displays[i];
+        drmModeModeInfo *mode = KMSDRM_ZlymeFindMode(display);
+        SDL_Rect bounds;
+
+        if (!mode)
+            continue;
+        SDL_zero(bounds);
+        if (SDL_GetDisplayBounds(i, &bounds) != 0)
+            return NULL;
+        window->x = bounds.x;
+        window->y = bounds.y;
+        window->windowed.x = window->x;
+        window->windowed.y = window->y;
+        return display;
+    }
+    return NULL;
+}
