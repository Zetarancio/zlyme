+/* Panel off only after this process has modeset HDMI. The marker stores
+ * the DSI mode, not a framebuffer a later process may reuse. */
+static int zlyme_panel_off;
+static uint32_t zlyme_dsi_crtc, zlyme_dsi_fb, zlyme_dsi_conn;
+static drmModeModeInfo zlyme_dsi_mode;
+
+void KMSDRM_ZlymeRestorePanel(int fd)
+{
+    if (!zlyme_panel_off || fd < 0)
+        return;
+    if (KMSDRM_drmModeSetCrtc(fd, zlyme_dsi_crtc, zlyme_dsi_fb, 0, 0,
+                              &zlyme_dsi_conn, 1, &zlyme_dsi_mode) != 0)
+        SDL_Log("ZLYME_HDMI_PANEL: restore failed errno=%d", errno);
+    else {
+        SDL_Log("ZLYME_HDMI_PANEL: DSI crtc %u restored", zlyme_dsi_crtc);
+        unlink("/run/zlyme/hdmi-panel-off");
+    }
+    zlyme_panel_off = 0;
+}
+
+static void KMSDRM_ZlymeWriteMarker(drmModeCrtc *crtc, uint32_t conn)
+{
+    FILE *fp = fopen("/run/zlyme/hdmi-panel-off", "w");
+    if (!fp)
+        return;
+    fprintf(fp, "%u %u %u %hu %hu %hu %hu %hu %hu %hu %hu %hu %u %u %u %s\n",
+            crtc->crtc_id, conn,
+            crtc->mode.clock,
+            crtc->mode.hdisplay, crtc->mode.hsync_start,
+            crtc->mode.hsync_end, crtc->mode.htotal, crtc->mode.hskew,
+            crtc->mode.vdisplay, crtc->mode.vsync_start,
+            crtc->mode.vsync_end, crtc->mode.vtotal, crtc->mode.vscan,
+            crtc->mode.vrefresh, crtc->mode.flags, crtc->mode.type,
+            crtc->mode.name);
+    fclose(fp);
+}
+
+static int KMSDRM_ZlymeReadMarker(uint32_t *crtc, uint32_t *conn, drmModeModeInfo *mode)
+{
+    FILE *fp = fopen("/run/zlyme/hdmi-panel-off", "r");
+    unsigned int c, k, clock, vrefresh, flags, type;
+    unsigned int hdisplay, hsync_start, hsync_end, htotal, hskew;
+    unsigned int vdisplay, vsync_start, vsync_end, vtotal, vscan;
+    char name[32];
+    if (!fp)
+        return 0;
+    memset(mode, 0, sizeof(*mode));
+    if (fscanf(fp, "%u %u %u %u %u %u %u %u %u %u %u %u %u %u %u %31s",
+               &c, &k, &clock,
+               &hdisplay, &hsync_start, &hsync_end, &htotal, &hskew,
+               &vdisplay, &vsync_start, &vsync_end, &vtotal, &vscan,
+               &vrefresh, &flags, &type, name) != 17) {
+        fclose(fp);
+        return 0;
+    }
+    fclose(fp);
+    *crtc = c;
+    *conn = k;
+    mode->clock = clock;
+    mode->hdisplay = hdisplay;
+    mode->hsync_start = hsync_start;
+    mode->hsync_end = hsync_end;
+    mode->htotal = htotal;
+    mode->hskew = hskew;
+    mode->vdisplay = vdisplay;
+    mode->vsync_start = vsync_start;
+    mode->vsync_end = vsync_end;
+    mode->vtotal = vtotal;
+    mode->vscan = vscan;
+    mode->vrefresh = vrefresh;
+    mode->flags = flags;
+    mode->type = type;
+    SDL_strlcpy(mode->name, name, sizeof(mode->name));
+    return 1;
+}
+
+static void KMSDRM_ZlymeQuiescePanel(int fd)
+{
+    const char *gate = SDL_getenv("ZLYME_HDMI_720P");
+    drmModeRes *res;
+    int i;
+    if (zlyme_panel_off)
+        return;
+    if (!gate || SDL_strcmp(gate, "1") != 0 || fd < 0)
+        return;
+    if (KMSDRM_drmSetClientCap(fd, DRM_CLIENT_CAP_UNIVERSAL_PLANES, 1) != 0 ||
+        KMSDRM_drmSetClientCap(fd, DRM_CLIENT_CAP_ATOMIC, 1) != 0) {
+        SDL_Log("ZLYME_HDMI_PANEL: client cap failed errno=%d", errno);
+        return;
+    }
+    res = KMSDRM_drmModeGetResources(fd);
+    if (!res) {
+        SDL_Log("ZLYME_HDMI_PANEL: no resources errno=%d", errno);
+        return;
+    }
+    for (i = 0; i < res->count_connectors; i++) {
+        drmModeConnector *conn = KMSDRM_drmModeGetConnector(fd, res->connectors[i]);
+        drmModeEncoder *enc;
+        drmModeCrtc *crtc;
+        if (!conn)
+            continue;
+        if (conn->connector_type != DRM_MODE_CONNECTOR_DSI || conn->encoder_id == 0) {
+            KMSDRM_drmModeFreeConnector(conn);
+            continue;
+        }
+        enc = KMSDRM_drmModeGetEncoder(fd, conn->encoder_id);
+        if (!enc || enc->crtc_id == 0) {
+            if (enc)
+                KMSDRM_drmModeFreeEncoder(enc);
+            KMSDRM_drmModeFreeConnector(conn);
+            continue;
+        }
+        crtc = KMSDRM_drmModeGetCrtc(fd, enc->crtc_id);
+        if (!crtc) {
+            KMSDRM_drmModeFreeEncoder(enc);
+            KMSDRM_drmModeFreeConnector(conn);
+            continue;
+        }
+        zlyme_dsi_crtc = crtc->crtc_id;
+        zlyme_dsi_fb = crtc->buffer_id;
+        zlyme_dsi_conn = conn->connector_id;
+        zlyme_dsi_mode = crtc->mode;
+        if (KMSDRM_drmModeSetCrtc(fd, crtc->crtc_id, 0, 0, 0,
+                                  &conn->connector_id, 1, NULL) != 0) {
+            SDL_Log("ZLYME_HDMI_PANEL: DSI disable failed errno=%d", errno);
+            KMSDRM_drmModeFreeCrtc(crtc);
+            KMSDRM_drmModeFreeEncoder(enc);
+            KMSDRM_drmModeFreeConnector(conn);
+            break;
+        }
+        zlyme_panel_off = 1;
+        KMSDRM_ZlymeWriteMarker(crtc, conn->connector_id);
+        SDL_Log("ZLYME_HDMI_PANEL: DSI crtc %u disabled after HDMI scanout",
+                crtc->crtc_id);
+        KMSDRM_drmModeFreeCrtc(crtc);
+        KMSDRM_drmModeFreeEncoder(enc);
+        KMSDRM_drmModeFreeConnector(conn);
+        break;
+    }
+    KMSDRM_drmModeFreeResources(res);
+}
+
+void KMSDRM_ZlymeRecoverPanel(int fd, uint32_t fb, uint32_t just_conn, int just_type)
+{
+    const char *gate = SDL_getenv("ZLYME_HDMI_720P");
+    uint32_t crtc, conn;
+    drmModeModeInfo mode;
+    if (gate && SDL_strcmp(gate, "1") == 0)
+        return;
+    if (fd < 0 || fb == 0)
+        return;
+    if (!KMSDRM_ZlymeReadMarker(&crtc, &conn, &mode))
+        return;
+    if (just_type == DRM_MODE_CONNECTOR_DSI && just_conn == conn) {
+        unlink("/run/zlyme/hdmi-panel-off");
+        return;
+    }
+    if (KMSDRM_drmModeSetCrtc(fd, crtc, fb, 0, 0, &conn, 1, &mode) != 0)
+        SDL_Log("ZLYME_HDMI_PANEL: recover failed errno=%d", errno);
+    else {
+        SDL_Log("ZLYME_HDMI_PANEL: DSI crtc %u recovered with this client fb", crtc);
+        unlink("/run/zlyme/hdmi-panel-off");
+    }
+}
