+    if (SDL_strcmp(line, "panel-off\n") != 0 || fgetc(fp) != EOF) {
+        fclose(fp);
+        return 0;
+    }
+    fclose(fp);
+    return 1;
+}
+
+static SDL_VideoDisplay *KMSDRM_ZlymeRecoverDisplay(_THIS, SDL_Window *window)
+{
+    int i, n;
+    if (!KMSDRM_ZlymePanelMarker())
+        return NULL;
+    n = SDL_GetNumVideoDisplays();
+    for (i = 0; i < n; i++) {
+        SDL_VideoDisplay *display = &_this->displays[i];
+        SDL_DisplayData *dispdata = display->driverdata;
+        SDL_Rect bounds;
+        if (!dispdata || !dispdata->connector ||
+            dispdata->connector->connector_type != DRM_MODE_CONNECTOR_DSI)
+            continue;
+        SDL_zero(bounds);
+        if (SDL_GetDisplayBounds(i, &bounds) == 0) {
+            window->x = bounds.x;
+            window->y = bounds.y;
+            window->windowed.x = window->x;
+            window->windowed.y = window->y;
+        }
+        return display;
+    }
+    return NULL;
+}
