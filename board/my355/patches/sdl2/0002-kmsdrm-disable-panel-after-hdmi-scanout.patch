+/* Panel off only after this process has modeset HDMI.
+ * The marker is the single line "panel-off". It does not store a
+ * framebuffer id. The next client restores the panel by opening the
+ * DSI display itself. */
+static int zlyme_panel_off;
+
+static const char *KMSDRM_ZlymeMarkerPath(void)
+{
+    const char *path = SDL_getenv("ZLYME_HDMI_PANEL_MARK");
+    if (path && path[0] != '\0')
+        return path;
+    return "/run/zlyme/hdmi-panel-off";
+}
+
+static int KMSDRM_ZlymeMarkerOn(void)
+{
+    FILE *fp = fopen(KMSDRM_ZlymeMarkerPath(), "r");
+    char line[16];
+    if (!fp)
+        return 0;
+    if (!fgets(line, sizeof(line), fp)) {
+        fclose(fp);
+        return 0;
+    }
+    if (SDL_strcmp(line, "panel-off\n") != 0 || fgetc(fp) != EOF) {
+        fclose(fp);
+        return 0;
+    }
+    fclose(fp);
+    return 1;
+}
+
+static void KMSDRM_ZlymeWriteMarker(void)
+{
+    FILE *fp = fopen(KMSDRM_ZlymeMarkerPath(), "w");
+    if (!fp)
+        return;
+    if (fputs("panel-off\n", fp) == EOF)
+        SDL_Log("ZLYME_HDMI_PANEL: marker write failed errno=%d", errno);
+    fclose(fp);
+}
+
+void KMSDRM_ZlymeRestorePanel(int fd)
+{
+    (void)fd;
+    /* Do not program another client's framebuffer. The next ungated
+     * SDL client modesets DSI with a buffer of its own. */
+    zlyme_panel_off = 0;
+}
+
+static void KMSDRM_ZlymeQuiescePanel(int fd, uint32_t hdmi_crtc)
+{
+    const char *gate = SDL_getenv("ZLYME_HDMI_720P");
+    drmModeRes *res;
+    int i;
+    if (zlyme_panel_off)
+        return;
+    if (!gate || SDL_strcmp(gate, "1") != 0 || fd < 0 || hdmi_crtc == 0)
+        return;
+    if (KMSDRM_drmSetClientCap(fd, DRM_CLIENT_CAP_UNIVERSAL_PLANES, 1) != 0 ||
+        KMSDRM_drmSetClientCap(fd, DRM_CLIENT_CAP_ATOMIC, 1) != 0) {
+        SDL_Log("ZLYME_HDMI_PANEL: client cap failed errno=%d", errno);
+        return;
+    }
+    res = KMSDRM_drmModeGetResources(fd);
+    if (!res) {
+        SDL_Log("ZLYME_HDMI_PANEL: no resources errno=%d", errno);
+        return;
+    }
+    for (i = 0; i < res->count_connectors; i++) {
+        drmModeConnector *conn = KMSDRM_drmModeGetConnector(fd, res->connectors[i]);
+        drmModeEncoder *enc;
+        drmModeCrtc *crtc;
+        if (!conn)
+            continue;
+        if (conn->connector_type != DRM_MODE_CONNECTOR_DSI || conn->encoder_id == 0) {
+            KMSDRM_drmModeFreeConnector(conn);
+            continue;
+        }
+        enc = KMSDRM_drmModeGetEncoder(fd, conn->encoder_id);
+        if (!enc || enc->crtc_id == 0) {
+            if (enc)
+                KMSDRM_drmModeFreeEncoder(enc);
+            KMSDRM_drmModeFreeConnector(conn);
+            continue;
+        }
+        if (enc->crtc_id == hdmi_crtc) {
+            SDL_Log("ZLYME_HDMI_PANEL: DSI crtc %u is the HDMI crtc", enc->crtc_id);
+            KMSDRM_drmModeFreeEncoder(enc);
+            KMSDRM_drmModeFreeConnector(conn);
+            break;
+        }
+        crtc = KMSDRM_drmModeGetCrtc(fd, enc->crtc_id);
+        if (!crtc) {
+            KMSDRM_drmModeFreeEncoder(enc);
+            KMSDRM_drmModeFreeConnector(conn);
+            continue;
+        }
+        if (crtc->crtc_id == 0 || crtc->crtc_id != enc->crtc_id ||
+            crtc->crtc_id == hdmi_crtc) {
+            SDL_Log("ZLYME_HDMI_PANEL: DSI crtc %u is not a separate CRTC",
+                    crtc->crtc_id);
+            KMSDRM_drmModeFreeCrtc(crtc);
+            KMSDRM_drmModeFreeEncoder(enc);
+            KMSDRM_drmModeFreeConnector(conn);
+            break;
+        }
+        /* Linux drm_mode_setcrtc rejects a nonzero connector count without
+         * a mode and a framebuffer. Disable is fb 0, no connectors, no mode. */
+        if (KMSDRM_drmModeSetCrtc(fd, crtc->crtc_id, 0, 0, 0, NULL, 0, NULL) != 0) {
+            SDL_Log("ZLYME_HDMI_PANEL: DSI disable failed errno=%d", errno);
+            KMSDRM_drmModeFreeCrtc(crtc);
+            KMSDRM_drmModeFreeEncoder(enc);
+            KMSDRM_drmModeFreeConnector(conn);
+            break;
+        }
+        zlyme_panel_off = 1;
+        KMSDRM_ZlymeWriteMarker();
+        SDL_Log("ZLYME_HDMI_PANEL: DSI crtc %u disabled after HDMI scanout",
+                crtc->crtc_id);
+        KMSDRM_drmModeFreeCrtc(crtc);
+        KMSDRM_drmModeFreeEncoder(enc);
+        KMSDRM_drmModeFreeConnector(conn);
+        break;
+    }
+    KMSDRM_drmModeFreeResources(res);
+}
+
+static void KMSDRM_ZlymeNotePanel(int fd, uint32_t crtc_id, uint32_t own_fb)
+{
+    drmModeCrtc *now;
+
+    /* The cached CRTC from connector open can still say buffer 0 after
+     * this process has modeset DSI. Read the CRTC now and clear the
+     * marker only when it is scanning this process's framebuffer. */
+    if (fd < 0 || crtc_id == 0 || own_fb == 0 || !KMSDRM_ZlymeMarkerOn())
+        return;
+    now = KMSDRM_drmModeGetCrtc(fd, crtc_id);
+    if (!now)
+        return;
+    if (now->buffer_id == own_fb && now->mode_valid && now->mode.hdisplay > 0)
+        unlink(KMSDRM_ZlymeMarkerPath());
+    KMSDRM_drmModeFreeCrtc(now);
+}
+
+void KMSDRM_ZlymeHoldPanel(void)
+{
+    /* This process cannot leave its framebuffer behind. The next
+     * ungated client still has to open DSI itself. */
+    KMSDRM_ZlymeWriteMarker();
+}
