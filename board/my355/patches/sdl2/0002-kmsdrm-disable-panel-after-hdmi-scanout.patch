+
+static int KMSDRM_ZlymePanelMarker(void)
+{
+    FILE *fp = fopen(KMSDRM_ZlymePanelPath(), "r");
+    char line[16];
+    const char *gate = SDL_getenv("ZLYME_HDMI_720P");
+    if (gate && SDL_strcmp(gate, "1") == 0)
+        return 0;
+    if (!fp)
+        return 0;
+    if (!fgets(line, sizeof(line), fp)) {
+        fclose(fp);
+        return 0;
