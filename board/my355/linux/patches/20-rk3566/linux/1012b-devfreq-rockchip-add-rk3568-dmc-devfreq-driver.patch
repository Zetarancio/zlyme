diff --git a/drivers/devfreq/rk3568_dmc.c b/drivers/devfreq/rk3568_dmc.c
--- a/drivers/devfreq/rk3568_dmc.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/devfreq/rk3568_dmc.c	2026-04-10 00:53:53.953113888 +0200
@@ -0,0 +1,593 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * RK3566/RK3568 DMC (Dynamic Memory Controller) devfreq driver.
+ *
+ * DDR frequency scaling uses a shared-memory protocol with the ARM
+ * Trusted Firmware.  SET_RATE returns "in progress", the kernel then
+ * starts the on-chip MCU which performs the hardware frequency change
+ * and fires a completion IRQ.
+ *
+ * Copyright (c) 2021 Rockchip Electronics Co. Ltd.
+ * Copyright (c) 2026 ROCKNIX contributors.
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/clk.h>
+#include <linux/devfreq.h>
+#include <linux/devfreq-event.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_opp.h>
+#include <linux/pm_qos.h>
+#include <linux/regulator/consumer.h>
+#include <linux/wait.h>
+
+#include <soc/rockchip/rockchip_sip.h>
+
+#define SIP_RET_SET_RATE_TIMEOUT		(-6)
+#define RK3568_ATF_VERSION_MIN			0x101
+
+/*
+ * Shared-memory layout matching the ATF DDR interface.
+ * First 4 KB page: interface parameters.  Second 4 KB: DTS parameters.
+ */
+struct rk3568_share_params {
+	u32 hz;
+	u32 lcdc_type;
+	u32 vop;
+	u32 vop_dclk_mode;
+	u32 sr_idle_en;
+	u32 addr_mcu_el3;
+	u32 wait_flag1;
+	u32 wait_flag0;
+	u32 complt_hwirq;
+	u32 update_drv_odt_cfg;
+	u32 update_deskew_cfg;
+	u32 freq_count;
+	u32 freq_info_mhz[6];
+	u32 wait_mode;
+	u32 vop_scan_line_time_ns;
+};
+
+struct rk3568_wait_ctrl {
+	wait_queue_head_t	wait_wq;
+	int			wait_flag;
+	int			wait_en;
+	int			wait_timeout_ms;
+	int			complt_irq;
+};
+
+struct rk3568_dmcfreq {
+	struct device			*dev;
+	struct devfreq			*devfreq;
+	struct devfreq_simple_ondemand_data ondemand_data;
+	struct clk			*dmc_clk;
+	struct devfreq_event_dev	*edev;
+	struct regulator		*vdd_center;
+	struct mutex			lock;
+
+	struct rk3568_share_params __iomem *share_params;
+	struct rk3568_wait_ctrl		wait_ctrl;
+	struct pm_qos_request		pm_qos;
+
+	unsigned long			rate;
+	unsigned long			volt;
+	unsigned long			boot_rate;
+	int				post_resume_scale_down;
+};
+
+/* ---- SIP helpers ------------------------------------------------------ */
+
+static struct arm_smccc_res sip_smc_dram(unsigned long arg0,
+					 unsigned long arg1,
+					 unsigned long arg2)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(ROCKCHIP_SIP_DRAM_FREQ, arg0, arg1, arg2,
+		      0, 0, 0, 0, &res);
+	return res;
+}
+
+/* ---- MCU completion IRQ & wait logic ---------------------------------- */
+
+static irqreturn_t rk3568_dcf_complete_irq(int irqno, void *dev_id)
+{
+	struct rk3568_dmcfreq *dmcfreq = dev_id;
+	struct arm_smccc_res res;
+
+	res = sip_smc_dram(ROCKCHIP_SIP_SHARE_PAGE_DDR, 0,
+			   ROCKCHIP_SIP_CONFIG_DRAM_POST_SET_RATE);
+	if (res.a0)
+		dev_err(dmcfreq->dev, "POST_SET_RATE error: %lx\n", res.a0);
+
+	dmcfreq->wait_ctrl.wait_flag = 0;
+	wake_up(&dmcfreq->wait_ctrl.wait_wq);
+	return IRQ_HANDLED;
+}
+
+static int rk3568_dmcfreq_wait_complete(struct rk3568_dmcfreq *dmcfreq)
+{
+	struct rk3568_wait_ctrl *wc = &dmcfreq->wait_ctrl;
+	struct arm_smccc_res res;
+
+	if (!wc->wait_en)
+		return 0;
+
+	wc->wait_flag = -1;
+	enable_irq(wc->complt_irq);
+
+	cpu_latency_qos_update_request(&dmcfreq->pm_qos, 0);
+
+	res = sip_smc_dram(0, 0, ROCKCHIP_SIP_CONFIG_MCU_START);
+	if (res.a0) {
+		dev_err(dmcfreq->dev, "MCU_START error: %lx\n", res.a0);
+		goto out;
+	}
+
+	wait_event_timeout(wc->wait_wq, wc->wait_flag == 0,
+			   msecs_to_jiffies(wc->wait_timeout_ms));
+
+	if (wc->wait_flag != 0) {
+		dev_err_ratelimited(dmcfreq->dev,
+				    "MCU completion timed out, forcing POST_SET_RATE\n");
+		res = sip_smc_dram(ROCKCHIP_SIP_SHARE_PAGE_DDR, 0,
+				   ROCKCHIP_SIP_CONFIG_DRAM_POST_SET_RATE);
+		if (res.a0)
+			dev_err(dmcfreq->dev, "POST_SET_RATE error: %lx\n",
+				res.a0);
+	}
+
+out:
+	cpu_latency_qos_update_request(&dmcfreq->pm_qos,
+				       PM_QOS_DEFAULT_VALUE);
+	disable_irq(wc->complt_irq);
+
+	return 0;
+}
+
+/* ---- Rate setting ----------------------------------------------------- */
+
+static int rk3568_dmc_set_rate(struct rk3568_dmcfreq *dmcfreq,
+			       unsigned long target_rate)
+{
+	struct rk3568_share_params __iomem *p = dmcfreq->share_params;
+	struct arm_smccc_res res;
+
+	writel_relaxed(target_rate, &p->hz);
+	writel_relaxed(0, &p->lcdc_type);
+	writel_relaxed(1, &p->wait_flag1);
+	writel_relaxed(1, &p->wait_flag0);
+
+	res = sip_smc_dram(ROCKCHIP_SIP_SHARE_PAGE_DDR, 0,
+			   ROCKCHIP_SIP_CONFIG_DRAM_SET_RATE);
+
+	if ((int)res.a1 == SIP_RET_SET_RATE_TIMEOUT)
+		rk3568_dmcfreq_wait_complete(dmcfreq);
+
+	return res.a0;
+}
+
+/* ---- devfreq callbacks ------------------------------------------------ */
+
+static int rk3568_dmcfreq_target(struct device *dev, unsigned long *freq,
+				 u32 flags)
+{
+	struct rk3568_dmcfreq *dmcfreq = dev_get_drvdata(dev);
+	struct dev_pm_opp *opp;
+	unsigned long target_rate, target_volt, old_rate;
+	int err;
+
+	opp = devfreq_recommended_opp(dev, freq, flags);
+	if (IS_ERR(opp))
+		return PTR_ERR(opp);
+
+	target_rate = dev_pm_opp_get_freq(opp);
+	target_volt = dev_pm_opp_get_voltage(opp);
+	dev_pm_opp_put(opp);
+
+	if (dmcfreq->rate == target_rate)
+		return 0;
+
+	mutex_lock(&dmcfreq->lock);
+	old_rate = dmcfreq->rate;
+
+	if (target_rate > old_rate) {
+		err = regulator_set_voltage(dmcfreq->vdd_center,
+					    target_volt, INT_MAX);
+		if (err) {
+			dev_err(dev, "cannot set voltage %lu uV\n",
+				target_volt);
+			goto unlock;
+		}
+	}
+
+	err = rk3568_dmc_set_rate(dmcfreq, target_rate);
+	if (err) {
+		dev_err(dev, "cannot set DDR rate %lu Hz (%d)\n",
+			target_rate, err);
+		if (target_rate > old_rate)
+			regulator_set_voltage(dmcfreq->vdd_center,
+					      dmcfreq->volt, INT_MAX);
+		goto unlock;
+	}
+
+	if (target_rate < old_rate) {
+		err = regulator_set_voltage(dmcfreq->vdd_center,
+					    target_volt, INT_MAX);
+		if (err)
+			dev_err(dev, "cannot set voltage %lu uV\n",
+				target_volt);
+	}
+
+	dmcfreq->rate = target_rate;
+	dmcfreq->volt = target_volt;
+	err = 0;
+
+unlock:
+	mutex_unlock(&dmcfreq->lock);
+	return err;
+}
+
+static int rk3568_dmcfreq_get_dev_status(struct device *dev,
+					 struct devfreq_dev_status *stat)
+{
+	struct rk3568_dmcfreq *dmcfreq = dev_get_drvdata(dev);
+	struct devfreq_event_data edata;
+	int ret;
+
+	stat->current_frequency = dmcfreq->rate;
+
+	/*
+	 * After resume, DFI may return total_count == 0 for several polls
+	 * (monitor block was powered off).  Force 0% load so the governor
+	 * scales to min; prime DFI so subsequent polls get valid deltas.
+	 */
+	if (dmcfreq->post_resume_scale_down > 0) {
+		dmcfreq->post_resume_scale_down--;
+		devfreq_event_get_event(dmcfreq->edev, &edata);
+		stat->busy_time = 0;
+		stat->total_time = 1;
+		return 0;
+	}
+
+	ret = devfreq_event_get_event(dmcfreq->edev, &edata);
+	if (ret < 0)
+		return ret;
+
+	if (edata.total_count == 0) {
+		stat->busy_time = 2;
+		stat->total_time = 10;
+		return 0;
+	}
+
+	stat->busy_time = edata.load_count;
+	stat->total_time = edata.total_count;
+
+	return 0;
+}
+
+static int rk3568_dmcfreq_get_cur_freq(struct device *dev, unsigned long *freq)
+{
+	struct rk3568_dmcfreq *dmcfreq = dev_get_drvdata(dev);
+
+	*freq = dmcfreq->rate;
+	return 0;
+}
+
+static struct devfreq_dev_profile rk3568_devfreq_profile = {
+	.polling_ms	= 200,
+	.target		= rk3568_dmcfreq_target,
+	.get_dev_status	= rk3568_dmcfreq_get_dev_status,
+	.get_cur_freq	= rk3568_dmcfreq_get_cur_freq,
+};
+
+/* ---- Suspend / resume ------------------------------------------------- */
+
+static int rk3568_dmcfreq_suspend(struct device *dev)
+{
+	struct rk3568_dmcfreq *dmcfreq = dev_get_drvdata(dev);
+	struct rk3568_share_params __iomem *p = dmcfreq->share_params;
+	struct dev_pm_opp *opp;
+	unsigned long target_volt;
+	unsigned long freq;
+
+	if (!dmcfreq->devfreq)
+		return 0;
+
+	/*
+	 * Force DDR to the boot frequency before suspend.  The ATF
+	 * resume path restores DDR from self-refresh expecting this
+	 * frequency.
+	 */
+	mutex_lock(&dmcfreq->lock);
+	if (dmcfreq->rate != dmcfreq->boot_rate) {
+		freq = dmcfreq->boot_rate;
+		opp = dev_pm_opp_find_freq_ceil(dev, &freq);
+		if (!IS_ERR(opp)) {
+			target_volt = dev_pm_opp_get_voltage(opp);
+			dev_pm_opp_put(opp);
+			if (target_volt > dmcfreq->volt)
+				regulator_set_voltage(dmcfreq->vdd_center,
+						      target_volt, INT_MAX);
+			rk3568_dmc_set_rate(dmcfreq, dmcfreq->boot_rate);
+			if (target_volt < dmcfreq->volt)
+				regulator_set_voltage(dmcfreq->vdd_center,
+						      target_volt, INT_MAX);
+			dmcfreq->rate = dmcfreq->boot_rate;
+			dmcfreq->volt = target_volt;
+		}
+	}
+
+	if (p) {
+		writel_relaxed(0, &p->hz);
+		writel_relaxed(1, &p->sr_idle_en);
+		writel_relaxed(0, &p->wait_flag1);
+		writel_relaxed(0, &p->wait_flag0);
+	}
+	mutex_unlock(&dmcfreq->lock);
+
+	return 0;
+}
+
+static int rk3568_dmcfreq_resume(struct device *dev)
+{
+	struct rk3568_dmcfreq *dmcfreq = dev_get_drvdata(dev);
+
+	if (!dmcfreq->devfreq)
+		return 0;
+
+	dmcfreq->rate = clk_get_rate(dmcfreq->dmc_clk);
+
+	if (dmcfreq->share_params)
+		writel_relaxed(0, &dmcfreq->share_params->sr_idle_en);
+
+	dmcfreq->post_resume_scale_down = 3;
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(rk3568_dmcfreq_pm,
+				rk3568_dmcfreq_suspend,
+				rk3568_dmcfreq_resume);
+
+/* ---- OPP table adjustment from ATF frequency info --------------------- */
+
+static int rk3568_dmc_get_freq_info(struct rk3568_dmcfreq *dmcfreq)
+{
+	struct device *dev = dmcfreq->dev;
+	struct rk3568_share_params __iomem *p = dmcfreq->share_params;
+	struct arm_smccc_res res;
+	struct dev_pm_opp *opp;
+	unsigned long rate;
+	unsigned long freq_info_rate[6];
+	int freq_count, i, j;
+
+	res = sip_smc_dram(ROCKCHIP_SIP_SHARE_PAGE_DDR, 0,
+			   ROCKCHIP_SIP_CONFIG_DRAM_GET_FREQ_INFO);
+	if (res.a0) {
+		dev_dbg(dev, "GET_FREQ_INFO failed (%ld), using DTS OPPs\n",
+			(long)res.a0);
+		return 0;
+	}
+
+	freq_count = readl_relaxed(&p->freq_count);
+	if (freq_count == 0 || freq_count > 6) {
+		dev_dbg(dev, "invalid freq_count %d from ATF\n", freq_count);
+		return 0;
+	}
+
+	for (i = 0; i < freq_count; i++) {
+		freq_info_rate[i] = (unsigned long)readl_relaxed(&p->freq_info_mhz[i]) * 1000000;
+		dev_dbg(dev, "ATF FSP[%d]: %lu Hz\n", i, freq_info_rate[i]);
+	}
+
+	for (rate = 0; ; rate++) {
+		opp = dev_pm_opp_find_freq_ceil(dev, &rate);
+		if (IS_ERR(opp))
+			break;
+		dev_pm_opp_put(opp);
+
+		for (j = 0; j < freq_count; j++) {
+			if (rate == freq_info_rate[j])
+				break;
+		}
+		if (j == freq_count) {
+			dev_dbg(dev, "disabling unsupported OPP %lu Hz\n",
+				rate);
+			dev_pm_opp_disable(dev, rate);
+		}
+	}
+
+	return 0;
+}
+
+/* ---- Probe / remove --------------------------------------------------- */
+
+static int rk3568_dmcfreq_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct rk3568_dmcfreq *data;
+	struct arm_smccc_res res;
+	struct dev_pm_opp *opp;
+	int complt_irq;
+	int ret;
+
+	data = devm_kzalloc(dev, sizeof(*data), GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+
+	data->dev = dev;
+	mutex_init(&data->lock);
+
+	/* Check ATF version */
+	res = sip_smc_dram(0, 0, ROCKCHIP_SIP_CONFIG_DRAM_GET_VERSION);
+	dev_dbg(dev, "ATF DDR version 0x%lx\n", res.a1);
+	if (res.a0 || res.a1 < RK3568_ATF_VERSION_MIN) {
+		dev_err(dev, "ATF too old or unsupported (need >= 0x%x)\n",
+			RK3568_ATF_VERSION_MIN);
+		return -ENXIO;
+	}
+
+	/* Request shared memory from ATF (2 pages) */
+	arm_smccc_smc(ROCKCHIP_SIP_SHARE_MEM, 2,
+		      ROCKCHIP_SIP_SHARE_PAGE_DDR, 0,
+		      0, 0, 0, 0, &res);
+	if (res.a0 || !res.a1) {
+		dev_err(dev, "SIP_SHARE_MEM failed (a0=%ld a1=0x%lx)\n",
+			(long)res.a0, res.a1);
+		return -ENOMEM;
+	}
+	data->share_params = devm_ioremap(dev, res.a1, 2 * PAGE_SIZE);
+	if (!data->share_params)
+		return dev_err_probe(dev, -ENOMEM,
+				     "failed to ioremap shared memory at 0x%lx\n",
+				     res.a1);
+	memset_io(data->share_params, 0, 2 * PAGE_SIZE);
+
+	/* Set up MCU-based DCF completion wait mechanism */
+	init_waitqueue_head(&data->wait_ctrl.wait_wq);
+	data->wait_ctrl.wait_en = 1;
+	data->wait_ctrl.wait_timeout_ms = 17 * 5;
+
+	complt_irq = platform_get_irq_byname(pdev, "complete");
+	if (complt_irq < 0)
+		return complt_irq;
+	data->wait_ctrl.complt_irq = complt_irq;
+
+	ret = devm_request_irq(dev, complt_irq, rk3568_dcf_complete_irq,
+			       0, dev_name(dev), data);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "cannot request complete IRQ\n");
+	disable_irq(complt_irq);
+
+	{
+		struct irq_data *irqd;
+		u32 complt_hwirq;
+
+		irqd = irq_get_irq_data(complt_irq);
+		if (!irqd)
+			return dev_err_probe(dev, -EINVAL,
+					     "cannot map complete IRQ to irq_data\n");
+		complt_hwirq = irqd_to_hwirq(irqd);
+		writel_relaxed(complt_hwirq, &data->share_params->complt_hwirq);
+	}
+
+	/* Initialize DRAM scaling in ATF */
+	res = sip_smc_dram(ROCKCHIP_SIP_SHARE_PAGE_DDR, 0,
+			   ROCKCHIP_SIP_CONFIG_DRAM_INIT);
+	if (res.a0) {
+		dev_err(dev, "DRAM_INIT failed: %lx\n", res.a0);
+		return -ENOMEM;
+	}
+
+	/* Get device resources */
+	data->vdd_center = devm_regulator_get(dev, "center");
+	if (IS_ERR(data->vdd_center))
+		return dev_err_probe(dev, PTR_ERR(data->vdd_center),
+				     "cannot get regulator \"center\"\n");
+
+	data->dmc_clk = devm_clk_get(dev, "dmc_clk");
+	if (IS_ERR(data->dmc_clk))
+		return dev_err_probe(dev, PTR_ERR(data->dmc_clk),
+				     "cannot get clk dmc_clk\n");
+
+	data->edev = devfreq_event_get_edev_by_phandle(dev,
+						       "devfreq-events", 0);
+	if (IS_ERR(data->edev))
+		return -EPROBE_DEFER;
+
+	/* Read boot frequency */
+	data->rate = clk_get_rate(data->dmc_clk);
+	data->boot_rate = data->rate;
+
+	/* Load and adjust OPP table */
+	ret = devm_pm_opp_of_add_table(dev);
+	if (ret) {
+		dev_err(dev, "invalid operating-points in DT\n");
+		return ret;
+	}
+
+	rk3568_dmc_get_freq_info(data);
+
+	cpu_latency_qos_add_request(&data->pm_qos, PM_QOS_DEFAULT_VALUE);
+
+	ret = devfreq_event_enable_edev(data->edev);
+	if (ret < 0) {
+		dev_err(dev, "failed to enable DFI event device\n");
+		goto err_qos;
+	}
+
+	opp = devfreq_recommended_opp(dev, &data->rate, 0);
+	if (IS_ERR(opp)) {
+		ret = PTR_ERR(opp);
+		goto err_edev;
+	}
+	data->rate = dev_pm_opp_get_freq(opp);
+	data->volt = dev_pm_opp_get_voltage(opp);
+	dev_pm_opp_put(opp);
+
+	data->ondemand_data.upthreshold = 25;
+	data->ondemand_data.downdifferential = 15;
+	rk3568_devfreq_profile.initial_freq = data->rate;
+
+	data->devfreq = devm_devfreq_add_device(dev,
+						&rk3568_devfreq_profile,
+						DEVFREQ_GOV_SIMPLE_ONDEMAND,
+						&data->ondemand_data);
+	if (IS_ERR(data->devfreq)) {
+		ret = PTR_ERR(data->devfreq);
+		dev_err(dev, "failed to add devfreq device: %d\n", ret);
+		goto err_edev;
+	}
+
+	devm_devfreq_register_opp_notifier(dev, data->devfreq);
+	platform_set_drvdata(pdev, data);
+
+	dev_info(dev, "DDR devfreq: %lu Hz, %lu uV\n",
+		 data->rate, data->volt);
+
+	return 0;
+
+err_edev:
+	devfreq_event_disable_edev(data->edev);
+err_qos:
+	cpu_latency_qos_remove_request(&data->pm_qos);
+	return ret;
+}
+
+static void rk3568_dmcfreq_remove(struct platform_device *pdev)
+{
+	struct rk3568_dmcfreq *dmcfreq = dev_get_drvdata(&pdev->dev);
+
+	if (dmcfreq->devfreq)
+		devfreq_event_disable_edev(dmcfreq->edev);
+
+	cpu_latency_qos_remove_request(&dmcfreq->pm_qos);
+}
+
+static const struct of_device_id rk3568_dmcfreq_of_match[] = {
+	{ .compatible = "rockchip,rk3568-dmc" },
+	{ },
+};
+MODULE_DEVICE_TABLE(of, rk3568_dmcfreq_of_match);
+
+static struct platform_driver rk3568_dmcfreq_driver = {
+	.probe	= rk3568_dmcfreq_probe,
+	.remove	= rk3568_dmcfreq_remove,
+	.driver	= {
+		.name	= "rk3568-dmc",
+		.pm	= pm_sleep_ptr(&rk3568_dmcfreq_pm),
+		.of_match_table = rk3568_dmcfreq_of_match,
+	},
+};
+module_platform_driver(rk3568_dmcfreq_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Zetarancio <zetarancio@users.noreply.github.com>");
+MODULE_DESCRIPTION("RK3566/RK3568 DMC devfreq driver");
