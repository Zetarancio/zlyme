choice
	prompt "Zlyme target device"
	default BR2_ZLYME_DEVICE_MY355

config BR2_ZLYME_DEVICE_MY355
	bool "Miyoo Flip (my355)"
	help
	  Miyoo Flip, RK3566. The only supported device.
	  Board files live in board/my355/.

endchoice

# NextUI workspace directory for the selected device. Hidden: the
# default follows the choice above. my355 stays my355.
config BR2_PACKAGE_NEXTUI_PLATFORM
	string
	default "my355" if BR2_ZLYME_DEVICE_MY355

menu "Zlyme"

comment "Boot"
source "$BR2_EXTERNAL_ZLYME_PATH/package/boot/Config.in"

comment "Drivers"
source "$BR2_EXTERNAL_ZLYME_PATH/package/drivers/Config.in"

comment "System"
source "$BR2_EXTERNAL_ZLYME_PATH/package/system/Config.in"

comment "Emulation"
source "$BR2_EXTERNAL_ZLYME_PATH/package/emulators/Config.in"

endmenu
